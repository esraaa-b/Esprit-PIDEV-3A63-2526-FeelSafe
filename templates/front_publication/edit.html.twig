{% extends "dashboard/base.html.twig" %}

{% block stylesheets %}
    <style>
        .edit-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(229, 231, 235, 0.5);
            transition: all 0.3s ease;
        }

        .edit-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .form-input {
            transition: all 0.2s ease;
            border: 2px solid #e5e7eb;
        }

        .form-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .file-upload-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
        }

        .btn-update {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%); /* Green gradient */
            transition: all 0.3s ease;
        }

        .btn-update:hover {
            filter: brightness(110%);
            transform: translateY(-1px);
        }

        .btn-cancel:hover {
            background-color: #f3f4f6;
            color: #ef4444;
        }
    </style>
{% endblock %}

{% block title %}Modifier la publication{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto mt-10 px-4">
    <div class="edit-card bg-white p-8 rounded-3xl shadow-xl">
        <div class="flex items-center gap-4 mb-8 border-b pb-6 border-gray-100">
            <div class="p-3 bg-green-50 rounded-2xl text-green-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Modifier la publication</h1>
                <p class="text-gray-500 mt-1">Mettez à jour les détails de votre publication</p>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            {# Titre #}
            <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700 uppercase tracking-wider">Titre</label>
                {{ form_widget(form.titre, {
                    'attr': {
                        'class': 'form-input w-full rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none',
                        'placeholder': 'Donnez un titre accrocheur...'
                    }
                }) }}
                <div class="text-red-500 text-sm">
                    {{ form_errors(form.titre) }}
                </div>
            </div>

            {# Contenu #}
            <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700 uppercase tracking-wider">Contenu</label>
                {{ form_widget(form.contenu, {
                    'attr': {
                        'class': 'form-input w-full rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none resize-none',
                        'placeholder': 'Exprimez-vous...',
                        'rows': 6
                    }
                }) }}
                <div class="text-red-500 text-sm">
                    {{ form_errors(form.contenu) }}
                </div>
            </div>

            {# Image #}
            <div class="space-y-2">
                <label class="block text-sm font-semibold text-gray-700 uppercase tracking-wider">Image de couverture</label>
                
                <div class="flex items-start gap-6 p-4 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                    <div class="flex-1">
                        {{ form_widget(form.image, {
                            'attr': {
                                'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors cursor-pointer'
                            }
                        }) }}
                        <div class="text-red-500 text-sm mt-1">
                            {{ form_errors(form.image) }}
                        </div>
                        <p class="mt-2 text-xs text-gray-400">PNG, JPG, GIF jusqu'à 5MB</p>
                    </div>

                    {% if publication.image %}
                        <div class="relative group">
                            <img src="{{ asset('uploads/' ~ publication.image) }}" alt="Aperçu" 
                                 class="w-24 h-24 object-cover rounded-lg shadow-sm border border-gray-200">
                            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg flex items-center justify-center">
                                <span class="text-white text-xs font-medium">Actuelle</span>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="pt-8 flex items-center justify-end gap-4 border-t border-gray-100 mt-8">
                <a href="{{ path('app_front_publication') }}"
                   class="btn-cancel px-6 py-2.5 rounded-xl text-gray-600 font-semibold transition-colors bg-white border border-gray-200 hover:border-red-200 flex items-center gap-2">
                   <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span>Annuler</span>
                </a>

                <button type="submit"
                        class="btn-update flex items-center justify-center gap-2 text-white font-bold px-6 py-2.5 rounded-xl shadow-lg shadow-green-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    <span>Enregistrer</span>
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
