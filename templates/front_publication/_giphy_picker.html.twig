{# Variables: textareaId, hiddenInputId (optional), initialGif (optional), showMedia (optional, default true) #}
{% set showMedia = showMedia ?? true %}

<div x-data="giphyPicker('{{ textareaId }}', '{{ hiddenInputId|default('') }}', '{{ initialGif|default('') }}')"
     class="relative giphy-picker-container"
     @giphy-clear.window="if($event.detail.textareaId === '{{ textareaId }}') clearGif()">

    {# Toolbar buttons #}
    <div class="flex items-center gap-1 mb-1">
        {% if showMedia %}
            <button type="button" @click="togglePanel('gifs')"
                :class="activePanel === 'gifs' ? 'bg-purple-100 text-purple-700 ring-1 ring-purple-300' : 'hover:bg-gray-100 text-gray-500'"
                class="px-2 py-1 rounded-md text-xs transition flex items-center gap-1.5 whitespace-nowrap">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/>
            </svg>
            GIF
        </button>

        <button type="button" @click="togglePanel('stickers')"
                :class="activePanel === 'stickers' ? 'bg-pink-100 text-pink-700 ring-1 ring-pink-300' : 'hover:bg-gray-100 text-gray-500'"
                class="px-2 py-1 rounded-md text-xs transition flex items-center gap-1.5 whitespace-nowrap">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
            Stickers
        </button>
        {% endif %}

        <button type="button" @click="togglePanel('emojis')"
                :class="activePanel === 'emojis' ? 'bg-yellow-100 text-yellow-700 ring-1 ring-yellow-300' : 'hover:bg-gray-100 text-gray-500'"
                class="px-2 py-1 rounded-md text-xs transition flex items-center gap-1.5 whitespace-nowrap">
            <span class="flex items-center gap-1.5">
                <i data-feather="sparkles" class="w-3.5 h-3.5"></i>
                <span>Emojis</span>
            </span>
        </button>

        <button type="button" @click="togglePanel('text-emojis')"
                :class="activePanel === 'text-emojis' ? 'bg-blue-100 text-blue-700 ring-1 ring-blue-300' : 'hover:bg-gray-100 text-gray-500'"
                class="px-2 py-1 rounded-md text-xs transition flex items-center gap-1.5 whitespace-nowrap text-base">
            😊
        </button>
    </div>

    {# Selected Preview #}
    <div x-show="selectedGif" class="relative mb-2 inline-block" x-cloak>
        <img :src="selectedGif" class="max-h-24 rounded-lg border border-border shadow-sm">
        <button type="button" @click="clearGif()"
                class="absolute -top-1.5 -right-1.5 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs shadow hover:bg-red-600 transition">
            ✕
        </button>
    </div>

    {# Panel #}
    <div x-show="activePanel !== null" x-cloak x-transition
         class="absolute z-50 bottom-full mb-2 right-0 w-72 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden"
         @click.outside="activePanel = null">



        <div class="p-2 h-64 overflow-y-auto overflow-x-hidden">
            <div x-show="loading" class="flex items-center justify-center h-full">
                <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-purple-500"></div>
            </div>

            {# Giphy Results (Gifs & Stickers) #}
            <template x-if="['gifs', 'stickers'].includes(activePanel)">
                <div class="grid grid-cols-7 gap-0.5 pt-2">
                    <template x-for="item in results" :key="item.id">
                        <button type="button" @click="selectGif(item)"
                                class="rounded-sm overflow-hidden hover:ring-2 hover:ring-purple-400 transition group relative aspect-square bg-gray-50">
                            <img :src="item.images.fixed_width_small.url"
                                 class="w-full h-full object-cover group-hover:scale-110 transition" loading="lazy">
                        </button>
                    </template>
                </div>
            </template>

            {# Giphy Animated Emojis #}
            <template x-if="activePanel === 'emojis'">
                <div class="flex flex-row flex-wrap gap-2 justify-start items-start">
                    <template x-for="item in results" :key="item.id">
                        <button type="button" @click="selectGif(item)"
                                class="hover:scale-125 transition flex items-center justify-center w-6 h-6">
                            <img :src="item.images.fixed_height_small.url"
                                 class="w-full h-full object-contain" loading="lazy">
                        </button>
                    </template>
                </div>
            </template>

            {# Text Emoji Results #}
            <template x-if="activePanel === 'text-emojis'">
                <div class="flex flex-row flex-wrap gap-2 justify-start pt-3">
                    <template x-for="emoji in allTextEmojis[activeEmojiCategory]" :key="emoji">
                        <button type="button" @click="insertEmoji(emoji)"
                                class="text-2xl w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-all hover:scale-110 active:scale-90"
                                x-text="emoji">
                        </button>
                    </template>
                </div>
            </template>

            <div x-show="!loading && results.length === 0 && activePanel !== 'text-emojis'" class="flex flex-col items-center justify-center h-full text-gray-400 text-sm">
                <p>Aucun résultat</p>
            </div>
        </div>

        {# Emoji Categories Tabs (Moved to bottom) #}
        <div x-show="activePanel === 'text-emojis'" class="flex items-center gap-1 px-2 py-1.5 bg-gray-50 overflow-x-auto no-scrollbar border-t border-gray-100">
            <template x-for="(list, category) in allTextEmojis" :key="category">
                <button type="button" @click="activeEmojiCategory = category"
                        :class="activeEmojiCategory === category ? 'bg-white shadow-sm ring-1 ring-gray-200' : 'opacity-60 hover:opacity-100'"
                        class="px-2 py-1 rounded text-sm transition whitespace-nowrap flex items-center gap-1">
                    <span x-text="category.split(' ')[0]"></span>
                    <span class="text-[10px] font-medium" x-text="category.split(' ').slice(1).join(' ')"></span>
                </button>
            </template>
        </div>

        {# Search (Moved to bottom) #}
        <div class="p-2 border-t border-gray-100" x-show="activePanel !== 'text-emojis' && activePanel !== 'emojis'">
            <input type="text" x-model="searchQuery" @input.debounce.400ms="search()"
                   :placeholder="'Rechercher...'"
                   class="w-full px-2.5 py-1 text-xs rounded-lg border border-gray-200 bg-gray-50 text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-400">
        </div>

        <div x-show="['gifs', 'stickers', 'emojis'].includes(activePanel)" class="px-2 py-1 border-t border-gray-100 flex justify-end">
            <span class="text-[10px] text-gray-400">Powered by GIPHY</span>
        </div>
    </div>
</div>

<script>
if (!window.giphyPickerInitialized) {
    window.giphyPickerInitialized = true;
    document.addEventListener('alpine:init', () => {
        Alpine.data('giphyPicker', (textareaId, hiddenInputId, initialGif = '') => ({
            activePanel: null,
            searchQuery: '',
            results: [],
            loading: false,
            selectedGif: initialGif,
            apiKey: 'n8duRZuzvYirm2KnbnO7eSVXuJMmI2NL',
            activeEmojiCategory: '😊 Smileys',

            allTextEmojis: {
                '😊 Smileys': ['😀','😃','😄','😁','😆','😅','🤣','😂','🙂','🙃','😉','😊','😇','🥰','😍','🤩','😘','😗','😚','😙','😋','😛','😜','🤪','😝','🤑','🤗','🤭','🤫','🤔','🤐','🤨','😐','😑','😶','😏','😒','🙄','😬','🤥','😌','😔','😪','🤤','😴'],
                '👋 People': ['👂','👃','🧠','👣','👀','👁️','🗣️','👤','👥','🫂','👶','🧒','👦','👧','🧑','👱','👨','🧔','👩','👵','👴','👲','👳','👮','👷','💂','🕵️','🤵','👰','🤰','🤱','👼','🎅','🤶','🦸','🦹','🧙','🧚','🧛','🧜','🧝','🧞','🧟','🕴️','💃','🕺','🤺','🏇','⛷️','🏂','🏌️','🏄','🚣','🏊','🏋️','🚴','🚵','🤸','🤼','🤽','🤾','🤹'],
                '🐾 Animals': ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐻‍❄️','🐨','🐯','🦁','🐮','🐷','🐽','🐸','🐵','🐒','🦍','🦧','🐶','🐕','🦮','🐕‍🦺','🐩','🐺','🦊','🦝','🐱','🐈','🐈‍⬛','🦁','🐯','🐅','🐆','🐴','🐎','🦄','🦓','🦌','🦬','🐮','🐂','🐃','🐄','🐷','🐖','🐗','🐽','🐏','🐑','🐐','🐪','🐫','🦙','🦒','🐘','🦣','🦏','🦛','🐭','🐁','🐀','🐹','🐰','🐇','🐿️','🦫','🦔','🦇','🐻','🐻‍❄️','🐨','🐼','🦥','🦦','🦨','🦘','🦡','🐾'],
                '🍎 Food': ['🍏','🍎','🍐','🍊','🍋','🍌','🍉','🍇','🍓','🫐',' melon','🍒','🍑','🥭','🍍','🥥','🥝','🍅','🍆','🥑','🥦','🥬','🥒','🌽','🥕','🫒','🧄','🧅','🥔','🍠','🥐','🍞','🥖','🥨','🥯','🥞','🧇','🧀','🍖','🍗','🥩','🥓','🍔','🍟','🍕','🌭','🥪','🌮','🌯','🥙','🧆','🥚','🍳','🥘','🍲','🥣','🥗','🍿','🧈','🧂','🥫'],
                '⚽ Activities': ['🏆','🥇','🥈','🥉','🏅','🎖️','🏵️','🎗️','🎫','🎟️','🎪','🤹','🎭','🎨','🎬','🎤','🎧','🎼','🎹','🥁','🎷','🎺','🎸','🪕','🎻','🎲','🧩','♟️','🎯','🎳','🎮','🎰','🛷','🎿','⛷️','🏂','⛸️','🏒','🏑','🏏','🏓','🏸','🥅','⛳','🏌️','🏐','🏀','🏈','⚾','🥎','🎾'],
                '🚗 Travel': ['🌋','🏔️','🗻','🏠','🏡','🏢','🏣','🏤','🏥','🏦','🏨','🏩','🏪','🏫','🏬','🏭','🏰','🏯','💒','🗼','🗽','⛪','🕌','🕍','⛩️','⛲','⛺','🌁','🌃','🏙️','🌄','🌅','🌆','🌇','🌉','🎠','🎡','🎢','🚂','🚃','🚄','🚅','🚆','🚇','🚈','🚉','🚊','🚝','🚞','🚋','🚌','🚍','🚎','🚐','🚑','🚒','🚓','🚔','🚕','🚖','🚗','🚘','🚙','🛻','🚚','🚛','🚜','🏎️','🏍️','🛵','🚲','🛩️','✈️','🛫','🛬','🛰️','🚀','🛸','🚁','🛶','⛵','🛥️','🚤','🛳️','⛴️','🚢','⚓','🚧','⛽','🚏','🗺️','🏁','🚩'],
                '💡 Objects': ['⌚','📱','📲','💻','⌨️','🖥️','🖨️','🖱️','🖲️','🕹️','🗜️','💽','💾','💿','📀','📼','📷','📸','📹','🎥','📽️','🎞️','📞','☎️','📟','📠','📺','📻','🎙️','🎚️','🎛️','🧭','⏱️','⏲️','⏰','🕰️','⌛','⏳','📡','🔋','🔌','💡','🔦','🕯️','🪔','🧯','🧺','🧻','🧼','🧽','🧴','🚿','🛀','🛀','🛁','🧼','🪒','🦷','🧷','🧹','🧺','🚽','🪠','🚪','🪟','🛏️','🛋️','🪑','🛀','🕯️','💡','🔦','🧱','⛓️','🪝','🔨','⚒️','⛏️','🛠️','⛏️','⚒️','🛠️','🗡️','⚔️','🔫','🏹','🛡️','🔧','🔩','⚙️','🗜️','⚖️','🦯','🔗','⛓️','⛓️','🧰','🧲','🪜'],
                '🔣 Symbols': ['❤️','🧡','💛','💚','💙','💜','🖤','🤍','🤎','💔','❣️','💕','💞','💓','💗','💖','💘','💝','💟','☮️','✝️','☪️','🕉️','☸️','✡️','🔯','🕎','☯️','☦️','🛐','⛎','♈','♉','♊','♋','♌',' Virgo','♎','♏','♐','♑','♒','♓','🆔','⚛️','🈳','🈹','☢️','☣️','📴','📳','🈶','🈚','🈸','🈺','🈷️','✴️','🈺','🉐','㊙️','㊗️','㊙️','㊗️','㊗️']
            },

            init() {
                if (this.selectedGif) {
                    const hiddenInput = document.getElementById(hiddenInputId);
                    if (hiddenInput) hiddenInput.value = this.selectedGif;
                }
            },

            togglePanel(panel) {
                if (this.activePanel === panel) {
                    this.activePanel = null;
                } else {
                    this.activePanel = panel;
                    this.searchQuery = '';
                    this.results = [];
                    if (['gifs', 'stickers', 'emojis'].includes(panel)) {
                        this.fetchTrending();
                    }
                }
            },

            async fetchTrending() {
                this.loading = true;
                let endpoint = this.activePanel;
                if (endpoint === 'emojis') endpoint = 'emoji';
               
                try {
                    const response = await fetch(`https://api.giphy.com/v1/${endpoint}/trending?api_key=${this.apiKey}&limit=30&rating=g`);
                    const data = await response.json();
                    this.results = data.data || [];
                } catch (e) { console.error(e); }
                this.loading = false;
            },

            async search() {
                if (!this.searchQuery.trim()) return this.fetchTrending();
                this.loading = true;
                let endpoint = this.activePanel;
                if (endpoint === 'emojis') endpoint = 'gifs';
               
                try {
                    const response = await fetch(`https://api.giphy.com/v1/${endpoint}/search?api_key=${this.apiKey}&q=${encodeURIComponent(this.searchQuery)}&limit=30&rating=g&lang=fr`);
                    const data = await response.json();
                    this.results = data.data || [];
                } catch (e) { console.error(e); }
                this.loading = false;
            },

            selectGif(item) {
                const url = item.images.fixed_height.url;
                this.selectedGif = url;
                const hiddenInput = document.getElementById(hiddenInputId);
                if (hiddenInput) hiddenInput.value = url;
                this.activePanel = null;
            },

            clearGif() {
                this.selectedGif = null;
                const hiddenInput = document.getElementById(hiddenInputId);
                if (hiddenInput) hiddenInput.value = '';
            },

            insertEmoji(emoji) {
                const textarea = document.getElementById(textareaId);
                if (textarea) {
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    textarea.value = textarea.value.substring(0, start) + emoji + textarea.value.substring(end);
                    textarea.selectionStart = textarea.selectionEnd = start + emoji.length;
                    textarea.focus();
                }
                this.activePanel = null;
            }
        }));
    });
}
</script>

<style>
.no-scrollbar::-webkit-scrollbar {
    display: none;
}
.no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
}
</style>