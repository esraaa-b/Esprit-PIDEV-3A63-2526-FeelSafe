{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Banner -->
        <div x-data="{ show: true }" x-show="show" class="bg-yellow-50 border border-yellow-100 p-6 rounded-xl relative shadow-sm">
            <button @click="show = false" class="absolute top-4 right-4 text-yellow-600 hover:text-yellow-800 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>
            <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
                <div class="p-3 bg-yellow-100 rounded-lg text-yellow-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-yellow-900">Échangez avec des personnes qui vous comprennent !</h3>
                    <p class="text-yellow-700 mt-1">
                        Nous sommes une communauté bienveillante et sécurisée, toujours là pour soutenir votre santé mentale 24h/24 et 7j/7.
                    </p>
                </div>
            </div>
        </div>

        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Communauté</h1>
                <p class="text-muted-foreground mt-1">
                    Échangez avec une communauté bienveillante et soutenante
                </p>
            </div>
            <a href="{{ path('app_front_publication_new') }}"
               class="inline-flex items-center justify-center px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nouveau sujet
            </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">{{ publications|length }}</p>
                        <p class="text-xs text-muted-foreground">Publications</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-2/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <div>
                        {% set totalReactions = 0 %}
                        {% for pub in publications %}
                            {% set totalReactions = totalReactions + pub.pubCom|length + pub.likesCount|default(0) + pub.dislikesCount|default(0) %}
                        {% endfor %}
                        <p class="text-2xl font-bold text-foreground">{{ totalReactions }}</p>
                        <p class="text-xs text-muted-foreground">Réactions</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-4/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">Active</p>
                        <p class="text-xs text-muted-foreground">Communauté</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-1/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">
                            {% set recentCount = 0 %}
                            {% for pub in publications %}
                                {% if pub.datePublication and date(pub.datePublication) > date('-7 days') %}
                                    {% set recentCount = recentCount + 1 %}
                                {% endif %}
                            {% endfor %}
                            {{ recentCount }}
                        </p>
                        <p class="text-xs text-muted-foreground">Cette semaine</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search -->
        <div class="flex flex-col md:flex-row gap-4">
            <form method="GET" action="{{ path('app_front_publication') }}" class="relative flex-1">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" 
                       name="q"
                       value="{{ search }}"
                       placeholder="Rechercher un sujet..." 
                       class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
            </form>
        </div>

        <!-- Filters -->
        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('app_front_publication') }}" 
               class="px-4 py-2 rounded-full text-sm font-medium transition-colors {{ app.request.query.get('tag') is empty and app.request.query.get('q') is empty ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80' }}">
               Tous
            </a>
            
            {% for tag in ['Anxiété', 'Dépression', 'Stress', 'Angoisse', 'Addiction', 'Solitude'] %}
                <a href="{{ path('app_front_publication', {'tag': tag}) }}"
                   class="px-4 py-2 rounded-full text-sm font-medium transition-colors {{ app.request.query.get('tag') == tag ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80' }}">
                   {{ tag }}
                </a>
            {% endfor %}

            {% if app.request.query.get('q') or app.request.query.get('tag') %}
                <a href="{{ path('app_front_publication') }}" 
                   class="ml-auto flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Réinitialiser
                </a>
            {% endif %}
        </div>

        <!-- Topics List -->
        <div class="space-y-4">
            {% if publications is empty %}
                <div class="bg-card rounded-lg border border-border p-12 text-center">
                    <svg class="w-16 h-16 mx-auto text-muted-foreground mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <h3 class="text-lg font-semibold text-foreground mb-2">Aucune publication</h3>
                    <p class="text-muted-foreground mb-4">Soyez le premier à partager quelque chose !</p>
                    <a href="{{ path('app_front_publication_new') }}" class="inline-flex items-center justify-center px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                        Créer une publication
                    </a>
                </div>
            {% else %}
                {% for publication in publications %}
                    <div class="bg-card rounded-lg border border-border p-6 hover:shadow-lg transition-shadow">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-medium shrink-0">
                                {{ publication.user ? publication.user.nom|first|upper : 'U' }}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1">
                                        <a href="{{ path('app_front_publication_show', {'id': publication.id}) }}" class="hover:text-primary">
                                            <h3 class="font-semibold text-foreground text-lg flex items-center gap-2">
                                                {% if publication.pinnedAt %}
                                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-yellow-100 text-yellow-700 text-sm border border-yellow-200 shadow-sm" title="Épinglé en haut de la liste">
                                                        📌
                                                    </span>
                                                {% endif %}
                                                {{ publication.titre }}
                                            </h3>
                                        </a>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-sm text-muted-foreground">
                                                {{ publication.user ? publication.user.nom : 'Utilisateur' }}
                                            </span>
                                            <span class="text-muted-foreground">•</span>
                                            <span class="text-sm text-muted-foreground">
                                                {{ publication.datePublication ? publication.datePublication|date('d/m/Y à H:i') : '' }}
                                            </span>
                                            <span class="text-muted-foreground">•</span>
                                            
                                        </div>
                                    </div>
                                    {% if publication.image %}
                                        <img src="{{ asset('uploads/' ~ publication.image) }}" 
                                             alt="{{ publication.titre }}"
                                             class="w-16 h-16 object-cover rounded-lg">
                                    {% endif %}
                                </div>
                                <p class="text-muted-foreground text-sm mt-2 line-clamp-2">
                                    {{ publication.contenu|length > 150 ? publication.contenu|slice(0, 150) ~ '...' : publication.contenu }}
                                </p>
                                <div class="flex items-center gap-4 mt-4 text-sm text-muted-foreground">
                                    <!-- Commentaires -->
                                    <span class="flex items-center gap-1">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                        {{ publication.pubCom|length }} commentaire{{ publication.pubCom|length > 1 ? 's' : '' }}
                                    </span>

                                    <!-- Likes -->
                                    <span class="flex items-center gap-1">
                                        <form method="POST" action="{{ path('app_front_publication_like', {'id': publication.id}) }}" class="inline">
                                            <button type="submit" class="hover:text-green-600 transition">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                                                </svg>
                                            </button>
                                        </form>
                                        <span>{{ publication.likesCount|default(0) }}</span>
                                    </span>

                                    <!-- Dislikes -->
                                    <span class="flex items-center gap-1">
                                        <form method="POST" action="{{ path('app_front_publication_dislike', {'id': publication.id}) }}" class="inline">
                                            <button type="submit" class="hover:text-red-600 transition">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path>
                                                </svg>
                                            </button>
                                        </form>
                                        <span>{{ publication.dislikesCount|default(0) }}</span>
                                    </span>

                                    {% if publication.image %}
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                <polyline points="21 15 16 10 5 21"></polyline>
                                            </svg>
                                            Image
                                        </span>
                                    {% endif %}

                                    {# Boutons d'action : modification et suppression (si propriétaire) #}
                                    {% if publication.user and publication.user.id == 1 %}
                                        <div class="flex items-center gap-2 ml-auto">
                                            {# Pin/Unpin Button #}
                                            <form method="post" action="{{ publication.pinnedAt ? path('app_front_publication_unpin', {id: publication.id}) : path('app_front_publication_pin', {id: publication.id}) }}" class="inline">
                                                <button type="submit" 
                                                        class="inline-flex items-center justify-center w-10 h-10 rounded-lg transition-colors font-medium text-lg border {{ publication.pinnedAt ? 'bg-yellow-50 text-yellow-700 border-yellow-100 hover:bg-yellow-100' : 'bg-gray-50 text-gray-700 border-gray-100 hover:bg-gray-100' }}"
                                                        title="{{ publication.pinnedAt ? 'Désépingler cette publication' : 'Épingler cette publication en haut de la liste' }}">
                                                    {{ publication.pinnedAt ? '📌' : '📍' }}
                                                </button>
                                            </form>

                                            <a href="{{ path('app_front_publication_edit', {'id': publication.id}) }}" 
                                               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors font-medium text-sm border border-blue-100">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                                </svg>
                                                <span>Modifier</span>
                                            </a>
                                            <form method="post" 
                                                  action="{{ path('app_front_publication_delete', {'id': publication.id}) }}" 
                                                  onsubmit="return confirm('Supprimer cette publication ?');" 
                                                  style="display:inline;">
                                                <button type="submit" 
                                                        class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-colors font-medium text-sm border border-red-100">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    <span>Supprimer</span>
                                                </button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <!-- Community Guidelines -->
        <div class="bg-secondary/50 rounded-lg border border-border p-6">
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="font-semibold text-foreground">Règles de la communauté</h3>
                    <p class="text-sm text-muted-foreground mt-1">
                        Notre communauté est un espace bienveillant. Soyez respectueux, soutenants et n'hésitez pas à signaler tout contenu inapproprié. Ensemble, nous créons un environnement sécurisant pour tous.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
