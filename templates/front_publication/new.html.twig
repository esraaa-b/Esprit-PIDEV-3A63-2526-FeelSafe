{% extends "dashboard/base.html.twig" %}
{% block dashboard_navbar %}{% endblock %}
{% block body_padding %}{% endblock %}

{% block title %}Nouvelle publication{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto mt-10 px-4">
    <div class="bg-card rounded-2xl shadow-lg border border-border p-8 space-y-8">
        <div class="flex items-center gap-4">
            <a href="{{ path('app_front_publication') }}" 
               class="inline-flex items-center gap-2 px-3 py-1.5 bg-secondary text-secondary-foreground font-medium rounded-lg hover:bg-secondary/80 transition-colors border border-border text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Retour</span>
            </a>
        </div>

        <div class="flex items-center gap-4 mb-6">
            <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-foreground">Nouvelle publication</h1>
                <p class="text-muted-foreground text-sm mt-1">Partagez vos pensées avec la communauté</p>
            </div>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}

            {# TITRE #}
            <div class="space-y-2">
                {{ form_widget(form.titre, {
                    'id': 'publication-titre',
                    'attr': {
                        'class': 'w-full bg-background border border-border rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:outline-none',
                        'placeholder': 'Titre de votre publication...'
                    }
                }) }}
                
                {# Emoji Picker for Title #}
                <div class="flex justify-end pr-2">
                    {% include 'front_publication/_giphy_picker.html.twig' with {
                        textareaId: 'publication-titre',
                        showMedia: false
                    } only %}
                </div>

                <div class="text-red-500 text-sm mt-1">
                    {{ form_errors(form.titre) }}
                </div>
            </div>

            {# CONTENU #}
            <div x-data="{ 
                loading: null, 
                error: null,
                async applyAI(action) {
                    const textarea = document.getElementById('publication-contenu');
                    const text = textarea.value;
                    if (!text) {
                        this.error = 'Veuillez d\'abord écrire un message.';
                        setTimeout(() => this.error = null, 3000);
                        return;
                    }
                    
                    this.loading = action;
                    this.error = null;
                    
                    try {
                        const response = await fetch('{{ path('app_front_publication_ai') }}', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action, text })
                        });
                        
                        const data = await response.json();
                        if (data.error) throw new Error(data.error);
                        
                        textarea.value = data.text;
                    } catch (e) {
                        this.error = 'Erreur: ' + e.message;
                    } finally {
                        this.loading = null;
                    }
                }
            }" class="space-y-2">
                <div class="flex items-center justify-between">
                    <label class="block text-sm font-semibold text-foreground uppercase tracking-wider">Contenu</label>
                    <div class="flex gap-2">
                        <button type="button" 
                                @click="applyAI('reformulate')"
                                :disabled="loading"
                                class="inline-flex items-center gap-1 px-2 py-1 text-xs font-bold rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors border border-blue-100 disabled:opacity-50">
                            <template x-if="loading === 'reformulate'">
                                <svg class="animate-spin h-3 w-3" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            </template>
                            <template x-if="loading !== 'reformulate'">
                                <span>🪄</span>
                            </template>
                            Reformuler
                        </button>
                        <button type="button" 
                                @click="applyAI('correct')"
                                :disabled="loading"
                                class="inline-flex items-center gap-1 px-2 py-1 text-xs font-bold rounded-lg bg-green-50 text-green-700 hover:bg-green-100 transition-colors border border-green-100 disabled:opacity-50">
                            <template x-if="loading === 'correct'">
                                <svg class="animate-spin h-3 w-3" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            </template>
                            <template x-if="loading !== 'correct'">
                                <span>✨</span>
                            </template>
                            Corriger
                        </button>
                    </div>
                </div>

                {{ form_widget(form.contenu, {
                    'id': 'publication-contenu',
                    'attr': {
                        'class': 'w-full resize-none bg-background border border-border rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:outline-none',
                        'placeholder': 'Exprimez-vous...',
                        'rows': 4
                    }
                }) }}

                <div x-show="error" x-text="error" class="text-xs text-red-500 font-medium"></div>
            </div>

            {# Emoji Picker for Content #}
            <div class="flex justify-end pr-2">
                {% include 'front_publication/_giphy_picker.html.twig' with {
                    textareaId: 'publication-contenu',
                    showMedia: false
                } only %}
            </div>

            <div class="text-red-500 text-sm mt-1">
                {{ form_errors(form.contenu) }}
            </div>

            

            {# IMAGE UPLOAD AVEC APERÇU (comme dans edit) #}
            <div class="space-y-2" x-data="{ 
                fileName: 'Aucun fichier choisi',
                previewUrl: '',
                updatePreview(event) {
                    const file = event.target.files[0];
                    if (file) {
                        this.fileName = file.name;
                        const reader = new FileReader();
                        reader.onload = (e) => this.previewUrl = e.target.result;
                        reader.readAsDataURL(file);
                    } else {
                        this.fileName = 'Aucun fichier choisi';
                        this.previewUrl = '';
                    }
                }
            }">
                <label class="block text-sm font-semibold text-foreground uppercase tracking-wider mb-2">Image</label>
                
                <div class="border border-dashed border-border rounded-xl p-4 hover:bg-secondary transition">
                    <div class="flex items-center gap-4">
                        {# Miniature #}
                        <template x-if="previewUrl">
                            <img :src="previewUrl" class="w-16 h-16 object-cover rounded-lg border border-border" alt="Aperçu">
                        </template>
                        <template x-if="!previewUrl">
                            <div class="w-16 h-16 bg-secondary rounded-lg border border-dashed border-border flex items-center justify-center text-muted-foreground">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        </template>

                        {# Upload controls #}
                        <div class="flex-1">
                            <label class="cursor-pointer flex flex-col items-center gap-2 text-muted-foreground">
                                <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <path d="M21 15l-5-5L5 21"/>
                                </svg>
                                <span x-text="previewUrl ? 'Changer l\'image' : 'Ajouter une image'"></span>
                                {{ form_widget(form.image, {
                                    'attr': {
                                        'class': 'hidden',
                                        '@change': 'updatePreview($event)',
                                        'accept': 'image/jpeg,image/png,image/webp'
                                    }
                                }) }}
                            </label>
                            <p class="text-xs text-muted-foreground text-center mt-1" x-text="fileName"></p>
                        </div>
                    </div>
                </div>

                <div class="text-red-500 text-sm mt-1">
                    {{ form_errors(form.image) }}
                </div>
            </div>

            {# CATEGORIE #}
            <div class="space-y-2">
                {{ form_widget(form.categorie, {
                    'attr': {
                        'class': 'w-full bg-background border border-border rounded-xl px-4 py-3 focus:ring-2 focus:ring-primary focus:outline-none transition-all'
                    }
                }) }}
                <div class="text-red-500 text-sm mt-1">
                    {{ form_errors(form.categorie) }}
                </div>
            </div>

            {# Pinned Status #}
            <div class="flex items-center gap-3 p-2">
                <div class="flex items-center h-5">
                    {{ form_widget(form.isPinned, {
                        'attr': {'class': 'w-5 h-5 text-yellow-600 border-border rounded focus:ring-yellow-500 cursor-pointer'}
                    }) }}
                </div>
                <div class="ml-3 text-sm text-left">
                    {{ form_label(form.isPinned, 'Épingler ma publication', {'label_attr': {'class': 'font-bold text-yellow-900 cursor-pointer'}}) }}
                    <p class="text-yellow-700 text-[10px] leading-tight">Mettez votre sujet en avant en haut de la liste.</p>
                </div>
            </div>

            {# BOUTONS D'ACTION (Annuler + Publier) #}
            <div class="flex items-center gap-3 pt-4">
                <a href="{{ path('app_front_publication') }}"
                   class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 bg-secondary text-secondary-foreground font-medium rounded-xl hover:bg-secondary/80 transition-colors border border-border text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span>Annuler</span>
                </a>

                <button type="submit"
                        class="flex-1 bg-primary text-primary-foreground py-3 rounded-xl font-semibold hover:bg-primary/90 transition text-base flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span>Publier</span>
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
