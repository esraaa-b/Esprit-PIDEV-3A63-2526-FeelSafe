{% extends 'auth/auth_base.html.twig' %}

{% block body %}
<div class="min-h-screen flex">
    <!-- Left Panel - Branding -->
    <div class="hidden lg:flex lg:w-1/2 bg-primary relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/images/hero-wellness.jpg')] bg-cover bg-center opacity-20"></div>
        <div class="relative z-10 flex flex-col justify-center px-12 text-primary-foreground">
            <div class="flex items-center gap-3 mb-8">
                <div class="w-12 h-12 rounded-xl bg-primary-foreground/20 flex items-center justify-center">
                    <i data-feather="heart" class="w-7 h-7"></i>
                </div>
                <span class="text-3xl font-serif font-bold">FeelSafe</span>
            </div>
            <h1 class="text-4xl font-serif font-bold mb-6 leading-tight text-balance">
                Votre espace de bien-être mental en toute sécurité
            </h1>
            <p class="text-lg opacity-90 mb-8 leading-relaxed">
                Rejoignez une communauté bienveillante et prenez soin de votre santé mentale avec des outils adaptés à vos besoins.
            </p>
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <i data-feather="shield" class="w-5 h-5"></i>
                    <span>Confidentialité garantie</span>
                </div>
                <div class="flex items-center gap-3">
                    <i data-feather="star" class="w-5 h-5"></i>
                    <span>Accompagnement personnalisé</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Panel - Login Form -->
    <div class="flex-1 flex items-center justify-center p-8 bg-background">
        <div class="w-full max-w-md">
            <!-- Mobile Logo -->
            <div class="lg:hidden flex items-center gap-2 mb-8 justify-center">
                <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                    <i data-feather="heart" class="w-6 h-6 text-primary-foreground"></i>
                </div>
                <span class="text-2xl font-serif font-bold text-foreground">FeelSafe</span>
            </div>

            <div class="border-0 shadow-lg rounded-lg bg-card p-6">
                <div class="space-y-1 pb-6">
                    <h2 class="text-2xl font-serif font-bold">Connexion</h2>
                    <p class="text-muted-foreground text-sm">
                        Entrez vos identifiants pour accéder à votre espace
                    </p>
                </div>

                {% if error %}
                    <div class="mb-4 p-3 rounded-lg bg-red-100 text-red-700 text-sm">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <!-- BOUTONS OAUTH (Google + GitHub) -->
                <div class="space-y-3 mb-4">
                    <!-- Bouton Google -->
                    <a href="{{ path('connect_google_start') }}" 
                       class="flex items-center justify-center gap-3 w-full h-12 px-4 border-2 border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all duration-200 group">
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        <span class="text-sm font-semibold text-gray-700 group-hover:text-gray-900">
                            Continuer avec Google
                        </span>
                    </a>

                    <!-- Bouton GitHub -->
                    <a href="{{ path('connect_github_start') }}" 
                       class="flex items-center justify-center gap-3 w-full h-12 px-4 border-2 border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 transition-all duration-200 group">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        <span class="text-sm font-semibold text-gray-700 group-hover:text-gray-900">
                            Continuer avec GitHub
                        </span>
                    </a>
                </div>

                <!-- Séparateur "ou avec email" -->
                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <span class="w-full border-t"></span>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase">
                        <span class="bg-card px-2 text-muted-foreground">ou avec email</span>
                    </div>
                </div>

                <!-- Formulaire classique -->
                <div class="mb-6">
                    <form method="post" action="{{ path('app_login') }}" class="space-y-4" novalidate>
                        <div class="space-y-2">
                            <label for="_username" class="block text-sm font-medium text-foreground">
                                Email
                            </label>
                            <input
                                type="email"
                                value="{{ last_username }}"
                                name="_username"
                                id="_username"
                                class="w-full h-11 px-3 py-2 border rounded-md"
                                placeholder="votre@email.com"
                                autofocus
                            >
                        </div>

                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <label for="_password" class="block text-sm font-medium text-foreground">
                                    Mot de passe
                                </label>
                                <a href="{{ path('app_forgot_password') }}" class="text-sm text-primary hover:underline">
                                    Mot de passe oublié?
                                </a>
                            </div>
                            <div class="relative">
                                <input
                                    type="password"
                                    name="_password"
                                    id="_password"
                                    class="w-full h-11 px-3 py-2 border rounded-md pr-10"
                                    placeholder="••••••••"
                                >
                                <button
                                    type="button"
                                    onclick="togglePassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                    tabindex="-1"
                                >
                                    <i id="password-toggle-icon" data-feather="eye" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button
                            type="submit"
                            class="w-full h-11 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors"
                        >
                            Se connecter
                        </button>
                    </form>
                </div>

                <!-- Lien vers inscription -->
                <div class="pt-0">
                    <p class="text-center text-sm text-muted-foreground">
                        Pas encore de compte? 
                        <a href="{{ path('app_register') }}" class="text-primary font-medium hover:underline">
                            Créer un compte
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/feather-icons"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
});

function togglePassword() {
    const passwordInput = document.getElementById('_password');
    const icon = document.getElementById('password-toggle-icon');

    if (passwordInput && icon) {
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            icon.setAttribute('data-feather', 'eye-off');
        } else {
            passwordInput.type = 'password';
            icon.setAttribute('data-feather', 'eye');
        }

        if (typeof feather !== 'undefined') {
            feather.replace();
        }
    }
}
</script>

{% endblock %}
