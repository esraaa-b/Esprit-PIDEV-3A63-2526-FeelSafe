{% extends 'auth/auth_base.html.twig' %}
{% block title %}{{ 'reset.title'|trans }} - FeelSafe{% endblock %}
{% block body %}
<div class="min-h-screen flex items-center justify-center p-8 bg-background">
    <div class="w-full max-w-md">
        <div class="flex items-center gap-2 mb-8 justify-center">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                <i data-feather="heart" class="w-6 h-6 text-primary-foreground"></i>
            </div>
            <span class="text-2xl font-serif font-bold text-foreground">{{ 'app.name'|trans }}</span>
        </div>
        <div class="border-0 shadow-lg rounded-lg bg-card p-6">
            <div class="space-y-1 pb-6">
                <h2 class="text-2xl font-serif font-bold">{{ 'reset.title'|trans }}</h2>
                <p class="text-muted-foreground text-sm">{{ 'reset.subtitle'|trans }}</p>
            </div>
            {% for message in app.flashes('error') %}
                <div class="mb-4 p-3 rounded-lg bg-red-100 border border-red-200 text-red-700 text-sm">
                    <i data-feather="alert-circle" class="w-4 h-4 inline mr-2"></i>{{ message }}
                </div>
            {% endfor %}
            <form method="post" class="space-y-4">
                <div class="space-y-2">
                    <label for="password" class="block text-sm font-medium text-foreground">{{ 'reset.new_password'|trans }}</label>
                    <div class="relative">
                        <i data-feather="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground"></i>
                        <input type="password" name="password" id="password"
                               class="w-full h-11 px-3 py-2 pl-10 pr-10 border border-gray-300 rounded-md"
                               placeholder="••••••••">
                        <button type="button" onclick="togglePassword('password')"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                            <i data-feather="eye" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
                <div class="space-y-2">
                    <label for="confirm_password" class="block text-sm font-medium text-foreground">{{ 'reset.confirm_password'|trans }}</label>
                    <div class="relative">
                        <i data-feather="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground"></i>
                        <input type="password" name="confirm_password" id="confirm_password"
                               class="w-full h-11 px-3 py-2 pl-10 pr-10 border border-gray-300 rounded-md"
                               placeholder="••••••••">
                        <button type="button" onclick="togglePassword('confirm_password')"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                            <i data-feather="eye" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
                    <p class="text-xs font-medium text-blue-900 mb-2">
                        <i data-feather="info" class="w-3 h-3 inline mr-1"></i>
                        {{ 'reset.password_hint'|trans }}
                    </p>
                </div>
                <button type="submit" class="w-full h-11 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors">
                    {{ 'reset.submit'|trans }}
                </button>
            </form>
            <div class="pt-4 text-center">
                <a href="{{ path('app_login') }}" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary">
                    <i data-feather="arrow-left" class="w-4 h-4"></i>
                    {{ 'forgot.back_login'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>
<script>
function togglePassword(id) {
    const f = document.getElementById(id);
    const i = f.nextElementSibling.querySelector('i');
    f.type = f.type === 'password' ? 'text' : 'password';
    i.setAttribute('data-feather', f.type === 'password' ? 'eye' : 'eye-off');
    feather.replace();
}
feather.replace();
</script>
{% endblock %}
