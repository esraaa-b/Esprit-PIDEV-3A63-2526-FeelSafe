<!DOCTYPE html>
{# ✅ lang + dir dynamiques selon la locale #}
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}FeelSafe - Authentification{% endblock %}</title>
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('build/app.css') }}">
        <style>
            .form-error {
                color: #dc2626;
                font-size: 0.875rem;
                margin-top: 0.25rem;
            }
            input[type="checkbox"]:checked {
                background-color: var(--primary, #6366f1);
                border-color: var(--primary, #6366f1);
            }
            .overflow-y-auto {
                scrollbar-width: thin;
                scrollbar-color: rgba(156, 163, 175, 0.5) transparent;
            }
            .overflow-y-auto::-webkit-scrollbar { width: 6px; }
            .overflow-y-auto::-webkit-scrollbar-track { background: transparent; }
            .overflow-y-auto::-webkit-scrollbar-thumb {
                background-color: rgba(156, 163, 175, 0.5);
                border-radius: 3px;
            }

            {# ✅ RTL : inverser les marges/paddings si arabe #}
            {% if app.request.locale == 'ar' %}
            body { font-family: 'Segoe UI', Tahoma, 'Arial Unicode MS', sans-serif; }
            .space-y-4 > * + * { margin-top: 1rem; }
            .text-balance { text-align: right; }
            {% endif %}
        </style>
    {% endblock %}
</head>
<body class="bg-gray-50">

    {# ✅ BOUTON LANGUE — fixé en haut à droite (ou gauche en RTL) #}
    <div class="{{ app.request.locale == 'ar' ? 'fixed top-4 left-4' : 'fixed top-4 right-4' }} z-50">
        <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
           class="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-full shadow-sm hover:shadow-md transition-all text-sm font-semibold text-gray-700 hover:text-primary">
            🌐 {{ 'app.lang_switch'|trans }}
        </a>
    </div>

    {% block body %}{% endblock %}
    
    {% block javascripts %}
        <script src="https://unpkg.com/feather-icons"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                feather.replace();
                setTimeout(function() {
                    const alerts = document.querySelectorAll('.alert-auto-hide');
                    alerts.forEach(function(alert) {
                        alert.style.transition = 'opacity 0.5s';
                        alert.style.opacity = '0';
                        setTimeout(() => alert.remove(), 500);
                    });
                }, 5000);
            });
        </script>
    {% endblock %}
</body>
</html>
