{% extends 'professionnel/base.html.twig' %}

{% block title %}Patients - Journal émotionnel{% endblock %}

{% block page_title %}Journal émotionnel des patients{% endblock %}
{% block page_subtitle %}Suivi et analyse des entrées journalières{% endblock %}

{% block header_actions %}
<div class="flex gap-2">
    <div class="relative">
        <input type="text" 
               id="searchPatient" 
               placeholder="Rechercher un patient..." 
               class="w-64 pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
        <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
    </div>
    <a href="{{ path('app_pro_journal_patients') }}" class="px-4 py-2 border border-[#0f3b3e] text-[#0f3b3e] rounded-lg hover:bg-[#eef8f9] transition-colors inline-flex items-center gap-2">
        <i class="fas fa-sync-alt"></i>
        Actualiser
    </a>
</div>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Statistiques globales -->
    {% set totalPatients = patientsData|length %}
    {% set totalEntries = 0 %}
    {% set totalAlerts = 0 %}
    
    {% for data in patientsData %}
        {% set totalEntries = totalEntries + data.journalCount %}
        {% if data.hasAlert %}
            {% set totalAlerts = totalAlerts + 1 %}
        {% endif %}
    {% endfor %}
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Patients avec journaux</p>
                    <p class="text-3xl font-bold text-gray-900">{{ totalPatients }}</p>
                </div>
                <div class="w-12 h-12 bg-[#eef8f9] rounded-lg flex items-center justify-center">
                    <i class="fas fa-users text-[#0f3b3e] text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Total entrées</p>
                    <p class="text-3xl font-bold text-gray-900">{{ totalEntries }}</p>
                </div>
                <div class="w-12 h-12 bg-[#eef8f9] rounded-lg flex items-center justify-center">
                    <i class="fas fa-book-open text-[#0f3b3e] text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Alertes</p>
                    <p class="text-3xl font-bold {% if totalAlerts > 0 %}text-red-600{% else %}text-gray-900{% endif %}">{{ totalAlerts }}</p>
                </div>
                <div class="w-12 h-12 bg-red-50 rounded-lg flex items-center justify-center">
                    <i class="fas fa-exclamation-triangle text-red-500 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Moyenne / patient</p>
                    <p class="text-3xl font-bold text-gray-900">
                        {% if totalPatients > 0 %}
                            {{ (totalEntries / totalPatients)|round(1) }}
                        {% else %}
                            0
                        {% endif %}
                    </p>
                </div>
                <div class="w-12 h-12 bg-[#eef8f9] rounded-lg flex items-center justify-center">
                    <i class="fas fa-chart-line text-[#0f3b3e] text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des patients -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-800">Liste des patients</h3>
        </div>
        
        {% if patientsData is empty %}
        <div class="p-12 text-center">
            <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-users text-gray-400 text-3xl"></i>
            </div>
            <h4 class="text-lg font-medium text-gray-700 mb-2">Aucun patient</h4>
            <p class="text-gray-500">Aucun patient n'a encore de journal émotionnel.</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Journaux</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Émotion dominante</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dernière entrée</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for data in patientsData %}
                    <tr class="hover:bg-gray-50 transition-colors patient-row">
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                                    {{ data.patient.prenom|slice(0,1)|upper }}{{ data.patient.nom|slice(0,1)|upper }}
                                </div>
                                <div class="ml-4">
                                    <div class="text-sm font-medium text-gray-900">
                                        {{ data.patient.prenom }} {{ data.patient.nom }}
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        {{ data.patient.email }}
                                    </div>
                                </div>
                                {% if data.hasAlert %}
                                <span class="ml-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    <i class="fas fa-exclamation-circle mr-1"></i>
                                    Alerte
                                </span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-1.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                {{ data.journalCount }} entrée{% if data.journalCount > 1 %}s{% endif %}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            {% if data.dominantEmotion %}
                                {% set emotion = data.dominantEmotion.emotion %}
                                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium 
                                    {% if emotion.value == 'tres_bien' %}bg-green-100 text-green-800
                                    {% elseif emotion.value == 'bien' %}bg-green-50 text-green-700
                                    {% elseif emotion.value == 'neutre' %}bg-yellow-100 text-yellow-800
                                    {% elseif emotion.value == 'pas_bien' %}bg-orange-100 text-orange-800
                                    {% elseif emotion.value == 'tres_mal' %}bg-red-100 text-red-800
                                    {% endif %}">
                                    {{ emotion.icon() }}
                                    {{ emotion.label() }}
                                    <span class="ml-1 font-bold">({{ data.dominantEmotion.percentage }}%)</span>
                                </span>
                            {% else %}
                                <span class="text-gray-400 text-sm">-</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            {% if data.lastJournal %}
                                <div class="text-sm text-gray-900">
                                    {{ data.lastJournal.dateCreation|date('d/m/Y') }}
                                </div>
                                <div class="text-xs text-gray-500">
                                    {{ data.lastJournal.dateCreation|date('H:i') }}
                                </div>
                            {% else %}
                                <span class="text-gray-400 text-sm">-</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            <a href="{{ path('app_pro_patient_journals', {'id': data.patient.id}) }}" 
                               class="inline-flex items-center px-3 py-2 border border-[#0f3b3e] text-sm leading-4 font-medium rounded-md text-[#0f3b3e] bg-white hover:bg-[#eef8f9] transition-colors">
                                <i class="fas fa-eye mr-2"></i>
                                Voir
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>
</div>

<!-- Modal pour voir le journal -->
<div id="journalModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
            <div id="modalContent" class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="flex justify-center items-center h-32">
                    <i class="fas fa-spinner fa-spin text-[#0f3b3e] text-2xl"></i>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchPatient');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.patient-row');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });
    }
});

function openModal(journalId) {
    const modal = document.getElementById('journalModal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    fetch(`/professionnel/journal/${journalId}/view`)
        .then(response => response.text())
        .then(html => {
            document.getElementById('modalContent').innerHTML = html;
        })
        .catch(error => {
            document.getElementById('modalContent').innerHTML = `
                <div class="text-center py-8">
                    <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-exclamation-circle text-red-500 text-2xl"></i>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">Erreur</h3>
                    <p class="text-gray-500">Impossible de charger le journal</p>
                    <button onclick="closeModal()" class="mt-4 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                        Fermer
                    </button>
                </div>
            `;
        });
}

function closeModal() {
    document.getElementById('journalModal').classList.add('hidden');
    document.body.style.overflow = '';
    document.getElementById('modalContent').innerHTML = `
        <div class="flex justify-center items-center h-32">
            <i class="fas fa-spinner fa-spin text-[#0f3b3e] text-2xl"></i>
        </div>
    `;
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeModal();
    }
});

document.addEventListener('click', function(e) {
    const modal = document.getElementById('journalModal');
    if (e.target === modal || e.target.classList.contains('bg-opacity-75')) {
        closeModal();
    }
});
</script>
{% endblock %}