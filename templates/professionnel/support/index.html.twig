{% extends 'professionnel/base.html.twig' %}

{% block title %}Demandes de RDV{% endblock %}
{% block page_title %}Demandes de rendez-vous{% endblock %}
{% block page_subtitle %}Gérez les demandes de rendez-vous de vos clients{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900"></h1>
        <div class="flex items-center gap-4">
            <div class="relative">
                <button id="notif-btn" class="relative inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-200 hover:bg-gray-50">
                    <svg class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 17h5l-1.405-1.405C18.79 14.79 18 13.42 18 12V8a6 6 0 10-12 0v4c0 1.42-.79 2.79-1.595 3.595L3 17h5" />
                        <path d="M13.73 21a2 2 0 01-3.46 0" />
                    </svg>
                    <span id="notif-badge" class="hidden absolute -top-1 -right-1 px-1.5 py-0.5 text-[10px] rounded-full bg-red-500 text-white">0</span>
                </button>
                <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 bg-white border border-gray-200 rounded-lg shadow-lg">
                    <div class="flex items-center justify-between p-3 border-b border-gray-100">
                        <div class="text-sm font-medium text-gray-700">Notifications</div>
                        <button id="notif-clear" class="text-xs px-2 py-1 rounded border border-gray-300 text-gray-700 hover:bg-gray-50">Tout effacer</button>
                    </div>
                    <div id="notif-list" class="max-h-80 overflow-auto divide-y divide-gray-100"></div>
                </div>
            </div>
            <a href="{{ path('app_support_calendar') }}" class="btn btn-outline">Calendrier</a>
            <a href="{{ path('app_support_accomp') }}" class="btn btn-outline">Accompagnement</a>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="col-span-2 bg-gray-50 rounded-lg border border-gray-200 p-4">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="text-sm text-gray-500">Prévision RDV (14 jours)</div>
                        <div id="forecast-summary" class="mt-1 text-sm text-gray-700"></div>
                    </div>
                    <div class="h-16 w-56">
                        <svg id="forecast-spark" viewBox="0 0 224 64" preserveAspectRatio="none" class="w-full h-full"></svg>
                    </div>
                </div>
            </div>
            <a href="{{ path('app_support_stats') }}" class="flex items-center justify-between bg-white rounded-lg border border-gray-200 p-4 hover:shadow transition-shadow">
                <div>
                    <div class="text-sm text-gray-500">Voir les statistiques</div>
                    <div class="text-sm text-gray-700">Résumé mensuel</div>
                </div>
                <span class="text-gray-400">→</span>
            </a>
        </div>
        {% set clientIds = [] %}
        {% set clientList = [] %}
        {% for r in rdvs %}
            {% if r.utilisateur and r.utilisateur.id not in clientIds %}
                {% set clientIds = clientIds|merge([r.utilisateur.id]) %}
                {% set clientList = clientList|merge([r.utilisateur]) %}
            {% endif %}
        {% endfor %}
        <div class="mb-4 flex flex-wrap items-end gap-3">
            <div>
                <label class="block text-xs text-gray-600 mb-1">Client</label>
                <select id="filter-client" class="border border-gray-300 rounded px-3 py-2 text-sm w-56">
                    <option value="">Tous</option>
                    {% for c in clientList %}
                        <option value="{{ c.id }}">{{ c.getFullName() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="block text-xs text-gray-600 mb-1">Date</label>
                <input type="date" id="filter-date" class="border border-gray-300 rounded px-3 py-2 text-sm w-48">
            </div>
            <button type="button" id="clear-filters" class="btn btn-outline btn-sm">Réinitialiser</button>
        </div>
        <div class="overflow-x-auto">
            <table id="rdv-table" class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Heure</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mode</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                {% for rdv in rdvs %}
                    <tr data-client="{{ rdv.utilisateur ? rdv.utilisateur.id : '' }}" data-date="{{ rdv.dateRdv|date('Y-m-d') }}">
                        <td class="px-6 py-4 text-sm text-gray-900">{{ rdv.utilisateur ? rdv.utilisateur.getFullName() : '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ rdv.dateRdv|date('d/m/Y') }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ rdv.heureRdv|date('H:i') }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ rdv.mode.value == 'en_ligne' ? 'En ligne' : 'Présentiel' }}</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="text-xs px-2 py-1 rounded-full 
                                {% if rdv.statut.value == 'planifie' %}bg-blue-100 text-blue-700{% elseif rdv.statut.value == 'honore' %}bg-green-100 text-green-700{% elseif rdv.statut.value == 'annule' %}bg-red-100 text-red-700{% else %}bg-gray-100 text-gray-700{% endif %}">
                                {{ rdv.statut.value }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <div class="flex items-center gap-2">
                                {% if rdv.mode.value == 'en_ligne' %}
                                <button type="button" class="btn btn-sm btn-primary" onclick="openJitsi('{{ rdv.id }}','{{ app.user.getFullName()|e('js') }}','{{ ('RDV avec ' ~ (rdv.utilisateur ? rdv.utilisateur.getFullName() : 'client') ~ ' — ' ~ rdv.dateRdv|date('d/m/Y') ~ ' ' ~ rdv.heureRdv|date('H:i'))|e('js') }}')">Rejoindre</button>
                                {% endif %}
                                <form action="{{ path('support_rdv_accept', { id: rdv.id }) }}" method="post">
                                    <button type="submit" class="btn btn-sm">Accepter</button>
                                </form>
                                <form action="{{ path('support_rdv_refuse', { id: rdv.id }) }}" method="post" class="flex items-center gap-2">
                                    <input type="text" name="commentaire" placeholder="Motif" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                    <button type="submit" class="btn btn-sm btn-danger">Refuser</button>
                                </form>
                                <form action="{{ path('support_rdv_update', { id: rdv.id }) }}" method="post" class="flex items-center gap-2">
                                    <select name="statut" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                        {% for s in statuts %}
                                            <option value="{{ s.value }}" {{ s.value == rdv.statut.value ? 'selected' : '' }}>
                                                {{ s.name|lower }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <input type="text" name="commentaire" value="{{ rdv.commentaire }}" placeholder="Commentaire" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                    <button type="submit" class="btn btn-sm btn-secondary">Mettre à jour</button>
                                </form>
                                {% if rdv.utilisateur %}
                                <a href="{{ path('app_support_accomp', { client_id: rdv.utilisateur.id }) }}" class="btn btn-sm btn-outline">Accompagnement client</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">Aucune demande</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div id="jitsi-modal" class="fixed inset-0 bg-black bg-opacity-60 hidden z-50">
        <div class="absolute top-4 right-4">
            <button id="jitsi-close" class="px-3 py-1 rounded bg-white text-gray-800 border">Fermer</button>
        </div>
        <div id="jitsi-container" class="w-full h-full"></div>
    </div>
    <script src="https://meet.jit.si/external_api.js"></script>
    <script>
        (function(){
            const btn = document.getElementById('notif-btn');
            const panel = document.getElementById('notif-panel');
            const badge = document.getElementById('notif-badge');
            const list = document.getElementById('notif-list');
            function fmtItem(it){
                const p = it.payload || {};
                if (it.type === 'new_rdv') {
                    return '<div class="p-3 text-sm"><div class="font-medium text-gray-900">Nouveau RDV</div><div class="text-gray-600">Avec '+(p.client||'—')+' le '+(p.date||'—')+' à '+(p.time||'—')+'</div></div>';
                }
                if (it.type === 'rdv_canceled') {
                    return '<div class="p-3 text-sm"><div class="font-medium text-gray-900">RDV annulé</div><div class="text-gray-600">'+(p.client||'—')+' • '+(p.date||'—')+' '+(p.time||'—')+'</div></div>';
                }
                if (it.type === 'rdv_refused') {
                    return '<div class="p-3 text-sm"><div class="font-medium text-gray-900">RDV refusé</div><div class="text-gray-600">'+(p.client||'—')+' • '+(p.date||'—')+' '+(p.time||'—')+'</div></div>';
                }
                return '<div class="p-3 text-sm text-gray-600">Notification</div>';
            }
            function loadNotif(){
                fetch('{{ path('support_notifications') }}', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r=>r.json())
                .then(d=>{
                    if(!d||!d.success){return;}
                    const items=d.notifications||[];
                    if(items.length){ badge.textContent=String(items.length); badge.classList.remove('hidden'); } else { badge.classList.add('hidden'); }
                    list.innerHTML = items.map(fmtItem).join('') || '<div class="p-3 text-sm text-gray-600">Aucune notification</div>';
                })
                .catch(()=>{});
            }
            if (btn) {
                btn.addEventListener('click',()=>{ panel.classList.toggle('hidden'); if(!panel.classList.contains('hidden')) loadNotif(); });
                setInterval(loadNotif, 15000);
                loadNotif();
            }
            const clearBtn = document.getElementById('notif-clear');
            if (clearBtn) {
                clearBtn.addEventListener('click', function(){
                    clearBtn.disabled = true;
                    const oldLabel = clearBtn.textContent;
                    clearBtn.textContent = 'Nettoyage…';
                    fetch('{{ path('support_notifications_clear') }}', { 
                        method:'POST', 
                        headers:{ 
                            'X-Requested-With':'XMLHttpRequest',
                            'Accept':'application/json'
                        },
                        credentials: 'same-origin'
                    })
                    .then(r=> r.ok ? r.json() : Promise.reject(new Error('HTTP '+r.status)))
                    .then(d=>{
                        if(d&&d.success){
                            list.innerHTML = '<div class="p-3 text-sm text-gray-600">Aucune notification</div>';
                            badge.classList.add('hidden');
                            loadNotif();
                        } else {
                            clearBtn.textContent = 'Erreur';
                            setTimeout(()=>{ clearBtn.textContent = oldLabel; clearBtn.disabled=false; }, 1200);
                        }
                    })
                    .catch(()=>{
                        clearBtn.textContent = 'Erreur';
                        setTimeout(()=>{ clearBtn.textContent = oldLabel; clearBtn.disabled=false; }, 1200);
                    })
                    .finally(()=>{ clearBtn.disabled = false; clearBtn.textContent = oldLabel; });
                });
            }
            fetch('{{ path('support_forecast') }}', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
              .then(r => r.json())
              .then(d => {
                if(!d || !d.success) return;
                const series = d.forecast || [];
                const max = Math.max(1, ...series.map(x => x.predicted));
                const W = 224, H = 64, pad = 6;
                const step = (W - 2*pad) / Math.max(1, series.length - 1);
                let p = '';
                series.forEach((v, i) => {
                    const x = pad + i * step;
                    const y = H - pad - (v.predicted / max) * (H - 2*pad);
                    p += (i === 0 ? 'M ' : ' L ') + x.toFixed(1) + ' ' + y.toFixed(1);
                });
                const spark = document.getElementById('forecast-spark');
                if (spark) {
                    spark.innerHTML = '<path d="'+p+'" fill="none" stroke="#2563eb" stroke-width="2"/>' +
                                      '<line x1="'+pad+'" y1="'+(H-pad)+'" x2="'+(W-pad)+'" y2="'+(H-pad)+'" stroke="#e5e7eb" stroke-width="1"/>';
                }
                const total = series.reduce((acc, v) => acc + v.predicted, 0);
                const avg = (total / Math.max(1, series.length)).toFixed(1);
                const first = series[0]?.predicted ?? 0;
                const last = series[series.length-1]?.predicted ?? 0;
                const delta = (last - first).toFixed(1);
                const sumEl = document.getElementById('forecast-summary');
                if (sumEl) {
                    sumEl.textContent = 'Moyenne: ' + avg + ' / jour • Tendance: ' + (delta >= 0 ? '+' : '') + delta;
                }
              })
              .catch(()=>{});
        })();
        let jitsiApi=null;
        function computeRoomAndPass(rdvId){const seed=btoa('feelsafe-v1:'+rdvId).replace(/[^A-Za-z0-9]/g,'');return{room:'feelsafe-'+rdvId+'-'+seed.slice(0,10),pass:seed.slice(-8)};}
        function openJitsi(rdvId,displayName,subject){
            const modal=document.getElementById('jitsi-modal'),container=document.getElementById('jitsi-container'),c=computeRoomAndPass(rdvId);
            if(jitsiApi){try{jitsiApi.dispose();}catch(e){}jitsiApi=null;}
            modal.classList.remove('hidden');
            jitsiApi=new JitsiMeetExternalAPI('meet.jit.si',{roomName:c.room,parentNode:container,width:'100%',height:'100%',interfaceConfigOverwrite:{HIDE_DEEP_LINKING_LOGO:true,TOOLBAR_BUTTONS:['microphone','camera','closedcaptions','desktop','chat','raisehand','tileview','hangup']},configOverwrite:{prejoinPageEnabled:false,startWithAudioMuted:true,startWithVideoMuted:true},userInfo:{displayName:displayName}});
            jitsiApi.addListener('videoConferenceJoined',function(){try{jitsiApi.executeCommand('subject',subject||'Rendez-vous');}catch(e){}try{jitsiApi.executeCommand('password',c.pass);}catch(e){}});
            document.getElementById('jitsi-close').onclick=function(){try{jitsiApi.executeCommand('hangup');}catch(e){}setTimeout(function(){if(jitsiApi){try{jitsiApi.dispose();}catch(e){}jitsiApi=null;}modal.classList.add('hidden');container.innerHTML='';},300);};
        }
    </script>
    <script>
        (function(){
            var fc=document.getElementById('filter-client');
            var fd=document.getElementById('filter-date');
            var cl=document.getElementById('clear-filters');
            function apply(){
                var cid=fc.value||'';
                var date=fd.value||'';
                var rows=document.querySelectorAll('#rdv-table tbody tr');
                rows.forEach(function(tr){
                    var tCid=tr.getAttribute('data-client')||'';
                    var tDate=tr.getAttribute('data-date')||'';
                    var show=true;
                    if(cid && tCid!==cid) show=false;
                    if(date && tDate!==date) show=false;
                    tr.style.display=show?'':'none';
                });
            }
            fc.addEventListener('change',apply);
            fd.addEventListener('change',apply);
            cl.addEventListener('click',function(){fc.value='';fd.value='';apply();});
        })();
    </script>
</div>
{% endblock %}
