{% extends "professionnel/base.html.twig" %}

{% block title %}Accompagnement{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">
            Accompagnement{% if selectedClient %} — {{ selectedClient.getFullName() }}{% endif %}
        </h1>
        <a href="{{ path('app_support') }}" class="btn btn-outline">← Rendez-vous</a>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full table-fixed divide-y divide-gray-200">
                <colgroup>
                    <col style="width: 12rem;">
                    <col style="width: 12rem;">
                    <col style="width: 8rem;">
                    <col style="width: 12rem;">
                    <col style="width: 12rem;">
                    <col style="width: 12rem;">
                    <col style="width: 8rem;">
                    <col style="width: 16rem;">
                </colgroup>
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Prochain RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date prochain RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Objectifs</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Notes de suivi</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Priorité</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                {% for a in accompagnements %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ a.utilisateur ? a.utilisateur.getFullName() : '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.rendezvous.dateRdv|date('d/m/Y') }} {{ a.rendezvous.heureRdv|date('H:i') }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.prochainRdv.value|capitalize }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.dateProchainRdv ? a.dateProchainRdv|date('d/m/Y H:i') : '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.objectifs ?: '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.notesSuivi ?: '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ a.niveauPriorite ?: '—' }}</td>
                        <td class="px-6 py-4">
                            <div class="space-y-2">
                                <form action="{{ path('support_accomp_save') }}" method="post" class="flex flex-wrap items-center gap-2">
                                    <input type="hidden" name="rendezvous_id" value="{{ a.rendezvous.id }}">
                                    <select name="prochain_rdv" class="border border-gray-300 rounded px-2 py-2 text-xs w-24" onchange="const d=this.form.querySelector('[name=date_prochain_rdv]'); if(this.value==='non'){d.value=''; d.setAttribute('disabled','disabled');} else {d.removeAttribute('disabled');}">
                                        {% for opt in prochainRdvOptions %}
                                            <option value="{{ opt.value }}" {{ a.prochainRdv.value == opt.value ? 'selected' : '' }}>
                                                {{ opt.value|capitalize }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <input type="datetime-local" name="date_prochain_rdv" value="{{ a.dateProchainRdv ? a.dateProchainRdv|date('Y-m-d\\TH:i') : '' }}" class="border border-gray-300 rounded px-2 py-2 text-xs w-40" {{ a.prochainRdv.value == 'non' ? 'disabled' : '' }}>
                                    <input type="text" name="objectifs" value="{{ a.objectifs }}" placeholder="Objectifs" class="border border-gray-300 rounded px-2 py-2 text-xs w-40">
                                    <input type="text" name="notes_suivi" value="{{ a.notesSuivi }}" placeholder="Notes de suivi" class="border border-gray-300 rounded px-2 py-2 text-xs w-40">
                                    <select name="niveau_priorite" class="border border-gray-300 rounded px-2 py-2 text-xs w-16">
                                        {% for i in 1..5 %}
                                            <option value="{{ i }}" {{ a.niveauPriorite == i ? 'selected' : '' }}>
                                                {{ i }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-secondary">Enregistrer</button>
                                </form>
                                <form action="{{ path('support_accomp_upload') }}" method="post" enctype="multipart/form-data" class="flex items-center gap-2">
                                    <input type="hidden" name="rendezvous_id" value="{{ a.rendezvous.id }}">
                                    <input type="file" name="piece" class="text-xs w-40">
                                    <button type="submit" class="btn btn-sm btn-outline">Ajouter document</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">Aucune donnée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold mb-4">Créer un accompagnement</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full table-fixed divide-y divide-gray-200">
                <colgroup>
                    <col style="width: 12rem;">
                    <col style="width: 12rem;">
                    <col style="width: 10rem;">
                    <col style="width: 14rem;">
                    <col style="width: 14rem;">
                    <col style="width: 10rem;">
                    <col style="width: 10rem;">
                </colgroup>
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Prochain RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date prochain RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Objectifs</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Notes de suivi</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Priorité</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                {% for r in rdvs %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ r.utilisateur ? r.utilisateur.getFullName() : '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ r.dateRdv|date('d/m/Y') }} {{ r.heureRdv|date('H:i') }}</td>
                        <td colspan="6" class="px-6 py-4">
                            <form action="{{ path('support_accomp_save') }}" method="post" class="flex flex-wrap items-center gap-2">
                                <input type="hidden" name="rendezvous_id" value="{{ r.id }}">
                                <select name="prochain_rdv" class="border border-gray-300 rounded px-2 py-2 text-xs" onchange="const d=this.form.querySelector('[name=date_prochain_rdv]'); if(this.value==='non'){d.value=''; d.setAttribute('disabled','disabled');} else {d.removeAttribute('disabled');}">
                                    {% for opt in prochainRdvOptions %}
                                        <option value="{{ opt.value }}">{{ opt.value|capitalize }}</option>
                                    {% endfor %}
                                </select>
                                <input type="datetime-local" name="date_prochain_rdv" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                <input type="text" name="objectifs" placeholder="Objectifs" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                <input type="text" name="notes_suivi" placeholder="Notes de suivi" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                <select name="niveau_priorite" class="border border-gray-300 rounded px-2 py-2 text-xs">
                                    {% for i in 1..5 %}<option value="{{ i }}">{{ i }}</option>{% endfor %}
                                </select>
                                <button type="submit" class="btn btn-sm">Créer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">Aucun rendez-vous trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold mb-4">Historique</h2>
        <div class="space-y-4">
            {% for a in accompagnements %}
            <div class="relative pl-8">
                <span class="absolute left-0 top-2 w-2 h-2 bg-blue-600 rounded-full"></span>
                <div class="text-sm text-gray-900">{{ a.utilisateur ? a.utilisateur.getFullName() : 'Client' }} • {{ a.rendezvous.dateRdv|date('d/m/Y') }} {{ a.rendezvous.heureRdv|date('H:i') }}</div>
                <div class="text-xs text-gray-600">Prochain: {{ a.prochainRdv.value|capitalize }}{% if a.dateProchainRdv %} • {{ a.dateProchainRdv|date('d/m/Y H:i') }}{% endif %} • Priorité: {{ a.niveauPriorite ?: '—' }}</div>
                {% if a.objectifs %}<div class="text-xs text-gray-700">Objectifs: {{ a.objectifs }}</div>{% endif %}
                {% if a.notesSuivi %}<div class="text-xs text-gray-700">Notes: {{ a.notesSuivi }}</div>{% endif %}
            </div>
            {% else %}
            <div class="text-sm text-gray-500">Aucun historique</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
