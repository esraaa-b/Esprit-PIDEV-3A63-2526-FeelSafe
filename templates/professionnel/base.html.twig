<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}FeelSafe - Espace Professionnel{% endblock %}</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Animation pour le menu déroulant */
        .dropdown-enter {
            opacity: 0;
            transform: translateY(-10px);
        }
        .dropdown-enter-active {
            opacity: 1;
            transform: translateY(0);
            transition: opacity 0.2s, transform 0.2s;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navbar fixe en haut -->
    <nav class="bg-white shadow-md border-b border-gray-200 fixed w-full z-50">
        <div class="px-6 py-3">
            <div class="flex items-center justify-between">
                <!-- Logo et nom -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-[#0f3b3e] rounded-lg flex items-center justify-center">
                        <i class="fas fa-heart text-white text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold text-gray-800">FeelSafe</span>
                        <span class="ml-2 text-xs font-semibold text-[#0f3b3e] bg-[#eef8f9] px-2 py-1 rounded-full">PRO</span>
                    </div>
                </div>

                <!-- Menu de navigation principal (centré) -->
                <div class="hidden md:flex items-center gap-1">
                    <!-- Tableau de bord -->
                    <a href="{{ path('professionnel_dashboard') }}" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors {% if app.request.get('_route') == 'professionnel_dashboard' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600 hover:bg-gray-100{% endif %}">
                        <i class="fas fa-chart-pie mr-2"></i>Tableau de bord
                    </a>
                    
                    <!-- Journaux patients -->
                    <a href="{{ path('app_pro_journal_patients') }}" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors {% if app.request.get('_route') starts with 'app_pro_journal' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600 hover:bg-gray-100{% endif %}">
                        <i class="fas fa-book-open mr-2"></i>Journaux patients
                    </a>
                    
                    <!-- Agenda avec badge -->
                    <a href="{{ path('app_pro_agenda') }}" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-gray-600 hover:bg-gray-100">
                        <i class="fas fa-calendar-check mr-2"></i>Agenda
                        <span class="ml-1 bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full text-xs">8</span>
                    </a>
                    
                    <!-- Messagerie avec badge -->
                    <a href="{{ path('app_pro_messages') }}" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-gray-600 hover:bg-gray-100">
                        <i class="fas fa-comments mr-2"></i>Messages
                        <span class="ml-1 bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-xs">3</span>
                    </a>
                    
                    <!-- Menu Accompagnement avec dropdown -->
                    <div class="relative group">
                        <button class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-gray-600 hover:bg-gray-100 flex items-center gap-1 {% if app.request.get('_route') starts with 'app_support' or app.request.get('_route') == 'app_pro_emergency' %}bg-[#eef8f9] text-[#0f3b3e]{% endif %}">
                            <i class="fas fa-hand-holding-heart mr-2"></i>Accompagnement
                            <i class="fas fa-chevron-down text-xs ml-1"></i>
                        </button>
                        
                        <!-- Dropdown menu -->
                        <div class="absolute left-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                            <a href="{{ path('app_support') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors">
                                <i class="fas fa-heart mr-3 w-5"></i>Accompagnement
                            </a>
                            <a href="{{ path('app_support_stats') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors">
                                <i class="fas fa-chart-line mr-3 w-5"></i>Statistiques
                            </a>
                            <a href="{{ path('app_pro_resources') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors">
                                <i class="fas fa-book-open mr-3 w-5"></i>Ressources
                            </a>
                            <div class="border-t border-gray-200 my-2"></div>
                            <a href="{{ path('app_pro_emergency') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors">
                                <div class="flex items-center justify-between">
                                    <span><i class="fas fa-exclamation-triangle mr-3 w-5 text-red-500"></i>Urgences</span>
                                    <span class="bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-xs">2</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Profil utilisateur et actions -->
                <div class="flex items-center gap-4">
                    <!-- Menu compte avec dropdown (visible sur desktop) -->
                    <div class="relative group hidden lg:block">
                        <button class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-600 hover:text-[#0f3b3e] hover:bg-gray-100 rounded-lg transition-colors">
                            <i class="fas fa-user-circle text-lg"></i>
                            <span>Mon compte</span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        
                        <!-- Dropdown menu compte -->
                        <div class="absolute right-0 mt-2 w-56 bg-white rounded-lg shadow-lg border border-gray-200 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                            <a href="{{ path('app_pro_profile') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors {% if app.request.get('_route') == 'app_pro_profile' %}bg-[#eef8f9] text-[#0f3b3e]{% endif %}">
                                <i class="fas fa-id-card mr-3 w-5"></i>Mon Profil
                            </a>
                            <a href="{{ path('app_pro_security') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e] transition-colors {% if app.request.get('_route') == 'app_pro_security' %}bg-[#eef8f9] text-[#0f3b3e]{% endif %}">
                                <i class="fas fa-shield-alt mr-3 w-5"></i>Sécurité
                            </a>
                            <div class="border-t border-gray-200 my-2"></div>
                            <a href="{{ path('app_logout') }}" class="block px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                <i class="fas fa-sign-out-alt mr-3 w-5"></i>Déconnexion
                            </a>
                        </div>
                    </div>
                    
                    <!-- Avatar et infos (visible sur desktop) -->
                    <div class="hidden lg:flex items-center gap-3">
                        <div class="w-9 h-9 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-700">Dr. {{ app.user.prenom }} {{ app.user.nom }}</div>
                            <div class="text-xs text-gray-500">{{ app.user.email }}</div>
                        </div>
                    </div>
                    
                    <!-- Version mobile simplifiée (avatar seul) -->
                    <div class="lg:hidden flex items-center">
                        <div class="w-9 h-9 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        </div>
                    </div>
                    
                    <!-- Bouton menu mobile -->
                    <button class="lg:hidden text-gray-500 hover:text-gray-700" onclick="toggleMobileMenu()">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menu mobile (caché par défaut) -->
        <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-gray-200 py-2 max-h-[80vh] overflow-y-auto">
            <a href="{{ path('professionnel_dashboard') }}" class="block px-6 py-3 text-sm font-medium {% if app.request.get('_route') == 'professionnel_dashboard' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600{% endif %}">
                <i class="fas fa-chart-pie mr-3 w-5"></i>Tableau de bord
            </a>
            <a href="{{ path('app_pro_journal_patients') }}" class="block px-6 py-3 text-sm font-medium {% if app.request.get('_route') starts with 'app_pro_journal' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600{% endif %}">
                <i class="fas fa-book-open mr-3 w-5"></i>Journaux patients
            </a>
            <a href="{{ path('app_pro_agenda') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                <div class="flex items-center justify-between">
                    <span><i class="fas fa-calendar-check mr-3 w-5"></i>Agenda</span>
                    <span class="bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full text-xs">8</span>
                </div>
            </a>
            <a href="{{ path('app_pro_messages') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                <div class="flex items-center justify-between">
                    <span><i class="fas fa-comments mr-3 w-5"></i>Messages</span>
                    <span class="bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-xs">3</span>
                </div>
            </a>
            
            <!-- Section Accompagnement mobile -->
            <div class="border-t border-gray-200 my-2 pt-2">
                <div class="px-6 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">Accompagnement</div>
                <a href="{{ path('app_support') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <i class="fas fa-heart mr-3 w-5"></i>Accompagnement
                </a>
                <a href="{{ path('app_support_stats') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <i class="fas fa-chart-line mr-3 w-5"></i>Statistiques
                </a>
                <a href="{{ path('app_pro_resources') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <i class="fas fa-book-open mr-3 w-5"></i>Ressources
                </a>
                <a href="{{ path('app_pro_emergency') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <div class="flex items-center justify-between">
                        <span><i class="fas fa-exclamation-triangle mr-3 w-5 text-red-500"></i>Urgences</span>
                        <span class="bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-xs">2</span>
                    </div>
                </a>
            </div>
            
            <!-- Section Mon compte mobile -->
            <div class="border-t border-gray-200 my-2 pt-2">
                <div class="px-6 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">Mon compte</div>
                <a href="{{ path('app_pro_profile') }}" class="block px-6 py-3 text-sm font-medium {% if app.request.get('_route') == 'app_pro_profile' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600{% endif %}">
                    <i class="fas fa-id-card mr-3 w-5"></i>Mon Profil
                </a>
                <a href="{{ path('app_pro_security') }}" class="block px-6 py-3 text-sm font-medium {% if app.request.get('_route') == 'app_pro_security' %}bg-[#eef8f9] text-[#0f3b3e]{% else %}text-gray-600{% endif %}">
                    <i class="fas fa-shield-alt mr-3 w-5"></i>Sécurité
                </a>
                <div class="border-t border-gray-200 my-2"></div>
                <div class="px-6 py-3">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold">
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-700">Dr. {{ app.user.prenom }} {{ app.user.nom }}</div>
                            <div class="text-xs text-gray-500">{{ app.user.email }}</div>
                        </div>
                    </div>
                    <a href="{{ path('app_logout') }}" class="block w-full text-center px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                        <i class="fas fa-sign-out-alt mr-2"></i>Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Espace pour compenser la navbar fixe -->
    <div class="pt-20">
        <!-- Messages flash -->
        <div class="px-6">
            {% for message in app.flashes('success') %}
                <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 flex items-center gap-3">
                    <i class="fas fa-check-circle text-green-500"></i>
                    {{ message }}
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 flex items-center gap-3">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                    {{ message }}
                </div>
            {% endfor %}
            
            {% for message in app.flashes('warning') %}
                <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-yellow-700 flex items-center gap-3">
                    <i class="fas fa-exclamation-triangle text-yellow-500"></i>
                    {{ message }}
                </div>
            {% endfor %}
        </div>

        <!-- Contenu principal -->
        <div class="px-6 pb-8">
            <!-- Header de page -->
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">{% block page_title %}Tableau de bord{% endblock %}</h1>
                    <p class="text-sm text-gray-500 mt-1">{% block page_subtitle %}{{ "now"|date("d F Y") }}{% endblock %}</p>
                </div>
                <div>
                    {% block header_actions %}{% endblock %}
                </div>
            </div>

            <!-- Block principal -->
            {% block body %}{% endblock %}
        </div>
    </div>

    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Fermer le menu mobile quand on redimensionne au-dessus de md
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 768) {
                document.getElementById('mobileMenu')?.classList.add('hidden');
            }
        });

        // Fermer le menu mobile en cliquant en dehors
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('mobileMenu');
            const menuButton = document.querySelector('[onclick="toggleMobileMenu()"]');
            
            if (window.innerWidth < 768 && menu && !menu.classList.contains('hidden')) {
                if (!menu.contains(event.target) && !menuButton?.contains(event.target)) {
                    menu.classList.add('hidden');
                }
            }
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>