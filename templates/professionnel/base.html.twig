<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.name'|trans }} - Professionnel{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: {% if app.request.locale == 'ar' %}'Segoe UI', Tahoma{% else %}'Inter'{% endif %}, sans-serif; }
    </style>
</head>
<body class="bg-gray-50">

    <!-- Navbar fixe -->
    <nav class="bg-white shadow-md border-b border-gray-200 fixed w-full z-50">
        <div class="px-6 py-3">
            <div class="flex items-center justify-between">

                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-[#0f3b3e] rounded-lg flex items-center justify-center">
                        <i class="fas fa-heart text-white text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold text-gray-800">{{ 'app.name'|trans }}</span>
                        <span class="ml-2 text-xs font-semibold text-[#0f3b3e] bg-[#eef8f9] px-2 py-1 rounded-full">PRO</span>
                    </div>
                </div>

                <!-- Menu principal desktop -->
                <div class="hidden md:flex items-center gap-1">
                    <a href="{{ path('professionnel_dashboard') }}"
                       class="px-4 py-2 text-sm font-medium rounded-lg transition-colors {{ app.request.get('_route') == 'professionnel_dashboard' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600 hover:bg-gray-100' }}">
                        <i class="fas fa-chart-pie mr-2"></i>{{ 'nav.dashboard'|trans }}
                    </a>

                    <a href="{{ path('app_pro_journal_patients') }}"
                       class="px-4 py-2 text-sm font-medium rounded-lg transition-colors {{ app.request.get('_route') starts with 'app_pro_journal' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600 hover:bg-gray-100' }}">
                        <i class="fas fa-book-open mr-2"></i>{{ 'pro.journal_patients'|trans }}
                    </a>

                    <div class="relative group">
                        <button class="px-4 py-2 text-sm font-medium rounded-lg transition-colors flex items-center gap-1 {{ app.request.get('_route') starts with 'app_support' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600 hover:bg-gray-100' }}">
                            <i class="fas fa-hand-holding-heart mr-2"></i>{{ 'nav.support'|trans }}
                            <i class="fas fa-chevron-down text-xs ml-1"></i>
                        </button>
                        <div class="absolute left-0 mt-2 w-52 bg-white rounded-lg shadow-lg border border-gray-200 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                            <a href="{{ path('app_support') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e]">
                                <i class="fas fa-heart mr-3 w-5"></i>{{ 'nav.support'|trans }}
                            </a>
                            <a href="{{ path('app_support_stats') }}" class="block px-4 py-3 text-sm text-gray-700 hover:bg-[#eef8f9] hover:text-[#0f3b3e]">
                                <i class="fas fa-chart-line mr-3 w-5"></i>{{ 'journal.stats_title'|trans }}
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Droite : Langue + Profil + Déconnexion -->
                <div class="flex items-center gap-2">

                    {# ✅ Bouton langue #}
                    <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
                       class="hidden lg:flex items-center gap-1 px-3 py-1.5 text-xs font-semibold border border-gray-300 rounded-full hover:bg-gray-100 text-gray-600">
                        🌐 {{ 'app.lang_switch'|trans }}
                    </a>

                    <a href="{{ path('app_pro_security') }}"
                       class="hidden lg:flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-lg transition-colors {{ app.request.get('_route') starts with 'app_pro_security' or app.request.get('_route') starts with 'app_pro_profile' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600 hover:text-[#0f3b3e] hover:bg-gray-100' }}">
                        <i class="fas fa-shield-alt"></i>
                        <span>{{ 'nav.security'|trans }}</span>
                    </a>

                    <div class="hidden lg:flex items-center gap-3 pl-2 border-l border-gray-200">
                        <div class="w-9 h-9 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="text-sm font-medium text-gray-700">Dr. {{ app.user.prenom }} {{ app.user.nom }}</div>
                            <div class="text-xs text-gray-500">{{ app.user.email }}</div>
                        </div>
                    </div>

                    <a href="{{ path('app_logout') }}"
                       title="{{ 'nav.logout'|trans }}"
                       class="hidden lg:flex items-center justify-center w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors ml-1">
                        <i class="fas fa-sign-out-alt text-base"></i>
                    </a>

                    <div class="lg:hidden flex items-center">
                        <div class="w-9 h-9 bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                            {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                        </div>
                    </div>

                    <button class="lg:hidden text-gray-500 hover:text-gray-700 ml-1" onclick="toggleMobileMenu()">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menu mobile -->
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-t border-gray-200 py-2 max-h-[80vh] overflow-y-auto">
            <a href="{{ path('professionnel_dashboard') }}" class="block px-6 py-3 text-sm font-medium {{ app.request.get('_route') == 'professionnel_dashboard' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600' }}">
                <i class="fas fa-chart-pie mr-3 w-5"></i>{{ 'nav.dashboard'|trans }}
            </a>
            <a href="{{ path('app_pro_journal_patients') }}" class="block px-6 py-3 text-sm font-medium {{ app.request.get('_route') starts with 'app_pro_journal' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600' }}">
                <i class="fas fa-book-open mr-3 w-5"></i>{{ 'pro.journal_patients'|trans }}
            </a>
            <div class="border-t border-gray-200 my-2 pt-2">
                <div class="px-6 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ 'nav.support'|trans }}</div>
                <a href="{{ path('app_support') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <i class="fas fa-heart mr-3 w-5"></i>{{ 'nav.support'|trans }}
                </a>
                <a href="{{ path('app_support_stats') }}" class="block px-6 py-3 text-sm font-medium text-gray-600">
                    <i class="fas fa-chart-line mr-3 w-5"></i>{{ 'journal.stats_title'|trans }}
                </a>
            </div>
            <div class="border-t border-gray-200 my-2 pt-2">
                <a href="{{ path('app_pro_security') }}" class="block px-6 py-3 text-sm font-medium {{ app.request.get('_route') starts with 'app_pro_security' or app.request.get('_route') starts with 'app_pro_profile' ? 'bg-[#eef8f9] text-[#0f3b3e]' : 'text-gray-600' }}">
                    <i class="fas fa-shield-alt mr-3 w-5"></i>{{ 'nav.security'|trans }}
                </a>
            </div>
            {# Langue mobile #}
            <div class="border-t border-gray-200 my-2 pt-2 px-6">
                <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
                   class="flex items-center gap-2 px-4 py-2 bg-gray-50 text-gray-600 rounded-lg text-sm font-semibold">
                    🌐 {{ 'app.lang_switch'|trans }}
                </a>
            </div>
            <div class="border-t border-gray-200 my-2 pt-2 px-6">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors text-sm">
                    <i class="fas fa-sign-out-alt"></i>{{ 'nav.logout'|trans }}
                </a>
            </div>
        </div>
    </nav>

    <!-- Contenu -->
    <div class="pt-20">
        <div class="px-6">
            {% for message in app.flashes('success') %}
                <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 flex items-center gap-3">
                    <i class="fas fa-check-circle text-green-500"></i>{{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 flex items-center gap-3">
                    <i class="fas fa-exclamation-circle text-red-500"></i>{{ message }}
                </div>
            {% endfor %}
        </div>
        <div class="px-6 pb-8">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">{% block page_title %}{{ 'nav.dashboard'|trans }}{% endblock %}</h1>
                    <p class="text-sm text-gray-500 mt-1">{% block page_subtitle %}{{ "now"|date("d F Y") }}{% endblock %}</p>
                </div>
                <div>{% block header_actions %}{% endblock %}</div>
            </div>
            {% block body %}{% endblock %}
        </div>
    </div>

    <script>
        function toggleMobileMenu() { document.getElementById('mobileMenu').classList.toggle('hidden'); }
        window.addEventListener('resize', function() { if (window.innerWidth >= 1024) document.getElementById('mobileMenu')?.classList.add('hidden'); });
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('mobileMenu');
            const btn  = document.querySelector('[onclick="toggleMobileMenu()"]');
            if (window.innerWidth < 1024 && menu && !menu.classList.contains('hidden'))
                if (!menu.contains(event.target) && !btn?.contains(event.target)) menu.classList.add('hidden');
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
