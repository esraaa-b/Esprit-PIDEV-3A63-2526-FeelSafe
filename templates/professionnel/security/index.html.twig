{% extends "professionnel/base.html.twig" %}

{% block title %}Sécurité - FeelSafe{% endblock %}

{% block page_title %}Sécurité & Confidentialité{% endblock %}
{% block page_subtitle %}Gérez la sécurité de votre compte{% endblock %}

{% block header_actions %}
<a href="{{ path('app_pro_profile') }}" class="px-4 py-2 border border-[#0f3b3e] text-[#0f3b3e] rounded-lg hover:bg-[#eef8f9] transition-colors inline-flex items-center gap-2">
    <i class="fas fa-arrow-left"></i>
    Retour au profil
</a>
{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Messages flash -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-700 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                    <i class="fas {% if label == 'success' %}fa-check-circle{% else %}fa-exclamation-circle{% endif %} mr-2"></i>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Changer le mot de passe -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-semibold text-gray-800">Changer mon mot de passe</h3>
            </div>
            
            <div class="p-6">
                <form method="post" action="{{ path('app_pro_security_password') }}" class="space-y-6">
                    <!-- Mot de passe actuel (avec placeholder qui montre des étoiles) -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Mot de passe actuel</label>
                        <input type="password" name="current_password" 
                               placeholder="••••••••" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        <p class="text-xs text-gray-500 mt-1">Entrez votre mot de passe actuel pour confirmer</p>
                    </div>
                    
                    <!-- Nouveau mot de passe -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nouveau mot de passe</label>
                        <input type="password" name="new_password" required
                               placeholder="Nouveau mot de passe"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        <p class="text-xs text-gray-500 mt-1">Minimum 6 caractères</p>
                    </div>
                    
                    <!-- Confirmation -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Confirmer le nouveau mot de passe</label>
                        <input type="password" name="confirm_password" required
                               placeholder="Confirmer le mot de passe"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                    </div>
                    
                    <input type="hidden" name="_token" value="{{ csrf_token('change-password') }}">
                    
                    <div class="flex justify-end">
                        <button type="submit" class="px-6 py-2 bg-[#0f3b3e] text-white rounded-lg hover:bg-[#1e5a5f] transition-colors">
                            <i class="fas fa-key mr-2"></i>
                            Changer le mot de passe
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sessions actives -->
      
    </div>
</div>
{% endblock %}