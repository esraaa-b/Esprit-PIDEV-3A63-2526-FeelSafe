{% extends "professionnel/base.html.twig" %}

{% block title %}Mon Profil - FeelSafe{% endblock %}

{% block page_title %}Mon Profil{% endblock %}
{% block page_subtitle %}Consultez et gérez votre profil professionnel{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Messages flash -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-700 border border-green-200{% else %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                    <i class="fas {% if label == 'success' %}fa-check-circle{% else %}fa-exclamation-circle{% endif %} mr-2"></i>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Profile Card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <!-- En-tête avec dégradé -->
            <div class="h-32 bg-gradient-to-r from-[#0f3b3e] to-[#2d6a6f]"></div>
            
            <!-- Contenu du profil -->
            <div class="px-6 pb-6">
                <div class="flex flex-col md:flex-row md:items-end gap-4 -mt-12 relative">
                    <!-- Avatar -->
                    <div class="w-24 h-24 rounded-xl bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] flex items-center justify-center text-white text-3xl font-bold border-4 border-white shadow-lg">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    
                    <!-- Infos utilisateur -->
                    <div class="flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h2 class="text-2xl font-bold text-gray-800">Dr. {{ app.user.prenom }} {{ app.user.nom }}</h2>
                            <span class="px-2 py-1 text-xs font-medium bg-[#eef8f9] text-[#0f3b3e] rounded-full">
                                Professionnel
                            </span>
                        </div>
                        
                        <div class="flex flex-wrap items-center gap-4 mt-2 text-sm text-gray-600">
                            <span class="flex items-center gap-1">
                                <i class="fas fa-envelope text-gray-400 w-4"></i>
                                {{ app.user.email }}
                            </span>
                            
                            {% if app.user.telephone %}
                            <span class="flex items-center gap-1">
                                <i class="fas fa-phone text-gray-400 w-4"></i>
                                {{ app.user.telephone }}
                            </span>
                            {% endif %}
                            
                            <span class="flex items-center gap-1">
                                <i class="fas fa-calendar text-gray-400 w-4"></i>
                                Membre depuis {{ app.user.dateCreation|date('d/m/Y') }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulaire d'édition des informations personnelles -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
                <h3 class="text-lg font-semibold text-gray-800">Modifier mes informations</h3>
            </div>
            
            <div class="p-6">
                <form method="post" action="{{ path('app_pro_profile_edit') }}" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Prénom</label>
                            <input type="text" name="prenom" value="{{ app.user.prenom }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
                            <input type="text" name="nom" value="{{ app.user.nom }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                            <input type="email" name="email" value="{{ app.user.email }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Téléphone</label>
                            <input type="tel" name="telephone" value="{{ app.user.telephone }}"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f3b3e] focus:border-transparent">
                        </div>
                    </div>
                    
                    <input type="hidden" name="_token" value="{{ csrf_token('profile-edit') }}">
                    
                    <div class="flex justify-end gap-4">
                        <button type="submit" class="px-6 py-2 bg-[#0f3b3e] text-white rounded-lg hover:bg-[#1e5a5f] transition-colors">
                            <i class="fas fa-save mr-2"></i>
                            Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_pro_security') }}" class="px-6 py-2 border border-[#0f3b3e] text-[#0f3b3e] rounded-lg hover:bg-[#eef8f9] transition-colors">
                            <i class="fas fa-shield-alt mr-2"></i>
                            Sécurité
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Actions supplémentaires -->
        <div class="flex justify-end">
            <a href="{{ path('app_logout') }}" class="px-6 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors">
                <i class="fas fa-sign-out-alt mr-2"></i>
                Déconnexion
            </a>
        </div>
    </div>
</div>
{% endblock %}