{% extends "professionnel/base.html.twig" %}

{% block title %}Mon Profil - FeelSafe{% endblock %}
{% block page_title %}Mon Profil{% endblock %}
{% block page_subtitle %}Consultez et gérez votre profil professionnel{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto space-y-6">

    {# ══ AVATAR HEADER CARD ══ #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {# Gradient banner #}
        <div class="h-32 bg-gradient-to-r from-[#0f3b3e] to-[#2d6a6f]"></div>

        <div class="px-6 pb-6">
            <div class="flex flex-col md:flex-row md:items-end gap-4 -mt-12 relative">
                {# Avatar #}
                <div class="w-24 h-24 rounded-xl bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] flex items-center justify-center text-white text-3xl font-bold border-4 border-white shadow-lg flex-shrink-0">
                    {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                </div>

                {# Name & meta #}
                <div class="flex-1 pt-14 md:pt-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-2xl font-bold text-gray-800">Dr. {{ app.user.prenom }} {{ app.user.nom }}</h2>
                        <span class="px-2 py-1 text-xs font-semibold bg-[#eef8f9] text-[#0f3b3e] rounded-full border border-[#c8e6e8]">
                            <i class="fas fa-user-md mr-1"></i>Professionnel
                        </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-4 mt-1 text-sm text-gray-500">
                        <span class="flex items-center gap-1"><i class="fas fa-envelope text-gray-400 w-4"></i>{{ app.user.email }}</span>
                        {% if app.user.telephone %}
                            <span class="flex items-center gap-1"><i class="fas fa-phone text-gray-400 w-4"></i>{{ app.user.telephone }}</span>
                        {% endif %}
                        <span class="flex items-center gap-1"><i class="fas fa-calendar text-gray-400 w-4"></i>Membre depuis {{ app.user.dateCreation|date('d/m/Y') }}</span>
                    </div>
                </div>

                {# Quick actions #}
                <div class="flex items-center gap-2 md:self-end pb-1">
                    <a href="{{ path('app_pro_security') }}"
                       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-[#0f3b3e] bg-[#eef8f9] border border-[#c8e6e8] rounded-lg hover:bg-[#d8f0f2] transition-colors">
                        <i class="fas fa-shield-alt"></i>Sécurité
                    </a>
                    <a href="{{ path('app_logout') }}"
                       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">
                        <i class="fas fa-sign-out-alt"></i>Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ══ EDIT FORM CARD ══ #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

        {# Card header #}
        <div class="flex items-start gap-4 px-6 py-5 border-b border-gray-100">
            <div class="w-11 h-11 rounded-xl bg-[#eef8f9] flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user text-[#0f3b3e]"></i>
            </div>
            <div>
                <div class="font-semibold text-gray-800">Informations personnelles</div>
                <div class="text-sm text-gray-500">Mettez à jour vos informations de profil</div>
            </div>
        </div>

        {# Mini avatar summary row #}
        <div class="mx-6 mt-5 bg-gray-50 rounded-xl border border-gray-200 p-4 flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#0f3b3e] to-[#2d6a6f] flex items-center justify-center text-white text-xl font-bold shadow flex-shrink-0">
                {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
            </div>
            <div>
                <div class="font-semibold text-gray-800">{{ app.user.prenom }} {{ app.user.nom }}</div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold bg-[#eef8f9] text-[#0f3b3e] rounded-full border border-[#c8e6e8] mt-1">
                    <i class="fas fa-user-md text-xs"></i>Professionnel
                </span>
                <div class="text-xs text-gray-400 mt-1">Membre depuis le {{ app.user.dateCreation|date('d/m/Y') }}</div>
            </div>
        </div>

        {# Form #}
        <form method="post" action="{{ path('app_pro_profile_edit') }}" class="px-6 py-6 space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('profile-edit') }}">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">
                        Prénom <span class="text-red-400">*</span>
                    </label>
                    <input type="text" name="prenom" value="{{ app.user.prenom }}" required
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0f3b3e]/20 focus:border-[#0f3b3e] focus:bg-white transition">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">
                        Nom <span class="text-red-400">*</span>
                    </label>
                    <input type="text" name="nom" value="{{ app.user.nom }}" required
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0f3b3e]/20 focus:border-[#0f3b3e] focus:bg-white transition">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">
                        Email <span class="text-red-400">*</span>
                    </label>
                    <input type="email" name="email" value="{{ app.user.email }}" required
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0f3b3e]/20 focus:border-[#0f3b3e] focus:bg-white transition">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Téléphone</label>
                    <input type="tel" name="telephone" value="{{ app.user.telephone }}"
                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0f3b3e]/20 focus:border-[#0f3b3e] focus:bg-white transition">
                </div>
            </div>

            <div class="pt-2 flex items-center gap-3">
                <button type="submit"
                        class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#0f3b3e] text-white text-sm font-semibold rounded-lg hover:bg-[#1a5055] transition-colors shadow-sm">
                    <i class="fas fa-save"></i>Sauvegarder les modifications
                </button>
            </div>
        </form>

    </div>

</div>
{% endblock %}
