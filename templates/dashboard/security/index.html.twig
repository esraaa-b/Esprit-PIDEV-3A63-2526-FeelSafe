{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-serif font-bold text-foreground">Sécurité & Profil</h1>
            <p class="text-muted-foreground mt-1">
                Gérez vos informations personnelles et vos paramètres de sécurité
            </p>
        </div>

        <!-- Tabs -->
        <div x-data="{ activeTab: 'profile' }" class="space-y-6">
            <!-- Tabs Navigation -->
            <div class="flex flex-wrap gap-2 border-b border-border pb-2">
                <button @click="activeTab = 'profile'"
                        :class="activeTab === 'profile' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Profil
                </button>
                <button @click="activeTab = 'security'"
                        :class="activeTab === 'security' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Sécurité
                </button>
                <button @click="activeTab = 'privacy'"
                        :class="activeTab === 'privacy' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Confidentialité
                </button>
            </div>

            <!-- Profile Tab -->
            <div x-show="activeTab === 'profile'" class="space-y-6">
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Informations personnelles</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Mettez à jour vos informations de profil
                    </p>
                    
                    <div class="space-y-6">
                        <!-- Avatar -->
                        <div class="flex items-center gap-6">
                            <div class="relative">
                                <div class="w-24 h-24 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-medium">
                                    {{ user.name|first|upper }}
                                </div>
                                <button type="button" class="absolute bottom-0 right-0 w-8 h-8 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-lg">
                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                        <circle cx="12" cy="13" r="4"></circle>
                                    </svg>
                                </button>
                            </div>
                            <div>
                                <h3 class="font-semibold text-foreground">{{ user.name }}</h3>
                                <p class="text-sm text-muted-foreground">Membre depuis {{ user.joined }}</p>
                                <span class="inline-block px-2 py-1 text-xs rounded bg-secondary text-secondary-foreground mt-2">Compte vérifié</span>
                            </div>
                        </div>

                        <!-- Form Fields -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label for="firstName" class="text-sm font-medium text-foreground">Prénom</label>
                                <input type="text" id="firstName" value="{{ user.name|split(' ')[0] ?? '' }}" 
                                       class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            </div>
                            <div class="space-y-2">
                                <label for="lastName" class="text-sm font-medium text-foreground">Nom</label>
                                <input type="text" id="lastName" value="{{ user.name|split(' ')[1] ?? '' }}" 
                                       class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            </div>
                            <div class="space-y-2">
                                <label for="email" class="text-sm font-medium text-foreground">Email</label>
                                <div class="relative">
                                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                    <input type="email" id="email" value="{{ user.email }}" 
                                           class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label for="phone" class="text-sm font-medium text-foreground">Téléphone</label>
                                <div class="relative">
                                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    <input type="tel" id="phone" placeholder="+33 6 00 00 00 00" 
                                           class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label for="birthday" class="text-sm font-medium text-foreground">Date de naissance</label>
                                <div class="relative">
                                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <input type="date" id="birthday" 
                                           class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label for="country" class="text-sm font-medium text-foreground">Pays</label>
                                <div class="relative">
                                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                    </svg>
                                    <input type="text" id="country" value="France" 
                                           class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                                </div>
                            </div>
                        </div>

                        <button type="button" class="px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                            Sauvegarder les modifications
                        </button>
                    </div>
                </div>
            </div>

            <!-- Security Tab -->
            <div x-show="activeTab === 'security'" class="space-y-6">
                <!-- Password -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Mot de passe</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Changez votre mot de passe régulièrement pour plus de sécurité
                    </p>
                    
                    <div class="space-y-4">
                        <div class="space-y-2">
                            <label for="currentPassword" class="text-sm font-medium text-foreground">Mot de passe actuel</label>
                            <input type="password" id="currentPassword" 
                                   class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label for="newPassword" class="text-sm font-medium text-foreground">Nouveau mot de passe</label>
                                <input type="password" id="newPassword" 
                                       class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            </div>
                            <div class="space-y-2">
                                <label for="confirmNewPassword" class="text-sm font-medium text-foreground">Confirmer le nouveau mot de passe</label>
                                <input type="password" id="confirmNewPassword" 
                                       class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            </div>
                        </div>
                        <button type="button" class="px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                            Mettre à jour le mot de passe
                        </button>
                    </div>
                </div>

                <!-- Two Factor Auth -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Authentification à deux facteurs</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Ajoutez une couche de sécurité supplémentaire à votre compte
                    </p>
                    
                    <div class="flex items-center justify-between">
                        <div class="space-y-1">
                            <p class="font-medium text-foreground">Activer la 2FA</p>
                            <p class="text-sm text-muted-foreground">
                                Recevez un code de vérification par SMS ou application
                            </p>
                        </div>
                        <div x-data="{ twoFactorEnabled: false }" class="flex items-center">
                            <button type="button" 
                                    @click="twoFactorEnabled = !twoFactorEnabled"
                                    :class="twoFactorEnabled ? 'bg-primary' : 'bg-secondary'"
                                    class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                                <span :class="twoFactorEnabled ? 'translate-x-6' : 'translate-x-1'" 
                                      class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Active Sessions -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Sessions actives</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Gérez les appareils connectés à votre compte
                    </p>
                    
                    <div class="space-y-4">
                        {% for session in sessions %}
                            <div class="flex items-center justify-between p-3 rounded-lg bg-secondary/50">
                                <div class="flex items-center gap-3">
                                    <div class="w-2 h-2 rounded-full {{ session.current ? 'bg-primary' : 'bg-muted-foreground' }}"></div>
                                    <div>
                                        <p class="font-medium text-foreground">{{ session.device }}</p>
                                        <p class="text-sm text-muted-foreground">
                                            {{ session.location }} - {{ session.lastActive }}
                                        </p>
                                    </div>
                                </div>
                                {% if session.current %}
                                    <span class="px-2 py-1 text-xs rounded bg-secondary text-secondary-foreground">
                                        Session actuelle
                                    </span>
                                {% else %}
                                    <button type="button" class="px-3 py-1 text-sm rounded-lg border border-input text-destructive hover:bg-secondary transition-colors">
                                        Déconnecter
                                    </button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="w-full mt-4 px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                        Déconnecter toutes les autres sessions
                    </button>
                </div>
            </div>

            <!-- Privacy Tab -->
            <div x-show="activeTab === 'privacy'" class="space-y-6">
                <!-- Privacy Settings -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Paramètres de confidentialité</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Contrôlez qui peut voir vos informations
                    </p>
                    
                    <div class="space-y-6">
                        <div x-data="{ publicProfile: false }" class="flex items-center justify-between">
                            <div class="space-y-1">
                                <p class="font-medium text-foreground">Profil public</p>
                                <p class="text-sm text-muted-foreground">
                                    Permettre aux autres membres de voir votre profil
                                </p>
                            </div>
                            <button type="button" 
                                    @click="publicProfile = !publicProfile"
                                    :class="publicProfile ? 'bg-primary' : 'bg-secondary'"
                                    class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                                <span :class="publicProfile ? 'translate-x-6' : 'translate-x-1'" 
                                      class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                            </button>
                        </div>
                        <div x-data="{ showActivity: true }" class="flex items-center justify-between">
                            <div class="space-y-1">
                                <p class="font-medium text-foreground">Afficher mon activité</p>
                                <p class="text-sm text-muted-foreground">
                                    Montrer vos contributions dans la communauté
                                </p>
                            </div>
                            <button type="button" 
                                    @click="showActivity = !showActivity"
                                    :class="showActivity ? 'bg-primary' : 'bg-secondary'"
                                    class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                                <span :class="showActivity ? 'translate-x-6' : 'translate-x-1'" 
                                      class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Notifications -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Notifications</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Gérez vos préférences de notifications
                    </p>
                    
                    <div x-data="{ emailNotifications: true }" class="flex items-center justify-between">
                        <div class="space-y-1">
                            <p class="font-medium text-foreground">Notifications par email</p>
                            <p class="text-sm text-muted-foreground">
                                Recevoir des rappels et mises à jour par email
                            </p>
                        </div>
                        <button type="button" 
                                @click="emailNotifications = !emailNotifications"
                                :class="emailNotifications ? 'bg-primary' : 'bg-secondary'"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                            <span :class="emailNotifications ? 'translate-x-6' : 'translate-x-1'" 
                                  class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                        </button>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="bg-card rounded-lg border border-border border-destructive/50 p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground text-destructive">Zone dangereuse</h2>
                    </div>
                    <p class="text-muted-foreground mb-6">
                        Actions irréversibles concernant votre compte
                    </p>
                    
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="font-medium text-foreground">Exporter mes données</p>
                                <p class="text-sm text-muted-foreground">
                                    Télécharger toutes vos données personnelles
                                </p>
                            </div>
                            <button type="button" class="px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                                Exporter
                            </button>
                        </div>
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="font-medium text-foreground">Supprimer mon compte</p>
                                <p class="text-sm text-muted-foreground">
                                    Cette action est définitive et irréversible
                                </p>
                            </div>
                            <button type="button" class="px-4 py-2 bg-destructive text-destructive-foreground rounded-lg font-medium hover:bg-destructive/90 transition-colors">
                                Supprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}