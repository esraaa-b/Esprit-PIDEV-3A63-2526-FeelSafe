{# templates/dashboard/index.html.twig #}
{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-serif font-bold text-foreground">
                {{ greeting }}, {{ userName }}
            </h1>
            <p class="text-muted-foreground mt-1">
                Comment vous sentez-vous aujourd'hui?
            </p>
        </div>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <svg class="w-4 h-4 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <span>{{ "now"|date("l d F")|capitalize }}</span>
        </div>
    </div>

    <!-- Quick Mood Check -->
    <div class="bg-card rounded-lg border border-border p-6">
        <div class="mb-4">
            <h2 class="text-lg font-semibold text-foreground">Comment vous sentez-vous?</h2>
            <p class="text-sm text-muted-foreground">Enregistrez votre humeur quotidienne</p>
        </div>
        
        <div x-data="{ selectedMood: null }" class="flex gap-3 flex-wrap">
            {% for mood in moodOptions %}
                <button type="button"
                        @click="selectedMood = '{{ mood.id }}'"
                        :class="selectedMood === '{{ mood.id }}' 
                                ? '{{ mood.color }} text-card border-transparent' 
                                : 'border-border hover:border-primary/50 text-foreground bg-transparent'"
                        class="flex items-center gap-2 px-4 py-2.5 rounded-full border-2 transition-all">
                    <span class="text-xl">{{ mood.icon }}</span>
                    <span class="font-medium">{{ mood.label }}</span>
                </button>
            {% endfor %}
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Wellness Score -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-foreground">72%</p>
                    <p class="text-sm text-muted-foreground">Score bien-être</p>
                </div>
            </div>
            <div class="h-2 w-full bg-secondary rounded-full overflow-hidden mt-4">
                <div class="h-full bg-primary rounded-full" style="width: 72%"></div>
            </div>
        </div>

        <!-- Journal Entries -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-chart-2/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                        <path d="M8 11h8"></path>
                        <path d="M8 6h8"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-foreground">12</p>
                    <p class="text-sm text-muted-foreground">Entrées journal</p>
                </div>
            </div>
            <div class="mt-4 flex gap-1">
                {% for day in moodHistory %}
                    <div class="flex-1 flex flex-col items-center gap-1">
                        {% if day.mood == 'happy' %}
                            <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                <line x1="15" y1="9" x2="15.01" y2="9"></line>
                            </svg>
                        {% elseif day.mood == 'sad' %}
                            <svg class="w-4 h-4 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M16 16s-1.5-2-4-2-4 2-4 2"></path>
                                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                <line x1="15" y1="9" x2="15.01" y2="9"></line>
                            </svg>
                        {% else %}
                            <svg class="w-4 h-4 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="15" x2="16" y2="15"></line>
                                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                                <line x1="15" y1="9" x2="15.01" y2="9"></line>
                            </svg>
                        {% endif %}
                        <span class="text-xs text-muted-foreground">{{ day.day }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Upcoming Appointments -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-chart-4/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div>
                    <p class="text-2xl font-bold text-foreground">2</p>
                    <p class="text-sm text-muted-foreground">RDV à venir</p>
                </div>
            </div>
            <div class="mt-4 space-y-2">
                <div class="text-sm">
                    <span class="text-foreground font-medium">Dr. Martin</span>
                    <span class="text-muted-foreground"> - Demain 14h</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Modules Grid -->
<div>
    <h2 class="text-xl font-serif font-semibold text-foreground mb-4">Vos modules</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for module in modules %}
            <a href="{{ module.href }}" class="block group">
                <div class="bg-card rounded-lg border border-border overflow-hidden h-full hover:shadow-lg transition-all duration-300">
                    <!-- Image Section - FIXED -->
                    <div class="relative h-32 overflow-hidden">
                        <!-- ONLY THE IMAGE TAG, NO GRAY PLACEHOLDER -->
                        <img 
                            src="{{ module.image }}" 
                            alt="{{ module.name }}"
                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-card via-card/50 to-transparent"></div>
                        <div class="absolute top-4 left-4 w-10 h-10 rounded-lg {{ module.color }} flex items-center justify-center">
                            {% if module.icon == 'shield' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            {% elseif module.icon == 'book' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                                    <path d="M8 11h8"></path>
                                    <path d="M8 6h8"></path>
                                </svg>
                            {% elseif module.icon == 'heart' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            {% elseif module.icon == 'sun' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="5"></circle>
                                    <line x1="12" y1="1" x2="12" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="23"></line>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                    <line x1="1" y1="12" x2="3" y2="12"></line>
                                    <line x1="21" y1="12" x2="23" y2="12"></line>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                </svg>
                            {% elseif module.icon == 'alert' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            {% elseif module.icon == 'users' %}
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-4">
                        <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">
                            {{ module.name }}
                        </h3>
                        <p class="text-sm text-muted-foreground mt-1">{{ module.description }}</p>
                        <div class="flex items-center gap-1 mt-3 text-primary text-sm font-medium">
                            <span>Accéder</span>
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>
</div>

    <!-- Quick Actions -->
    <div class="bg-primary text-primary-foreground rounded-lg border border-primary p-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h3 class="text-lg font-semibold">Besoin d'aide immédiate?</h3>
                <p class="text-primary-foreground/80 text-sm mt-1">
                    Notre équipe est disponible 24h/24 pour vous accompagner
                </p>
            </div>
            <div class="flex gap-3">
                <a href="/dashboard/emergency" class="px-4 py-2 bg-primary-foreground text-primary rounded-lg font-medium hover:bg-primary-foreground/90 transition-colors">
                    Demander de l'aide
                </a>
                <a href="/dashboard/support" class="px-4 py-2 border border-primary-foreground/30 text-primary-foreground rounded-lg font-medium hover:bg-primary-foreground/10 transition-colors bg-transparent">
                    Prendre RDV
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}