{% extends "dashboard/base.html.twig" %}

{% block title %}Historique des Urgences{% endblock %}

{% block content %}
<div class="container mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Historique des Urgences</h1>
        <a href="{{ path('app_emergency') }}" class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
            ← Retour
        </a>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Gravité</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for emergency in emergencies %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-900">{{ emergency.id }}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ emergency.typeUrgence }}</td>
                        <td class="px-6 py-4 text-sm text-gray-600 max-w-md truncate">{{ emergency.description|slice(0, 50) }}{% if emergency.description|length > 50 %}...{% endif %}</td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 text-xs rounded-full 
                                {% if emergency.niveauGravite >= 4 %}bg-red-100 text-red-800
                                {% elseif emergency.niveauGravite >= 3 %}bg-yellow-100 text-yellow-800
                                {% else %}bg-green-100 text-green-800{% endif %}">
                                {{ emergency.niveauGravite }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 text-xs rounded-full 
                                {% if emergency.statut == 'résolue' %}bg-green-100 text-green-800
                                {% elseif emergency.statut == 'prise en charge' %}bg-blue-100 text-blue-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ emergency.statut }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ emergency.dateHeure|date('d/m/Y H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            Aucune urgence enregistrée
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}