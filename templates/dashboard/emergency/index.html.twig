{% extends "dashboard/base.html.twig" %}

{% block title %}Urgence & Support - FeelSafe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [x-cloak] { display: none !important; }
    </style>
{% endblock %}

{% block content %}
<div class="space-y-8" x-data="emergencyReport()" x-cloak>
    {# Header #}
    <div>
        <h1 class="text-3xl font-serif font-bold text-foreground">Urgence & Support</h1>
        <p class="text-muted-foreground mt-1">
            Obtenez de l'aide rapidement en cas de besoin
        </p>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
    {% endfor %}

    {# Emergency Alert #}
    <div class="border border-destructive/50 bg-destructive/5 rounded-lg p-4">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-destructive flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <div>
                <h3 class="font-semibold text-destructive">En cas d'urgence vitale</h3>
                <p class="text-destructive/80 text-sm mt-1">
                    Si vous ou quelqu'un est en danger immediat, appelez le 15 (SAMU) ou le 112.
                </p>
            </div>
        </div>
    </div>

    {# Quick Actions #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {# Report Emergency Card #}
        <div class="relative">
            <button @click="dialogOpen = true" class="w-full cursor-pointer hover:shadow-lg transition-all border border-destructive/20 hover:border-destructive/50 rounded-xl bg-card text-left">
                <div class="p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-destructive/10 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-foreground text-lg">Signaler une urgence</h3>
                    <p class="text-sm text-muted-foreground mt-1">Demandez de l'aide rapidement</p>
                </div>
            </button>

           {# Emergency Form Modal #}
<div x-show="dialogOpen" x-transition class="fixed inset-0 bg-foreground/50 z-50 flex items-center justify-center p-4" @click.self="dialogOpen = false">
    <div class="bg-card rounded-lg shadow-lg max-w-lg w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6">
            <form method="POST" action="{{ path('app_emergency') }}" @submit.prevent="validateAndSubmit" novalidate>
                <div class="mb-4">
                    <div class="flex items-center gap-2 mb-2">
                        <svg class="w-5 h-5 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <h2 class="text-xl font-serif font-semibold text-foreground">Signaler une situation urgente</h2>
                    </div>
                    <p class="text-muted-foreground text-sm">Votre demande sera traitee en priorite par notre equipe</p>
                </div>

                <input type="hidden" name="submit_emergency" value="1">

                {# Validation Errors #}
                <div x-show="errors.length > 0" class="mb-4 p-3 bg-destructive/10 border border-destructive/20 rounded-lg">
                    <p class="text-destructive font-medium mb-1">Veuillez corriger les erreurs suivantes :</p>
                    <ul class="list-disc list-inside text-sm text-destructive/80">
                        <template x-for="error in errors" :key="error">
                            <li x-text="error"></li>
                        </template>
                    </ul>
                </div>

               {# Urgency Level #}
                <div class="mb-4">
                    <p class="text-sm font-medium text-foreground mb-3">Niveau d'urgence <span class="text-destructive">*</span></p>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="urgency_level" value="high" class="hidden" x-model="form.urgencyLevel">
                            <div :class="form.urgencyLevel === 'high' ? 'border-destructive bg-destructive/5 text-destructive' : 'border-border hover:border-destructive'" class="p-3 rounded-lg border-2 text-center transition-all">
                                <span class="font-medium">Elevé</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="urgency_level" value="medium" class="hidden" x-model="form.urgencyLevel">
                            <div :class="form.urgencyLevel === 'medium' ? 'border-blue-500 bg-blue-100 text-blue-600' : 'border-border hover:border-blue-500'" class="p-3 rounded-lg border-2 text-center transition-all">
                                <span class="font-medium">Moyen</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="urgency_level" value="low" class="hidden" x-model="form.urgencyLevel">
                            <div :class="form.urgencyLevel === 'low' ? 'border-primary bg-primary/5 text-primary' : 'border-border hover:border-primary'" class="p-3 rounded-lg border-2 text-center transition-all">
                                <span class="font-medium">Faible</span>
                            </div>
                        </label>
                    </div>
                </div>

                {# Location #}
                <div class="mb-4">
                    <p class="text-sm font-medium text-foreground mb-2">Votre localisation <span class="text-destructive">*</span></p>
                    <select name="location" x-model="form.location" class="w-full p-3 rounded-lg border border-border bg-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="" disabled selected>Sélectionnez votre ville</option>
                        <option value="Tunis">Tunis</option>
                        <option value="Sfax">Sfax</option>
                        <option value="Sousse">Sousse</option>
                        <option value="Ariana">Ariana</option>
                        <option value="Ben Arous">Ben Arous</option>
                        <option value="Manouba">Manouba</option>
                        <option value="Bizerte">Bizerte</option>
                        <option value="Nabeul">Nabeul</option>
                        <option value="Hammamet">Hammamet</option>
                        <option value="Monastir">Monastir</option>
                        <option value="Mahdia">Mahdia</option>
                        <option value="Kairouan">Kairouan</option>
                        <option value="Kasserine">Kasserine</option>
                        <option value="Gafsa">Gafsa</option>
                        <option value="Gabès">Gabès</option>
                        <option value="Médenine">Médenine</option>
                        <option value="Tataouine">Tataouine</option>
                        <option value="Tozeur">Tozeur</option>
                        <option value="Kébili">Kébili</option>
                        <option value="Jendouba">Jendouba</option>
                        <option value="Béja">Béja</option>
                        <option value="Le Kef">Le Kef</option>
                        <option value="Siliana">Siliana</option>
                        <option value="Zaghouan">Zaghouan</option>
                    </select>
                </div>

                {# Description #}
                <div class="mb-6">
                    <p class="text-sm font-medium text-foreground mb-2">Décrivez votre situation <span class="text-destructive">*</span></p>
                    <textarea name="description" x-model="form.description" placeholder="Expliquez brièvement ce qui se passe... (minimum 10 caractères)" class="w-full min-h-32 p-3 rounded-lg border border-border bg-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                    <p class="text-xs mt-1" :class="form.description.length >= 10 ? 'text-green-600' : 'text-destructive'">
                        <span x-text="form.description.length"></span> / 10 caractères minimum
                    </p>
                </div>

                {# Buttons #}
                <div class="flex justify-end gap-2">
                    <button type="button" @click="dialogOpen = false; resetForm()" class="px-4 py-2 rounded-lg border border-border hover:bg-secondary transition-colors">Annuler</button>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-destructive text-destructive-foreground hover:bg-destructive/90 transition-colors">
                        Envoyer ma demande
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

        {# Chat Card #}
        <div x-data="{ chatOpen: false }">
            <a href="#" @click.prevent="chatOpen = true" class="cursor-pointer hover:shadow-lg transition-all border border-border rounded-xl bg-card block">
                <div class="p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-chart-4/10 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-foreground text-lg">Chat d'urgence</h3>
                    <p class="text-sm text-muted-foreground mt-1">Parlez à quelqu'un maintenant</p>
                </div>
            </a>

            {# Chat Modal #}
            <div x-show="chatOpen" x-transition class="fixed inset-0 bg-foreground/50 z-50 flex items-center justify-center p-4" @click.self="chatOpen = false">
                <div class="bg-card rounded-lg shadow-lg max-w-lg w-full">
                    <div class="p-4 border-b border-border flex justify-between items-center">
                        <h3 class="text-xl font-semibold text-foreground">Chat d'urgence</h3>
                        <button @click="chatOpen = false" class="text-muted-foreground hover:text-foreground">✕</button>
                    </div>
                    <div class="p-6">
                        <div class="mb-4 p-4 bg-chart-4/10 rounded-lg">
                            <p class="text-chart-4 font-medium mb-2">⚡ Mode développement</p>
                            <p class="text-sm text-muted-foreground">
                                En production, ce chat serait connecté à notre équipe de support.
                            </p>
                        </div>
                        
                        <div class="space-y-4">
                            <p class="font-medium text-foreground">En attendant, vous pouvez :</p>
                            
                            <div class="p-3 rounded-lg bg-secondary/50 hover:bg-secondary transition-colors">
                                <a href="tel:+21628090014" class="flex items-center gap-3">
                                    <span class="text-primary">📞</span>
                                    <div>
                                        <p class="font-medium">Appeler le support</p>
                                        <p class="text-sm text-muted-foreground">+216 28 090 014</p>
                                    </div>
                                </a>
                            </div>
                            
                            <div class="p-3 rounded-lg bg-secondary/50 hover:bg-secondary transition-colors">
                                <a href="mailto:support@feelsafe.com" class="flex items-center gap-3">
                                    <span class="text-primary">✉️</span>
                                    <div>
                                        <p class="font-medium">Envoyer un email</p>
                                        <p class="text-sm text-muted-foreground">support@feelsafe.com</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        
                        <div class="mt-6 text-center">
                            <button @click="chatOpen = false" class="px-4 py-2 bg-primary text-primary-foreground rounded-lg">
                                Fermer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Centers Card #}
        <div x-data="{ mapOpen: false }">
            <a href="#" @click.prevent="mapOpen = true" class="cursor-pointer hover:shadow-lg transition-all border border-border rounded-xl bg-card block">
                <div class="p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-foreground text-lg">Centres à proximité</h3>
                    <p class="text-sm text-muted-foreground mt-1">Trouvez de l'aide près de vous</p>
                </div>
            </a>

            {# Map Modal #}
            <div x-show="mapOpen" x-transition class="fixed inset-0 bg-foreground/50 z-50 flex items-center justify-center p-4" @click.self="mapOpen = false">
                <div class="bg-card rounded-lg shadow-lg max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                    <div class="p-4 border-b border-border flex justify-between items-center">
                        <h3 class="text-xl font-semibold text-foreground">ESPRIT</h3>
                        <button @click="mapOpen = false" class="text-muted-foreground hover:text-foreground text-xl">✕</button>
                    </div>
                    <div class="p-4">
                        <div class="w-full h-96 rounded-lg overflow-hidden border border-border">
                            <iframe
                                width="100%"
                                height="100%"
                                style="border:0"
                                loading="lazy"
                                allowfullscreen
                                referrerpolicy="no-referrer-when-downgrade"
                                src="https://www.google.com/maps/embed/v1/place?key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8&q=ESPRIT+Pôle+Technologique+1+2+rue+André+Ampère+Cebalat+2083">
                            </iframe>
                        </div>
                        
                        <div class="mt-4 space-y-3">
                            <div class="p-4 rounded-lg bg-secondary/50">
                                <div class="flex items-start gap-3">
                                    <span class="text-primary text-xl">📍</span>
                                    <div>
                                        <p class="font-medium text-foreground">ESPRIT</p>
                                        <p class="text-sm text-muted-foreground">Pôle Technologique, 1-2 rue André Ampère</p>
                                        <p class="text-sm text-muted-foreground">Cebalat 2083, Tunisie</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex gap-3">
                                <a href="https://www.google.com/maps/dir/?api=1&destination=ESPRIT+Pôle+Technologique+1+2+rue+André+Ampère+Cebalat+2083" target="_blank" class="flex-1 p-3 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors text-center">
                                    🗺️ Obtenir l'itinéraire
                                </a>
                                <a href="tel:+21670830000" class="flex-1 p-3 rounded-lg border border-border hover:bg-secondary transition-colors text-center">
                                    📞 Appeler
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Emergency Contacts #}
    <div class="border border-border rounded-xl bg-card">
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Numéros d'urgence</h2>
            </div>
            <p class="text-muted-foreground text-sm">Ces lignes sont disponibles pour vous écouter et vous aider</p>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for contact in [
                    { name: "SOS Amitié", number: "09 72 39 40 50", desc: "Écoute 24h/24" },
                    { name: "Fil Santé Jeunes", number: "0 800 235 236", desc: "Gratuit et anonyme" },
                    { name: "SAMU", number: "15", desc: "Urgences médicales" },
                    { name: "Prévention suicide", number: "3114", desc: "24h/24, 7j/7" }
                ] %}
                    <div class="flex items-center justify-between p-4 rounded-xl bg-secondary/50 hover:bg-secondary transition-colors">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-foreground">{{ contact.name }}</p>
                                <p class="text-sm text-muted-foreground">{{ contact.desc }}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <a href="tel:{{ contact.number|replace({' ': ''}) }}" class="text-lg font-bold text-primary hover:underline">{{ contact.number }}</a>
                            <p class="text-xs text-primary flex items-center gap-1 justify-end mt-1">
                                <span class="w-2 h-2 rounded-full bg-primary"></span>
                                Disponible
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Previous Requests #}
    <div class="border border-border rounded-xl bg-card">
        <div class="p-6 border-b border-border">
            <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Historique des demandes</h2>
            </div>
            <p class="text-muted-foreground text-sm">Suivez l'état de vos demandes précédentes</p>
        </div>
        <div class="p-6">
            {% if emergencies|length > 0 %}
                <div class="space-y-4">
                    {% for emergency in emergencies %}
                        <div class="flex items-center justify-between p-4 rounded-lg bg-secondary/30 border border-border">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                        {% if emergency.severityLevel >= 4 %}bg-destructive/10 text-destructive
                                        {% elseif emergency.severityLevel >= 3 %}bg-chart-2/10 text-chart-2
                                        {% else %}bg-primary/10 text-primary{% endif %}">
                                        {% if emergency.severityLevel >= 4 %}Urgent
                                        {% elseif emergency.severityLevel >= 3 %}Modéré
                                        {% else %}Faible{% endif %}
                                    </span>
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full 
                                        {% if emergency.status == 'Resolved' %}bg-green-100 text-green-800
                                        {% elseif emergency.status == 'In Progress' %}bg-blue-100 text-blue-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {{ emergency.status }}
                                    </span>
                                </div>
                                <p class="text-sm text-foreground">{{ emergency.description|slice(0, 60) }}{% if emergency.description|length > 60 %}...{% endif %}</p>
                                <p class="text-xs text-muted-foreground mt-1">{{ emergency.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-8">
                    <svg class="w-12 h-12 text-muted-foreground mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p class="text-muted-foreground">Aucune demande précédente</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('emergencyReport', () => ({
            dialogOpen: false,
            chatOpen: false,
            form: {
                urgencyLevel: '',
                location: '',
                description: ''
            },
            errors: [],
            
            validateAndSubmit(e) {
                this.errors = [];
                
                if (!this.form.urgencyLevel) {
                    this.errors.push('Veuillez sélectionner un niveau d\'urgence');
                }
                
                if (!this.form.location) {
                    this.errors.push('Veuillez sélectionner votre localisation');
                }
                
                if (!this.form.description || this.form.description.trim().length < 10) {
                    this.errors.push('La description doit contenir au moins 10 caractères');
                }
                
                if (this.errors.length > 0) {
                    e.preventDefault();
                    return false;
                }
                
                e.target.submit();
            },
            
            resetForm() {
                this.form = {
                    urgencyLevel: '',
                    location: '',
                    description: ''
                };
                this.errors = [];
                this.dialogOpen = false;
            }
        }));
    });
</script>
{% endblock %}