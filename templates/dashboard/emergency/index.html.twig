{% extends "dashboard/base.html.twig" %}

{% block title %}Urgence & Support - FeelSafe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [x-cloak] { display: none !important; }
        
        /* Modern Chat Styling - Matching Java */
        .chat-message-user {
            background-color: #2e7d32;
            color: white;
            border-radius: 15px 15px 5px 15px;
            padding: 10px 15px;
            max-width: 80%;
            margin-left: auto;
        }
        
        .chat-message-bot {
            background-color: #f5f5f5;
            color: #333333;
            border-radius: 15px 15px 15px 5px;
            padding: 10px 15px;
            max-width: 80%;
        }
        
        .chat-message-time {
            font-size: 9px;
            opacity: 0.7;
            margin-top: 4px;
        }
        
        /* SmartWatch Styling - Exactly matching Java FXML */
        .smartwatch-container {
            background-color: #f5f5f5;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }
        
        .smartwatch-header {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }
        
        .smartwatch-status {
            font-size: 13px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 10px;
        }
        
        .smartwatch-location {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
        }
        
        .location-btn {
            background-color: #1565c0;
            color: white;
            border-radius: 15px;
            padding: 4px 12px;
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 4px;
            border: none;
            cursor: pointer;
        }
        
        .location-btn:hover {
            background-color: #0d47a1;
        }
        
        .metrics-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 5px 0;
        }
        
        .metric-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .metric-icon {
            width: 35px;
            text-align: center;
            font-size: 16px;
        }
        
        .metric-slider {
            flex: 1;
            margin: 0 12px;
            height: 4px;
            border-radius: 5px;
            -webkit-appearance: none;
        }
        
        .metric-slider:focus {
            outline: none;
        }
        
        .metric-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #2e7d32;
            cursor: pointer;
        }
        
        .bp-sliders {
            flex: 1;
            display: flex;
            gap: 12px;
            margin: 0 12px;
        }
        
        .bp-slider-group {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .bp-label {
            font-size: 9px;
            color: #666666;
            width: 20px;
        }
        
        .bp-slider {
            flex: 1;
            height: 4px;
            border-radius: 5px;
            -webkit-appearance: none;
        }
        
        .bp-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #2e7d32;
            cursor: pointer;
        }
        
        .metric-value {
            width: 70px;
            text-align: right;
            font-weight: bold;
            font-size: 12px;
        }
        
        /* Button styles matching Java */
        .start-btn {
            background-color: #2e7d32;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            font-size: 13px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .start-btn:hover {
            background-color: #1b5e20;
        }
        
        .start-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .stop-btn {
            background-color: #c62828;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            font-size: 13px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .stop-btn:hover {
            background-color: #b71c1c;
        }
        
        .stop-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        /* Metric value colors matching Java */
        .metric-critical {
            color: #c62828 !important;
            font-weight: bold;
        }
        
        .metric-warning {
            color: #ff9800 !important;
            font-weight: bold;
        }
        
        .metric-normal {
            color: #2e7d32 !important;
        }
        
        /* Stat Cards - Exactly matching Java */
        .stats-row {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }
        
        .stat-card {
            flex: 1;
            background: white;
            border-radius: 8px;
            padding: 8px;
            text-align: center;
            border: 1px solid #e0e0e0;
            transition: all 0.2s;
        }
        
        .stat-card.history-card {
            background-color: #2e7d32;
            cursor: pointer;
        }
        
        .stat-card.history-card .stat-value,
        .stat-card.history-card .stat-label {
            color: white;
        }
        
        .stat-card.history-card:hover {
            background-color: #1b5e20;
            transform: translateY(-2px);
        }
        
        .stat-card:not(.history-card) {
            cursor: default;
        }
        
        .stat-value {
            font-size: 18px;
            font-weight: bold;
            color: #333;
        }
        
        .stat-label {
            font-size: 10px;
            color: #666;
            margin-top: 4px;
        }
        
        /* Crisis Chart Container */
        .chart-container {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 12px;
            border: 1px solid #e8f5e9;
            margin-top: 12px;
        }
        
        canvas {
            width: 100%;
            height: 160px;
        }
        
        /* Emergency Call Button */
        .emergency-call-btn {
            background-color: #c62828;
            border-radius: 20px;
            padding: 5px 15px;
            color: white;
            font-weight: bold;
            font-size: 13px;
            transition: all 0.2s;
        }
        
        .emergency-call-btn:hover {
            background-color: #b71c1c;
        }
        
        /* Resizable Divider */
        .resize-handle {
            width: 8px;
            cursor: col-resize;
            background: transparent;
            position: relative;
            transition: background 0.2s;
            flex-shrink: 0;
        }
        
        .resize-handle:hover {
            background: #c8e6c9;
        }
        
        .resize-handle:active {
            background: #2e7d32;
        }
        
        /* Dragging state */
        body.resizing {
            cursor: col-resize !important;
            user-select: none !important;
        }
        
        body.resizing * {
            cursor: col-resize !important;
            user-select: none !important;
        }
        
        /* Typing indicator */
        .typing-indicator {
            display: flex;
            gap: 4px;
            padding: 8px 12px;
        }
        
        .typing-indicator span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #999;
            animation: bounce 1.4s infinite ease-in-out both;
        }
        
        .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
        .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
        
        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }
        
        .chat-scroll::-webkit-scrollbar {
            width: 6px;
        }
        
        .chat-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .chat-scroll::-webkit-scrollbar-thumb {
            background: #c8e6c9;
            border-radius: 3px;
        }
        
        input[type="range"] {
            width: 100%;
            height: 4px;
            border-radius: 5px;
            background: #e0e0e0;
            -webkit-appearance: none;
        }
        
        input[type="range"]:focus {
            outline: none;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #2e7d32;
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block content %}
<div x-data="emergencyDashboard()" x-init="init()" x-cloak class="space-y-4">
    
    <!-- Header with Emergency Call Button -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <svg class="w-6 h-6 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2a10 10 0 1 0 10 10 10 10 0 0 0-10-10z"/>
                    <path d="M12 6v4l3 3"/>
                </svg>
                Assistant IA FeelSafe
            </h1>
            <p class="text-gray-500 text-sm mt-1">Je suis là pour vous écouter 💚</p>
        </div>
        <button @click="startEmergencyCall()" class="emergency-call-btn flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Appel Urgence</span>
        </button>
    </div>
    
    <!-- Main Split View (Chat | SmartWatch+Stats) -->
    <div class="flex gap-0" x-ref="mainContainer" style="height: 740px;">
        
        <!-- LEFT PANEL: Chat -->
        <div class="flex-1 min-w-0" x-ref="leftPanel" style="flex: 1; display: flex; flex-direction: column; min-width: 0;">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col" style="flex: 1; min-height: 0; display: flex; flex-direction: column;">
                <!-- Chat Header -->
                <div class="p-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center flex-shrink-0">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                        <span class="font-semibold text-gray-900">Assistant IA FeelSafe</span>
                        <span class="text-xs text-gray-500" x-text="aiStatus"></span>
                    </div>
                    <button @click="clearChat()" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </button>
                </div>
                
                <!-- Chat Messages - SCROLLABLE -->
                <div class="flex-1 overflow-y-auto p-4 space-y-3 chat-scroll" x-ref="chatMessages" style="overflow-y: auto; min-height: 0;">
                    <template x-for="(msg, idx) in messages" :key="idx">
                        <div :class="msg.sender === 'user' ? 'flex justify-end' : 'flex justify-start'">
                            <div :class="msg.sender === 'user' ? 'chat-message-user' : 'chat-message-bot'">
                                <p class="text-sm whitespace-pre-wrap break-words" x-text="msg.text"></p>
                                <div class="chat-message-time" x-text="msg.time"></div>
                            </div>
                        </div>
                    </template>
                    <div x-show="isTyping" class="flex justify-start">
                        <div class="chat-message-bot">
                            <div class="typing-indicator"><span></span><span></span><span></span></div>
                        </div>
                    </div>
                </div>
                
                <!-- Chat Input - FIXED -->
                <div class="p-4 border-t border-gray-200 bg-white flex-shrink-0">
                    <div class="flex gap-2">
                        <textarea x-model="messageInput" 
                                  @keydown.enter.prevent="if(!$event.shiftKey) sendMessage()"
                                  placeholder="Écrivez votre message... (Shift+Enter pour nouvelle ligne, Enter pour envoyer)"
                                  class="flex-1 p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 resize-none"
                                  rows="2"></textarea>
                        <button @click="sendMessage()" :disabled="!messageInput.trim() || isTyping"
                                style="background-color: #2e7d32;"
                                class="px-4 py-2 text-white rounded-lg hover:opacity-90 disabled:opacity-50 transition-opacity">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                    <p class="text-xs text-gray-400 mt-2 text-center">💚 L'assistant est là pour vous écouter. En cas de crise, une urgence sera automatiquement créée.</p>
                </div>
            </div>
        </div>
        
        <!-- RESIZABLE DIVIDER -->
        <div class="resize-handle" @mousedown="startResize"></div>
        
        <!-- RIGHT PANEL: SmartWatch + Stats -->
        <div class="w-96 flex-shrink-0" x-ref="rightPanel" style="overflow-y: auto;">
            <div class="space-y-4">
                
                <!-- SmartWatch Component - Java style with color hints -->
                <div class="smartwatch-container" x-ref="watchContainer">
                    <div class="smartwatch-header">
                        <svg class="w-5 h-5 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 12.4V7.6a2 2 0 0 0-1.5-1.9l-6-1.2a2 2 0 0 0-1 0l-6 1.2A2 2 0 0 0 4 7.6v4.8a2 2 0 0 0 1.5 1.9l6 1.2a2 2 0 0 0 1 0l6-1.2a2 2 0 0 0 1.5-1.9z"></path>
                            <path d="M12 12v6"></path>
                            <path d="M12 2v4"></path>
                        </svg>
                        <span class="font-semibold text-gray-900">SmartWatch FeelSafe</span>
                    </div>
                    
                    <div class="smartwatch-status">
                        <span class="text-sm" :class="simulationRunning ? 'text-green-600' : 'text-gray-500'" x-text="watchStatus"></span>
                    </div>
                    
                    <div class="smartwatch-location">
                        <span class="text-xs text-gray-500" x-text="locationText"></span>
                        <button @click="selectLocation()" class="location-btn">
                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <span>Localisation</span>
                        </button>
                    </div>
                    
                    <!-- Heart Rate -->
                    <div class="metric-row">
                        <div class="metric-icon">❤️</div>
                        <input type="range" x-model="heartRate" min="40" max="180" class="metric-slider" @input="updateWatchStyle()">
                        <div class="metric-value" x-text="heartRate + ' bpm'" :class="getHeartRateClass()"></div>
                    </div>
                    
                    <!-- SpO2 -->
                    <div class="metric-row">
                        <div class="metric-icon">🫁</div>
                        <input type="range" x-model="spo2" min="70" max="100" class="metric-slider" @input="updateWatchStyle()">
                        <div class="metric-value" x-text="spo2 + '%'" :class="getSpO2Class()"></div>
                    </div>
                    
<!-- Blood Pressure - Sys and Dia on same line (labels left of sliders) -->
<div class="metric-row">
    <div class="metric-icon">💉</div>
    <div style="flex: 1; display: flex; gap: 8px; margin: 0 12px; align-items: center;">
        <div style="display: flex; align-items: center; gap: 4px; flex: 1;">
            <span style="font-size: 9px; color: #666; width: 25px;">Sys</span>
            <input type="range" x-model="bpSys" min="60" max="220" style="flex: 1; height: 4px;" @input="updateWatchStyle()">
        </div>
        <div style="display: flex; align-items: center; gap: 4px; flex: 1;">
            <span style="font-size: 9px; color: #666; width: 25px;">Dia</span>
            <input type="range" x-model="bpDia" min="40" max="140" style="flex: 1; height: 4px;" @input="updateWatchStyle()">
        </div>
    </div>
    <div class="metric-value" x-text="bpSys + '/' + bpDia + ' mmHg'" :class="getBloodPressureClass()"></div>
</div>
                    
                    <!-- Temperature -->
                    <div class="metric-row">
                        <div class="metric-icon">🌡️</div>
                        <input type="range" x-model="temperature" min="34" max="42" step="0.1" class="metric-slider" @input="updateWatchStyle()">
                        <div class="metric-value" x-text="temperature + '°C'" :class="getTemperatureClass()"></div>
                    </div>
                    
                    <!-- Controls -->
                    <div class="flex justify-center gap-4 mt-4">
                        <button @click="startSimulation()" :disabled="simulationRunning" class="start-btn">Démarrer</button>
                        <button @click="stopSimulation()" :disabled="!simulationRunning" class="stop-btn">Arrêter</button>
                    </div>
                </div>
                
                <!-- Crisis Chart -->
                <div class="chart-container">
                    <div class="flex items-center gap-2 mb-3">
                        <svg class="w-4 h-4 text-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                        <span class="text-sm font-semibold text-gray-900">Évolution des Crises (30 jours)</span>
                    </div>
                    <canvas id="crisisChart" width="400" height="160"></canvas>
                </div>
                
                <!-- Stats Cards Row -->
                <div class="stats-row">
                    <div @click="openHistory()" class="stat-card history-card">
                        <div class="stat-value" x-text="totalCrises">0</div>
                        <div class="stat-label">Historique</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #ff9800;" x-text="streak">0</div>
                        <div class="stat-label">Sans crise</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #1565c0;" x-text="totalCrises">0</div>
                        <div class="stat-label">Total crises</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value" style="color: #c62828;" x-text="avgSeverity">0</div>
                        <div class="stat-label">Gravité moyenne</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function emergencyDashboard() {
    return {
        // Chat
        messages: [],
        messageInput: '',
        isTyping: false,
        aiStatus: '✅ Prêt',
        
        // Stats
        totalCrises: 0,
        streak: 0,
        avgSeverity: 0,
        crisisData: [],
        chart: null,
        
        // SmartWatch
        simulationRunning: false,
        watchStatus: '⏸ Simulation arrêtée',
        watchCritical: false,
        heartRate: 75,
        spo2: 98,
        bpSys: 120,
        bpDia: 80,
        temperature: 36.5,
        locationText: '📍 Aucune localisation',
        simulationInterval: null,
        
        // Debounce tracking (to prevent spam)
        lastUrgenceTime: {
            heart: null,
            spo2: null,
            bp: null,
            temp: null
        },
        
        // Resize properties
        resizeStartX: 0,
        startLeftWidth: 0,
        
        init() {
            this.loadChatHistory();
            this.loadStats();
            // Watch for value changes to update colors (matching Java)
            this.$watch('heartRate', () => this.updateWatchStyle());
            this.$watch('spo2', () => this.updateWatchStyle());
            this.$watch('bpSys', () => this.updateWatchStyle());
            this.$watch('bpDia', () => this.updateWatchStyle());
            this.$watch('temperature', () => this.updateWatchStyle());
            
            this.$nextTick(() => {
                const container = this.$refs.mainContainer;
                if (container) {
                    const totalWidth = container.clientWidth;
                    const leftWidth = totalWidth * 0.6;
                    this.$refs.leftPanel.style.width = leftWidth + 'px';
                    this.$refs.leftPanel.style.flex = 'none';
                    this.$refs.rightPanel.style.width = (totalWidth - leftWidth - 8) + 'px';
                }
            });
            
            setInterval(() => this.loadStats(), 30000);
        },
        
        startResize(e) {
            this.resizeStartX = e.clientX;
            this.startLeftWidth = this.$refs.leftPanel.offsetWidth;
            
            document.body.classList.add('resizing');
            document.addEventListener('mousemove', this.onResize);
            document.addEventListener('mouseup', this.stopResize);
            e.preventDefault();
        },
        
        onResize(e) {
            if (!this.resizeStartX) return;
            
            const delta = e.clientX - this.resizeStartX;
            const container = this.$refs.mainContainer;
            const containerWidth = container.offsetWidth;
            const minLeftWidth = 300;
            const maxLeftWidth = containerWidth - 350;
            
            let newLeftWidth = this.startLeftWidth + delta;
            if (newLeftWidth < minLeftWidth) newLeftWidth = minLeftWidth;
            if (newLeftWidth > maxLeftWidth) newLeftWidth = maxLeftWidth;
            
            this.$refs.leftPanel.style.width = newLeftWidth + 'px';
            this.$refs.leftPanel.style.flex = 'none';
            this.$refs.rightPanel.style.width = (containerWidth - newLeftWidth - 8) + 'px';
        },
        
        stopResize() {
            document.body.classList.remove('resizing');
            document.removeEventListener('mousemove', this.onResize);
            document.removeEventListener('mouseup', this.stopResize);
            this.resizeStartX = 0;
        },
        
        async loadChatHistory() {
            try {
                const res = await fetch('/chat/history');
                const data = await res.json();
                this.messages = data.success && data.history.length ? data.history : [{
                    sender: 'bot',
                    text: 'Bonjour! Je suis votre assistant FeelSafe. Comment vous sentez-vous aujourd\'hui ? Parlez-moi de ce qui vous préoccupe, je suis là pour vous écouter 💚',
                    time: new Date().toLocaleTimeString()
                }];
                this.scrollToBottom();
            } catch(e) { console.error(e); }
        },
        
        async sendMessage() {
            if (!this.messageInput.trim() || this.isTyping) return;
            const userMessage = this.messageInput;
            this.messages.push({ sender: 'user', text: userMessage, time: new Date().toLocaleTimeString() });
            this.messageInput = '';
            this.scrollToBottom();
            this.isTyping = true;
            this.aiStatus = '🤖 Assistant réfléchit...';
            
            try {
                const res = await fetch('/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: userMessage })
                });
                const data = await res.json();
                if (data.success) {
                    setTimeout(() => {
                        this.messages.push({ sender: 'bot', text: data.message, time: data.timestamp || new Date().toLocaleTimeString() });
                        this.isTyping = false;
                        this.aiStatus = '✅ Assistant IA prêt';
                        this.scrollToBottom();
                        this.loadStats();
                    }, 500);
                } else throw new Error();
            } catch(e) {
                this.messages.push({ sender: 'bot', text: "Je rencontre des difficultés techniques. Si vous avez besoin d'aide immédiate, appelez le 15 ou le 112.", time: new Date().toLocaleTimeString() });
                this.isTyping = false;
                this.aiStatus = '⚠️ Erreur de connexion';
                this.scrollToBottom();
            }
        },
        
        async clearChat() {
            if (!confirm('Effacer la conversation ?')) return;
            await fetch('/chat/clear', { method: 'POST' });
            this.messages = [{ sender: 'bot', text: 'Conversation effacée. Comment puis-je vous aider ?', time: new Date().toLocaleTimeString() }];
        },
        
        async loadStats() {
            try {
                const res = await fetch('/api/emergency/stats');
                const data = await res.json();
                if (data.success) {
                    this.totalCrises = data.total;
                    this.streak = data.streak;
                    this.avgSeverity = data.avgSeverity;
                    this.crisisData = data.chartData;
                    this.drawChart();
                }
            } catch(e) { console.error(e); }
        },
        
        drawChart() {
            const canvas = document.getElementById('crisisChart');
            if (!canvas) return;
            if (this.chart) this.chart.destroy();
            const ctx = canvas.getContext('2d');
            const labels = this.crisisData.map(d => d.day);
            const values = this.crisisData.map(d => d.gravity);
            this.chart = new Chart(ctx, {
                type: 'line',
                data: { labels, datasets: [{ label: 'Niveau de gravité', data: values, borderColor: '#2e7d32', backgroundColor: 'rgba(46,125,50,0.1)', fill: true, tension: 0.3, pointBackgroundColor: values.map(v => v > 0 ? '#2e7d32' : 'transparent'), pointRadius: values.map(v => v > 0 ? 4 : 0) }] },
                options: { responsive: true, maintainAspectRatio: true, scales: { y: { beginAtZero: true, max: 5, title: { display: true, text: 'Gravité' } }, x: { title: { display: true, text: 'Jour du mois' } } }, plugins: { legend: { display: false } } }
            });
        },
        
        scrollToBottom() {
            this.$nextTick(() => { const el = this.$refs.chatMessages; if (el) el.scrollTop = el.scrollHeight; });
        },
        
        // ===================== SMARTWATCH SIMULATION =====================

        // Check if any value is critical (for container styling)
        isAnyValueCritical() {
            const hr = parseFloat(this.heartRate);
            const sp = parseFloat(this.spo2);
            const sys = parseFloat(this.bpSys);
            const temp = parseFloat(this.temperature);
            
            return hr < 40 || hr > 120 || sp < 90 || sys < 90 || sys > 180 || temp < 35.0 || temp > 39.5;
        },

        // Update container style based on current values (matching Java's updateStatusColor)
        updateWatchStyle() {
            if (this.simulationRunning) return;
            
            const container = document.querySelector('.smartwatch-container');
            if (!container) return;
            
            if (this.isAnyValueCritical()) {
                container.style.backgroundColor = '#fff3e0';
                container.style.borderColor = '#ff9800';
                container.style.borderWidth = '2px';
            } else {
                container.style.backgroundColor = '#f5f5f5';
                container.style.borderColor = '#e0e0e0';
                container.style.borderWidth = '1px';
            }
        },

        // Individual metric color classes (matching Java's per-value styling)
        getHeartRateClass() {
            const hr = parseFloat(this.heartRate);
            if (hr < 40 || hr > 120) return 'metric-critical';
            if (hr < 50 || hr > 110) return 'metric-warning';
            return 'metric-normal';
        },

        getSpO2Class() {
            const sp = parseFloat(this.spo2);
            if (sp < 90) return 'metric-critical';
            if (sp < 94) return 'metric-warning';
            return 'metric-normal';
        },

        getBloodPressureClass() {
            const sys = parseFloat(this.bpSys);
            if (sys < 90 || sys > 180) return 'metric-critical';
            if (sys < 100 || sys > 160) return 'metric-warning';
            return 'metric-normal';
        },

        getTemperatureClass() {
            const temp = parseFloat(this.temperature);
            if (temp < 35 || temp > 39.5) return 'metric-critical';
            if (temp < 36 || temp > 38.5) return 'metric-warning';
            return 'metric-normal';
        },
        
        startSimulation() {
            if (this.simulationRunning) return;
            this.simulationRunning = true;
            this.watchStatus = '🟢 Surveillance active';
            this.updateWatchContainerStyle();
            this.simulationInterval = setInterval(() => {
                this.checkThresholds();
            }, 2000);
        },
        
        stopSimulation() {
            if (this.simulationInterval) {
                clearInterval(this.simulationInterval);
                this.simulationInterval = null;
            }
            this.simulationRunning = false;
            this.watchStatus = '⏸ Simulation arrêtée';
            this.watchCritical = false;
            this.updateWatchContainerStyle();
        },
        
        updateWatchContainerStyle() {
            const container = document.querySelector('.smartwatch-container');
            if (container) {
                if (this.watchCritical) {
                    container.style.backgroundColor = '#ffebee';
                    container.style.borderColor = '#c62828';
                    container.style.borderWidth = '2px';
                } else if (this.simulationRunning) {
                    container.style.backgroundColor = '#e8f5e9';
                    container.style.borderColor = '#2e7d32';
                    container.style.borderWidth = '2px';
                } else {
                    container.style.backgroundColor = '#f5f5f5';
                    container.style.borderColor = '#e0e0e0';
                    container.style.borderWidth = '1px';
                }
            }
        },
        
        canCreateUrgence(metricKey) {
            const lastTime = this.lastUrgenceTime[metricKey];
            if (!lastTime) return true;
            const minutesSince = (Date.now() - lastTime) / (1000 * 60);
            return minutesSince >= 25;
        },
        
        async createUrgenceIfAllowed(metricKey, metricName, value) {
            if (!this.canCreateUrgence(metricKey)) return;
            
            const heartRate = parseFloat(this.heartRate);
            const spo2 = parseFloat(this.spo2);
            const bpSys = parseFloat(this.bpSys);
            const bpDia = parseFloat(this.bpDia);
            const temperature = parseFloat(this.temperature);
            
            const description = `Alerte smartwatch: ${metricName} à ${value}
Valeurs complètes: FC=${heartRate}bpm, SpO2=${spo2}%, PA=${bpSys}/${bpDia}mmHg, T°=${temperature.toFixed(1)}°C
Localisation: ${this.locationText.replace('📍 ', '')}`;
            
            try {
                const response = await fetch('/api/emergency/health-alert', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        type: `Urgence ${metricName}`,
                        description: description,
                        gravity: 5
                    })
                });
                
                if (response.ok) {
                    this.lastUrgenceTime[metricKey] = Date.now();
                    this.loadStats();
                }
            } catch(e) {
                console.error('Error creating urgency:', e);
            }
        },
        
        async checkThresholds() {
            let anyCritical = false;
            const alerts = [];
            
            const heartRate = parseFloat(this.heartRate);
            const spo2 = parseFloat(this.spo2);
            const bpSys = parseFloat(this.bpSys);
            const bpDia = parseFloat(this.bpDia);
            const temperature = parseFloat(this.temperature);
            
            if (heartRate < 40) {
                anyCritical = true;
                alerts.push('🚨 FC critique');
                await this.createUrgenceIfAllowed('heart', 'Fréquence cardiaque', heartRate + ' bpm (trop basse)');
            } else if (heartRate > 120) {
                anyCritical = true;
                alerts.push('🚨 FC critique');
                await this.createUrgenceIfAllowed('heart', 'Fréquence cardiaque', heartRate + ' bpm (trop élevée)');
            }
            
            if (spo2 < 90) {
                anyCritical = true;
                alerts.push('🚨 SpO2 critique');
                await this.createUrgenceIfAllowed('spo2', 'Saturation en oxygène', spo2 + '% (critique)');
            }
            
            if (bpSys < 90) {
                anyCritical = true;
                alerts.push('🚨 PA critique');
                await this.createUrgenceIfAllowed('bp', 'Pression artérielle', bpSys + '/' + bpDia + ' mmHg (trop basse)');
            } else if (bpSys > 180) {
                anyCritical = true;
                alerts.push('🚨 PA critique');
                await this.createUrgenceIfAllowed('bp', 'Pression artérielle', bpSys + '/' + bpDia + ' mmHg (trop élevée)');
            }
            
            if (temperature < 35.0) {
                anyCritical = true;
                alerts.push('🚨 Temp critique');
                await this.createUrgenceIfAllowed('temp', 'Température corporelle', temperature.toFixed(1) + '°C (hypothermie)');
            } else if (temperature > 39.5) {
                anyCritical = true;
                alerts.push('🚨 Temp critique');
                await this.createUrgenceIfAllowed('temp', 'Température corporelle', temperature.toFixed(1) + '°C (fièvre critique)');
            }
            
            this.watchCritical = anyCritical;
            
            if (anyCritical) {
                this.watchStatus = alerts.join(' | ');
            } else if (this.simulationRunning) {
                this.watchStatus = '✅ Tous les paramètres sont normaux';
            }
            
            this.updateWatchContainerStyle();
        },
        
        selectLocation() {
            const loc = prompt('Entrez votre localisation (ex: Tunis, Sfax, Sousse...):', 'Tunis');
            if (loc && loc.trim()) {
                this.locationText = '📍 ' + loc.trim();
            }
        },
        
        startEmergencyCall() { 
            window.open('https://meet.jit.si/FeelSafe-Urgence', '_blank'); 
        },
        
        openHistory() { 
            window.location.href = '{{ path('emergency_history') }}'; 
        }
    };
}
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}