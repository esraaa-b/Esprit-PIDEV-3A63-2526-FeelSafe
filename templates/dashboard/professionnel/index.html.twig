{# templates/dashboard/professionnel/index.html.twig #}
{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto space-y-6">
    
    {# HEADER PROFESSIONNEL - COMPACT ET INFORMATIF #}
    <div class="bg-card rounded-xl border border-border p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-lg bg-primary/10 flex items-center justify-center">
                    <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-foreground">
                        {{ greeting }}, Dr. {{ userName }}
                    </h1>
                    <p class="text-sm text-muted-foreground">
                        Espace professionnel • {{ "now"|date("l d F Y")|capitalize }}
                    </p>
                </div>
            </div>
            <div class="hidden md:flex items-center gap-3">
                <a href="/pro/dashboard/urgences" class="px-4 py-2 bg-destructive/10 text-destructive rounded-lg text-sm font-medium hover:bg-destructive/20 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                    2 Alertes
                </a>
                <a href="/pro/dashboard/messages" class="px-4 py-2 bg-chart-2/10 text-chart-2 rounded-lg text-sm font-medium hover:bg-chart-2/20 transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    8 Messages
                </a>
            </div>
        </div>
    </div>

    {# STATISTIQUES - LAYOUT EN GRILLE COMPACTE #}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {% for stat in stats %}
            <div class="bg-card rounded-xl border border-border p-5 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg {{ stat.color }} flex items-center justify-center">
                        {% if stat.icon == 'users' %}
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        {% elseif stat.icon == 'calendar' %}
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        {% elseif stat.icon == 'mail' %}
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        {% elseif stat.icon == 'heart' %}
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        {% endif %}
                    </div>
                </div>
                <p class="text-3xl font-bold text-foreground mb-1">{{ stat.value }}</p>
                <p class="text-sm text-muted-foreground">{{ stat.label }}</p>
            </div>
        {% endfor %}
    </div>

    {# LAYOUT 2 COLONNES - AGENDA + ACTIVITÉ #}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        {# AGENDA DU JOUR - 2/3 de largeur #}
        <div class="lg:col-span-2 bg-card rounded-xl border border-border p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
                    <div class="w-1 h-6 bg-chart-4 rounded-full"></div>
                    Agenda du jour
                </h2>
                <span class="px-3 py-1 bg-chart-4/10 text-chart-4 rounded-full text-sm font-medium">
                    {{ todayAppointments|length }} rendez-vous
                </span>
            </div>
            
            <div class="space-y-3">
                {% for appointment in todayAppointments %}
                    <div class="flex items-center gap-4 p-4 rounded-lg border border-border hover:bg-secondary/30 transition-colors group">
                        {# Heure #}
                        <div class="flex-shrink-0 text-center">
                            <div class="w-16 h-16 rounded-lg bg-chart-4/10 flex flex-col items-center justify-center">
                                <span class="text-lg font-bold text-foreground">{{ appointment.time|slice(0, 2) }}</span>
                                <span class="text-xs text-muted-foreground">{{ appointment.time|slice(3, 5) }}</span>
                            </div>
                        </div>
                        
                        {# Info patient #}
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <p class="font-semibold text-foreground">{{ appointment.patient }}</p>
                                {% if appointment.status == 'urgent' %}
                                    <span class="px-2 py-0.5 bg-destructive/10 text-destructive rounded text-xs font-medium flex items-center gap-1">
                                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        </svg>
                                        URGENT
                                    </span>
                                {% endif %}
                            </div>
                            <p class="text-sm text-muted-foreground">{{ appointment.type }}</p>
                        </div>
                        
                        {# Status #}
                        <div class="flex-shrink-0">
                            {% if appointment.status == 'confirmed' %}
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Confirmé
                                </span>
                            {% elseif appointment.status == 'pending' %}
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-chart-2/10 text-chart-2 border border-chart-2/20">
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    En attente
                                </span>
                            {% elseif appointment.status == 'urgent' %}
                                <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium bg-destructive/10 text-destructive border border-destructive/20">
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    Urgent
                                </span>
                            {% endif %}
                        </div>
                        
                        {# Actions #}
                        <button class="flex-shrink-0 w-8 h-8 rounded-lg hover:bg-secondary flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="1"></circle>
                                <circle cx="12" cy="5" r="1"></circle>
                                <circle cx="12" cy="19" r="1"></circle>
                            </svg>
                        </button>
                    </div>
                {% endfor %}
            </div>
            
            <div class="mt-4 pt-4 border-t border-border">
                <a href="/pro/dashboard/agenda" class="text-sm text-primary hover:underline font-medium flex items-center gap-1">
                    Voir l'agenda complet
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        {# ACTIVITÉ RÉCENTE - 1/3 largeur #}
        <div class="bg-card rounded-xl border border-border p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
                    <div class="w-1 h-6 bg-primary rounded-full"></div>
                    Activité
                </h2>
            </div>
            
            <div class="space-y-4">
                {% for activity in recentActivity %}
                    <div class="flex items-start gap-3 pb-4 border-b border-border last:border-0 last:pb-0">
                        <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center
                            {% if activity.mood == 'happy' %}bg-primary/10{% elseif activity.mood == 'sad' %}bg-destructive/10{% else %}bg-chart-2/10{% endif %}">
                            {% if activity.mood == 'happy' %}
                                <span class="text-lg">😊</span>
                            {% elseif activity.mood == 'sad' %}
                                <span class="text-lg">😢</span>
                            {% else %}
                                <span class="text-lg">😐</span>
                            {% endif %}
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-foreground truncate">{{ activity.patient }}</p>
                            <p class="text-xs text-muted-foreground mt-0.5">{{ activity.action }}</p>
                            <p class="text-xs text-muted-foreground/70 mt-1 flex items-center gap-1">
                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                {{ activity.time }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
            
            <div class="mt-4 pt-4 border-t border-border">
                <a href="/pro/dashboard/activity" class="text-sm text-primary hover:underline font-medium flex items-center gap-1">
                    Toute l'activité
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>

    {# MODULES - GRILLE COMPACTE 6 COLONNES #}
    <div>
        <h2 class="text-xl font-bold text-foreground mb-4 flex items-center gap-2">
            <div class="w-1 h-7 bg-primary rounded-full"></div>
            Outils professionnels
        </h2>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            {% for module in modules %}
                <a href="{{ module.href }}" class="group block">
                    <div class="bg-card rounded-xl border border-border p-4 hover:border-primary hover:shadow-lg transition-all text-center h-full">
                        <div class="w-12 h-12 rounded-lg {{ module.color }} flex items-center justify-center mx-auto mb-3">
                            {% if module.icon == 'users' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            {% elseif module.icon == 'calendar' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            {% elseif module.icon == 'mail' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            {% elseif module.icon == 'book' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                                    <path d="M8 11h8"></path>
                                    <path d="M8 6h8"></path>
                                </svg>
                            {% elseif module.icon == 'alert' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            {% elseif module.icon == 'shield' %}
                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            {% endif %}
                        </div>
                        <h3 class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
                            {{ module.name }}
                        </h3>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    {# SECTION ALERTES - DESIGN SOBRE #}
    <div class="bg-destructive/5 border-l-4 border-destructive rounded-xl p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-destructive/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-foreground">Alertes urgentes</h3>
                    <p class="text-sm text-muted-foreground">2 patients nécessitent une attention immédiate</p>
                </div>
            </div>
            <div class="flex gap-3">
                <a href="/pro/dashboard/urgences" class="px-6 py-2.5 bg-destructive text-white rounded-lg font-medium hover:bg-destructive/90 transition-colors">
                    Consulter
                </a>
            </div>
        </div>
    </div>

</div>
{% endblock %}
