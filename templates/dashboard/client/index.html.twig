{# templates/dashboard/client/index.html.twig #}
{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto space-y-6">
    
    {# HEADER AVEC GRANDE IMAGE DE FOND #}
    <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-primary/20 via-chart-2/20 to-chart-4/20 p-8 md:p-12">
        <div class="relative z-10">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-16 h-16 rounded-full bg-primary/10 backdrop-blur-sm flex items-center justify-center border-2 border-primary/30">
                    <span class="text-3xl">👋</span>
                </div>
                <div>
                    <h1 class="text-4xl font-bold text-foreground mb-1">
                        {{ greeting }}, {{ userName }}
                    </h1>
                    <p class="text-muted-foreground text-lg">
                        Prenez soin de vous aujourd'hui
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-sm text-muted-foreground mt-4">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                </svg>
                <span>{{ "now"|date("l d F Y")|capitalize }}</span>
            </div>
        </div>
    </div>

    {# MOOD TRACKER - GRANDE SECTION CENTRALE #}
    <div class="bg-gradient-to-br from-white to-primary/5 dark:from-card dark:to-primary/5 rounded-2xl border-2 border-primary/20 p-8 shadow-xl">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-foreground mb-2">💭 Comment vous sentez-vous ?</h2>
            <p class="text-muted-foreground">Partagez votre ressenti avec nous</p>
        </div>
        
        <div x-data="{ selectedMood: null }" class="flex flex-wrap justify-center gap-4">
            {% for mood in moodOptions %}
                <button type="button"
                        @click="selectedMood = '{{ mood.id }}'"
                        :class="selectedMood === '{{ mood.id }}' 
                                ? '{{ mood.color }} text-white border-transparent shadow-2xl scale-110' 
                                : 'bg-white dark:bg-card border-border hover:border-primary/50 text-foreground hover:shadow-lg'"
                        class="flex flex-col items-center gap-3 px-8 py-6 rounded-2xl border-2 transition-all duration-300 min-w-[120px]">
                    <span class="text-4xl">{{ mood.icon }}</span>
                    <span class="font-semibold text-sm">{{ mood.label }}</span>
                </button>
            {% endfor %}
        </div>
    </div>

    {# STATISTIQUES EN CERCLE - DESIGN UNIQUE #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {# Wellness Score - CERCLE PROGRESSIF #}
        <div class="bg-white dark:bg-card rounded-2xl border border-border p-6 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="relative inline-flex items-center justify-center mb-4">
                <svg class="w-32 h-32 transform -rotate-90">
                    <circle cx="64" cy="64" r="56" stroke="currentColor" stroke-width="8" fill="none" class="text-secondary" />
                    <circle cx="64" cy="64" r="56" stroke="currentColor" stroke-width="8" fill="none" class="text-primary" 
                            stroke-dasharray="351.68" stroke-dashoffset="98.87" stroke-linecap="round"/>
                </svg>
                <div class="absolute">
                    <p class="text-4xl font-bold text-primary">72%</p>
                </div>
            </div>
            <h3 class="font-semibold text-foreground text-lg">Score Bien-être</h3>
            <p class="text-sm text-muted-foreground mt-1">En amélioration 📈</p>
        </div>

        {# Journal - DESIGN CARTE #}
        <div class="bg-gradient-to-br from-chart-2/10 to-chart-2/5 rounded-2xl border border-chart-2/30 p-6 shadow-lg hover:shadow-xl transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-14 h-14 rounded-full bg-chart-2/20 flex items-center justify-center">
                    <svg class="w-7 h-7 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                        <path d="M8 11h8"></path>
                        <path d="M8 6h8"></path>
                    </svg>
                </div>
                <span class="text-4xl font-bold text-chart-2">12</span>
            </div>
            <h3 class="font-semibold text-foreground text-lg mb-2">Journal</h3>
            <div class="flex gap-1 mt-3">
                {% for day in moodHistory %}
                    <div class="flex-1 flex flex-col items-center gap-1 p-1 rounded-lg hover:bg-white/50 transition-colors">
                        {% if day.mood == 'happy' %}
                            <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center">
                                <span class="text-xs">😊</span>
                            </div>
                        {% elseif day.mood == 'sad' %}
                            <div class="w-6 h-6 rounded-full bg-destructive/20 flex items-center justify-center">
                                <span class="text-xs">😢</span>
                            </div>
                        {% else %}
                            <div class="w-6 h-6 rounded-full bg-chart-2/20 flex items-center justify-center">
                                <span class="text-xs">😐</span>
                            </div>
                        {% endif %}
                        <span class="text-xs text-muted-foreground font-medium">{{ day.day }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# RDV - DESIGN MINIMAL #}
        <div class="bg-gradient-to-br from-chart-4/10 to-chart-4/5 rounded-2xl border border-chart-4/30 p-6 shadow-lg hover:shadow-xl transition-shadow">
            <div class="flex items-center justify-between mb-4">
                <div class="w-14 h-14 rounded-full bg-chart-4/20 flex items-center justify-center">
                    <svg class="w-7 h-7 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <span class="text-4xl font-bold text-chart-4">2</span>
            </div>
            <h3 class="font-semibold text-foreground text-lg mb-2">Rendez-vous</h3>
            <div class="bg-white/50 dark:bg-card/50 rounded-lg p-3 mt-3">
                <p class="text-sm font-medium text-foreground">Dr. Martin</p>
                <p class="text-xs text-muted-foreground flex items-center gap-1 mt-1">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Demain à 14h00
                </p>
            </div>
        </div>
    </div>

    {# MODULES - DISPOSITION EN MOSAIQUE #}
    <div>
        <h2 class="text-2xl font-bold text-foreground mb-6 flex items-center gap-2">
            <span class="w-2 h-8 bg-primary rounded-full"></span>
            Vos espaces de bien-être
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for module in modules %}
                <a href="{{ module.href }}" class="group block">
                    <div class="bg-white dark:bg-card rounded-2xl border-2 border-border overflow-hidden h-full hover:border-primary hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
                        {# Image plus grande #}
                        <div class="relative h-52 overflow-hidden">
                            <img 
                                src="{{ module.image }}" 
                                alt="{{ module.name }}"
                                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                            
                            {# Icon en bas à gauche sur l'image #}
                            <div class="absolute bottom-4 left-4 w-14 h-14 rounded-2xl {{ module.color }} backdrop-blur-md flex items-center justify-center shadow-lg border-2 border-white/30">
                                {% if module.icon == 'shield' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                {% elseif module.icon == 'book' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                                        <path d="M8 11h8"></path>
                                        <path d="M8 6h8"></path>
                                    </svg>
                                {% elseif module.icon == 'heart' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                {% elseif module.icon == 'sun' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="5"></circle>
                                        <line x1="12" y1="1" x2="12" y2="3"></line>
                                        <line x1="12" y1="21" x2="12" y2="23"></line>
                                    </svg>
                                {% elseif module.icon == 'alert' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                {% elseif module.icon == 'users' %}
                                    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                {% endif %}
                            </div>
                            
                            {# Titre sur l'image #}
                            <div class="absolute bottom-4 right-4">
                                <h3 class="font-bold text-white text-xl drop-shadow-lg">
                                    {{ module.name }}
                                </h3>
                            </div>
                        </div>
                        
                        {# Description en bas #}
                        <div class="p-5">
                            <p class="text-sm text-muted-foreground mb-3">{{ module.description }}</p>
                            <div class="flex items-center gap-2 text-primary font-medium group-hover:gap-4 transition-all">
                                <span class="text-sm">Explorer</span>
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    {# SECTION AIDE - DESIGN CALL TO ACTION #}
    <div class="relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/90 to-chart-4 opacity-95"></div>
        <div class="relative z-10 p-10 text-center">
            <div class="max-w-2xl mx-auto">
                <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <h3 class="text-3xl font-bold text-white mb-3">Besoin de parler ?</h3>
                <p class="text-white/90 text-lg mb-6">
                    Notre équipe bienveillante est là pour vous, 24h/24 et 7j/7
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="/dashboard/emergency" class="px-8 py-4 bg-white text-primary rounded-xl font-bold hover:bg-white/90 transition-all shadow-xl hover:shadow-2xl hover:scale-105">
                        Demander de l'aide maintenant
                    </a>
                    <a href="/dashboard/support" class="px-8 py-4 border-2 border-white text-white rounded-xl font-bold hover:bg-white/10 transition-all">
                        Prendre rendez-vous
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
