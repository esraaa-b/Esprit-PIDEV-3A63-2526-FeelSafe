{% extends 'base.html.twig' %}

{% block title %}Conversation historique{% endblock %}

{% block body %}
<div class="container mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Historique de la conversation</h1>
    <div class="bg-white shadow rounded p-4">
        <div class="space-y-4">
            {% for msg in messages %}
                <div class="py-2">
                    <div class="text-sm text-gray-500">{{ msg.getCreatedAt().format('d/m/Y H:i') }} • {{ msg.getRole() }}</div>
                    <div class="mt-1 text-base">{{ msg.getContent()|e }}</div>
                </div>
                <hr />
            {% else %}
                <div>Aucun message pour cette conversation.</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
