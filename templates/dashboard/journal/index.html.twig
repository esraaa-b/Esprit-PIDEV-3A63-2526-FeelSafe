                    </div>
                    
                    <!-- SECTION AUDIO -->
                    <div class="mb-6 border-b border-border pb-6">
                        <h3 class="text-md font-medium text-foreground mb-3">Audio</h3>
                        
                        <template x-if="editAudioUrl && editAudioUrl !== '' && removeAudioFlag === '0'">
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-foreground mb-2">Audio actuel</label>
                                <div class="flex items-center gap-2 p-3 bg-secondary/10 rounded-lg">
                                    <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 1v11m0 0a3 3 0 0 0 3-3V4a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3z"></path>
                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                    </svg>
                                    <audio controls class="flex-1 h-10">
                                        <source :src="editAudioUrl">
                                    </audio>
                                    <button type="button"
                                            @click="removeAudioFlag = '1'; editAudioUrl = null;"
                                            class="text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition-colors">
                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </template>
                        
                        <template x-if="removeAudioFlag === '1'">
                            <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg text-amber-700 text-sm flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                                <span>L'audio actuel sera supprimé</span>
                                <button type="button" 
                                        @click="removeAudioFlag = '0'; editAudioUrl = originalAudioUrl"
                                        class="ml-auto text-xs bg-white px-2 py-1 rounded border border-amber-300 hover:bg-amber-100">
                                    Annuler
                                </button>
                            </div>
                        </template>
                        
                        <div>
                            <label class="inline-flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-input hover:bg-secondary cursor-pointer transition-colors">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <span x-text="editAudioUrl && removeAudioFlag === '0' ? 'Remplacer l\'audio' : 'Ajouter un audio'"></span>
                                <input type="file" 
                                       name="audio" 
                                       class="hidden" 
                                       accept="audio/*" 
                                       @change="onEditAudioUpload">
                            </label>
                        </div>
                    </div>
                    
                    <div class="flex justify-end gap-3 pt-4">
                        <button type="button" 
                                @click="closeEditModal()" 
                                class="px-4 py-2 rounded-lg border border-input hover:bg-secondary transition-colors">
                            Annuler
                        </button>
                        <button type="submit"
                                class="px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">
                            Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Chart Modal -->
    <div x-show="chartModalOpen" 
         x-cloak 
         class="fixed inset-0 z-[150] flex items-center justify-center p-4"
         style="background-color: rgba(0,0,0,0.5);"
         @keydown.escape.window="closeChartModal()"
         @click="closeChartModal()">
        
        <div class="relative bg-card rounded-lg border border-border w-full max-w-5xl max-h-[90vh] flex flex-col shadow-2xl"
             @click.stop>
            
            <div class="flex items-center justify-between p-6 border-b border-border shrink-0">
                <div>
                    <h2 class="text-xl font-serif font-bold text-foreground">Tendances émotionnelles</h2>
                    <p class="text-sm text-muted-foreground mt-1">Analyse de vos humeurs sur les 30 derniers jours</p>
                </div>
                <button @click="closeChartModal()" class="p-2 hover:bg-secondary rounded-lg">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto flex-1">
                <div class="h-96 w-full">
                    <canvas id="emotionChartModal"></canvas>
                </div>
                
                <div class="flex flex-wrap gap-4 justify-center mt-6">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: #16a34a;"></span>
                        <span class="text-sm">😊 Très bien</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: #86efac;"></span>
                        <span class="text-sm">🙂 Bien</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: #eab308;"></span>
                        <span class="text-sm">😐 Neutre</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: #fecaca;"></span>
                        <span class="text-sm">😕 Pas bien</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full" style="background-color: #dc2626;"></span>
                        <span class="text-sm">😢 Très mal</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div> <!-- FIN du div x-data -->

<script>
function journalApp() {
    return {
        newJournalOpen: false,
        selectedMood: null,
        newEntry: '',
        isRecording: false,
        mediaRecorder: null,
        audioChunks: [],
        audioBlob: null,
        audioUrl: null,
        audioFile: null,
        imageFile: null,
        imagePreview: null,
        
        editModalOpen: false,
        editId: null,
        editEmotion: null,
        editContenu: '',
        editCsrf: '',
        editImageUrl: null,
        editAudioUrl: null,
        removeImageFlag: '0',
        removeAudioFlag: '0',
        originalImageUrl: null,
        originalAudioUrl: null,
        
        activeMood: 'all',
        
        flashMessage: {
            show: false,
            text: '',
            type: 'success',
            timeout: null
        },
        
        chartModalOpen: false,
        chart: null,
        chartModal: null,
        
        init() {
            console.log('Alpine component initialized');
        },
        
        showFlashMessage(message) {
            if (this.flashMessage.timeout) clearTimeout(this.flashMessage.timeout);
            this.flashMessage.show = true;
            this.flashMessage.text = message.text;
            this.flashMessage.type = message.type;
            this.flashMessage.timeout = setTimeout(() => this.clearFlashMessage(), 3000);
        },
        
        clearFlashMessage() {
            this.flashMessage.show = false;
            this.flashMessage.text = '';
            if (this.flashMessage.timeout) {
                clearTimeout(this.flashMessage.timeout);
                this.flashMessage.timeout = null;
            }
        },
        
        openChartModal() {
            this.chartModalOpen = true;
            this.$nextTick(() => this.initChartModal());
        },
        
        closeChartModal() {
            this.chartModalOpen = false;
            if (this.chartModal) {
                this.chartModal.destroy();
                this.chartModal = null;
            }
        },
        
        initChartModal() {
            if (typeof Chart !== 'undefined') {
                const ctx = document.getElementById('emotionChartModal');
                if (ctx) {
                    if (this.chartModal) this.chartModal.destroy();
                    this.chartModal = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: {{ chartLabels|json_encode|raw }},
                            datasets: [
                                {
                                    label: '😊 Très bien',
                                    data: {{ chartData['tres_bien']|json_encode|raw }},
                                    borderColor: '#16a34a',
                                    backgroundColor: 'rgba(22, 163, 74, 0.1)',
                                    tension: 0.4,
                                    fill: false,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    borderWidth: 2
                                },
                                {
                                    label: '🙂 Bien',
                                    data: {{ chartData['bien']|json_encode|raw }},
                                    borderColor: '#86efac',
                                    backgroundColor: 'rgba(134, 239, 172, 0.1)',
                                    tension: 0.4,
                                    fill: false,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    borderWidth: 2
                                },
                                {
                                    label: '😐 Neutre',
                                    data: {{ chartData['neutre']|json_encode|raw }},
                                    borderColor: '#eab308',
                                    backgroundColor: 'rgba(234, 179, 8, 0.1)',
                                    tension: 0.4,
                                    fill: false,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    borderWidth: 2
                                },
                                {
                                    label: '😕 Pas bien',
                                    data: {{ chartData['pas_bien']|json_encode|raw }},
                                    borderColor: '#fecaca',
                                    backgroundColor: 'rgba(254, 202, 202, 0.1)',
                                    tension: 0.4,
                                    fill: false,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    borderWidth: 2
                                },
                                {
                                    label: '😢 Très mal',
                                    data: {{ chartData['tres_mal']|json_encode|raw }},
                                    borderColor: '#dc2626',
                                    backgroundColor: 'rgba(220, 38, 38, 0.1)',
                                    tension: 0.4,
                                    fill: false,
                                    pointRadius: 4,
                                    pointHoverRadius: 6,
                                    borderWidth: 2
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                            scales: {
                                y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 }, title: { display: true, text: 'Nombre d\'entrées' } },
                                x: { title: { display: true, text: 'Date' } }
                            }
                        }
                    });
                }
            }
        },
        
        openEditModal(id, emotion, contenu, imageUrl, audioUrl, csrfToken) {
            this.editId = id;
            this.editEmotion = emotion;
            this.editContenu = contenu || '';
            this.editCsrf = csrfToken;
            this.editImageUrl = imageUrl || null;
            this.editAudioUrl = audioUrl || null;
            this.originalImageUrl = imageUrl || null;
            this.originalAudioUrl = audioUrl || null;
            this.removeImageFlag = '0';
            this.removeAudioFlag = '0';
            this.editModalOpen = true;
        },
        
        closeEditModal() {
            this.editModalOpen = false;
            this.editId = null;
            this.editEmotion = null;
            this.editContenu = '';
            this.editCsrf = '';
            this.editImageUrl = null;
            this.editAudioUrl = null;
            this.originalImageUrl = null;
            this.originalAudioUrl = null;
            this.removeImageFlag = '0';
            this.removeAudioFlag = '0';
        },
        
        onEditImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                this.removeImageFlag = '0';
                if (this.editImageUrl) URL.revokeObjectURL(this.editImageUrl);
                this.editImageUrl = URL.createObjectURL(file);
            }
        },
        
        onEditAudioUpload(event) {
            const file = event.target.files[0];
            if (file) {
                this.removeAudioFlag = '0';
                if (this.editAudioUrl) URL.revokeObjectURL(this.editAudioUrl);
                this.editAudioUrl = URL.createObjectURL(file);
            }
        },
        
        async toggleRecording() {
            if (!this.isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    this.mediaRecorder = new MediaRecorder(stream);
                    this.audioChunks = [];
                    this.mediaRecorder.ondataavailable = e => this.audioChunks.push(e.data);
                    this.mediaRecorder.onstop = () => {
                        this.audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });
                        this.audioUrl = URL.createObjectURL(this.audioBlob);
                        const file = new File([this.audioBlob], 'recording.webm', { type: 'audio/webm' });
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        const audioInput = document.querySelector('#newJournalAudioInput');
                        if (audioInput) audioInput.files = dataTransfer.files;
                        this.audioFile = file;
                        stream.getTracks().forEach(track => track.stop());
                    };
                    this.mediaRecorder.start();
                    this.isRecording = true;
                } catch (error) {
                    console.error('Error accessing microphone:', error);
                    alert('Impossible d\'accéder au microphone. Vérifiez vos permissions.');
                }
            } else {
                this.mediaRecorder.stop();
                this.isRecording = false;
            }
        },
        
        onImageUpload(event) {
            this.imageFile = event.target.files[0];
            if (this.imageFile) {
                if (this.imagePreview) URL.revokeObjectURL(this.imagePreview);
                this.imagePreview = URL.createObjectURL(this.imageFile);
            }
        },
        
        onAudioUpload(event) {
            this.audioFile = event.target.files[0];
            if (this.audioFile) {
                if (this.audioUrl) URL.revokeObjectURL(this.audioUrl);
                this.audioUrl = URL.createObjectURL(this.audioFile);
                this.audioBlob = this.audioFile;
            }
        },
        
        resetForm() {
            this.newJournalOpen = false;
            this.selectedMood = null;
            this.newEntry = '';
            this.isRecording = false;
            this.audioChunks = [];
            this.audioBlob = null;
            if (this.audioUrl) URL.revokeObjectURL(this.audioUrl);
            this.audioUrl = null;
            this.audioFile = null;
            this.imageFile = null;
            if (this.imagePreview) URL.revokeObjectURL(this.imagePreview);
            this.imagePreview = null;
            
            const imageInput = document.querySelector('#newJournalImageInput');
            const audioInput = document.querySelector('#newJournalAudioInput');
            if (imageInput) imageInput.value = '';
            if (audioInput) audioInput.value = '';
        }
    }
}

document.addEventListener('alpine:init', () => {
    Alpine.data('journalApp', journalApp);
});

document.addEventListener('DOMContentLoaded', () => {
    {% for message in app.flashes('success') %}
        window.dispatchEvent(new CustomEvent('flash-message', {
            detail: { text: '{{ message|escape('js') }}', type: 'success' }
        }));
    {% endfor %}
    {% for message in app.flashes('error') %}
        window.dispatchEvent(new CustomEvent('flash-message', {
            detail: { text: '{{ message|escape('js') }}', type: 'error' }
        }));
    {% endfor %}
});
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<style>
[x-cloak] { display: none !important; }

/* Animations globales */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
@keyframes shimmer { 0% { background-position: -1000px 0; } 100% { background-position: 1000px 0; } }
@keyframes ripple { 0% { transform: scale(0,0); opacity: 0.5; } 20% { transform: scale(25,25); opacity: 0.3; } 100% { opacity: 0; transform: scale(40,40); } }

.animate-fade-in { animation: fadeIn 0.5s ease-out; }
.animate-slide-up { animation: slideInUp 0.5s ease-out; }
.animate-slide-right { animation: slideInRight 0.4s ease-out; }
.animate-scale { animation: scaleIn 0.3s ease-out; }
.animate-pulse-slow { animation: pulse 2s infinite; }

.hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
.hover-lift:hover { transform: translateY(-2px); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.02); }
.hover-scale { transition: transform 0.2s ease; }
.hover-scale:hover { transform: scale(1.02); }
.smooth-transition { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
.skeleton { background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 1000px 100%; animation: shimmer 2s infinite; }

.journal-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
.journal-card:hover { border-color: rgba(59, 130, 246, 0.3); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.02); }
.emotion-badge { transition: all 0.2s ease; }
.emotion-badge:hover { transform: scale(1.05); }

.btn-animate { position: relative; overflow: hidden; transition: all 0.3s ease; }
.btn-animate::after { content: ''; position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; background: rgba(255,255,255,0.5); opacity: 0; border-radius: 100%; transform: scale(1,1) translate(-50%); transform-origin: 50% 50%; }
.btn-animate:focus:not(:active)::after { animation: ripple 1s ease-out; }

.stat-card { animation: slideInUp 0.5s ease-out; animation-fill-mode: both; }
.stat-card:nth-child(1) { animation-delay: 0.1s; }
.stat-card:nth-child(2) { animation-delay: 0.2s; }
.stat-card:nth-child(3) { animation-delay: 0.3s; }
.stat-card:nth-child(4) { animation-delay: 0.4s; }

.emotion-item { animation: scaleIn 0.4s ease-out; animation-fill-mode: both; }
{% for i in 1..5 %}.emotion-item:nth-child({{ i }}) { animation-delay: {{ i * 0.1 }}s; }{% endfor %}

.journal-entry { animation: slideInRight 0.4s ease-out; animation-fill-mode: both; }
.flash-message { animation: slideInRight 0.3s ease-out, fadeIn 0.3s ease-out; }

audio { transition: all 0.2s ease; }
audio:hover { filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1)); }
.hover-zoom { transition: transform 0.3s ease; }
.hover-zoom:hover { transform: scale(1.02); }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 10px; transition: background 0.2s ease; }
::-webkit-scrollbar-thumb:hover { background: #a1a1a1; }
</style>
{% endblock %}