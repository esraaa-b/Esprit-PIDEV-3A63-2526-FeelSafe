{% extends "dashboard/base.html.twig" %}

{% block content %}
<div x-data="journalApp()" 
     @flash-message.window="showFlashMessage($event.detail)"
     @clear-flash.window="clearFlashMessage()">
    
    <div class="max-w-7xl mx-auto">
        <div class="space-y-8">
            <!-- Header -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-serif font-bold text-foreground">Journal Émotionnel</h1>
                    <p class="text-muted-foreground mt-1">
                        Exprimez vos émotions et suivez votre parcours de bien-être
                    </p>
                </div>
                <button type="button" 
                        @click="newJournalOpen = true"
                       class="inline-flex items-center justify-center px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors btn-animate">
                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Nouvelle entrée
                </button>
            </div>

            <!-- Flash Messages Container -->
            <div x-show="flashMessage.show" 
                 x-cloak
                 x-transition:enter.duration.300ms
                 x-transition:leave.duration.500ms
                 class="fixed top-4 right-4 z-[1000] max-w-md w-full">
                <div :class="flashMessage.type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700'"
                     class="border px-4 py-3 rounded-lg shadow-lg flex items-center justify-between flash-message">
                    <span class="block sm:inline" x-text="flashMessage.text"></span>
                    <button @click="clearFlashMessage()" class="ml-4">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Stats -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                    <path d="M8 11h8"></path>
                    <path d="M8 6h8"></path>
                </svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-foreground">{{ stats.monthEntries }}</p>
                <p class="text-xs text-muted-foreground">Entrées ce mois</p>
            </div>
        </div>
    </div>
    
    <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-chart-2/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-foreground">{{ stats.consecutiveDays }}</p>
                <p class="text-xs text-muted-foreground">Jours consécutifs</p>
            </div>
        </div>
    </div>
    
    <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-chart-4/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                    <line x1="9" y1="9" x2="9.01" y2="9"></line>
                    <line x1="15" y1="9" x2="15.01" y2="9"></line>
                </svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-foreground">{{ stats.positivePercentage }}%</p>
                <p class="text-xs text-muted-foreground">Humeur positive</p>
            </div>
        </div>
    </div>
</div>

            <!-- Filters -->
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition btn-animate">
                    <button type="button" 
                            @click="activeMood = 'all'" 
                            :class="activeMood === 'all' ? 'bg-primary text-white border-primary' : 'border-input hover:bg-secondary'"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition">
                        Tous
                    </button>
                    
                    {% for mood in moodOptions %}
                        <button type="button" 
                                @click="activeMood = '{{ mood.value }}'" 
                                :class="activeMood === '{{ mood.value }}' ? '{{ mood.color() }}' : '{{ mood.inactiveColor() }}'"
                                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition">
                            <span>{{ mood.icon() }}</span>
                            <span>{{ mood.label() }}</span>
                        </button>
                    {% endfor %}
                </div>

                <!-- Journal Entries -->
                {% for entry in journals %}
                    <div x-show="activeMood === 'all' || activeMood === '{{ entry.emotion.value }}'"
                         x-cloak
                        class="bg-card p-4 rounded-xl border mb-4 journal-card journal-entry hover-lift">
                        
                        <div class="flex items-center justify-between">
                            <h3 class="font-semibold text-lg">
                                Entrée du {{ entry.dateCreation|date('d/m/Y') }} à {{ entry.dateCreation|date('H:i') }}
                            </h3>
                            <span class="{{ entry.emotion.color() }} px-3 py-1 rounded-full text-xs font-medium flex items-center gap-1 emotion-badge">
                                <span>{{ entry.emotion.icon() }}</span>
                                <span>{{ entry.emotion.label() }}</span>
                            </span>
                        </div>
                        
                        {% if entry.contenu %}
                            <div class="mt-3 p-3 bg-secondary/10 rounded-lg">
                                <p class="text-foreground whitespace-pre-wrap">{{ entry.contenu|nl2br }}</p>
                            </div>
                        {% endif %}
                        
                        {% if entry.image %}
                            <div class="mt-4">
                                <img src="{{ asset('uploads/journals/images/' ~ entry.image) }}" 
                                     alt="Journal image" 
                                     class="rounded-lg max-h-64 object-cover border border-border hover-zoom">
                            </div>
                        {% endif %}
                        
                        {% if entry.audio %}
                            <div class="mt-4">
                                <audio controls class="w-full">
                                    <source src="{{ asset('uploads/journals/audio/' ~ entry.audio) }}" type="audio/mpeg">
                                </audio>
                            </div>
                        {% endif %}
                        
                        <div class="flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border">
                            <button type="button" 
                                    @click='openEditModal(
                                        {{ entry.id }}, 
                                        "{{ entry.emotion.value }}", 
                                        {{ entry.contenu ? entry.contenu|json_encode|raw : '""' }}, 
                                        "{{ entry.image ? asset('uploads/journals/images/' ~ entry.image) : '' }}", 
                                        "{{ entry.audio ? asset('uploads/journals/audio/' ~ entry.audio) : '' }}",
                                        "{{ csrf_token('edit_journal_' ~ entry.id) }}"
                                    )'
                                  class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-primary bg-primary/5 hover:bg-primary/10 rounded-lg transition-colors btn-animate">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Modifier
                            </button>
                            
                            <div x-data="{ showDeleteModal: false }" class="inline">
                                <button type="button" 
                                    @click="showDeleteModal = true"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors btn-animate"
                                    style="color: #dc2626; background-color: rgba(220, 38, 38, 0.05);">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Supprimer
                                </button>
                                <div x-show="showDeleteModal" 
                                     x-cloak
                                     class="fixed inset-0 z-[200] flex items-center justify-center p-4"
                                     style="background-color: rgba(0,0,0,0.5);"
                                     @keydown.escape.window="showDeleteModal = false"
                                     @click="showDeleteModal = false">
                                    
                                    <div class="bg-card rounded-lg border border-border w-full max-w-md shadow-2xl"
                                         @click.stop>
                                        
                                        <div class="p-6">
                                            <div class="flex items-start gap-4">
                                                <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                                                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </div>
                                                
                                                <div class="flex-1">
                                                    <h3 class="text-lg font-semibold text-foreground mb-1">Confirmer la suppression</h3>
                                                    <p class="text-sm text-muted-foreground mb-4">Êtes-vous sûr de vouloir supprimer cette entrée ? Cette action est irréversible.</p>
                                                    
                                                    <div class="flex justify-end gap-2">
                                                        <button type="button" 
                                                                @click="showDeleteModal = false" 
                                                                class="px-3 py-1.5 text-xs font-medium rounded-md border border-input hover:bg-secondary transition-colors">
                                                            Annuler
                                                        </button>
                                                        
                                                        <form method="post" 
                                                              action="{{ path('app_journal_delete', {id: entry.id}) }}" 
                                                              class="inline">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entry.id) }}">
                                                            <button type="submit" 
                                                                    class="px-3 py-1.5 text-xs font-medium text-white bg-red-500 hover:bg-red-600 rounded-md transition-colors">
                                                                Supprimer
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-16 bg-card rounded-xl border border-border">
                        <div class="flex justify-center mb-4">
                            <svg class="w-16 h-16 text-muted-foreground/30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                                <path d="M8 11h8"></path>
                                <path d="M8 6h8"></path>
                            </svg>
                        </div>
                        <p class="text-lg font-medium text-foreground">Aucune entrée pour le moment</p>
                        <p class="text-sm text-muted-foreground mt-1">Commencez par créer votre première entrée de journal</p>
                        <button type="button" 
                                @click="newJournalOpen = true"
                                class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Nouvelle entrée
                        </button>
                    </div>
                {% endfor %}
            </div>

            <!-- Emotions Statistics -->
            <div class="bg-card rounded-lg border border-border p-6">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Statistiques émotionnelles</h2>
                    </div>
                    
                    <button type="button"
                            @click="openChartModal()"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-lg hover:bg-primary/20 transition-colors btn-animate">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 12v3a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2h3m12 0v.01M12 7v.01M9 5h.01M7 5h.01" />
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                        </svg>
                        Voir les tendances
                    </button>
                </div>
                
                <p class="text-muted-foreground mb-6">Vos émotions en un coup d'œil</p>
                
                <div class="flex flex-wrap gap-4 justify-between">
                    {% for mood in moodOptions %}
                        {% set moodCount = moodStats[mood.value] ?? 0 %}
                        <div class="flex-1 min-w-[150px] bg-secondary/5 rounded-lg p-4">
                            <div class="flex flex-col items-center text-center">
                                <div class="{{ mood.color() }} w-12 h-12 rounded-full flex items-center justify-center text-xl mb-2">
                                    {{ mood.icon() }}
                                </div>
                                <span class="text-sm font-medium text-foreground">{{ mood.label() }}</span>
                                <span class="text-2xl font-bold text-foreground mt-1">{{ moodCount }}</span>
                                <span class="text-xs text-muted-foreground">
                                    entrée{% if moodCount != 1 %}s{% endif %}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- New Journal Entry Modal -->
    <div x-show="newJournalOpen" 
         x-cloak 
         class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
         style="background-color: rgba(0,0,0,0.5);"
         @keydown.escape.window="resetForm()"
         @click="resetForm()">
        
        <div class="relative bg-card rounded-lg border border-border w-full max-w-lg max-h-[90vh] flex flex-col shadow-2xl"
             @click.stop>
            <div class="p-6 overflow-y-auto flex-1">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-serif font-bold text-foreground">Nouvelle entrée de journal</h2>
                    <button @click="resetForm()" 
                            class="p-2 hover:bg-secondary rounded-lg transition-colors">
                        <svg class="w-5 h-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                
                <p class="text-muted-foreground mb-6">Prenez un moment pour exprimer comment vous vous sentez</p>
                
                <form method="POST" 
                      action="{{ path('app_journal_new') }}" 
                      enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('create_journal') }}">
                    <input type="hidden" name="emotion" :value="selectedMood">
                    
                    <div class="mb-6">
                        <p class="text-sm font-medium text-foreground mb-3">Comment vous sentez-vous ?</p>
                        <div class="flex flex-wrap gap-2">
                            {% for mood in moodOptions %}
                                <button type="button" 
                                        @click="selectedMood = '{{ mood.value }}'"
                                        :class="selectedMood === '{{ mood.value }}' ? '{{ mood.color() }}' : '{{ mood.inactiveColor() }}'"
                                        class="flex items-center gap-2 px-3 py-2 rounded-full border-2 transition-all text-sm">
                                    <span>{{ mood.icon() }}</span>
                                    <span>{{ mood.label() }}</span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <textarea name="contenu" 
                                  x-model="newEntry" 
                                  placeholder="Décrivez votre journée (optionnel si vous ajoutez une image ou un audio)..."
                                  class="w-full min-h-32 px-3 py-2 rounded-lg border border-input bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50"></textarea>
                    </div>
                    
                    <div class="space-y-4 mb-6">
                        <div>
                            <label class="inline-flex items-center justify-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors cursor-pointer">
                                <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                Ajouter une image
                                <input type="file" 
                                       name="image" 
                                       id="newJournalImageInput" 
                                       @change="onImageUpload" 
                                       class="hidden" 
                                       accept="image/*">
                            </label>
                        </div>
                        
                        <template x-if="imagePreview">
                            <div class="mt-2 max-h-44 overflow-hidden rounded-lg border">
                                <img :src="imagePreview" 
                                     alt="Aperçu" 
                                     class="w-full h-full object-contain">
                            </div>
                        </template>
                        
                        <div class="space-y-2">
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button" 
                                        @click="toggleRecording()" 
                                        :class="isRecording ? 'bg-red-500 text-white border-red-500' : ''"
                                        class="inline-flex items-center justify-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary transition-colors">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M12 1v11m0 0a3 3 0 0 0 3-3V4a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3z"></path>
                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                    </svg>
                                    <span x-text="isRecording ? 'Arrêter l\'enregistrement' : 'Enregistrer un vocal'"></span>
                                </button>
                                
                                <label class="inline-flex items-center justify-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors cursor-pointer">
                                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    Upload fichier audio
                                    <input type="file" 
                                           name="audio" 
                                           id="newJournalAudioInput" 
                                           @change="onAudioUpload" 
                                           class="hidden" 
                                           accept="audio/*">
                                </label>
                            </div>
                            
                            <template x-if="audioUrl">
                                <div class="mt-2">
                                    <p class="text-sm text-muted-foreground mb-1">Aperçu audio:</p>
                                    <audio controls class="w-full">
                                        <source :src="audioUrl" :type="audioFile?.type || 'audio/webm'">
                                    </audio>
                                </div>
                            </template>
                        </div>
                    </div>
                    
                    <div class="border-t border-border pt-4 flex justify-end gap-2">
                        <button type="button" 
                                @click="resetForm()" 
                                class="px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                            Annuler
                        </button>
                        <button type="submit" 
                                :disabled="!selectedMood || (!newEntry && !audioUrl && !imageFile)"
                                :class="!selectedMood || (!newEntry && !audioUrl && !imageFile) ? 'opacity-50 cursor-not-allowed' : 'hover:bg-primary/90'"
                                class="px-4 py-2 bg-primary text-primary-foreground rounded-lg transition-colors">
                            Publier
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Journal Modal - CENTRÉ ET FONCTIONNEL -->
    <div x-show="editModalOpen" 
         x-cloak 
         class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
         style="background-color: rgba(0,0,0,0.5);"
         @keydown.escape.window="closeEditModal()"
         @click="closeEditModal()">
        
        <div class="relative bg-card rounded-lg border border-border w-full max-w-lg max-h-[90vh] flex flex-col shadow-2xl"
             @click.stop>
            
            <div class="flex items-center justify-between p-6 border-b border-border shrink-0">
                <h2 class="text-xl font-serif font-bold text-foreground">Modifier l'entrée</h2>
                <button type="button" 
                        @click="closeEditModal()" 
                        class="p-2 hover:bg-secondary rounded-lg transition-colors">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto flex-1">
                <form method="POST" :action="`/dashboard/journal/${editId}/edit`" enctype="multipart/form-data">
                    <input type="hidden" name="_token" :value="editCsrf">
                    <input type="hidden" name="emotion" :value="editEmotion">
                    <input type="hidden" name="remove_image" :value="removeImageFlag">
                    <input type="hidden" name="remove_audio" :value="removeAudioFlag">
                    
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-foreground mb-2">Comment vous sentiez-vous ?</label>
                        <div class="flex flex-wrap gap-2">
                            {% for mood in moodOptions %}
                            <button type="button"
                                    @click="editEmotion = '{{ mood.value }}'"
                                    :class="editEmotion === '{{ mood.value }}' ? '{{ mood.color() }}' : '{{ mood.inactiveColor() }}'"
                                    class="flex items-center gap-2 px-3 py-2 rounded-full border-2 text-sm transition-all">
                                <span>{{ mood.icon() }}</span>
                                <span>{{ mood.label() }}</span>
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-foreground mb-2">Description</label>
                        <textarea name="contenu" 
                                  x-model="editContenu" 
                                  rows="4"
                                  class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground focus:ring-2 focus:ring-primary/50 focus:outline-none"></textarea>
                    </div>
                    
                    <!-- SECTION IMAGE -->
                    <div class="mb-6 border-b border-border pb-6">
                        <h3 class="text-md font-medium text-foreground mb-3">Image</h3>
                        
