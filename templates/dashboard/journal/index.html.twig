{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Journal Émotionnel</h1>
                <p class="text-muted-foreground mt-1">
                    Exprimez vos émotions et suivez votre parcours de bien-être
                </p>
            </div>
            <button type="button"
                    @click="$dispatch('open-dialog', {id: 'new-journal'})"
                    class="inline-flex items-center justify-center px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nouvelle entrée
            </button>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                            <path d="M8 11h8"></path>
                            <path d="M8 6h8"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">24</p>
                        <p class="text-xs text-muted-foreground">Entrées ce mois</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-2/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">7</p>
                        <p class="text-xs text-muted-foreground">Jours consécutifs</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-4/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                            <line x1="9" y1="9" x2="9.01" y2="9"></line>
                            <line x1="15" y1="9" x2="15.01" y2="9"></line>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">72%</p>
                        <p class="text-xs text-muted-foreground">Humeur positive</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-1/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">156</p>
                        <p class="text-xs text-muted-foreground">Réactions reçues</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div x-data="{ activeMood: 'all' }">
       <div class="flex items-center gap-2 flex-wrap mb-6">

    <!-- Tous -->
    <button
        type="button"
        @click="activeMood = 'all'"
        :class="activeMood === 'all'
            ? 'bg-primary text-white border-primary'
            : 'border-input hover:bg-secondary'"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition"
    >
        Tous
    </button>

    <!-- Emotions -->
    {% for mood in moodOptions %}
        <button
            type="button"
            @click="activeMood = '{{ mood.value }}'"
            :class="activeMood === '{{ mood.value }}'
                ? '{{ mood.color() }}'
                : 'border-input hover:bg-secondary'"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition"
        >
            <span>{{ mood.icon() }}</span>
            <span>{{ mood.label() }}</span>
        </button>
    {% endfor %}
</div>


        <!-- Journal Entries -->
       {% for entry in journals %}

    <div
        x-show="activeMood === 'all' || activeMood === '{{ entry.emotion.value }}'"
        class="bg-card p-4 rounded-xl border mb-4"
    >
        <h3 class="font-semibold text-lg">
    Entrée du {{ entry.dateCreation|date('d/m/Y') }}
</h3>
    <p class="mt-3">
        {{ entry.contenu }}
    </p>

    {% if entry.image %}
        <img src="{{ asset('uploads/journals/images/' ~ entry.image) }}"
             class="mt-4 rounded-lg">
    {% endif %}

    {% if entry.audio %}
        <audio controls class="mt-4 w-full">
            <source src="{{ asset('uploads/journals/audio/' ~ entry.audio) }}">
        </audio>
    {% endif %}

    <!-- STATS -->
    <div class="flex gap-6 mt-4 text-sm text-gray-500">
        <span>🤍 {{ entry.likes|default(0) }}</span>
        <span>💬 0</span>   
 </div>

    <!-- 👇 ADD IT HERE -->
    <div class="flex items-center gap-4 mt-4 pt-4 border-t border-border">
        
        <a href="{{ path('app_journal_edit', {id: entry.id}) }}"
           class="text-sm text-primary hover:underline">
            ✏️ Modifier
        </a>

        <form method="post"
              action="{{ path('app_journal_delete', {id: entry.id}) }}"
              onsubmit="return confirm('Supprimer ce journal ?');">
            <button class="text-sm text-destructive hover:underline">
                🗑 Supprimer
            </button>
        </form>

    </div>

</div>

{% endfor %}


        <!-- Mood Insights -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Tendances émotionnelles</h2>
            </div>
            <p class="text-muted-foreground mb-6">
                Analyse de vos humeurs sur les 30 derniers jours
            </p>
            
            <div class="grid grid-cols-5 gap-4">
                {% for mood in moodOptions %}
                <button
                    class="px-3 py-2 rounded {{ mood.color }}"
                >
                    {{ mood.name|lower|replace({'_':' '}) }}
                </button>
            {% endfor %}

            </div>
        </div>
    </div>
</div>

<!-- New Journal Entry Modal -->
<div x-data="{
    newJournalOpen: false,
    selectedMood: null,
    newEntry: '',
    isRecording: false,
    mediaRecorder: null,
    audioChunks: [],
    audioBlob: null,
    audioUrl: null,

    async toggleRecording() {
        if (!this.isRecording) {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            this.mediaRecorder = new MediaRecorder(stream);
            this.audioChunks = [];

            this.mediaRecorder.ondataavailable = e => this.audioChunks.push(e.data);
            this.mediaRecorder.onstop = () => {
                this.audioBlob = new Blob(this.audioChunks, { type: 'audio/webm' });
                this.audioUrl = URL.createObjectURL(this.audioBlob);
            };

            this.mediaRecorder.start();
            this.isRecording = true;
        } else {
            this.mediaRecorder.stop();
            this.isRecording = false;
        }
    }
}"
  x-on:open-dialog.window="if ($event.detail.id === 'new-journal') newJournalOpen = true"
     class="fixed inset-0 z-50 flex items-center justify-center p-4"
     x-show="newJournalOpen"
     style="display: none;">
    
    <!-- Overlay -->
    <div class="absolute inset-0 bg-foreground/50" @click="newJournalOpen = false; selectedMood = null; newEntry = ''"></div>
    
    <!-- Dialog -->
    <div class="relative bg-card rounded-lg border border-border w-full max-w-lg shadow-lg"
         @click.outside="newJournalOpen = false">
        
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-serif font-bold text-foreground">Nouvelle entrée de journal</h2>
                <button @click="newJournalOpen = false; selectedMood = null; newEntry = ''" 
                        class="p-2 hover:bg-secondary rounded-lg transition-colors">
                    <svg class="w-5 h-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <p class="text-muted-foreground mb-6">
                Prenez un moment pour exprimer comment vous vous sentez
            </p>
            
<form method="POST"
      action="{{ path('app_journal_new') }}"
      enctype="multipart/form-data"
      class="space-y-4">
                <div>
                    <input type="hidden" name="emotion" :value="selectedMood">
                    <p class="text-sm font-medium text-foreground mb-3">Comment vous sentez-vous?</p>
                    <div class="flex flex-wrap gap-2">
                        {% for mood in moodOptions %}
                        <button type="button"
                            @click="selectedMood = '{{ mood.value }}'"
                            :class="selectedMood === '{{ mood.value }}'
                                ? '{{ mood.color }} text-card border-transparent'
                                : 'border-border hover:border-primary/50'"
                            class="flex items-center gap-2 px-3 py-2 rounded-full border-2 transition-all text-sm">

                            <span>{{ mood.icon }}</span>
                            <span>{{ mood.label }}</span>
                        </button>
                    {% endfor %}

                    </div>
                </div>
                <div>
                    <textarea name="contenu"
          x-model="newEntry"
          required
          class="w-full min-h-32 px-3 py-2 rounded-lg border">
</textarea>
  </div>
                <div class="flex items-center gap-2">
                    <button type="button" class="inline-flex items-center justify-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                        <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        Ajouter une image
                    </button>
                    <div class="flex items-center gap-2">
                    <button type="button"
                            @click="toggleRecording()"
                            :class="isRecording ? 'bg-red-500 text-white' : ''"
                            class="inline-flex items-center justify-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 1v11m0 0a3 3 0 0 0 3-3V4a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        </svg>
                        <span x-text="isRecording ? 'Arrêter l’enregistrement' : 'Enregistrer un vocal'"></span>
                    </button>
                </div>

                <!-- Audio preview -->
                <template x-if="audioUrl">
                    <audio controls class="mt-2 w-full">
                        <source :src="audioUrl" type="audio/webm">
                    </audio>
                </template>

                </div>
                <div class="flex justify-end gap-2">
                    <button @click="newJournalOpen = false; selectedMood = null; newEntry = ''"
                            class="px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                        Annuler
                    </button>
                    <button type="submit"
        :disabled="!selectedMood || (!newEntry && !audioUrl)"
        :class="!selectedMood || (!newEntry && !audioUrl)
            ? 'opacity-50 cursor-not-allowed'
            : ''"
        class="px-4 py-2 bg-primary text-primary-foreground rounded-lg">
    Publier
</button>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 