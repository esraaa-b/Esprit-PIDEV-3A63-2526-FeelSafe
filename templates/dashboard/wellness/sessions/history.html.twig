{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-6xl mx-auto">
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <a href="{{ path('app_wellness') }}" class="text-muted-foreground hover:text-foreground transition-colors">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </a>
                    <span class="text-sm text-muted-foreground">Bien-être</span>
                </div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Historique des sessions</h1>
                <p class="text-muted-foreground mt-1">
                    Toutes vos activités de bien-être
                </p>
            </div>
            <a href="{{ path('app_wellness_stats') }}" class="px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
                Voir les statistiques
            </a>
        </div>

        <!-- Timeline -->
        <div class="space-y-4">
            {% for session in sessions %}
                {% set isCompleted = session.statutSession.value == 'completee' %}
                {% set hasEvolution = session.scoreHumeurAvant and session.scoreHumeurApres %}
                {% set evolution = hasEvolution ? session.scoreHumeurApres - session.scoreHumeurAvant : 0 %}
                
                <div class="bg-card rounded-lg border border-border p-6 hover:shadow-md transition-shadow">
                    <div class="flex items-start gap-6">
                        <!-- Timeline Icon -->
                        <div class="flex flex-col items-center flex-shrink-0">
                            <div class="w-12 h-12 rounded-full flex items-center justify-center
                                {% if isCompleted %}
                                    bg-chart-2/10 text-chart-2
                                {% elseif session.statutSession.value == 'en_cours' %}
                                    bg-chart-4/10 text-chart-4
                                {% else %}
                                    bg-secondary text-secondary-foreground
                                {% endif %}">
                                {% if isCompleted %}
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                {% elseif session.statutSession.value == 'en_cours' %}
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                {% else %}
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                    </svg>
                                {% endif %}
                            </div>
                            {% if not loop.last %}
                                <div class="w-0.5 h-16 bg-border mt-2"></div>
                            {% endif %}
                        </div>

                        <!-- Content -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-4 mb-3">
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-foreground mb-1">
                                        {{ session.activite.nomActivite }}
                                    </h3>
                                    <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                            </svg>
                                            {{ session.dateDebut|date('d/m/Y à H:i') }}
                                        </span>
                                        {% if session.dureeReelle %}
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <polyline points="12 6 12 12 16 14"></polyline>
                                                </svg>
                                                {{ session.dureeReelle }} min
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="px-3 py-1 text-sm font-medium rounded-full
                                    {% if isCompleted %}
                                        bg-chart-2/10 text-chart-2
                                    {% elseif session.statutSession.value == 'en_cours' %}
                                        bg-chart-4/10 text-chart-4
                                    {% else %}
                                        bg-secondary text-secondary-foreground
                                    {% endif %}">
                                    {{ session.statutSession.value|replace({'_': ' '})|capitalize }}
                                </span>
                            </div>

                            <!-- Mood Evolution -->
                            {% if hasEvolution %}
                                <div class="flex items-center gap-4 p-4 bg-secondary/50 rounded-lg">
                                    <div class="flex items-center gap-3">
                                        <div class="text-center">
                                            <p class="text-xs text-muted-foreground mb-1">Avant</p>
                                            <p class="text-2xl font-bold text-foreground">{{ session.scoreHumeurAvant }}</p>
                                        </div>
                                        <svg class="w-5 h-5 {{ evolution > 0 ? 'text-chart-2' : 'text-muted-foreground' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="9 18 15 12 9 6"></polyline>
                                        </svg>
                                        <div class="text-center">
                                            <p class="text-xs text-muted-foreground mb-1">Après</p>
                                            <p class="text-2xl font-bold {{ evolution > 0 ? 'text-chart-2' : 'text-foreground' }}">{{ session.scoreHumeurApres }}</p>
                                        </div>
                                    </div>
                                    {% if evolution != 0 %}
                                        <div class="ml-auto px-3 py-1 rounded-full text-sm font-semibold
                                            {% if evolution > 0 %}
                                                bg-chart-2/10 text-chart-2
                                            {% else %}
                                                bg-destructive/10 text-destructive
                                            {% endif %}">
                                            {{ evolution > 0 ? '+' : '' }}{{ evolution }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <!-- Comment -->
                            {% if session.commentaire %}
                                <div class="mt-3 p-3 bg-background rounded-lg border-l-4 border-primary">
                                    <p class="text-sm text-muted-foreground italic">
                                        "{{ session.commentaire }}"
                                    </p>
                                </div>
                            {% endif %}

                            <!-- Meta -->
                            <div class="flex flex-wrap items-center gap-3 mt-3">
                                {% if session.noteSatisfaction %}
                                    <div class="flex items-center gap-1">
                                        {% for i in 1..5 %}
                                            <svg class="w-4 h-4 {{ i <= session.noteSatisfaction ? 'text-chart-4' : 'text-secondary' }}" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                                            </svg>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if session.impactPercu %}
                                    <span class="px-2 py-1 text-xs rounded-full
                                        {% if session.impactPercu.value == 'tres_positif' or session.impactPercu.value == 'positif' %}
                                            bg-chart-2/10 text-chart-2
                                        {% else %}
                                            bg-secondary text-secondary-foreground
                                        {% endif %}">
                                        Impact: {{ session.impactPercu.value|replace({'_': ' '})|capitalize }}
                                    </span>
                                {% endif %}
                                {% if session.estObjectifAtteint %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-chart-2/10 text-chart-2 flex items-center gap-1">
                                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        Objectif atteint
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-16 bg-card rounded-lg border border-border">
                    <svg class="w-20 h-20 mx-auto text-muted-foreground/30 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <polyline points="23 20 23 14 17 14"></polyline>
                        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                    </svg>
                    <h3 class="text-lg font-semibold text-foreground mb-2">Aucune session pour le moment</h3>
                    <p class="text-muted-foreground mb-4">Commencez votre première activité de bien-être</p>
                    <a href="{{ path('app_wellness_activites') }}" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        Démarrer une activité
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}