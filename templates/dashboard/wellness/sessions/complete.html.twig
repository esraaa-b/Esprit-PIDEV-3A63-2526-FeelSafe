{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-3xl mx-auto">
    <div class="space-y-6">
        <!-- Success Header -->
        <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-chart-2/10 flex items-center justify-center">
                <svg class="w-10 h-10 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h1 class="text-3xl font-serif font-bold text-foreground mb-2">Bravo !</h1>
            <p class="text-muted-foreground">
                Vous avez terminé : <strong class="text-foreground">{{ session.activite.nomActivite }}</strong>
            </p>
        </div>

        <!-- Evaluation Form -->
        <form method="post" class="space-y-6">
            <!-- Mood After -->
            <div class="bg-card rounded-lg border border-border p-6">
                <h2 class="text-lg font-semibold text-foreground mb-4">Comment vous sentez-vous maintenant ?</h2>
                
                <!-- Mood Options -->
                <div x-data="{ selectedMood: '{{ session.humeurApres ? session.humeurApres.value : '' }}' }" class="space-y-4">
                    <div class="flex gap-3 flex-wrap">
                        <label class="flex-1 min-w-[120px] cursor-pointer">
                            <input type="radio" name="humeur_apres" value="TRES_BIEN" x-model="selectedMood" class="peer sr-only">
                            <div class="p-4 rounded-lg border-2 border-border peer-checked:border-chart-2 peer-checked:bg-chart-2/10 transition-all text-center hover:border-chart-2/50">
                                <div class="text-3xl mb-2">😄</div>
                                <p class="text-sm font-medium text-foreground">Très bien</p>
                            </div>
                        </label>
                        <label class="flex-1 min-w-[120px] cursor-pointer">
                            <input type="radio" name="humeur_apres" value="BIEN" x-model="selectedMood" class="peer sr-only">
                            <div class="p-4 rounded-lg border-2 border-border peer-checked:border-chart-2 peer-checked:bg-chart-2/10 transition-all text-center hover:border-chart-2/50">
                                <div class="text-3xl mb-2">🙂</div>
                                <p class="text-sm font-medium text-foreground">Bien</p>
                            </div>
                        </label>
                        <label class="flex-1 min-w-[120px] cursor-pointer">
                            <input type="radio" name="humeur_apres" value="NEUTRE" x-model="selectedMood" class="peer sr-only">
                            <div class="p-4 rounded-lg border-2 border-border peer-checked:border-chart-4 peer-checked:bg-chart-4/10 transition-all text-center hover:border-chart-4/50">
                                <div class="text-3xl mb-2">😐</div>
                                <p class="text-sm font-medium text-foreground">Neutre</p>
                            </div>
                        </label>
                        <label class="flex-1 min-w-[120px] cursor-pointer">
                            <input type="radio" name="humeur_apres" value="PAS_BIEN" x-model="selectedMood" class="peer sr-only">
                            <div class="p-4 rounded-lg border-2 border-border peer-checked:border-destructive peer-checked:bg-destructive/10 transition-all text-center hover:border-destructive/50">
                                <div class="text-3xl mb-2">😕</div>
                                <p class="text-sm font-medium text-foreground">Pas bien</p>
                            </div>
                        </label>
                    </div>

                    <!-- Mood Score -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">
                            Notez votre humeur de 1 à 10
                        </label>
                        <input type="range" name="score_humeur_apres" min="1" max="10" value="5" class="w-full h-2 bg-secondary rounded-lg appearance-none cursor-pointer accent-primary">
                        <div class="flex justify-between text-xs text-muted-foreground mt-1">
                            <span>1</span>
                            <span>5</span>
                            <span>10</span>
                        </div>
                    </div>

                    <!-- Emotion Text -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">
                            Décrivez votre état émotionnel (optionnel)
                        </label>
                        <input type="text" name="emotion_apres" placeholder="Ex: Détendu, Énergisé, Calme..." class="w-full px-4 py-2 bg-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                    </div>
                </div>
            </div>

            <!-- Satisfaction -->
            <div class="bg-card rounded-lg border border-border p-6">
                <h2 class="text-lg font-semibold text-foreground mb-4">Votre évaluation</h2>
                
                <div class="space-y-4">
                    <!-- Stars Rating -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">
                            Note de satisfaction
                        </label>
                        <div x-data="{ rating: 0, hover: 0 }" class="flex gap-2">
                            <template x-for="star in 5" :key="star">
                                <button type="button" 
                                        @click="rating = star" 
                                        @mouseenter="hover = star" 
                                        @mouseleave="hover = 0"
                                        class="text-3xl transition-colors focus:outline-none">
                                    <span x-show="star <= (hover || rating)" class="text-chart-4">★</span>
                                    <span x-show="star > (hover || rating)" class="text-secondary">☆</span>
                                </button>
                            </template>
                            <input type="hidden" name="note_satisfaction" x-model="rating">
                        </div>
                    </div>

                    <!-- Impact -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">
                            Impact perçu
                        </label>
                        <select name="impact_percu" class="w-full px-4 py-2 bg-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                            <option value="">Sélectionner...</option>
<option value="TRES_POSITIF">Très positif</option>
<option value="POSITIF">Positif</option>
<option value="NEUTRE">Neutre</option>
<option value="NEGATIF">Négatif</option>
                        </select>
                    </div>

                    <!-- Objectif atteint -->
                    <div class="flex items-center gap-3 p-4 bg-secondary/50 rounded-lg">
                        <input type="checkbox" name="est_objectif_atteint" value="1" id="objectif" class="w-5 h-5 rounded border-input accent-primary">
                        <label for="objectif" class="text-sm font-medium text-foreground cursor-pointer">
                            J'ai atteint mon objectif pour cette session
                        </label>
                    </div>

                    <!-- Comment -->
                    <div>
                        <label class="block text-sm font-medium text-foreground mb-2">
                            Commentaire (optionnel)
                        </label>
                        <textarea name="commentaire" rows="3" placeholder="Partagez votre expérience..." class="w-full px-4 py-2 bg-background border border-input rounded-lg focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="flex gap-3">
                <button type="submit" class="flex-1 px-6 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                    Enregistrer et terminer
                </button>
                <a href="{{ path('app_wellness') }}" class="px-6 py-3 bg-secondary text-secondary-foreground rounded-lg font-semibold hover:bg-secondary/80 transition-colors">
                    Ignorer
                </a>
            </div>
        </form>
    </div>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.0/dist/cdn.min.js"></script>
{% endblock %}