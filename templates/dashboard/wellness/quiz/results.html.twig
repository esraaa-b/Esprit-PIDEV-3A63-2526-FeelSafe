{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-5xl mx-auto">
    <div class="space-y-8">
        <!-- Success Header -->
        <div class="text-center py-8">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-chart-2 to-primary flex items-center justify-center animate-bounce">
                <svg class="w-10 h-10 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h1 class="text-3xl font-serif font-bold text-foreground mb-3">
                Analyse terminée ! 🎉
            </h1>
            <p class="text-lg text-muted-foreground">
                Voici vos recommandations personnalisées par IA
            </p>
        </div>

        <!-- Global Message from AI -->
        <div class="bg-gradient-to-br from-primary/10 to-chart-2/10 rounded-xl border border-border p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="font-semibold text-foreground mb-2 flex items-center gap-2">
                        <span>Message de votre assistant IA</span>
                        <span class="px-2 py-0.5 text-xs rounded-full bg-primary/20 text-primary font-medium">Gemini</span>
                    </h3>
                    <p class="text-foreground leading-relaxed">{{ results.explanation ?? results.global_message ?? 'Analyse complète de vos réponses.' }}</p>
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        {% if results.recommendations is not empty %}
            <div>
                <h2 class="text-2xl font-semibold text-foreground mb-6 flex items-center gap-2">
                    <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="6"></circle>
                        <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                    </svg>
                    Vos activités recommandées
                </h2>

                <div class="space-y-6">
                    {% for item in results.recommendations %}
                        {% set activite = item.activity %}
                        {% set medals = ['🥇', '🥈', '🥉'] %}
                        
                        <div class="bg-card rounded-xl border-2 {{ loop.first ? 'border-primary' : 'border-border' }} overflow-hidden hover:shadow-xl transition-all duration-300">
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                <!-- Image -->
                                <div class="relative h-64 lg:h-auto overflow-hidden">
                                    {% if activite.imageUrl %}
                                        <img src="{{ activite.imageUrl }}" alt="{{ activite.nomActivite }}" class="absolute inset-0 w-full h-full object-cover">
                                    {% else %}
                                        <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-primary/20 to-chart-2/20 flex items-center justify-center">
                                            <svg class="w-16 h-16 text-muted-foreground/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                            </svg>
                                        </div>
                                    {% endif %}
                                    <div class="absolute inset-0 bg-gradient-to-t from-card via-card/50 to-transparent"></div>
                                    
                                    <!-- Priority Badge -->
                                    <div class="absolute top-4 left-4">
                                        <div class="text-4xl">{{ medals[loop.index0] ?? '⭐' }}</div>
                                    </div>
                                </div>

                                <!-- Content -->
                                <div class="lg:col-span-2 p-6">
                                    <div class="flex items-start justify-between mb-4">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="px-3 py-1 text-sm font-semibold rounded-full bg-primary/10 text-primary">
                                                    {{ activite.typeActivite }}
                                                </span>
                                                {% if activite.niveauDifficulte %}
                                                    <span class="px-3 py-1 text-sm rounded-full border border-border">
                                                        {{ activite.niveauDifficulte.value|capitalize }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                            <h3 class="text-2xl font-bold text-foreground mb-2">
                                                {{ activite.nomActivite }}
                                            </h3>
                                            <p class="text-muted-foreground mb-4">
                                                {{ activite.description }}
                                            </p>
                                        </div>
                                    </div>

                                    <!-- AI Reason -->
                                    <div class="bg-primary/5 rounded-lg p-4 mb-4 border-l-4 border-primary">
                                        <div class="flex items-start gap-3">
                                            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 2v20M2 12h20"></path>
                                                <circle cx="12" cy="12" r="10"></circle>
                                            </svg>
                                            <div>
                                                <p class="font-semibold text-foreground text-sm mb-1">Pourquoi cette activité ?</p>
                                                <p class="text-foreground leading-relaxed">{{ item.reason }}</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Meta Info -->
                                    <div class="flex flex-wrap items-center gap-4 mb-4">
                                        {% if activite.dureeSuggeree %}
                                            <div class="flex items-center gap-2 text-muted-foreground">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <polyline points="12 6 12 12 16 14"></polyline>
                                                </svg>
                                                <span class="text-sm font-medium">{{ activite.dureeSuggeree }} minutes</span>
                                            </div>
                                        {% endif %}
                                        {% if activite.categorie %}
                                            <div class="flex items-center gap-2 text-muted-foreground">
                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                                </svg>
                                                <span class="text-sm font-medium">{{ activite.categorie }}</span>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="flex flex-wrap gap-3">
                                        <form method="post" action="{{ path('app_wellness_session_start', {'id': activite.id}) }}" class="inline">
                                            <button type="submit" class="px-6 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors inline-flex items-center gap-2">
                                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                                </svg>
                                                Commencer maintenant
                                            </button>
                                        </form>
                                        <a href="{{ path('app_wellness_activite_show', {'id': activite.id}) }}" class="px-6 py-3 bg-secondary text-secondary-foreground rounded-lg font-semibold hover:bg-secondary/80 transition-colors inline-flex items-center gap-2">
                                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <path d="M12 16v-4"></path>
                                                <path d="M12 8h.01"></path>
                                            </svg>
                                            En savoir plus
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="text-center py-12 bg-card rounded-lg border border-border">
                <svg class="w-16 h-16 mx-auto text-muted-foreground/30 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 16v-4"></path>
                    <path d="M12 8h.01"></path>
                </svg>
                <h3 class="text-lg font-semibold text-foreground mb-2">Aucune recommandation disponible</h3>
                <p class="text-muted-foreground">Veuillez réessayer le quiz.</p>
            </div>
        {% endif %}

        <!-- Actions -->
        <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="{{ path('app_wellness_quiz_questions') }}" class="px-6 py-3 bg-card border border-border rounded-lg font-medium text-foreground hover:bg-secondary transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <polyline points="23 20 23 14 17 14"></polyline>
                    <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                </svg>
                Refaire le quiz
            </a>
            <a href="{{ path('app_wellness') }}" class="px-6 py-3 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                Retour au bien-être
            </a>
        </div>
    </div>
</div>
{% endblock %}