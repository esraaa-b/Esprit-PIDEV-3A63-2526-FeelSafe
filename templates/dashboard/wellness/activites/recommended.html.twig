{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <a href="{{ path('app_wellness') }}" class="text-muted-foreground hover:text-foreground transition-colors">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </a>
                    <span class="text-sm text-muted-foreground">Bien-être</span>
                </div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Recommandations intelligentes</h1>
                <p class="text-muted-foreground mt-1">
                    Activités personnalisées selon la météo et vos préférences
                </p>
            </div>
        </div>

        <!-- Weather Banner -->
        <div class="bg-gradient-to-r from-primary/10 to-chart-2/10 rounded-lg border border-border p-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="text-4xl">
                        {% if weatherCategory == 'outdoor' %}☀️
                        {% elseif weatherCategory == 'indoor' %}🌧️
                        {% else %}⛅
                        {% endif %}
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-foreground">
                            {% if weatherCategory == 'outdoor' %}
                                Conditions idéales pour sortir !
                            {% elseif weatherCategory == 'indoor' %}
                                Parfait pour rester au chaud
                            {% else %}
                                Temps agréable aujourd'hui
                            {% endif %}
                        </h2>
                        <p class="text-sm text-muted-foreground">
                            {{ weather.temperature }}°C · {{ weather.description }}
                        </p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm text-muted-foreground">{{ weather.city }}</p>
                </div>
            </div>
        </div>

        <!-- Activity of the Moment -->
        {% if activityOfTheMoment %}
            <div class="bg-card rounded-lg border border-primary/50 p-6">
                <div class="flex items-start gap-6">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-chart-4 to-chart-2 flex items-center justify-center text-3xl flex-shrink-0">
                        ⚡
                    </div>
                    <div class="flex-1">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-chart-4/10 text-chart-4 text-sm font-medium mb-3">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            Parfait pour maintenant
                        </div>
                        <h2 class="text-2xl font-bold text-foreground mb-2">
                            {{ activityOfTheMoment.activity.nomActivite }}
                        </h2>
                        <p class="text-muted-foreground mb-4">{{ activityOfTheMoment.reason }}</p>
                        <div class="flex items-center gap-3">
                            <a href="{{ path('app_wellness_activite_show', {'id': activityOfTheMoment.activity.id}) }}" class="px-6 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors inline-flex items-center gap-2">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                </svg>
                                Commencer maintenant
                            </a>
                            <span class="text-sm text-muted-foreground">
                                {% if activityOfTheMoment.activity.dureeSuggeree %}
                                    {{ activityOfTheMoment.activity.dureeSuggeree }} min
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- All Recommendations -->
        <div>
            <h2 class="text-xl font-semibold text-foreground mb-4">Toutes les recommandations</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for item in smartRecommendations %}
                    {% set activite = item.activity %}
                    {% set score = item.score %}
                    {% set reason = item.reason %}
                    
                    <a href="{{ path('app_wellness_activite_show', {'id': activite.id}) }}" class="block group">
                        <div class="bg-card rounded-xl border border-border overflow-hidden h-full hover:shadow-xl hover:border-primary/50 transition-all duration-300">
                            <div class="relative h-48 overflow-hidden">
                                {% if activite.imageUrl %}
                                    <img src="{{ activite.imageUrl }}" alt="{{ activite.nomActivite }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                {% else %}
                                    <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-primary/20 to-chart-2/20"></div>
                                {% endif %}
                                <div class="absolute inset-0 bg-gradient-to-t from-card via-card/50 to-transparent"></div>
                                
                                <div class="absolute top-4 left-4 right-4 flex items-start justify-between">
                                    <span class="px-3 py-1 rounded-full backdrop-blur-sm bg-primary/90 text-primary-foreground text-sm font-semibold">
                                        {{ activite.typeActivite }}
                                    </span>
                                    <div class="px-3 py-1 rounded-full backdrop-blur-sm bg-chart-2/90 text-card text-sm font-bold flex items-center gap-1">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                                        </svg>
                                        {{ score }}%
                                    </div>
                                </div>
                            </div>
                            
                            <div class="p-5">
                                <h3 class="font-bold text-foreground text-lg group-hover:text-primary transition-colors mb-2">
                                    {{ activite.nomActivite }}
                                </h3>
                                <p class="text-sm text-muted-foreground line-clamp-2 mb-4">
                                    {{ activite.description }}
                                </p>
                                
                                <div class="flex items-start gap-2 p-3 bg-secondary/50 rounded-lg mb-4">
                                    <svg class="w-4 h-4 text-chart-4 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M12 16v-4"></path>
                                        <path d="M12 8h.01"></path>
                                    </svg>
                                    <p class="text-xs text-foreground font-medium">{{ reason }}</p>
                                </div>
                                
                                <div class="flex items-center justify-between">
                                    {% if activite.dureeSuggeree %}
                                        <span class="text-sm text-muted-foreground flex items-center gap-1">
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                            {{ activite.dureeSuggeree }} min
                                        </span>
                                    {% endif %}
                                    
                                    <div class="flex items-center gap-1 text-primary group-hover:gap-2 transition-all">
                                        <span class="text-sm font-semibold">Découvrir</span>
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="9 18 15 12 9 6"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="col-span-3 text-center py-16 bg-card rounded-lg border border-border">
                        <p class="text-muted-foreground">Aucune recommandation disponible pour le moment</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}