{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-5xl mx-auto">
    <div class="space-y-6">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-sm">
            <a href="{{ path('app_wellness') }}" class="text-muted-foreground hover:text-foreground transition-colors">
                Bien-être
            </a>
            <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <a href="{{ path('app_wellness_activites') }}" class="text-muted-foreground hover:text-foreground transition-colors">
                Activités
            </a>
            <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="text-foreground">{{ activite.nomActivite }}</span>
        </div>

        <!-- Header with Image -->
        <div class="bg-card rounded-lg border border-border overflow-hidden">
            <div class="relative h-64 md:h-80 overflow-hidden">
                {% if activite.imageUrl %}
                    <img src="{{ activite.imageUrl }}" alt="{{ activite.nomActivite }}" class="absolute inset-0 w-full h-full object-cover">
                {% else %}
                    <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-primary/20 to-chart-2/20 flex items-center justify-center">
                        <svg class="w-24 h-24 text-muted-foreground/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </div>
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-card via-card/80 to-transparent"></div>
                
                <!-- Title Overlay -->
                <div class="absolute bottom-0 left-0 right-0 p-6">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        <span class="px-3 py-1 text-sm font-semibold rounded-full bg-primary/90 text-primary-foreground backdrop-blur-sm">
                            {{ activite.typeActivite }}
                        </span>
                        {% if activite.categorie %}
                            <span class="px-3 py-1 text-sm rounded-full bg-card/90 text-foreground backdrop-blur-sm border border-border">
                                {{ activite.categorie }}
                            </span>
                        {% endif %}
                        {% if activite.niveauDifficulte %}
                            <span class="px-3 py-1 text-sm font-medium rounded-full bg-card/90 backdrop-blur-sm border
                                {% if activite.niveauDifficulte.value == 'facile' %}
                                    text-chart-2 border-chart-2
                                {% elseif activite.niveauDifficulte.value == 'modere' %}
                                    text-chart-4 border-chart-4
                                {% else %}
                                    text-destructive border-destructive
                                {% endif %}">
                                {{ activite.niveauDifficulte.value|capitalize }}
                            </span>
                        {% endif %}
                    </div>
                    <h1 class="text-3xl md:text-4xl font-serif font-bold text-foreground">
                        {{ activite.nomActivite }}
                    </h1>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-card rounded-lg border border-border p-4 text-center">
                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mx-auto mb-2">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-foreground">
                    {% if activite.dureeSuggeree %}
                        {{ activite.dureeSuggeree }}
                    {% else %}
                        -
                    {% endif %}
                </p>
                <p class="text-xs text-muted-foreground">Minutes suggérées</p>
            </div>

            <div class="bg-card rounded-lg border border-border p-4 text-center">
                <div class="w-10 h-10 rounded-lg bg-chart-2/10 flex items-center justify-center mx-auto mb-2">
                    <svg class="w-5 h-5 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <polyline points="23 20 23 14 17 14"></polyline>
                        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-foreground">{{ totalSessions }}</p>
                <p class="text-xs text-muted-foreground">Sessions effectuées</p>
            </div>

            <div class="bg-card rounded-lg border border-border p-4 text-center">
                <div class="w-10 h-10 rounded-lg bg-chart-4/10 flex items-center justify-center mx-auto mb-2">
                    <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-foreground">{{ completedSessions }}</p>
                <p class="text-xs text-muted-foreground">Complétées</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Description -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <h2 class="text-xl font-semibold text-foreground mb-4">Description</h2>
                    <p class="text-muted-foreground leading-relaxed">
                        {{ activite.description }}
                    </p>
                </div>

                <!-- Instructions -->
                {% if activite.instructionsDetaillees %}
                    <div class="bg-card rounded-lg border border-border p-6">
                        <h2 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            Instructions
                        </h2>
                        <div class="prose prose-sm max-w-none text-muted-foreground">
                            {{ activite.instructionsDetaillees|nl2br }}
                        </div>
                    </div>
                {% endif %}

                <!-- Objectif -->
                {% if activite.objectifEmotionnel %}
                    <div class="bg-card rounded-lg border border-border p-6">
                        <h2 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 16v-4"></path>
                                <path d="M12 8h.01"></path>
                            </svg>
                            Objectif émotionnel
                        </h2>
                        <p class="text-muted-foreground">
                            {{ activite.objectifEmotionnel }}
                        </p>
                    </div>
                {% endif %}
            </div>

            <!-- Right Column -->
            <div class="space-y-6">
                <!-- Start Button -->
                <div class="bg-primary text-primary-foreground rounded-lg border border-primary p-6">
                    <div class="text-center mb-4">
                        <svg class="w-12 h-12 mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="5 3 19 12 5 21 5 3"></polygon>
                        </svg>
                        <h3 class="text-lg font-semibold mb-2">Prêt à commencer ?</h3>
                        <p class="text-sm text-primary-foreground/80">
                            Lancez cette activité maintenant
                        </p>
                    </div>
                    <form method="post" action="{{ path('app_wellness_session_start', {'id': activite.id}) }}">
                        <button type="submit" class="w-full px-6 py-3 bg-primary-foreground text-primary rounded-lg font-semibold hover:bg-primary-foreground/90 transition-colors">
                            Démarrer l'activité
                        </button>
                    </form>
                </div>

                <!-- Your Stats -->
                {% if totalSessions > 0 %}
                    <div class="bg-card rounded-lg border border-border p-6">
                        <h3 class="text-lg font-semibold text-foreground mb-4">Vos statistiques</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-muted-foreground">Sessions totales</span>
                                <span class="font-semibold text-foreground">{{ totalSessions }}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-muted-foreground">Complétées</span>
                                <span class="font-semibold text-chart-2">{{ completedSessions }}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-muted-foreground">Temps total</span>
                                <span class="font-semibold text-foreground">{{ totalMinutes }} min</span>
                            </div>
                            <div class="h-2 w-full bg-secondary rounded-full overflow-hidden">
                                <div class="h-full bg-chart-2 rounded-full" style="width: {{ totalSessions > 0 ? (completedSessions / totalSessions * 100) : 0 }}%"></div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Info Card -->
                <div class="bg-secondary/50 rounded-lg border border-border p-6">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 16v-4"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                        <div class="text-sm text-muted-foreground">
                            <p class="font-medium text-foreground mb-2">Conseil</p>
                            <p>Trouvez un endroit calme et confortable pour pratiquer cette activité. Prenez le temps dont vous avez besoin.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}