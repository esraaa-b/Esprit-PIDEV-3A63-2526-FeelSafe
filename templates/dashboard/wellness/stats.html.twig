{% extends "dashboard/base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <a href="{{ path('app_wellness') }}" class="text-muted-foreground hover:text-foreground transition-colors">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </a>
                    <span class="text-sm text-muted-foreground">Bien-être</span>
                </div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Mes statistiques</h1>
                <p class="text-muted-foreground mt-1">
                    Suivez votre progression et vos accomplissements
                </p>
            </div>
            <a href="{{ path('app_wellness_sessions_history') }}" class="px-4 py-2 bg-card border border-border rounded-lg font-medium text-foreground hover:bg-secondary transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="1 4 1 10 7 10"></polyline>
                    <polyline points="23 20 23 14 17 14"></polyline>
                    <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                </svg>
                Voir l'historique
            </a>
        </div>

        <!-- Overview Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Total Sessions -->
            <div class="bg-gradient-to-br from-primary/10 to-primary/5 rounded-lg border border-primary/20 p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                        </svg>
                    </div>
                </div>
                <p class="text-3xl font-bold text-foreground mb-1">{{ totalSessions }}</p>
                <p class="text-sm text-muted-foreground">Sessions totales</p>
            </div>

            <!-- Completed Sessions -->
            <div class="bg-gradient-to-br from-chart-2/10 to-chart-2/5 rounded-lg border border-chart-2/20 p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-chart-2/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                </div>
                <p class="text-3xl font-bold text-foreground mb-1">{{ completedSessions }}</p>
                <p class="text-sm text-muted-foreground">Sessions complétées</p>
                {% if totalSessions > 0 %}
                    <div class="mt-3 h-2 w-full bg-secondary rounded-full overflow-hidden">
                        <div class="h-full bg-chart-2 rounded-full transition-all" style="width: {{ (completedSessions / totalSessions * 100) }}%"></div>
                    </div>
                {% endif %}
            </div>

            <!-- Total Minutes -->
            <div class="bg-gradient-to-br from-chart-4/10 to-chart-4/5 rounded-lg border border-chart-4/20 p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-chart-4/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>
                <p class="text-3xl font-bold text-foreground mb-1">{{ totalMinutes }}</p>
                <p class="text-sm text-muted-foreground">Minutes pratiquées</p>
                <p class="text-xs text-chart-4 mt-2 font-medium">≈ {{ (totalMinutes / 60)|round(1) }} heures</p>
            </div>

            <!-- Streak -->
            <div class="bg-gradient-to-br from-chart-1/10 to-chart-1/5 rounded-lg border border-chart-1/20 p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-chart-1/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-chart-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8.5 14.5L12 2l3.5 12.5h6.5L12 21l-3.5-6.5z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-3xl font-bold text-foreground mb-1">{{ streak }}</p>
                <p class="text-sm text-muted-foreground">Jours consécutifs</p>
                {% if streak > 0 %}
                    <p class="text-xs text-chart-1 mt-2 font-medium">🔥 Continuez comme ça !</p>
                {% endif %}
            </div>
        </div>

        <!-- Mood Evolution Chart -->
        {% if moodEvolution is not empty %}
            <div class="bg-card rounded-lg border border-border p-6">
                <h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                        <polyline points="17 6 23 6 23 12"></polyline>
                    </svg>
                    Évolution de votre humeur
                </h2>
                
                <!-- Chart Container -->
                <div class="h-64 relative">
                    <canvas id="moodChart"></canvas>
                </div>

                <!-- Legend -->
                <div class="flex items-center justify-center gap-6 mt-6 text-sm">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-primary"></div>
                        <span class="text-muted-foreground">Avant</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-chart-2"></div>
                        <span class="text-muted-foreground">Après</span>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Insights -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Average Improvement -->
            {% if moodEvolution is not empty %}
                {% set totalEvolution = 0 %}
                {% for item in moodEvolution %}
                    {% set totalEvolution = totalEvolution + item.evolution %}
                {% endfor %}
                {% set avgEvolution = (totalEvolution / moodEvolution|length)|round(1) %}
                
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-{{ avgEvolution > 0 ? 'chart-2' : 'secondary' }}/10 flex items-center justify-center flex-shrink-0">
                            {% if avgEvolution > 0 %}
                                <svg class="w-6 h-6 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="18 15 12 9 6 15"></polyline>
                                </svg>
                            {% else %}
                                <svg class="w-6 h-6 text-secondary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="8" y1="12" x2="16" y2="12"></line>
                                </svg>
                            {% endif %}
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-foreground mb-2">Amélioration moyenne</h3>
                            <p class="text-3xl font-bold {{ avgEvolution > 0 ? 'text-chart-2' : 'text-foreground' }} mb-2">
                                {{ avgEvolution > 0 ? '+' : '' }}{{ avgEvolution }}
                            </p>
                            <p class="text-sm text-muted-foreground">
                                {% if avgEvolution > 0 %}
                                    En moyenne, vos sessions améliorent votre humeur de {{ avgEvolution }} point{{ avgEvolution > 1 ? 's' : '' }} !
                                {% else %}
                                    Votre humeur reste stable pendant vos sessions.
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Completion Rate -->
            {% if totalSessions > 0 %}
                {% set completionRate = (completedSessions / totalSessions * 100)|round %}
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 6v6l4 2"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-foreground mb-2">Taux de complétion</h3>
                            <p class="text-3xl font-bold text-primary mb-2">{{ completionRate }}%</p>
                            <p class="text-sm text-muted-foreground mb-3">
                                {{ completedSessions }} sessions complétées sur {{ totalSessions }}
                            </p>
                            <div class="h-2 w-full bg-secondary rounded-full overflow-hidden">
                                <div class="h-full bg-primary rounded-full transition-all" style="width: {{ completionRate }}%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Achievements -->
        <div class="bg-card rounded-lg border border-border p-6">
            <h2 class="text-xl font-semibold text-foreground mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                </svg>
                Vos accomplissements
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- First Session -->
                <div class="p-4 rounded-lg border-2 {{ totalSessions > 0 ? 'border-chart-2 bg-chart-2/5' : 'border-border bg-secondary/50' }} transition-all">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 rounded-full {{ totalSessions > 0 ? 'bg-chart-2 text-card' : 'bg-secondary text-secondary-foreground' }} flex items-center justify-center">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-foreground">Premier pas</h3>
                            <p class="text-xs text-muted-foreground">Complétez votre 1ère session</p>
                        </div>
                    </div>
                    {% if totalSessions > 0 %}
                        <p class="text-xs text-chart-2 font-medium">✓ Débloqué !</p>
                    {% else %}
                        <p class="text-xs text-muted-foreground">À débloquer</p>
                    {% endif %}
                </div>

                <!-- 7 Day Streak -->
                <div class="p-4 rounded-lg border-2 {{ streak >= 7 ? 'border-chart-4 bg-chart-4/5' : 'border-border bg-secondary/50' }} transition-all">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 rounded-full {{ streak >= 7 ? 'bg-chart-4 text-card' : 'bg-secondary text-secondary-foreground' }} flex items-center justify-center">
                            🔥
                        </div>
                        <div>
                            <h3 class="font-semibold text-foreground">Série de 7</h3>
                            <p class="text-xs text-muted-foreground">7 jours consécutifs</p>
                        </div>
                    </div>
                    {% if streak >= 7 %}
                        <p class="text-xs text-chart-4 font-medium">✓ Débloqué !</p>
                    {% else %}
                        <p class="text-xs text-muted-foreground">{{ streak }}/7 jours</p>
                    {% endif %}
                </div>

                <!-- 10 Sessions -->
                <div class="p-4 rounded-lg border-2 {{ completedSessions >= 10 ? 'border-primary bg-primary/5' : 'border-border bg-secondary/50' }} transition-all">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 rounded-full {{ completedSessions >= 10 ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground' }} flex items-center justify-center">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-foreground">Dévoué</h3>
                            <p class="text-xs text-muted-foreground">10 sessions complétées</p>
                        </div>
                    </div>
                    {% if completedSessions >= 10 %}
                        <p class="text-xs text-primary font-medium">✓ Débloqué !</p>
                    {% else %}
                        <p class="text-xs text-muted-foreground">{{ completedSessions }}/10 sessions</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Empty State -->
        {% if totalSessions == 0 %}
            <div class="text-center py-16 bg-card rounded-lg border border-border">
                <svg class="w-20 h-20 mx-auto text-muted-foreground/30 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
                <h3 class="text-lg font-semibold text-foreground mb-2">Commencez votre parcours</h3>
                <p class="text-muted-foreground mb-6">Complétez votre première session pour voir vos statistiques</p>
                <a href="{{ path('app_wellness_activites') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    Démarrer une activité
                </a>
            </div>
        {% endif %}
    </div>
</div>

{% if moodEvolution is not empty %}
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('moodChart');
    if (!ctx) return;

    const moodData = {{ moodEvolution|json_encode|raw }};
    
    const labels = moodData.map(item => {
        const date = new Date(item.date);
        return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    });
    
    const beforeScores = moodData.map(item => item.avant);
    const afterScores = moodData.map(item => item.apres);

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Avant',
                    data: beforeScores,
                    borderColor: 'rgb(102, 126, 234)',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4,
                    fill: true
                },
                {
                    label: 'Après',
                    data: afterScores,
                    borderColor: 'rgb(16, 185, 129)',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                    padding: 12,
                    borderColor: 'rgba(255, 255, 255, 0.1)',
                    borderWidth: 1
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 10,
                    ticks: {
                        stepSize: 2
                    },
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            },
            interaction: {
                mode: 'nearest',
                axis: 'x',
                intersect: false
            }
        }
    });
});
</script>
{% endif %}
{% endblock %}