function viewRdv(id) {
    switchTab('rdv');
    document.getElementById('search-rdv').value = '#' + id;
    filterRdvTable();
}

function filterRdvTable() {
    const searchTerm = document.getElementById('search-rdv').value.toLowerCase();
    const statutFilter = document.getElementById('filter-statut').value.toLowerCase();
    
    document.querySelectorAll('#rdv-table-body tr').forEach(row => {
        const text = row.textContent.toLowerCase();
        const statutElement = row.querySelector('.bg-yellow-100, .bg-green-100, .bg-red-100, .bg-gray-100');
        const statut = statutElement ? statutElement.textContent.toLowerCase() : '';
        
        const matchesSearch = !searchTerm || text.includes(searchTerm);
        const matchesStatut = !statutFilter || statut.includes(statutFilter);
        
        row.style.display = matchesSearch && matchesStatut ? '' : 'none';
    });
}

function filterAccompTable() {
    const searchTerm = document.getElementById('search-accomp').value.toLowerCase();
    const prioriteFilter = document.getElementById('filter-priorite').value;
    
    document.querySelectorAll('#accomp-table-body tr').forEach(row => {
        const text = row.textContent.toLowerCase();
        const prioriteElement = row.querySelector('.bg-red-100, .bg-yellow-100, .bg-green-100');
        const priorite = prioriteElement ? prioriteElement.textContent.toLowerCase() : '';
        
        const matchesSearch = !searchTerm || text.includes(searchTerm);
        const matchesPriorite = !prioriteFilter || 
            (prioriteFilter == 1 && priorite.includes('haute')) ||
            (prioriteFilter == 2 && priorite.includes('moyenne')) ||
            (prioriteFilter == 3 && priorite.includes('basse'));
        
        row.style.display = matchesSearch && matchesPriorite ? '' : 'none';
    });
}

