{% extends 'admin/base.html.twig' %}

{% block title %}Gestion RDV & Accompagnement | Admin FeelSafe{% endblock %}

{% block content %}
<div class="space-y-8">
    {# Header with actions #}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <span>📅</span> Rendez-vous & Accompagnement
            </h1>
            <p class="text-sm text-gray-600 mt-1">Gérez les rendez-vous et le suivi des accompagnements</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="openModal('rdv')" 
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm">
                <span>➕</span> Nouveau RDV
            </button>
            <button onclick="openModal('accompagnement')" 
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                <span>📝</span> Nouvel Accompagnement
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col items-center text-center">
                <div class="text-3xl mb-3">📅</div>
                <div class="text-3xl font-bold text-blue-600 mb-1">{{ rendezVous|length }}</div>
                <p class="text-sm font-medium text-gray-600 mb-3">Rendez-vous total</p>
                <div class="text-xs text-gray-500 pt-3 border-t border-gray-100 w-full">
                    {% set rdvPlanifies = rendezVous|filter(rdv => rdv.statut.value == 'planifie')|length %}
                    <span>{{ rdvPlanifies }} planifiés</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col items-center text-center">
                <div class="text-3xl mb-3">👥</div>
                <div class="text-3xl font-bold text-blue-600 mb-1">{{ accompagnements|length }}</div>
                <p class="text-sm font-medium text-gray-600 mb-3">Accompagnements</p>
                <div class="text-xs text-gray-500 pt-3 border-t border-gray-100 w-full">
                    {% set accompActifs = accompagnements|filter(acc => acc.niveauPriorite <= 2)|length %}
                    <span>{{ accompActifs }} prioritaires</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col items-center text-center">
                <div class="text-3xl mb-3">✅</div>
                <div class="text-3xl font-bold text-blue-600 mb-1">{{ rendezVous|filter(rdv => rdv.statut.value == 'honore')|length }}</div>
                <p class="text-sm font-medium text-gray-600 mb-3">RDV honorés</p>
                <div class="text-xs text-gray-500 pt-3 border-t border-gray-100 w-full">
                    {% set totalRdv = rendezVous|length %}
                    {% set rdvHonores = rendezVous|filter(rdv => rdv.statut.value == 'honore')|length %}
                    <span>{{ (totalRdv > 0 ? (rdvHonores / totalRdv * 100)|round : 0) }}% de taux</span>
                </div>
            </div>
        </div>
        
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col items-center text-center">
                <div class="text-3xl mb-3">📊</div>
                <div class="text-3xl font-bold text-blue-600 mb-1">{{ utilisateurs|length }}</div>
                <p class="text-sm font-medium text-gray-600 mb-3">Utilisateurs</p>
                <div class="text-xs text-gray-500 pt-3 border-t border-gray-100 w-full">
                    <span>Tous rôles confondus</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Tabs -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="flex border-b border-gray-200 bg-gray-50/50">
            <button onclick="switchTab('rdv')" 
                    id="tab-rdv-btn"
                    class="px-6 py-4 text-sm font-medium border-b-2 transition-colors -mb-px
                           {% if current_tab is not defined or current_tab == 'rdv' %}border-blue-600 text-blue-600{% else %}border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300{% endif %}">
                Rendez-vous
            </button>
            <button onclick="switchTab('accompagnement')"
                    id="tab-accomp-btn"
                    class="px-6 py-4 text-sm font-medium border-b-2 transition-colors -mb-px
                           {% if current_tab is defined and current_tab == 'accompagnement' %}border-blue-600 text-blue-600{% else %}border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300{% endif %}">
                Accompagnements
            </button>
            <button onclick="switchTab('history')"
                    id="tab-history-btn"
                    class="px-6 py-4 text-sm font-medium border-b-2 transition-colors -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300">
                Historique
            </button>
        </div>
        
        <div id="rdv-tab" class="{% if current_tab is not defined or current_tab == 'rdv' %}block{% else %}hidden{% endif %}">
            <!-- RDV Table -->
            <div class="p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Liste des Rendez-vous</h2>
                        <p class="text-sm text-gray-600 mt-1">Gérez tous les rendez-vous du système</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="search-rdv" placeholder="Rechercher un RDV..." 
                               class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <select id="filter-statut" 
                                class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
                            <option value="">Tous les statuts</option>
                            <option value="planifie">Planifié</option>
                            <option value="honore">Honoré</option>
                            <option value="annule">Annulé</option>
                            <option value="non_honore">Non honoré</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <label class="text-sm text-gray-600">Action en masse:</label>
                        <select id="rdv-bulk-status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                            <option value="">— Changer statut —</option>
                            <option value="planifie">Planifié</option>
                            <option value="honore">Honoré</option>
                            <option value="annule">Annulé</option>
                            <option value="non_honore">Non honoré</option>
                        </select>
                        <button id="rdv-bulk-apply" class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm hover:bg-blue-700">Appliquer</button>
                        <button id="rdv-bulk-delete" class="px-3 py-2 rounded-lg bg-red-600 text-white text-sm hover:bg-red-700">Supprimer</button>
                    </div>
                    <div class="ml-auto">
                        <a href="{{ path('admin_rdv_export') }}" class="px-3 py-2 rounded-lg border border-gray-300 text-sm bg-white hover:bg-gray-50">Exporter CSV</a>
                    </div>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3"><input type="checkbox" id="rdv-select-all"></th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Professionnel</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Heure</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mode</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="rdv-table-body" class="bg-white divide-y divide-gray-200">
                            {% for rdv in rendezVous %}
                            <tr data-id="{{ rdv.id }}" class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4"><input type="checkbox" class="rdv-select" value="{{ rdv.id }}"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#{{ rdv.id }}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-xs font-medium">
                                            {{ rdv.utilisateur.prenom|first|upper }}
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">{{ rdv.utilisateur.prenom }} {{ rdv.utilisateur.nom }}</div>
                                            <div class="text-xs text-gray-500">{{ rdv.utilisateur.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-green-500 to-teal-600 rounded-full flex items-center justify-center text-white text-xs font-medium">
                                            {{ rdv.professionnel.prenom|first|upper }}
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">{{ rdv.professionnel.prenom }} {{ rdv.professionnel.nom }}</div>
                                            <div class="text-xs text-gray-500">{{ rdv.professionnel.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-col">
                                        <span class="text-sm text-gray-900">{{ rdv.dateRdv|date('d/m/Y') }}</span>
                                        <span class="text-xs text-gray-500">{{ rdv.heureRdv|date('H:i') }}</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-4 font-medium rounded-full 
                                        {{ rdv.mode.value == 'en_ligne' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800' }}">
                                        {{ rdv.mode.value == 'en_ligne' ? 'En ligne' : 'Présentiel' }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% set statutClass = {
                                        'planifie': 'bg-yellow-100 text-yellow-800',
                                        'honore': 'bg-green-100 text-green-800',
                                        'annule': 'bg-red-100 text-red-800',
                                        'non_honore': 'bg-gray-100 text-gray-800'
                                    } %}
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-4 font-medium rounded-full {{ statutClass[rdv.statut.value] }}">
                                        {{ rdv.statut.value|replace({'_': ' '})|title }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <button onclick="editRdv({{ rdv.id }})" 
                                                class="p-2 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                                                title="Modifier">
                                            <span class="text-lg">✏️</span>
                                        </button>
                                        <button onclick="deleteRdv({{ rdv.id }})" 
                                                class="p-2 text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                                title="Supprimer">
                                            <span class="text-lg">🗑️</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center">
                                        <span class="text-5xl mb-4 opacity-25">📅</span>
                                        <h3 class="text-lg font-medium text-gray-900 mb-1">Aucun rendez-vous trouvé</h3>
                                        <p class="text-sm text-gray-500 max-w-md mx-auto">
                                            Créez votre premier rendez-vous en cliquant sur le bouton "Nouveau RDV"
                                        </p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="accompagnement-tab" class="{% if current_tab is defined and current_tab == 'accompagnement' %}block{% else %}hidden{% endif %}">
            <!-- Accompagnement Table -->
            <div class="p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Liste des Accompagnements</h2>
                        <p class="text-sm text-gray-600 mt-1">Suivi des accompagnements en cours</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="search-accomp" placeholder="Rechercher..." 
                               class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <select id="filter-priorite" 
                                class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
                            <option value="">Toutes priorités</option>
                            <option value="1">Haute priorité</option>
                            <option value="2">Priorité moyenne</option>
                            <option value="3">Basse priorité</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <label class="text-sm text-gray-600">Priorité (masse):</label>
                        <select id="accomp-bulk-priority" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                            <option value="">— Définir priorité —</option>
                            <option value="1">Haute</option>
                            <option value="2">Moyenne</option>
                            <option value="3">Basse</option>
                        </select>
                        <button id="accomp-bulk-apply" class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm hover:bg-blue-700">Appliquer</button>
                        <button id="accomp-bulk-delete" class="px-3 py-2 rounded-lg bg-red-600 text-white text-sm hover:bg-red-700">Supprimer</button>
                    </div>
                    <div class="ml-auto">
                        <a href="{{ path('admin_accompagnement_export') }}" class="px-3 py-2 rounded-lg border border-gray-300 text-sm bg-white hover:bg-gray-50">Exporter CSV</a>
                    </div>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3"><input type="checkbox" id="accomp-select-all"></th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Utilisateur</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">RDV lié</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prochain RDV</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priorité</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Objectifs</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="accomp-table-body" class="bg-white divide-y divide-gray-200">
                            {% for accomp in accompagnements %}
                            <tr data-id="{{ accomp.id }}" class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4"><input type="checkbox" class="accomp-select" value="{{ accomp.id }}"></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#{{ accomp.id }}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-xs font-medium">
                                            {{ accomp.utilisateur.prenom|first|upper }}
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">{{ accomp.utilisateur.prenom }} {{ accomp.utilisateur.nom }}</div>
                                            <div class="text-xs text-gray-500">{{ accomp.utilisateur.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="javascript:void(0)" onclick="viewRdv({{ accomp.rendezvous.id }})" 
                                       class="text-sm text-blue-600 hover:text-blue-800 hover:underline">
                                        RDV #{{ accomp.rendezvous.id }} ({{ accomp.rendezvous.dateRdv|date('d/m/Y') }})
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if accomp.prochainRdv.value == 'oui' and accomp.dateProchainRdv %}
                                        <div class="flex flex-col">
                                            <span class="text-sm text-gray-900">{{ accomp.dateProchainRdv|date('d/m/Y') }}</span>
                                            <span class="text-xs text-gray-500">Planifié</span>
                                        </div>
                                    {% else %}
                                        <span class="px-2.5 py-1 inline-flex text-xs leading-4 font-medium rounded-full bg-gray-100 text-gray-800">
                                            Non planifié
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% set prioriteClass = {
                                        1: 'bg-red-100 text-red-800',
                                        2: 'bg-yellow-100 text-yellow-800',
                                        3: 'bg-green-100 text-green-800'
                                    } %}
                                    <span class="px-2.5 py-1 inline-flex text-xs leading-4 font-medium rounded-full {{ prioriteClass[accomp.niveauPriorite] }}">
                                        {% if accomp.niveauPriorite == 1 %}Haute
                                        {% elseif accomp.niveauPriorite == 2 %}Moyenne
                                        {% else %}Basse
                                        {% endif %}
                                    </span>
                                </td>
                                <td class="px-6 py-4 max-w-xs">
                                    <div class="text-sm text-gray-600 truncate" title="{{ accomp.objectifs|default('Aucun objectif défini') }}">
                                        {{ accomp.objectifs|default('Aucun objectif')|slice(0, 50) }}{% if accomp.objectifs and accomp.objectifs|length > 50 %}...{% endif %}
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <button onclick="editAccompagnement({{ accomp.id }})" 
                                                class="p-2 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                                                title="Modifier">
                                            <span class="text-lg">✏️</span>
                                        </button>
                                        <button onclick="deleteAccompagnement({{ accomp.id }})" 
                                                class="p-2 text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                                title="Supprimer">
                                            <span class="text-lg">🗑️</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center">
                                        <span class="text-5xl mb-4 opacity-25">📝</span>
                                        <h3 class="text-lg font-medium text-gray-900 mb-1">Aucun accompagnement trouvé</h3>
                                        <p class="text-sm text-gray-500 max-w-md mx-auto">
                                            Créez votre premier accompagnement pour commencer le suivi
                                        </p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="history-tab" class="hidden">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Historique des actions RDV</h2>
                        <p class="text-sm text-gray-600 mt-1">Créations, mises à jour, annulations…</p>
                    </div>
                    <button id="history-clear" class="px-3 py-2 rounded-lg border border-gray-300 text-sm bg-white hover:bg-gray-50">Vider l'historique</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Professionnel</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">RDV</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ancien</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nouveau</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Commentaire</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="history-body" class="bg-white divide-y divide-gray-200"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="rdv-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-900 bg-opacity-75 transition-opacity" onclick="closeModal('rdv')"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl w-full">
