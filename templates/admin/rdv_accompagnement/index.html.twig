<!-- Notification container -->
<div id="notification-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

<script>
let currentDeleteAction = null;
let currentDeleteId = null;
let currentTab = 'rdv';

document.addEventListener('DOMContentLoaded', function() {
    // Initialize tabs
    switchTab('rdv');
    
    // Setup event listeners
    document.getElementById('filter-statut').addEventListener('change', filterRdvTable);
    document.getElementById('filter-priorite').addEventListener('change', filterAccompTable);
    document.getElementById('search-rdv').addEventListener('input', filterRdvTable);
    document.getElementById('search-accomp').addEventListener('input', filterAccompTable);
    
    // Setup prochain RDV toggle
    document.getElementById('accomp-prochain-rdv').addEventListener('change', function() {
        const dateContainer = document.getElementById('prochain-rdv-date-container');
        dateContainer.style.display = this.value === 'oui' ? 'block' : 'none';
    });
    
    // Set default date to today for RDV
    const today = new Date().toISOString().split('T')[0];
    const rdvDate = document.getElementById('rdv-date');
    if (rdvDate) rdvDate.min = today;
    
    // Set default date to tomorrow for accompagnement
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const accompDate = document.getElementById('accomp-prochain-date');
    if (accompDate) accompDate.min = tomorrow.toISOString().split('T')[0];
});

function switchTab(tabName) {
    currentTab = tabName;
    
    // Update tab buttons
    document.getElementById('tab-rdv-btn').classList.toggle('border-blue-600', tabName === 'rdv');
    document.getElementById('tab-rdv-btn').classList.toggle('text-blue-600', tabName === 'rdv');
    document.getElementById('tab-rdv-btn').classList.toggle('border-transparent', tabName !== 'rdv');
    document.getElementById('tab-rdv-btn').classList.toggle('text-gray-600', tabName !== 'rdv');
    
    document.getElementById('tab-accomp-btn').classList.toggle('border-blue-600', tabName === 'accompagnement');
    document.getElementById('tab-accomp-btn').classList.toggle('text-blue-600', tabName === 'accompagnement');
    document.getElementById('tab-accomp-btn').classList.toggle('border-transparent', tabName !== 'accompagnement');
    document.getElementById('tab-accomp-btn').classList.toggle('text-gray-600', tabName !== 'accompagnement');
    document.getElementById('tab-history-btn').classList.toggle('border-blue-600', tabName === 'history');
    document.getElementById('tab-history-btn').classList.toggle('text-blue-600', tabName === 'history');
    document.getElementById('tab-history-btn').classList.toggle('border-transparent', tabName !== 'history');
    document.getElementById('tab-history-btn').classList.toggle('text-gray-600', tabName !== 'history');
    
    // Update tab content
    document.getElementById('rdv-tab').classList.toggle('hidden', tabName !== 'rdv');
    document.getElementById('accompagnement-tab').classList.toggle('hidden', tabName !== 'accompagnement');
    document.getElementById('history-tab').classList.toggle('hidden', tabName !== 'history');
    if (tabName === 'history') loadHistory();
}

async function loadHistory(){
    try{
        const res = await fetch('{{ path('admin_history_list') }}', { headers:{'X-Requested-With':'XMLHttpRequest', 'Accept':'application/json'} });
        let data = null;
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
            data = await res.json();
        } else {
            const txt = await res.text();
            document.getElementById('history-body').innerHTML = '<tr><td colspan="9" class="px-6 py-4 text-center text-sm text-red-600">Erreur: réponse non JSON</td></tr>';
            return;
        }
        const tbody = document.getElementById('history-body');
        tbody.innerHTML = '';
        if(!data.success){ tbody.innerHTML = '<tr><td colspan="9" class="px-6 py-4 text-center text-sm text-gray-500">Erreur</td></tr>'; return; }
        const items = data.items || [];
        if(items.length === 0){ tbody.innerHTML = '<tr><td colspan="9" class="px-6 py-4 text-center text-sm text-gray-500">Aucune action</td></tr>'; return; }
        items.forEach(i=>{
            const tr = document.createElement('tr');
            const actionClass = i.action==='accept'?'bg-blue-100 text-blue-700':(i.action==='update'?'bg-yellow-100 text-yellow-700':(i.action==='refuse'?'bg-red-100 text-red-700':'bg-gray-100 text-gray-700'));
            const rdvLabel = (i.date_rdv && i.heure_rdv) ? (new Date(i.date_rdv).toLocaleDateString('fr-FR')+' '+new Date(i.heure_rdv).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})) : '—';
            tr.innerHTML = `
                <td class="px-6 py-4 text-sm text-gray-700">${ i.date_action ? new Date(i.date_action).toLocaleDateString('fr-FR')+' '+new Date(i.date_action).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) : '—' }</td>
                <td class="px-6 py-4 text-sm"><span class="text-xs px-2 py-1 rounded-full ${actionClass}">${ i.action }</span></td>
                <td class="px-6 py-4 text-sm text-gray-700">${ (i.pro_prenom||'')+' '+(i.pro_nom||'') }</td>
                <td class="px-6 py-4 text-sm text-gray-700">${ (i.client_prenom||'')+' '+(i.client_nom||'') }</td>
                <td class="px-6 py-4 text-sm text-gray-700">${ rdvLabel }</td>
                <td class="px-6 py-4 text-sm text-gray-700">${ i.ancien_statut || '—' }</td>
                <td class="px-6 py-4 text-sm text-gray-700">${ i.nouveau_statut || '—' }</td>
                <td class="px-6 py-4 text-sm text-gray-700">${ i.commentaire || '—' }</td>
                <td class="px-6 py-4"><button class="px-3 py-1 rounded border text-sm" data-delete="${ i.id }">Supprimer</button></td>
            `;
            tbody.appendChild(tr);
        });
        tbody.querySelectorAll('button[data-delete]').forEach(btn=>{
            btn.addEventListener('click', async ()=>{
                if(!confirm('Supprimer cet enregistrement ?')) return;
                const id = btn.getAttribute('data-delete');
                const r = await fetch('{{ path('admin_history_delete', { id: 0 })|replace({'0':'__ID__'}) }}'.replace('__ID__', id), { method:'DELETE', headers:{'X-Requested-With':'XMLHttpRequest'} });
                const d = await r.json();
                if(d && d.success){ btn.closest('tr').remove(); }
                else alert('Suppression impossible');
            });
        });
        document.getElementById('history-clear').onclick = async function(){
            if(!confirm('Vider tout l’historique ?')) return;
            const r = await fetch('{{ path('admin_history_clear') }}', { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} });
            const d = await r.json();
            if(d && d.success){ loadHistory(); }
            else alert('Erreur');
        };
    }catch(e){
        document.getElementById('history-body').innerHTML = '<tr><td colspan="9" class="px-6 py-4 text-center text-sm text-gray-500">Erreur: '+e.message+'</td></tr>';
    }
}

function openModal(modalType) {
    closeAllModals();
    
    if (modalType === 'rdv') {
        resetRdvForm();
        document.getElementById('rdv-modal-title').textContent = 'Nouveau Rendez-vous';
        document.getElementById('rdv-modal').classList.remove('hidden');
    } else if (modalType === 'accompagnement') {
        resetAccompForm();
        document.getElementById('accomp-modal-title').textContent = 'Nouvel Accompagnement';
        document.getElementById('accompagnement-modal').classList.remove('hidden');
    }
}

function closeModal(modalType) {
    if (modalType === 'rdv') {
        document.getElementById('rdv-modal').classList.add('hidden');
    } else if (modalType === 'accompagnement') {
        document.getElementById('accompagnement-modal').classList.add('hidden');
    } else if (modalType === 'confirm') {
        document.getElementById('confirm-modal').classList.add('hidden');
    }
}

function closeAllModals() {
    document.getElementById('rdv-modal').classList.add('hidden');
    document.getElementById('accompagnement-modal').classList.add('hidden');
    document.getElementById('confirm-modal').classList.add('hidden');
}

function resetRdvForm() {
    document.getElementById('rdv-form').reset();
    document.getElementById('rdv-id').value = '';
    document.getElementById('rdv-statut').value = 'planifie';
    
    // Set default date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('rdv-date').value = today;
    document.getElementById('rdv-time').value = '09:00';
}

function resetAccompForm() {
    document.getElementById('accomp-form').reset();
    document.getElementById('accomp-id').value = '';
    document.getElementById('accomp-priorite').value = '3';
    document.getElementById('accomp-prochain-rdv').value = 'non';
    document.getElementById('prochain-rdv-date-container').style.display = 'none';
    
    // Set default date to tomorrow
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    document.getElementById('accomp-prochain-date').valueAsDate = tomorrow;
}

async function saveRdv() {
    const rdvId = document.getElementById('rdv-id').value;
    const isEdit = rdvId !== '';
    
    const formData = {
        utilisateur_id: document.getElementById('rdv-utilisateur').value,
        professionnel_id: document.getElementById('rdv-professionnel').value,
        date_rdv: document.getElementById('rdv-date').value,
        heure_rdv: document.getElementById('rdv-time').value,
        mode: document.getElementById('rdv-mode').value,
        localisation: document.getElementById('rdv-localisation').value,
        statut: document.getElementById('rdv-statut').value,
        commentaire: document.getElementById('rdv-commentaire').value
    };
    
    // Validation
    if (!formData.utilisateur_id || !formData.professionnel_id || !formData.date_rdv || !formData.heure_rdv || !formData.mode || !formData.statut) {
        showNotification('Veuillez remplir tous les champs obligatoires (*)', 'error');
        return;
    }
    
    const url = isEdit ? 
        `/admin/rdv-accompagnement/rdv/${rdvId}/edit` :
        '/admin/rdv-accompagnement/rdv/new';
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            showNotification(data.message, 'success');
            closeModal('rdv');
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        showNotification('Erreur réseau: ' + error.message, 'error');
    }
}

async function saveAccompagnement() {
    const accompId = document.getElementById('accomp-id').value;
    const isEdit = accompId !== '';
    
    const formData = {
        rendezvous_id: document.getElementById('accomp-rendezvous').value,
        utilisateur_id: document.getElementById('accomp-utilisateur').value,
        prochain_rdv: document.getElementById('accomp-prochain-rdv').value,
        date_prochain_rdv: document.getElementById('accomp-prochain-date').value,
        objectifs: document.getElementById('accomp-objectifs').value,
        notes_suivi: document.getElementById('accomp-notes').value,
        niveau_priorite: document.getElementById('accomp-priorite').value
    };
    
    // Validation
    if (!formData.rendezvous_id || !formData.utilisateur_id) {
        showNotification('Veuillez remplir tous les champs obligatoires (*)', 'error');
        return;
    }
    
    if (formData.prochain_rdv === 'non') {
        formData.date_prochain_rdv = null;
    }
    
    const url = isEdit ? 
        `/admin/rdv-accompagnement/accompagnement/${accompId}/edit` :
        '/admin/rdv-accompagnement/accompagnement/new';
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            showNotification(data.message, 'success');
            closeModal('accompagnement');
            setTimeout(() => {
                window.location.reload();
            }, 1500);
        } else {
            showNotification(data.message, 'error');
        }
    } catch (error) {
        showNotification('Erreur réseau: ' + error.message, 'error');
    }
}

async function editRdv(id) {
