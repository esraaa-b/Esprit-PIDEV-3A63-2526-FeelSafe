{% extends 'admin/base.html.twig' %}

{% block title %}Historique des actions RDV{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <span>🕘</span> Historique des actions RDV
            </h1>
            <p class="text-sm text-gray-600 mt-1">Voir toutes les actions sur les rendez-vous (création, mise à jour, annulation, etc.)</p>
        </div>
        <button id="clear-history" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors shadow-sm">
            <span>🗑️</span> Vider l'historique
        </button>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Professionnel</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Client</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">RDV</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ancien statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nouveau statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Commentaire</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                {% for i in items %}
                    <tr data-id="{{ i.id }}">
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.date_action ? i.date_action|date('d/m/Y H:i') : '—' }}</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="text-xs px-2 py-1 rounded-full
                                {% if i.action == 'accept' %}bg-blue-100 text-blue-700
                                {% elseif i.action == 'update' %}bg-yellow-100 text-yellow-700
                                {% elseif i.action == 'refuse' %}bg-red-100 text-red-700
                                {% else %}bg-gray-100 text-gray-700{% endif %}">
                                {{ i.action }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.pro_prenom ~ ' ' ~ i.pro_nom }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.client_prenom ~ ' ' ~ i.client_nom }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">
                            {% if i.date_rdv and i.heure_rdv %}
                                {{ i.date_rdv|date('d/m/Y') }} {{ i.heure_rdv|date('H:i') }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.ancien_statut ?: '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.nouveau_statut ?: '—' }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ i.commentaire ?: '—' }}</td>
                        <td class="px-6 py-4">
                            <button class="btn btn-outline btn-sm" data-delete>Supprimer</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="px-6 py-4 text-center text-sm text-gray-500">Aucune action enregistrée</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.getElementById('clear-history').addEventListener('click', async function(){
    if(!confirm('Confirmer la suppression de tout l’historique ?')) return;
    try{
        const res = await fetch('{{ path('admin_history_clear') }}', { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} });
        const data = await res.json();
        if(data && data.success){ location.reload(); }
        else { alert('Erreur'); }
    }catch(e){ alert('Erreur: '+e.message); }
});
document.querySelectorAll('button[data-delete]').forEach(btn=>{
    btn.addEventListener('click', async function(){
        const tr = btn.closest('tr'); const id = tr && tr.getAttribute('data-id');
        if(!id) return;
        if(!confirm('Supprimer cet enregistrement ?')) return;
        try{
            const res = await fetch('{{ path('admin_history_delete', { id: 0 })|replace({'0':'__ID__'}) }}'.replace('__ID__', id), { method:'DELETE', headers:{'X-Requested-With':'XMLHttpRequest'} });
            const data = await res.json();
            if(data && data.success){ tr.remove(); }
            else { alert('Suppression impossible'); }
        }catch(e){ alert('Erreur: '+e.message); }
    });
});
</script>
{% endblock %}

