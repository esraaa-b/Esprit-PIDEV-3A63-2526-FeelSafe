{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle Activité{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <!-- En-tête -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header animate__animated animate__fadeInDown">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="header-icon-wrapper bg-gradient-primary">
                            <i class="fas fa-plus-circle"></i>
                        </div>
                        <div class="ms-3">
                            <h1 class="h3 mb-0 fw-bold">Créer une nouvelle activité</h1>
                            <p class="text-muted mb-0">Ajoutez une activité au catalogue de bien-être</p>
                        </div>
                    </div>
                    <a href="{{ path('admin_wellness_activites') }}" class="btn-back">
                        <i class="fas fa-arrow-left me-2"></i>
                        Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire -->
    <form method="post" class="animate__animated animate__fadeInUp">
        <div class="row g-4">
            <!-- Colonne Gauche -->
            <div class="col-lg-8">
                <!-- Informations de base -->
                <div class="form-card mb-4">
                    <div class="form-card-header">
                        <i class="fas fa-info-circle me-2"></i>
                        <h5>Informations de base</h5>
                    </div>
                    <div class="form-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label for="nom_activite" class="form-label-modern">
                                        <i class="fas fa-heading me-1"></i>
                                        Nom de l'activité <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-modern" id="nom_activite" name="nom_activite" placeholder="Ex: Méditation guidée" required>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label for="type_activite" class="form-label-modern">
                                        <i class="fas fa-tag me-1"></i>
                                        Type d'activité <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control-modern" id="type_activite" name="type_activite" placeholder="Ex: Méditation, Sport, Yoga" required>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div class="form-group-modern">
                                    <label for="description" class="form-label-modern">
                                        <i class="fas fa-align-left me-1"></i>
                                        Description
                                    </label>
                                    <textarea class="form-control-modern" id="description" name="description" rows="4" placeholder="Décrivez brièvement cette activité..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Détails de l'activité -->
                <div class="form-card mb-4">
                    <div class="form-card-header">
                        <i class="fas fa-sliders-h me-2"></i>
                        <h5>Détails de l'activité</h5>
                    </div>
                    <div class="form-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group-modern">
                                    <label for="duree_suggeree" class="form-label-modern">
                                        <i class="fas fa-clock me-1"></i>
                                        Durée suggérée (min)
                                    </label>
                                    <input type="number" class="form-control-modern" id="duree_suggeree" name="duree_suggeree" min="1" placeholder="15">
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group-modern">
                                    <label for="categorie" class="form-label-modern">
                                        <i class="fas fa-folder me-1"></i>
                                        Catégorie
                                    </label>
                                    <input type="text" class="form-control-modern" id="categorie" name="categorie" placeholder="Ex: Relaxation, Énergisante">
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group-modern">
                                    <label for="niveau_difficulte" class="form-label-modern">
                                        <i class="fas fa-signal me-1"></i>
                                        Niveau de difficulté
                                    </label>
                                    <select class="form-select-modern" id="niveau_difficulte" name="niveau_difficulte">
                                        <option value="">Sélectionner...</option>
                                        {% for niveau in niveauxDifficulte %}
                                            <option value="{{ niveau.value }}">{{ niveau.value|capitalize }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div class="form-group-modern">
                                    <label for="objectif_emotionnel" class="form-label-modern">
                                        <i class="fas fa-bullseye me-1"></i>
                                        Objectif émotionnel
                                    </label>
                                    <input type="text" class="form-control-modern" id="objectif_emotionnel" name="objectif_emotionnel" placeholder="Ex: Réduire l'anxiété, Améliorer l'humeur">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Instructions détaillées -->
                <div class="form-card">
                    <div class="form-card-header">
                        <i class="fas fa-list-ol me-2"></i>
                        <h5>Instructions détaillées</h5>
                    </div>
                    <div class="form-card-body">
                        <div class="form-group-modern">
                            <label for="instructions_detaillees" class="form-label-modern">
                                <i class="fas fa-file-alt me-1"></i>
                                Étapes à suivre
                            </label>
                            <textarea class="form-control-modern" id="instructions_detaillees" name="instructions_detaillees" rows="8" placeholder="1. Trouvez un endroit calme
2. Asseyez-vous confortablement
3. Fermez les yeux..."></textarea>
                            <small class="form-text">Décrivez les étapes détaillées pour réaliser cette activité</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne Droite -->
            <div class="col-lg-4">
                <!-- Image -->
                <div class="form-card mb-4">
                    <div class="form-card-header">
                        <i class="fas fa-image me-2"></i>
                        <h5>Image</h5>
                    </div>
                    <div class="form-card-body">
                        <div class="form-group-modern">
                            <label for="image_url" class="form-label-modern">
                                <i class="fas fa-link me-1"></i>
                                URL de l'image
                            </label>
                            <input type="url" class="form-control-modern" id="image_url" name="image_url" placeholder="https://exemple.com/image.jpg">
                            <small class="form-text">Lien vers une image illustrative</small>
                        </div>
                        <div class="image-preview mt-3">
                            <div class="preview-placeholder">
                                <i class="fas fa-image"></i>
                                <p>Aperçu de l'image</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Paramètres -->
                <div class="form-card">
                    <div class="form-card-header">
                        <i class="fas fa-cog me-2"></i>
                        <h5>Paramètres</h5>
                    </div>
                    <div class="form-card-body">
                        <div class="switch-group">
                            <div class="switch-item">
                                <div class="switch-info">
                                    <i class="fas fa-star text-warning"></i>
                                    <div>
                                        <h6>Activité prédéfinie</h6>
                                        <p>Cette activité fait partie du catalogue</p>
                                    </div>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" id="est_predefinie" name="est_predefinie" value="1" checked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                            
                            <div class="switch-item">
                                <div class="switch-info">
                                    <i class="fas fa-check-circle text-success"></i>
                                    <div>
                                        <h6>Activité active</h6>
                                        <p>Visible pour les utilisateurs</p>
                                    </div>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" id="est_active" name="est_active" value="1" checked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bouton de soumission -->
                <div class="action-buttons mt-4">
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save me-2"></i>
                        Créer l'activité
                    </button>
                    <a href="{{ path('admin_wellness_activites') }}" class="btn-cancel">
                        <i class="fas fa-times me-2"></i>
                        Annuler
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
/* Page Header - Réutilisé */
.page-header {
    background: white;
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.header-icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: white;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-back {
    padding: 0.75rem 1.5rem;
    background: white;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
}

.btn-back:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #475569;
}

/* Form Card */
.form-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

.form-card-header {
    padding: 1.5rem;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
}

.form-card-header i {
    color: #667eea;
    font-size: 1.2rem;
}

.form-card-header h5 {
    margin: 0;
    font-weight: 700;
    color: #1e293b;
}

.form-card-body {
    padding: 2rem;
}

/* Form Elements */
.form-group-modern {
    margin-bottom: 1.5rem;
}

.form-label-modern {
    display: flex;
    align-items: center;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
}

.form-label-modern i {
    color: #94a3b8;
}

.form-control-modern,
.form-select-modern {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    background: white;
}

.form-control-modern:focus,
.form-select-modern:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-control-modern::placeholder {
    color: #cbd5e1;
}

textarea.form-control-modern {
    resize: vertical;
    min-height: 100px;
}

.form-text {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #94a3b8;
}

/* Image Preview */
.image-preview {
    border-radius: 12px;
    overflow: hidden;
    background: #f8fafc;
    border: 2px dashed #e2e8f0;
}

.preview-placeholder {
    padding: 3rem 1rem;
    text-align: center;
    color: #cbd5e1;
}

.preview-placeholder i {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.preview-placeholder p {
    margin: 0;
    font-size: 0.9rem;
}

/* Switch Group */
.switch-group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.switch-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    background: #f8fafc;
    border-radius: 12px;
    transition: all 0.3s ease;
}

.switch-item:hover {
    background: #f1f5f9;
}

.switch-info {
    display: flex;
    gap: 1rem;
    flex: 1;
}

.switch-info i {
    font-size: 1.5rem;
    margin-top: 0.25rem;
}

.switch-info h6 {
    margin: 0 0 0.25rem 0;
    font-weight: 600;
    color: #1e293b;
    font-size: 0.95rem;
}

.switch-info p {
    margin: 0;
    font-size: 0.85rem;
    color: #64748b;
}

/* Toggle Switch */
.switch {
    position: relative;
    display: inline-block;
    width: 52px;
    height: 28px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #cbd5e1;
    transition: 0.4s;
    border-radius: 28px;
}

.slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: 0.4s;
    border-radius: 50%;
}

input:checked + .slider {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

input:checked + .slider:before {
    transform: translateX(24px);
}

/* Action Buttons */
.action-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.btn-submit {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

.btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.btn-cancel {
    width: 100%;
    padding: 1rem;
    background: white;
    color: #64748b;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-cancel:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #475569;
}

/* Animations */
.animate__animated {
    animation-duration: 0.6s;
}

@media (max-width: 992px) {
    .form-card-body {
        padding: 1.5rem;
    }
}
</style>

<script>
// Prévisualisation de l'image
document.getElementById('image_url').addEventListener('input', function() {
    const url = this.value;
    const preview = document.querySelector('.preview-placeholder');
    
    if (url) {
        preview.innerHTML = `<img src="${url}" alt="Preview" style="width: 100%; height: auto; display: block;" onerror="this.parentElement.innerHTML='<i class=\'fas fa-exclamation-triangle\'></i><p>Image non disponible</p>'">`;
    } else {
        preview.innerHTML = '<i class="fas fa-image"></i><p>Aperçu de l\'image</p>';
    }
});
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
{% endblock %}