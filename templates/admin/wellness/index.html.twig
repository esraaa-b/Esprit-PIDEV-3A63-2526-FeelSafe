{% extends 'admin/base.html.twig' %}

{% block title %}Wellness - Tableau de bord{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <!-- En-tête avec Animation -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="header-wellness animate__animated animate__fadeInDown">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <div class="icon-wrapper bg-gradient-success me-3">
                                <i class="fas fa-spa"></i>
                            </div>
                            <div>
                                <h1 class="h2 mb-0 fw-bold">Module Wellness</h1>
                                <p class="text-muted mb-0">Activités de Bien-être et Suivi Émotionnel</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="badge-status">
                            <i class="fas fa-circle pulse-dot"></i>
                            Actif
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques Améliorées avec Animations -->
    <div class="row g-4 mb-4">
        <!-- Card 1 -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card stats-card-primary animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                <div class="stats-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <p class="stats-label">TOTAL ACTIVITÉS</p>
                            <h2 class="stats-value">{{ statsActivites.total }}</h2>
                            <div class="stats-info">
                                <i class="fas fa-check-circle"></i>
                                <span>{{ statsActivites.actives }} actives</span>
                            </div>
                        </div>
                        <div class="stats-icon bg-primary">
                            <i class="fas fa-dumbbell"></i>
                        </div>
                    </div>
                    <div class="stats-progress">
                        <div class="progress-bar bg-primary" style="width: {{ statsActivites.total > 0 ? (statsActivites.actives / statsActivites.total * 100) : 0 }}%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card stats-card-success animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                <div class="stats-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <p class="stats-label">TOTAL SESSIONS</p>
                            <h2 class="stats-value">{{ statsSessions.total }}</h2>
                            <div class="stats-info">
                                <i class="fas fa-check-circle"></i>
                                <span>{{ statsSessions.completees }} complétées</span>
                            </div>
                        </div>
                        <div class="stats-icon bg-success">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                    <div class="stats-progress">
                        <div class="progress-bar bg-success" style="width: {{ statsSessions.total > 0 ? (statsSessions.completees / statsSessions.total * 100) : 0 }}%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card stats-card-warning animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
                <div class="stats-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <p class="stats-label">EN COURS</p>
                            <h2 class="stats-value">{{ statsSessions.en_cours }}</h2>
                            <div class="stats-info">
                                <i class="fas fa-clock"></i>
                                <span>Sessions actives</span>
                            </div>
                        </div>
                        <div class="stats-icon bg-warning">
                            <i class="fas fa-hourglass-half"></i>
                        </div>
                    </div>
                    <div class="stats-progress">
                        <div class="progress-bar bg-warning" style="width: 60%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card stats-card-info animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
                <div class="stats-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1">
                            <p class="stats-label">CATALOGUE</p>
                            <h2 class="stats-value">{{ statsActivites.predefinies }}</h2>
                            <div class="stats-info">
                                <i class="fas fa-star"></i>
                                <span>Prédéfinies</span>
                            </div>
                        </div>
                        <div class="stats-icon bg-info">
                            <i class="fas fa-book-open"></i>
                        </div>
                    </div>
                    <div class="stats-progress">
                        <div class="progress-bar bg-info" style="width: 85%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions Rapides Stylées -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="action-card animate__animated animate__fadeInUp" style="animation-delay: 0.5s;">
                <div class="action-header">
                    <i class="fas fa-bolt"></i>
                    <h5>Actions rapides</h5>
                </div>
                <div class="action-buttons">
                    <a href="{{ path('admin_wellness_activites_new') }}" class="btn-modern btn-modern-primary">
                        <div class="btn-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <div class="btn-content">
                            <span class="btn-title">Nouvelle Activité</span>
                            <span class="btn-subtitle">Créer une activité</span>
                        </div>
                        <i class="fas fa-arrow-right btn-arrow"></i>
                    </a>
                    
                    <a href="{{ path('admin_wellness_activites') }}" class="btn-modern btn-modern-secondary">
                        <div class="btn-icon">
                            <i class="fas fa-th-list"></i>
                        </div>
                        <div class="btn-content">
                            <span class="btn-title">Voir Activités</span>
                            <span class="btn-subtitle">{{ statsActivites.total }} activités</span>
                        </div>
                        <i class="fas fa-arrow-right btn-arrow"></i>
                    </a>
                    
                    <a href="{{ path('admin_wellness_sessions') }}" class="btn-modern btn-modern-success">
                        <div class="btn-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="btn-content">
                            <span class="btn-title">Voir Sessions</span>
                            <span class="btn-subtitle">{{ statsSessions.total }} sessions</span>
                        </div>
                        <i class="fas fa-arrow-right btn-arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Récentes Ultra Stylées -->
    <div class="row">
        <div class="col-12">
            <div class="sessions-card animate__animated animate__fadeInUp" style="animation-delay: 0.6s;">
                <div class="sessions-header">
                    <div class="d-flex align-items-center">
                        <div class="header-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">Sessions récentes</h5>
                            <p class="mb-0">7 derniers jours</p>
                        </div>
                    </div>
                    <a href="{{ path('admin_wellness_sessions') }}" class="btn-link-modern">
                        Voir tout
                        <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
                
                {% if sessionsRecentes is not empty %}
                    <div class="sessions-list">
                        {% for session in sessionsRecentes %}
                            <div class="session-item">
                                <div class="session-info">
                                    <div class="session-user">
                                        <div class="user-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="user-details">
                                            <h6 class="mb-0">{{ session.utilisateur.nom }} {{ session.utilisateur.prenom }}</h6>
                                            <small class="text-muted">{{ session.utilisateur.email }}</small>
                                        </div>
                                    </div>
                                    
                                    <div class="session-activity">
                                        <span class="activity-badge">
                                            <i class="fas fa-dumbbell me-1"></i>
                                            {{ session.activite.nomActivite }}
                                        </span>
                                    </div>
                                    
                                    <div class="session-status">
                                        <span class="status-badge status-{{ session.statutSession.value }}">
                                            <i class="fas fa-{{ session.statutSession.value == 'completee' ? 'check-circle' : (session.statutSession.value == 'en_cours' ? 'clock' : 'circle') }}"></i>
                                            {{ session.statutSession.value|replace({'_': ' '})|capitalize }}
                                        </span>
                                    </div>
                                    
                                    <div class="session-mood">
                                        {% if session.humeurAvant %}
                                            <div class="mood-indicator">
                                                <span class="mood-label">Avant</span>
                                                <span class="mood-value mood-{{ session.humeurAvant.value }}">
                                                    {{ session.scoreHumeurAvant ?? '?' }}/10
                                                </span>
                                            </div>
                                        {% endif %}
                                        
                                        {% if session.humeurApres %}
                                            <i class="fas fa-arrow-right text-muted mx-2"></i>
                                            <div class="mood-indicator">
                                                <span class="mood-label">Après</span>
                                                <span class="mood-value mood-{{ session.humeurApres.value }}">
                                                    {{ session.scoreHumeurApres ?? '?' }}/10
                                                </span>
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="session-date">
                                        <i class="fas fa-calendar-alt me-1"></i>
                                        {{ session.dateDebut|date('d/m/Y H:i') }}
                                    </div>
                                    
                                    <div class="session-actions">
                                        <a href="{{ path('admin_wellness_sessions_show', {'id': session.id}) }}" class="btn-action" title="Voir détails">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-inbox"></i>
                        </div>
                        <h5>Aucune session récente</h5>
                        <p>Les sessions apparaîtront ici lorsque les utilisateurs commenceront à utiliser l'application.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
/* ========== ANIMATIONS ========== */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.5;
    }
}

@keyframes slideIn {
    from {
        transform: translateX(-10px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.animate__animated {
    animation-duration: 0.8s;
    animation-fill-mode: both;
}

.animate__fadeInDown {
    animation-name: fadeInUp;
}

.animate__fadeInUp {
    animation-name: fadeInUp;
}

/* ========== HEADER ========== */
.header-wellness {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2rem;
    border-radius: 20px;
    color: white;
    box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
}

.icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
}

.badge-status {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.pulse-dot {
    animation: pulse 2s infinite;
    color: #4ade80;
}

/* ========== STATS CARDS ========== */
.stats-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.stats-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.stats-card-body {
    padding: 1.5rem;
}

.stats-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: #94a3b8;
    margin-bottom: 0.5rem;
}

.stats-value {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.stats-card-success .stats-value {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.stats-card-warning .stats-value {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.stats-card-info .stats-value {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.stats-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
}

.stats-info i {
    color: #10b981;
}

.stats-icon {
    width: 60px;
    height: 60px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: white;
}

.stats-progress {
    height: 6px;
    background: #f1f5f9;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 1rem;
}

.progress-bar {
    height: 100%;
    border-radius: 10px;
    transition: width 1s ease;
}

/* ========== ACTION CARD ========== */
.action-card {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.action-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.action-header i {
    font-size: 1.5rem;
    color: #f59e0b;
}

.action-header h5 {
    margin: 0;
    font-weight: 700;
}

.action-buttons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
}

.btn-modern {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 15px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
}

.btn-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
}

.btn-modern:hover::before {
    left: 100%;
}

.btn-modern-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

.btn-modern-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    color: white;
}

.btn-modern-secondary {
    background: white;
    border-color: #e2e8f0;
    color: #1e293b;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.btn-modern-secondary:hover {
    background: #f8fafc;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    border-color: #cbd5e1;
    color: #1e293b;
}

.btn-modern-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
}

.btn-modern-success:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    color: white;
}

.btn-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
}

.btn-modern-secondary .btn-icon {
    background: #f1f5f9;
    color: #667eea;
}

.btn-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.btn-title {
    font-weight: 700;
    font-size: 1rem;
}

.btn-subtitle {
    font-size: 0.75rem;
    opacity: 0.8;
}

.btn-arrow {
    font-size: 1rem;
    transition: transform 0.3s ease;
}

.btn-modern:hover .btn-arrow {
    transform: translateX(5px);
}

/* ========== SESSIONS CARD ========== */
.sessions-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.sessions-header {
    padding: 2rem;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
}

.header-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-right: 1rem;
}

.sessions-header h5 {
    margin: 0;
    font-weight: 700;
    color: #1e293b;
}

.sessions-header p {
    font-size: 0.875rem;
    color: #64748b;
}

.btn-link-modern {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
}

.btn-link-modern:hover {
    color: #764ba2;
    transform: translateX(3px);
}

.sessions-list {
    padding: 1rem;
}

.session-item {
    padding: 1.25rem;
    border-radius: 15px;
    margin-bottom: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
    animation: slideIn 0.5s ease;
}

.session-item:hover {
    background: white;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transform: translateX(5px);
}

.session-info {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr 1.5fr 1.5fr auto;
    gap: 1.5rem;
    align-items: center;
}

.session-user {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.user-avatar {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.user-details h6 {
    font-weight: 600;
    color: #1e293b;
}

.activity-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #475569;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
}

.status-completee {
    background: #d1fae5;
    color: #065f46;
}

.status-en_cours {
    background: #fef3c7;
    color: #92400e;
}

.session-mood {
    display: flex;
    align-items: center;
}

.mood-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.mood-label {
    font-size: 0.7rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
}

.mood-value {
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.875rem;
}

.mood-tres_bien, .mood-bien {
    background: #d1fae5;
    color: #065f46;
}

.mood-neutre {
    background: #fef3c7;
    color: #92400e;
}

.mood-pas_bien, .mood-tres_mal {
    background: #fee2e2;
    color: #991b1b;
}

.session-date {
    font-size: 0.875rem;
    color: #64748b;
}

.btn-action {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
}

.btn-action:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    color: white;
}

/* ========== EMPTY STATE ========== */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
}

.empty-icon {
    width: 100px;
    height: 100px;
    margin: 0 auto 2rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: #cbd5e1;
}

.empty-state h5 {
    color: #475569;
    margin-bottom: 0.5rem;
}

.empty-state p {
    color: #94a3b8;
    max-width: 400px;
    margin: 0 auto;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 1200px) {
    .session-info {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

@media (max-width: 768px) {
    .action-buttons {
        grid-template-columns: 1fr;
    }
}
</style>

<!-- Animate.css CDN pour les animations -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

{% endblock %}