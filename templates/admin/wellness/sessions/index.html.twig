}

.empty-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto 2rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: #cbd5e1;
}

.empty-state-modern h4 {
    color: #475569;
    margin-bottom: 0.5rem;
}

.empty-state-modern p {
    color: #94a3b8;
    margin-bottom: 0;
}

.animate__animated {
    animation-duration: 0.6s;
}

/* Responsive */
@media (max-width: 1200px) {
    .session-body-inline {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .mood-tracker {
        flex-wrap: wrap;
    }
}

@media (max-width: 768px) {
    .filter-content {
        flex-direction: column;
        align-items: stretch;
    }
    
    .search-box {
        min-width: 100%;
    }
    
    .filter-group {
        flex-direction: column;
    }
    
    .session-timeline-card {
        padding-left: 50px;
    }
    
    .timeline-dot {
        width: 35px;
        height: 35px;
    }
}
</style>

<script>
// Recherche en temps réel
document.getElementById('searchInput').addEventListener('keyup', function() {
    filterSessions();
});

// Filtres
document.getElementById('statusFilter').addEventListener('change', function() {
    filterSessions();
});

document.getElementById('moodFilter').addEventListener('change', function() {
    filterSessions();
});

function filterSessions() {
    const searchValue = document.getElementById('searchInput').value.toLowerCase();
    const statusValue = document.getElementById('statusFilter').value;
    const moodValue = document.getElementById('moodFilter').value;
    
    const items = document.querySelectorAll('.session-timeline-item');
    let visibleCount = 0;
    
    items.forEach(item => {
        const text = item.textContent.toLowerCase();
        const status = item.dataset.status;
        const mood = item.dataset.mood;
        
        const matchSearch = text.includes(searchValue);
        const matchStatus = !statusValue || status === statusValue;
        const matchMood = !moodValue || mood === moodValue;
        
        if (matchSearch && matchStatus && matchMood) {
            item.style.display = '';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });
    
    document.getElementById('sessionCount').textContent = visibleCount;
}

// Confirmation de suppression
function confirmDelete(id) {
    if (confirm('Êtes-vous sûr de vouloir supprimer cette session ?')) {
        document.getElementById('deleteForm' + id).submit();
    }
}
</script>

