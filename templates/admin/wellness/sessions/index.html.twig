{% extends 'admin/base.html.twig' %}

{% block title %}Liste des Sessions{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <!-- En-tête -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header animate__animated animate__fadeInDown">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="header-icon-wrapper bg-gradient-success">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="ms-3">
                            <h1 class="h3 mb-0 fw-bold">Sessions d'Activités</h1>
                            <p class="text-muted mb-0">Suivi et gestion des sessions utilisateurs</p>
                        </div>
                    </div>
                    <a href="{{ path('admin_wellness') }}" class="btn-back">
                        <i class="fas fa-arrow-left me-2"></i>
                        Retour au Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Flash -->
    {% for message in app.flashes('success') %}
        <div class="alert-modern alert-success animate__animated animate__fadeInDown" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert-modern alert-danger animate__animated animate__fadeInDown" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            {{ message }}
        </div>
    {% endfor %}

    <!-- Filtres et recherche -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="filter-card animate__animated animate__fadeInUp">
                <div class="filter-content">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" placeholder="Rechercher une session...">
                    </div>
                    
                    <div class="filter-group">
                        <select class="filter-select" id="statusFilter">
                            <option value="">Tous les statuts</option>
                            <option value="completee">Complétées</option>
                            <option value="en_cours">En cours</option>
                            <option value="planifiee">Planifiées</option>
                            <option value="abandonnee">Abandonnées</option>
                        </select>
                        
                        <select class="filter-select" id="moodFilter">
                            <option value="">Toutes les humeurs</option>
                            <option value="tres_bien">Très bien</option>
                            <option value="bien">Bien</option>
                            <option value="neutre">Neutre</option>
                            <option value="pas_bien">Pas bien</option>
                            <option value="tres_mal">Très mal</option>
                        </select>
                    </div>
                    
                    <div class="filter-stats">
                        <span class="stat-badge">
                            <i class="fas fa-list-ul me-1"></i>
                            <strong id="sessionCount">{{ sessions|length }}</strong> sessions
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline des sessions -->
    <div class="row" id="sessionsTimeline">
        {% for session in sessions %}
            <div class="col-12 session-timeline-item animate__animated animate__fadeInUp" 
                 style="animation-delay: {{ loop.index * 0.05 }}s;"
                 data-status="{{ session.statutSession.value }}"
                 data-mood="{{ session.humeurAvant ? session.humeurAvant.value : '' }}">
                <div class="session-timeline-card">
                    <!-- Timeline Line -->
                    <div class="timeline-line"></div>
                    <div class="timeline-dot timeline-dot-{{ session.statutSession.value }}">
                        <i class="fas fa-{{ session.statutSession.value == 'completee' ? 'check' : (session.statutSession.value == 'en_cours' ? 'clock' : (session.statutSession.value == 'planifiee' ? 'calendar' : 'times')) }}"></i>
                    </div>
                    
                    <!-- Content -->
                    <div class="session-content">
                        <div class="session-header-inline">
                            <div class="session-time">
                                <i class="fas fa-calendar-alt me-2"></i>
                                <span class="date-main">{{ session.dateDebut|date('d/m/Y') }}</span>
                                <span class="time-sub">{{ session.dateDebut|date('H:i') }}</span>
                            </div>
                            
                            <span class="status-badge-timeline status-{{ session.statutSession.value }}">
                                <i class="fas fa-{{ session.statutSession.value == 'completee' ? 'check-circle' : (session.statutSession.value == 'en_cours' ? 'clock' : (session.statutSession.value == 'planifiee' ? 'calendar' : 'times-circle')) }}"></i>
                                {{ session.statutSession.value|replace({'_': ' '})|capitalize }}
                            </span>
                        </div>
                        
                        <div class="session-body-inline">
                            <div class="user-section">
                                <div class="user-avatar-timeline">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="user-info-timeline">
                                    <h6>{{ session.utilisateur.nom }} {{ session.utilisateur.prenom }}</h6>
                                    <small>{{ session.utilisateur.email }}</small>
                                </div>
                            </div>
                            
                            <div class="activity-section">
                                <div class="activity-badge-timeline">
                                    <i class="fas fa-dumbbell me-2"></i>
                                    {{ session.activite.nomActivite }}
                                </div>
                                {% if session.dureeReelle %}
                                    <div class="duration-badge">
                                        <i class="fas fa-stopwatch me-1"></i>
                                        {{ session.dureeReelle }} min
                                    </div>
                                {% endif %}
                            </div>
                            
                            <div class="mood-section">
                                {% if session.humeurAvant or session.humeurApres %}
                                    <div class="mood-tracker">
                                        {% if session.humeurAvant %}
                                            <div class="mood-item">
                                                <span class="mood-label">Avant</span>
                                                <div class="mood-display mood-{{ session.humeurAvant.value }}">
                                                    <i class="fas fa-{{ session.humeurAvant.value == 'tres_bien' or session.humeurAvant.value == 'bien' ? 'smile' : (session.humeurAvant.value == 'neutre' ? 'meh' : 'frown') }}"></i>
                                                    {% if session.scoreHumeurAvant %}
                                                        <span class="mood-score">{{ session.scoreHumeurAvant }}/10</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endif %}
                                        
                                        {% if session.humeurApres %}
                                            <i class="fas fa-arrow-right mood-arrow"></i>
                                            <div class="mood-item">
                                                <span class="mood-label">Après</span>
                                                <div class="mood-display mood-{{ session.humeurApres.value }}">
                                                    <i class="fas fa-{{ session.humeurApres.value == 'tres_bien' or session.humeurApres.value == 'bien' ? 'smile' : (session.humeurApres.value == 'neutre' ? 'meh' : 'frown') }}"></i>
                                                    {% if session.scoreHumeurApres %}
                                                        <span class="mood-score">{{ session.scoreHumeurApres }}/10</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            
                                            {% if session.scoreHumeurAvant and session.scoreHumeurApres %}
                                                <div class="mood-evolution">
                                                    {% set diff = session.scoreHumeurApres - session.scoreHumeurAvant %}
                                                    <span class="evolution-badge evolution-{{ diff > 0 ? 'positive' : (diff < 0 ? 'negative' : 'neutral') }}">
                                                        <i class="fas fa-{{ diff > 0 ? 'arrow-up' : (diff < 0 ? 'arrow-down' : 'minus') }}"></i>
                                                        {{ diff > 0 ? '+' : '' }}{{ diff }}
                                                    </span>
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted-timeline">Humeur non renseignée</span>
                                {% endif %}
                            </div>
                            
                            {% if session.impactPercu %}
                                <div class="impact-section">
                                    <span class="impact-badge impact-{{ session.impactPercu.value }}">
                                        <i class="fas fa-{{ session.impactPercu.value == 'tres_positif' or session.impactPercu.value == 'positif' ? 'thumbs-up' : (session.impactPercu.value == 'neutre' ? 'minus' : 'thumbs-down') }} me-1"></i>
                                        {{ session.impactPercu.value|replace({'_': ' '})|capitalize }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="session-footer-inline">
                            <div class="btn-group-timeline">
                                <a href="{{ path('admin_wellness_sessions_show', {'id': session.id}) }}" class="btn-icon-timeline btn-info" title="Voir détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_wellness_sessions_edit', {'id': session.id}) }}" class="btn-icon-timeline btn-warning" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn-icon-timeline btn-danger" title="Supprimer" onclick="confirmDelete({{ session.id }})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <form method="post" id="deleteForm{{ session.id }}" action="{{ path('admin_wellness_sessions_delete', {'id': session.id}) }}" style="display:none;"></form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state-modern">
                    <div class="empty-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h4>Aucune session trouvée</h4>
                    <p>Les sessions apparaîtront ici lorsque les utilisateurs commenceront à utiliser l'application.</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
