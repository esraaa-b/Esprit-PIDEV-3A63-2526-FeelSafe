    font-size: 0.9rem;
}

.status-badge-timeline {
    padding: 0.5rem 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.status-completee {
    background: #d1fae5;
