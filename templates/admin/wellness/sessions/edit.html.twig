</style>

<script>
// Calcul de l'évolution de l'humeur
function updateEvolution() {
    const scoreBefore = parseFloat(document.getElementById('score_humeur_avant').value);
    const scoreAfter = parseFloat(document.getElementById('score_humeur_apres').value);
    const indicator = document.getElementById('evolutionIndicator');
    const evolutionText = document.getElementById('evolutionText');
    
    if (!isNaN(scoreBefore) && !isNaN(scoreAfter)) {
        const diff = scoreAfter - scoreBefore;
        indicator.style.display = 'block';
        
        if (diff > 0) {
            indicator.querySelector('.evolution-card').style.background = 'linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%)';
            indicator.querySelector('.evolution-card').style.borderColor = '#10b981';
            indicator.querySelector('.evolution-card').style.color = '#065f46';
            evolutionText.innerHTML = `<strong>Amélioration de ${diff} point${diff > 1 ? 's' : ''}</strong> - Évolution positive ! 🎉`;
        } else if (diff < 0) {
            indicator.querySelector('.evolution-card').style.background = 'linear-gradient(135deg, #fee2e2 0%, #fecaca 100%)';
            indicator.querySelector('.evolution-card').style.borderColor = '#ef4444';
            indicator.querySelector('.evolution-card').style.color = '#991b1b';
            evolutionText.innerHTML = `<strong>Baisse de ${Math.abs(diff)} point${Math.abs(diff) > 1 ? 's' : ''}</strong> - Attention à surveiller`;
        } else {
            indicator.querySelector('.evolution-card').style.background = 'linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%)';
            indicator.querySelector('.evolution-card').style.borderColor = '#94a3b8';
            indicator.querySelector('.evolution-card').style.color = '#475569';
            evolutionText.innerHTML = `<strong>Humeur stable</strong> - Aucun changement`;
        }
    } else {
        indicator.style.display = 'none';
    }
}

// Event listeners
document.getElementById('score_humeur_avant').addEventListener('input', updateEvolution);
document.getElementById('score_humeur_apres').addEventListener('input', updateEvolution);

// Initialiser l'évolution au chargement
document.addEventListener('DOMContentLoaded', updateEvolution);

// Limiter les caractères du commentaire
const commentaire = document.getElementById('commentaire');
if (commentaire) {
    commentaire.addEventListener('input', function() {
        if (this.value.length > 500) {
            this.value = this.value.substring(0, 500);
        }
    });
}
</script>

