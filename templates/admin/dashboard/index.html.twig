{% extends 'admin/base.html.twig' %}

{% block title %}Administration - FeelSafe{% endblock %}

{% block stylesheets %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

:root {
  --brand-admin:        #6366f1;
  --brand-soft:         rgba(99,102,241,0.10);
  --brand-glow:         rgba(99,102,241,0.22);
  --accent-green:       #10b981;
  --accent-amber:       #f59e0b;
  --accent-red:         #ef4444;
  --accent-sky:         #0ea5e9;
  --bg:                 #f4f6fb;
  --surface:            #ffffff;
  --surface-2:          #f8f9fe;
  --border:             #e5e7ef;
  --border-strong:      #d1d5e0;
  --hover:              #f1f3ff;
  --text-main:          #111827;
  --text-muted:         #6b7280;
  --text-light:         #9ca3af;
  --radius-sm:          8px;
  --radius:             14px;
  --radius-lg:          20px;
  --radius-xl:          28px;
  --shadow-xs:          0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --shadow-sm:          0 2px 8px rgba(0,0,0,.08), 0 1px 3px rgba(0,0,0,.05);
  --shadow-md:          0 4px 20px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.06);
  --shadow-lg:          0 12px 40px rgba(0,0,0,.14), 0 4px 12px rgba(0,0,0,.08);
  --shadow-glow:        0 8px 32px rgba(99,102,241,.25);
  --transition:         all .22s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; }

body {
  font-family: 'Figtree', sans-serif;
  background: var(--bg);
  color: var(--text-main);
  -webkit-font-smoothing: antialiased;
}

/* ══════════════════════════════════════════════
   ✅ FLASH MESSAGES (STYLED)
══════════════════════════════════════════════ */
.flash-messages {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 450px;
}

.flash-message {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border-radius: var(--radius);
  font-family: 'Figtree', sans-serif;
  font-size: 14px;
  font-weight: 600;
  box-shadow: var(--shadow-lg);
  animation: slideInRight 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  backdrop-filter: blur(10px);
  border: 1.5px solid;
}

.flash-success {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.95), rgba(5, 150, 105, 0.95));
  color: white;
  border-color: rgba(255, 255, 255, 0.3);
}

.flash-error {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.95), rgba(220, 38, 38, 0.95));
  color: white;
  border-color: rgba(255, 255, 255, 0.3);
}

.flash-message-icon {
  font-size: 24px;
  flex-shrink: 0;
}

.flash-message-close {
  margin-left: auto;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  transition: var(--transition);
  flex-shrink: 0;
}

.flash-message-close:hover {
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(90deg);
}

@keyframes slideInRight {
  from {
    transform: translateX(120%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: translateX(120%);
  }
}

/* ══════════════════════════════════════════════
   ADMIN PROFILE BANNER
══════════════════════════════════════════════ */
.admin-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
}

.admin-card[style*="linear-gradient(135deg, #8b5cf6"] {
  border: none;
  border-radius: var(--radius-xl) !important;
  box-shadow: var(--shadow-glow), var(--shadow-lg);
  background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 60%, #6366f1 100%) !important;
  position: relative;
  overflow: hidden;
}

.admin-card[style*="linear-gradient(135deg, #8b5cf6"]::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 220px; height: 220px;
  border-radius: 50%;
  background: rgba(255,255,255,.06);
  pointer-events: none;
}

.admin-card[style*="linear-gradient(135deg, #8b5cf6"]::after {
  content: '';
  position: absolute;
  bottom: -80px; left: 30%;
  width: 300px; height: 300px;
  border-radius: 50%;
  background: rgba(255,255,255,.04);
  pointer-events: none;
}

.admin-card[style*="linear-gradient(135deg, #8b5cf6"] > div > div > div:first-child {
  border: 3px solid rgba(255,255,255,.35) !important;
  box-shadow: 0 4px 20px rgba(0,0,0,.25), 0 0 0 6px rgba(255,255,255,.08);
  backdrop-filter: blur(12px);
}

.admin-card[style*="linear-gradient(135deg, #8b5cf6"] button {
  border-radius: var(--radius) !important;
  font-weight: 700 !important;
  box-shadow: 0 6px 20px rgba(0,0,0,.22) !important;
  letter-spacing: -.01em;
}

/* Stat cards */
.admin-card[style*="linear-gradient(135deg, #f0f9ff"],
.admin-card[style*="linear-gradient(135deg, #f0fdf4"],
.admin-card[style*="linear-gradient(135deg, #fffbeb"],
.admin-card[style*="linear-gradient(135deg, #faf5ff"] {
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: var(--surface) !important;
  position: relative;
  overflow: hidden;
  transition: var(--transition);
}

.admin-card[style*="linear-gradient(135deg, #f0f9ff"]:hover,
.admin-card[style*="linear-gradient(135deg, #f0fdf4"]:hover,
.admin-card[style*="linear-gradient(135deg, #fffbeb"]:hover,
.admin-card[style*="linear-gradient(135deg, #faf5ff"]:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--border-strong);
}

.admin-card[style*="linear-gradient(135deg, #f0f9ff"]::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #6366f1, #818cf8); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.admin-card[style*="linear-gradient(135deg, #f0fdf4"]::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #10b981, #34d399); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.admin-card[style*="linear-gradient(135deg, #fffbeb"]::before  { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #f59e0b, #fbbf24); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.admin-card[style*="linear-gradient(135deg, #faf5ff"]::before   { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, #8b5cf6, #a78bfa); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }

.admin-card[style*="linear-gradient(135deg, #f0f9ff"] > div[style*="font-size: 36px"],
.admin-card[style*="linear-gradient(135deg, #f0fdf4"] > div[style*="font-size: 36px"],
.admin-card[style*="linear-gradient(135deg, #fffbeb"] > div[style*="font-size: 36px"],
.admin-card[style*="linear-gradient(135deg, #faf5ff"] > div[style*="font-size: 36px"] {
  font-family: 'Syne', sans-serif !important;
  font-size: 2.6rem !important;
  font-weight: 800 !important;
  letter-spacing: -.04em;
  line-height: 1;
}

.admin-card h3[style*="font-size: 14px"] {
  font-family: 'Figtree', sans-serif;
  font-size: .72rem !important;
  text-transform: uppercase;
  letter-spacing: .08em;
  font-weight: 700 !important;
  color: var(--text-light) !important;
}

.card-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -.025em;
  color: var(--text-main);
  margin: 0 0 4px;
}

.card-subtitle {
  font-size: .85rem;
  color: var(--text-muted);
  margin: 0;
}

#searchInput {
  padding: 10px 16px !important;
  border: 1.5px solid var(--border) !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-size: .875rem !important;
  color: var(--text-main) !important;
  background: var(--surface-2) !important;
  min-width: 260px !important;
  transition: var(--transition) !important;
  box-shadow: var(--shadow-xs) !important;
}

#searchInput:focus {
  border-color: var(--brand-admin) !important;
  outline: none !important;
  box-shadow: 0 0 0 3px var(--brand-glow) !important;
  background: var(--surface) !important;
}

#searchInput::placeholder { color: var(--text-light); }

.card-header button[onclick="openCreateModal()"] {
  background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
  border-radius: var(--radius-sm) !important;
  box-shadow: 0 4px 14px rgba(99,102,241,.35) !important;
  font-family: 'Figtree', sans-serif !important;
  letter-spacing: -.01em;
}

.card-header a[href*="export"] {
  background: linear-gradient(135deg, #059669, #10b981) !important;
  border-radius: var(--radius-sm) !important;
  box-shadow: 0 4px 14px rgba(16,185,129,.3) !important;
  font-family: 'Figtree', sans-serif !important;
  letter-spacing: -.01em;
}

/* TABLE */
#usersTable {
  border-collapse: separate;
  border-spacing: 0;
}

#usersTable thead tr {
  background: var(--surface-2);
}

#usersTable thead th {
  font-family: 'Figtree', sans-serif;
  font-size: .7rem !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: .09em !important;
  color: var(--text-light) !important;
  padding: 14px 16px !important;
  border-bottom: 1.5px solid var(--border) !important;
  white-space: nowrap;
  background: transparent;
}

#usersTable thead th:first-child { border-radius: var(--radius-sm) 0 0 0; padding-left: 20px !important; }
#usersTable thead th:last-child  { border-radius: 0 var(--radius-sm) 0 0; }

#usersTable tbody tr {
  border-bottom: 1px solid var(--border) !important;
  transition: var(--transition) !important;
}

#usersTable tbody tr:last-child { border-bottom: none !important; }

#usersTable tbody tr:hover {
  background: var(--hover) !important;
  box-shadow: inset 3px 0 0 var(--brand-admin);
}

#usersTable tbody td {
  padding: 14px 16px !important;
  font-size: .88rem !important;
  color: var(--text-main);
  vertical-align: middle;
}

#usersTable tbody td:first-child {
  padding-left: 20px !important;
  font-family: 'Syne', sans-serif;
  font-weight: 700;
  font-size: .8rem !important;
  color: var(--text-muted);
}

#usersTable tbody td div[style*="width: 40px"] {
  box-shadow: 0 2px 10px rgba(99,102,241,.30) !important;
  border: 2px solid rgba(255,255,255,.8);
  flex-shrink: 0;
}

#usersTable tbody td div[style*="font-weight: 600"] {
  font-weight: 600 !important;
  color: var(--text-main) !important;
  font-size: .9rem;
}

#usersTable tbody a[href^="mailto:"] {
  color: var(--text-muted) !important;
  transition: var(--transition);
}
#usersTable tbody a[href^="mailto:"]:hover {
  color: var(--brand-admin) !important;
  text-decoration: underline;
}

#usersTable tbody span[style*="border-radius: 20px"] {
  font-family: 'Figtree', sans-serif;
  font-size: .72rem !important;
  font-weight: 700 !important;
  letter-spacing: .04em;
  padding: 5px 12px !important;
  border-radius: 20px !important;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 12px;
  border-radius: 20px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .04em;
}

.status-active {
  background: rgba(16,185,129,.10);
  color: #059669;
  border: 1px solid rgba(16,185,129,.2);
}

.status-inactive {
  background: rgba(107,114,128,.10);
  color: var(--text-muted);
  border: 1px solid rgba(107,114,128,.18);
}

#usersTable button[onclick*="openEditModal"] {
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-weight: 600 !important;
  font-size: .78rem !important;
  padding: 7px 14px !important;
  background: rgba(99,102,241,.08) !important;
  color: var(--brand-admin) !important;
  border: 1.5px solid rgba(99,102,241,.22) !important;
  transition: var(--transition) !important;
}

#usersTable button[onclick*="openEditModal"]:hover {
  background: rgba(99,102,241,.18) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 12px rgba(99,102,241,.2) !important;
}

#usersTable button[onclick*="openDeleteModal"] {
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-weight: 600 !important;
  font-size: .78rem !important;
  padding: 7px 14px !important;
  background: rgba(239,68,68,.08) !important;
  color: var(--accent-red) !important;
  border: 1.5px solid rgba(239,68,68,.22) !important;
  transition: var(--transition) !important;
}

#usersTable button[onclick*="openDeleteModal"]:hover {
  background: rgba(239,68,68,.18) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 4px 12px rgba(239,68,68,.2) !important;
}

#usersTable span[style*="var(--brand-admin-soft)"] {
  background: var(--brand-soft) !important;
  color: var(--brand-admin) !important;
  border-color: rgba(99,102,241,.22) !important;
  border-radius: var(--radius-sm) !important;
  font-weight: 700 !important;
  font-size: .78rem !important;
}

#usersTable td[colspan="8"] > div:first-child {
  font-size: 3.5rem !important;
}

/* MODALS */
.modal {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn .2s ease;
}

.modal-overlay {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(15,20,40,.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.modal-content {
  position: relative;
  background: var(--surface);
  border-radius: var(--radius-xl) !important;
  box-shadow: 0 30px 80px rgba(0,0,0,.22), 0 8px 24px rgba(0,0,0,.12);
  border: 1px solid var(--border);
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp .28s cubic-bezier(.34,1.56,.64,1);
  z-index: 10001;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.modal-content::-webkit-scrollbar { width: 5px; }
.modal-content::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }

.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22px 28px;
  border-bottom: 1.5px solid var(--border);
}

.modal-header[style*="linear-gradient(135deg, #8b5cf6"] {
  background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%) !important;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0 !important;
  border-bottom: none;
}

.modal-header[style*="linear-gradient(135deg, #8b5cf6"] h2 {
  font-family: 'Syne', sans-serif !important;
  font-weight: 700 !important;
  letter-spacing: -.025em;
  font-size: 1.2rem !important;
}

.modal-header:not([style*="linear-gradient"]) {
  background: var(--surface-2);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.modal-header:not([style*="linear-gradient"]) h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.15rem !important;
  font-weight: 700 !important;
  letter-spacing: -.02em;
  color: var(--text-main) !important;
}

.modal-close {
  background: rgba(255,255,255,.15) !important;
  border: 1px solid rgba(255,255,255,.2) !important;
  border-radius: 8px !important;
  font-size: 1rem !important;
  padding: 6px 10px !important;
  transition: var(--transition) !important;
  line-height: 1;
}
.modal-close:hover {
  background: rgba(255,255,255,.28) !important;
  transform: scale(1.1) !important;
}

.modal-header:not([style*="linear-gradient"]) .modal-close {
  background: var(--hover) !important;
  border: 1.5px solid var(--border) !important;
  color: var(--text-muted) !important;
}

.modal-body  { padding: 28px !important; }

.modal-footer {
  display: flex; justify-content: flex-end; gap: 12px;
  padding: 20px 28px;
  border-top: 1.5px solid var(--border);
  background: var(--surface-2);
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.form-label {
  font-family: 'Figtree', sans-serif;
  font-size: .72rem !important;
  font-weight: 700 !important;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--text-muted);
  margin-bottom: 7px;
}

.form-input {
  width: 100%;
  padding: 11px 14px !important;
  border: 1.5px solid var(--border) !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-size: .9rem !important;
  color: var(--text-main) !important;
  background: var(--surface-2) !important;
  transition: var(--transition) !important;
  box-shadow: var(--shadow-xs) !important;
}

.form-input:focus {
  border-color: var(--brand-admin) !important;
  outline: none !important;
  box-shadow: 0 0 0 3px var(--brand-glow) !important;
  background: var(--surface) !important;
}

.form-input::placeholder { color: var(--text-light) !important; }
select.form-input[multiple] { min-height: 120px !important; }
select.form-input option { padding: 6px; }

.btn-primary {
  padding: 11px 24px;
  background: linear-gradient(135deg, var(--brand-admin), #8b5cf6) !important;
  color: white !important;
  border: none !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-size: .875rem !important;
  font-weight: 700 !important;
  cursor: pointer;
  transition: var(--transition) !important;
  display: inline-flex; align-items: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(99,102,241,.35) !important;
  letter-spacing: -.01em;
}
.btn-primary:hover {
  background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 6px 22px rgba(99,102,241,.45) !important;
}

.btn-secondary {
  padding: 11px 24px;
  background: var(--surface) !important;
  color: var(--text-muted) !important;
  border: 1.5px solid var(--border) !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-size: .875rem !important;
  font-weight: 600 !important;
  cursor: pointer;
  transition: var(--transition) !important;
  display: inline-flex; align-items: center; gap: 8px;
  box-shadow: var(--shadow-xs) !important;
}
.btn-secondary:hover {
  background: var(--hover) !important;
  color: var(--text-main) !important;
  border-color: var(--border-strong) !important;
}

.btn-danger {
  padding: 11px 24px;
  background: linear-gradient(135deg, #dc2626, var(--accent-red)) !important;
  color: white !important;
  border: none !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-size: .875rem !important;
  font-weight: 700 !important;
  cursor: pointer;
  transition: var(--transition) !important;
  display: inline-flex; align-items: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(239,68,68,.3) !important;
  letter-spacing: -.01em;
}
.btn-danger:hover {
  background: linear-gradient(135deg, #b91c1c, #dc2626) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 6px 22px rgba(239,68,68,.4) !important;
}

#createModal form button[type="submit"] {
  background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
  border-radius: var(--radius-sm) !important;
  font-family: 'Figtree', sans-serif !important;
  font-weight: 700 !important;
  letter-spacing: -.01em;
  box-shadow: 0 4px 16px rgba(99,102,241,.35) !important;
}

.modal-body div[style*="rgba(139, 92, 246, 0.1)"] {
  border-radius: var(--radius-sm) !important;
  background: rgba(99,102,241,.06) !important;
  border: 1.5px solid rgba(99,102,241,.15) !important;
}

#deleteModal .modal-body > div > div:first-child {
  font-size: 4rem !important;
  margin-bottom: 14px !important;
}

#createModal div[style*="position: relative"] button[type="button"] {
  color: var(--text-muted) !important;
  transition: var(--transition) !important;
}
#createModal div[style*="position: relative"] button[type="button"]:hover {
  color: var(--brand-admin) !important;
}

@keyframes fadeIn  { from { opacity: 0;                  } to { opacity: 1;                  } }
@keyframes slideUp { from { opacity: 0; transform: translateY(24px) scale(.97); }
                     to   { opacity: 1; transform: translateY(0)     scale(1);   } }

.admin-card          { animation: fadeInUp .4s ease .12s both; }

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0);    }
}

#usersTable tbody tr { animation: fadeInUp .35s ease both; }
#usersTable tbody tr:nth-child(1)  { animation-delay: .20s; }
#usersTable tbody tr:nth-child(2)  { animation-delay: .25s; }
#usersTable tbody tr:nth-child(3)  { animation-delay: .30s; }
#usersTable tbody tr:nth-child(4)  { animation-delay: .35s; }
#usersTable tbody tr:nth-child(5)  { animation-delay: .40s; }
#usersTable tbody tr:nth-child(6)  { animation-delay: .45s; }
#usersTable tbody tr:nth-child(7)  { animation-delay: .50s; }
#usersTable tbody tr:nth-child(8)  { animation-delay: .55s; }
#usersTable tbody tr:nth-child(9)  { animation-delay: .60s; }
#usersTable tbody tr:nth-child(10) { animation-delay: .65s; }

::-webkit-scrollbar       { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--brand-admin); }

@media (max-width: 768px) {
  .admin-card { padding: 16px; }
  .modal-body  { padding: 20px !important; }
  .modal-footer { padding: 16px 20px; }
  #searchInput { min-width: 180px !important; }
}
</style>
{% endblock %}

{% block content %}

{# ✅ FLASH MESSAGES #}
{% if app.flashes('success')|length > 0 or app.flashes('error')|length > 0 %}
<div class="flash-messages">
    {% for message in app.flashes('success') %}
        <div class="flash-message flash-success">
            <span class="flash-message-icon">✅</span>
            <span>{{ message }}</span>
            <button class="flash-message-close" onclick="this.parentElement.remove()">×</button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="flash-message flash-error">
            <span class="flash-message-icon">❌</span>
            <span>{{ message }}</span>
            <button class="flash-message-close" onclick="this.parentElement.remove()">×</button>
        </div>
    {% endfor %}
</div>
{% endif %}

<!-- SECTION PROFIL ADMIN -->
<div class="admin-card" style="background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%); color: white; margin-bottom: 32px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 20px;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; color: white; font-size: 32px; font-weight: 700; border: 3px solid rgba(255, 255, 255, 0.3);">
                {{ app.user.prenom|slice(0, 1)|upper }}{{ app.user.nom|slice(0, 1)|upper }}
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9; margin-bottom: 4px;">
                    👑 Administrateur
                </div>
                <h2 style="font-size: 28px; font-weight: 800; margin: 0 0 8px 0;">
                    {{ app.user.fullName }}
                </h2>
                <div style="display: flex; gap: 20px; flex-wrap: wrap; font-size: 14px; opacity: 0.95;">
                    <span>📧 {{ app.user.email }}</span>
                    {% if app.user.telephone %}
                        <span>📱 {{ app.user.telephone }}</span>
                    {% endif %}
                    <span>📅 Inscrit le {{ app.user.dateCreation|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>
        <button onclick="openAdminProfileModal()"
                style="padding: 14px 24px; background: white; color: #8b5cf6; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);"
                onmouseover="this.style.transform='translateY(-3px) scale(1.05)'; this.style.boxShadow='0 6px 20px rgba(0, 0, 0, 0.3)'"
                onmouseout="this.style.transform='translateY(0) scale(1)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.2)'">
            ✏️ Modifier mon profil
        </button>
    </div>
</div>

<!-- Statistiques -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
    <div class="admin-card" style="background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Total utilisateurs</h3>
        <div style="font-size: 36px; font-weight: 800; color: var(--brand-admin); margin: 12px 0;">
            {{ stats.total_users }}
        </div>
        <small style="color: var(--text-light); font-size: 12px; display: block; margin-top: 8px;">
            {{ stats.total_clients }} clients · 
            {{ stats.total_professionnels }} pros · 
            {{ stats.total_admins }} admins
        </small>
    </div>
    <div class="admin-card" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Clients</h3>
        <div style="font-size: 36px; font-weight: 800; color: #16a34a; margin: 12px 0;">{{ stats.total_clients }}</div>
        <small style="color: var(--text-light); font-size: 12px;">Utilisateurs clients</small>
    </div>
    <div class="admin-card" style="background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Professionnels</h3>
        <div style="font-size: 36px; font-weight: 800; color: #f59e0b; margin: 12px 0;">{{ stats.total_professionnels }}</div>
        <small style="color: var(--text-light); font-size: 12px;">Professionnels actifs</small>
    </div>
    <div class="admin-card" style="background: linear-gradient(135deg, #faf5ff 0%, #ffffff 100%);">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Administrateurs</h3>
        <div style="font-size: 36px; font-weight: 800; color: #8b5cf6; margin: 12px 0;">{{ stats.total_admins }}</div>
        <small style="color: var(--text-light); font-size: 12px;">Admins système</small>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     🤖 IA — SECTION RÉSUMÉ DES UTILISATEURS INACTIFS
═══════════════════════════════════════════════════════ -->
<div class="admin-card" id="ia-inactifs-section" style="margin-bottom: 32px; border: 1.5px solid rgba(99,102,241,0.2);">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:6px;">
        <span style="font-size:28px;">🤖</span>
        <div>
            <h2 class="card-title" style="margin:0;">IA — Résumé des utilisateurs inactifs</h2>
            <p class="card-subtitle" style="margin:0;">Analyse intelligente par rôle avec recommandations : Relancer / Archiver / Supprimer</p>
        </div>
    </div>
    <hr style="border:none;border-top:1.5px solid var(--border);margin:14px 0 20px;">

    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:18px;">
        <label style="font-size:14px;font-weight:600;color:var(--text-muted);">Période d'inactivité :</label>
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
            <button onclick="setSeuilIA(7)" id="btn-s7"
                    style="padding:8px 16px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;box-shadow:0 3px 10px rgba(99,102,241,.35);">
                7 jours
            </button>
            <button onclick="setSeuilIA(14)" id="btn-s14"
                    style="padding:8px 16px;background:var(--surface-2);color:var(--text-muted);border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;">
                14 jours
            </button>
            <button onclick="setSeuilIA(21)" id="btn-s21"
                    style="padding:8px 16px;background:var(--surface-2);color:var(--text-muted);border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;">
                21 jours
            </button>
            <button onclick="setSeuilIA(30)" id="btn-s30"
                    style="padding:8px 16px;background:var(--surface-2);color:var(--text-muted);border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;">
                30 jours
            </button>
            <button onclick="setSeuilIA(60)" id="btn-s60"
                    style="padding:8px 16px;background:var(--surface-2);color:var(--text-muted);border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;">
                60 jours
            </button>
            <input type="number" id="ia-seuil" value="7" min="1" max="365"
                   style="width:80px;padding:8px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;font-weight:600;text-align:center;"
                   oninput="clearSeuilButtons()">
            <span style="font-size:13px;color:var(--text-muted);">jours (personnalisé)</span>
        </div>
        <button id="ia-btn-analyser" onclick="iaAnalyserInactifs()"
                style="padding:10px 22px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:8px;box-shadow:0 4px 14px rgba(99,102,241,.35);">
            ⚡ Analyser les inactifs
        </button>
    </div>

    <div id="ia-rapport-container" style="display:none;">
        <!-- Rapport IA -->
        <div id="ia-loading" style="display:none;text-align:center;padding:32px;">
            <div style="font-size:32px;margin-bottom:10px;animation:spin 1s linear infinite;">⚙️</div>
            <p style="color:var(--text-muted);font-size:14px;">Analyse IA en cours...</p>
        </div>
        <div id="ia-rapport-texte" style="display:none;padding:20px 24px;background:var(--surface-2);border:1.5px solid var(--border);border-radius:12px;margin-bottom:20px;white-space:pre-wrap;font-size:14px;line-height:1.7;color:var(--text-main);max-height:380px;overflow-y:auto;"></div>
        
        <!-- Table utilisateurs inactifs -->
        <div id="ia-table-container" style="display:none;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:10px;">
                <h3 style="font-size:15px;font-weight:700;color:var(--text-main);margin:0;">
                    📋 Liste des utilisateurs inactifs
                    <span id="ia-count-badge" style="margin-left:8px;padding:3px 10px;border-radius:20px;font-size:12px;background:rgba(99,102,241,.1);color:var(--brand-admin);border:1px solid rgba(99,102,241,.2);"></span>
                </h3>
                <span id="ia-rapport-ok" style="font-size:13px;color:#059669;font-weight:600;">✅ Rapport IA généré avec succès.</span>
            </div>
            <div style="overflow-x:auto;">
                <table id="ia-inactifs-table" style="width:100%;border-collapse:collapse;font-size:13px;">
                    <thead>
                        <tr style="background:var(--surface-2);border-bottom:1.5px solid var(--border);">
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">ID</th>
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Utilisateur</th>
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Email</th>
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Rôle</th>
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Statut</th>
                            <th style="padding:11px 14px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Inactivité</th>
                            <th style="padding:11px 14px;text-align:center;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-light);">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ia-inactifs-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->

<!-- Table utilisateurs -->
<div class="admin-card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
        <div>
            <h2 class="card-title">Gestion des utilisateurs</h2>
            <p class="card-subtitle">Liste complète des utilisateurs inscrits sur la plateforme</p>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <input type="text" id="searchInput" placeholder="🔍 Rechercher un utilisateur..."
                   style="padding: 10px 16px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; min-width: 250px; transition: all 0.2s;"
                   onkeyup="filterTable()">
            <button onclick="openCreateModal()"
                    style="padding: 10px 20px; background: #8b5cf6; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;"
                    onmouseover="this.style.background='#7c3aed'; this.style.transform='translateY(-2px)'"
                    onmouseout="this.style.background='#8b5cf6'; this.style.transform='translateY(0)'">
                ➕ Créer un utilisateur
            </button>
            <a href="{{ path('admin_users_export_csv') }}"
               style="padding: 10px 20px; background: #10b981; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; text-decoration: none;"
               onmouseover="this.style.background='#059669'; this.style.transform='translateY(-2px)'"
               onmouseout="this.style.background='#10b981'; this.style.transform='translateY(0)'">
                📥 Exporter CSV
            </a>
        </div>
    </div>

    <div style="overflow-x: auto;">
        <table id="usersTable" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid var(--border); text-align: left;">
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">ID</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Utilisateur</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Email</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Téléphone</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Rôle</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Statut</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px;">Inscription</th>
                    <th style="padding: 14px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% if users is defined and users|length > 0 %}
                {% for user in users %}
                <tr style="border-bottom: 1px solid var(--border); transition: all 0.2s ease;"
                    data-user-id="{{ user.id }}"
                    data-edit-token="{{ csrf_tokens['edit_' ~ user.id] }}"
                    data-delete-token="{{ csrf_tokens['delete_' ~ user.id] }}"
                    data-user-nom="{{ user.nom }}"
                    data-user-prenom="{{ user.prenom }}"
                    data-user-email="{{ user.email }}"
                    data-user-telephone="{{ user.telephone|default('') }}"
                    data-user-roles='{{ user.roles|json_encode|raw }}'
                    data-user-statut="{{ user.statut }}"
                    onmouseover="this.style.background='var(--hover)'"
                    onmouseout="this.style.background='transparent'">
                    <td style="padding: 16px 12px; font-size: 14px; font-weight: 600; color: var(--text-main);">#{{ user.id }}</td>
                    <td style="padding: 16px 12px; font-size: 14px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9, #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; font-size: 14px; font-weight: 700; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.3);">
                                {{ user.prenom|slice(0, 1)|upper }}{{ user.nom|slice(0, 1)|upper }}
                            </div>
                            <div style="font-weight: 600; color: var(--text-main);">{{ user.prenom }} {{ user.nom }}</div>
                        </div>
                    </td>
                    <td style="padding: 16px 12px; font-size: 14px; color: var(--text-muted);">
                        <a href="mailto:{{ user.email }}" style="color: inherit; text-decoration: none;">{{ user.email }}</a>
                    </td>
                    <td style="padding: 16px 12px; font-size: 14px; color: var(--text-muted);">{{ user.telephone|default('-') }}</td>
                    <td style="padding: 16px 12px; font-size: 14px;">
                        {% if user.isAdmin() %}
                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: rgba(139, 92, 246, 0.1); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.2);">👑 Admin</span>
                        {% elseif user.isProfessionnel() %}
                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2);">💼 Professionnel</span>
                        {% else %}
                            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: rgba(34, 197, 94, 0.1); color: #16a34a; border: 1px solid rgba(34, 197, 94, 0.2);">👤 Client</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 12px; font-size: 14px;">
                        {% set joursInactif = user.lastLogin ? date().diff(user.lastLogin).days : null %}
                        {% set isInactif = (user.lastLogin is null) or (joursInactif > 7) %}
                        {% if not isInactif %}
                            <span class="status-badge status-active">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #16a34a; margin-right: 6px;"></span>Actif
                            </span>
                        {% else %}
                            <span class="status-badge status-inactive">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #94a3b8; margin-right: 6px;"></span>Inactif
                            </span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 12px; font-size: 13px; color: var(--text-muted);">
                        {{ user.dateCreation ? user.dateCreation|date('d/m/Y à H:i') : '-' }}
                    </td>
                    <td style="padding: 16px 12px; text-align: center;">
                        <div style="display: flex; gap: 8px; justify-content: center;">
                            {% if app.user and user.id != app.user.id %}
                                <button onclick="openEditModal(this.closest('tr'))"
                                        style="padding: 8px 14px; background: rgba(14, 165, 233, 0.1); color: #0ea5e9; border: 1px solid rgba(14, 165, 233, 0.3); border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 6px;"
                                        onmouseover="this.style.background='rgba(14, 165, 233, 0.2)'; this.style.transform='translateY(-2px)'"
                                        onmouseout="this.style.background='rgba(14, 165, 233, 0.1)'; this.style.transform='translateY(0)'">
                                    ✏️ Modifier
                                </button>
                                <button onclick="openDeleteModal(this.closest('tr'))"
                                        style="padding: 8px 14px; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 6px;"
                                        onmouseover="this.style.background='rgba(239, 68, 68, 0.2)'; this.style.transform='translateY(-2px)'"
                                        onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'; this.style.transform='translateY(0)'">
                                    🗑️ Supprimer
                                </button>
                            {% else %}
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; background: var(--brand-admin-soft); color: var(--brand-admin); border: 1px solid rgba(14, 165, 233, 0.2);">
                                    👤 Vous
                                </span>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="8" style="padding: 60px 20px; text-align: center;">
                        <div style="font-size: 64px; margin-bottom: 16px; opacity: 0.5;">📭</div>
                        <div style="font-size: 16px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Aucun utilisateur trouvé</div>
                        <div style="font-size: 14px; color: var(--text-muted);">La liste des utilisateurs est vide pour le moment.</div>
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>

{# ➕ MODAL CRÉATION D'UTILISATEUR #}
<div id="createModal" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeCreateModal()"></div>
    <div class="modal-content" style="max-width: 620px;">
        <div class="modal-header" style="background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%); color: white; border-radius: 16px 16px 0 0;">
