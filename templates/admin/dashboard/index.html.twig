// 🤖 IA — SÉLECTION SEMAINE
// ═══════════════════════════════════════════
function setSeuilIA(val) {
    document.getElementById('ia-seuil').value = val;
    const ids = [7, 14, 21, 30, 60];
    ids.forEach(id => {
        const btn = document.getElementById('btn-s' + id);
        if (btn) {
            if (id === val) {
                btn.style.background = 'linear-gradient(135deg,#6366f1,#8b5cf6)';
                btn.style.color = 'white';
                btn.style.border = 'none';
                btn.style.boxShadow = '0 3px 10px rgba(99,102,241,.35)';
            } else {
                btn.style.background = 'var(--surface-2)';
                btn.style.color = 'var(--text-muted)';
                btn.style.border = '1.5px solid var(--border)';
                btn.style.boxShadow = 'none';
            }
        }
    });
}

function clearSeuilButtons() {
    const ids = [7, 14, 21, 30, 60];
    ids.forEach(id => {
        const btn = document.getElementById('btn-s' + id);
        if (btn) {
            btn.style.background = 'var(--surface-2)';
            btn.style.color = 'var(--text-muted)';
            btn.style.border = '1.5px solid var(--border)';
            btn.style.boxShadow = 'none';
        }
    });
}

// ═══════════════════════════════════════════
// 🤖 IA — ANALYSE DES UTILISATEURS INACTIFS
// ═══════════════════════════════════════════

async function iaAnalyserInactifs() {
    const seuil = parseInt(document.getElementById('ia-seuil').value) || 7;
    const container    = document.getElementById('ia-rapport-container');
    const loading      = document.getElementById('ia-loading');
    const rapportTexte = document.getElementById('ia-rapport-texte');
    const tableContainer = document.getElementById('ia-table-container');
    const tbody        = document.getElementById('ia-inactifs-tbody');
    const countBadge   = document.getElementById('ia-count-badge');
    const btn          = document.getElementById('ia-btn-analyser');

    // Réinitialiser
    container.style.display = 'block';
    loading.style.display = 'block';
    rapportTexte.style.display = 'none';
    tableContainer.style.display = 'none';
    rapportTexte.textContent = '';
    tbody.innerHTML = '';
    btn.disabled = true;
    btn.textContent = '⏳ Analyse en cours...';

    try {
        // 1. Récupérer les inactifs depuis notre API PHP
        const apiResp = await fetch(`/admin/users/inactifs?jours=${seuil}`);
        if (!apiResp.ok) throw new Error('Erreur API inactifs (HTTP ' + apiResp.status + ')');
        const apiData = await apiResp.json();
        const inactifs = apiData.utilisateurs || [];

        // 2. Construire le prompt IA
        const roles = {};
        inactifs.forEach(u => {
            const r = u.roles.includes('ROLE_ADMIN') ? 'Admin'
                    : u.roles.includes('ROLE_PROFESSIONNEL') ? 'Professionnel'
                    : 'Client';
            roles[r] = (roles[r] || 0) + 1;
        });
        const totalUsers = {{ stats.total_users }};
        const tauxInactivite = totalUsers > 0 ? Math.round((inactifs.length / totalUsers) * 100) : 0;

        const promptData = {
            total_utilisateurs: totalUsers,
            total_inactifs: inactifs.length,
            taux_inactivite: tauxInactivite,
            seuil_jours: seuil,
            repartition_roles: roles,
            echantillon: inactifs.slice(0, 8).map(u => ({
                nom: u.nom,
                role: u.roles.includes('ROLE_ADMIN') ? 'Admin'
                    : u.roles.includes('ROLE_PROFESSIONNEL') ? 'Professionnel' : 'Client',
                jours_inactif: u.jours_inactif,
                jamais_connecte: !u.last_login
            }))
        };

        const prompt = `Tu es un expert en gestion de plateforme de santé mentale "FeelSafe".
Analyse les données suivantes sur les utilisateurs inactifs et génère un rapport structuré en français.

DONNÉES:
${JSON.stringify(promptData, null, 2)}

Génère un rapport avec exactement ces sections:
📊 BILAN D'INACTIVITÉ
[2-3 phrases de synthèse avec chiffres clés]

🔍 ANALYSE DES PROFILS
[3 observations numérotées sur les profils inactifs]

⚡ RECOMMANDATIONS PAR RÔLE
[Actions spécifiques pour Clients / Professionnels / Admins : Relancer / Archiver / Supprimer]

📅 PLAN D'ACTION
[3 étapes prioritaires concrètes]

Sois précis, analytique, et utilise les données fournies. Réponds uniquement en français.`;

        // 3. Appel à l'API Claude via le backend Symfony (proxy sécurisé)
        const iaResp = await fetch('/admin/ia/analyser', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: prompt })
        });
        if (!iaResp.ok) {
            const errData = await iaResp.json().catch(() => ({}));
            throw new Error(errData.error || 'Erreur API IA (HTTP ' + iaResp.status + ')');
        }
        const iaData = await iaResp.json();
        const rapport = iaData.rapport || 'Aucun rapport généré.';

        // 4. Afficher le rapport
        loading.style.display = 'none';
        rapportTexte.textContent = rapport;
        rapportTexte.style.display = 'block';

        // 5. Remplir la table
        countBadge.textContent = inactifs.length + ' utilisateur(s)';
        tbody.innerHTML = '';
        inactifs.forEach(u => {
            const role = u.roles.includes('ROLE_ADMIN') ? '<span style="padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(139,92,246,.1);color:#8b5cf6;border:1px solid rgba(139,92,246,.2);">ADMIN</span>'
                       : u.roles.includes('ROLE_PROFESSIONNEL') ? '<span style="padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(245,158,11,.1);color:#f59e0b;border:1px solid rgba(245,158,11,.2);">PROFESSIONNEL</span>'
                       : '<span style="padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(16,185,129,.1);color:#059669;border:1px solid rgba(16,185,129,.2);">CLIENT</span>';
            // Statut automatique : inactif si jamais connecté OU > seuil jours
            const isInactif = !u.last_login || u.jours_inactif > seuil;
            const statut = !isInactif
                ? '<span style="padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(16,185,129,.1);color:#059669;border:1px solid rgba(16,185,129,.2);">• Actif</span>'
                : '<span style="padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;background:rgba(107,114,128,.1);color:#6b7280;border:1px solid rgba(107,114,128,.2);">• Inactif</span>';
            const inactiviteLabel = u.jours_inactif !== null
                ? `<span style="color:#ef4444;font-weight:700;">${u.jours_inactif} jour(s)</span>`
                : '<span style="color:#6b7280;">Jamais connecté</span>';

            const initials = u.nom.split(' ').map(p => p[0]?.toUpperCase() || '').slice(0,2).join('');
            tbody.innerHTML += `
            <tr style="border-bottom:1px solid var(--border);transition:all .2s;" onmouseover="this.style.background='var(--hover)'" onmouseout="this.style.background='transparent'">
                <td style="padding:13px 14px;font-weight:700;color:var(--text-muted);">#${u.id}</td>
                <td style="padding:13px 14px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:700;flex-shrink:0;">${initials}</div>
                        <span style="font-weight:600;">${u.nom}</span>
                    </div>
                </td>
                <td style="padding:13px 14px;color:var(--text-muted);">${u.email}</td>
                <td style="padding:13px 14px;">${role}</td>
                <td style="padding:13px 14px;">${statut}</td>
                <td style="padding:13px 14px;">${inactiviteLabel}</td>
                <td style="padding:13px 14px;text-align:center;">
                    <div style="display:flex;gap:6px;justify-content:center;">
                        <button onclick="alert('Fonctionnalité : Envoyer un email de relance à ${u.email.replace(/'/g, "\\'")}')"
                                style="padding:6px 12px;background:rgba(99,102,241,.1);color:var(--brand-admin);border:1.5px solid rgba(99,102,241,.25);border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;"
                                onmouseover="this.style.background='rgba(99,102,241,.2)'" onmouseout="this.style.background='rgba(99,102,241,.1)'">
                            📧 Relancer
                        </button>
                    </div>
                </td>
            </tr>`;
        });

        if (inactifs.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="padding:40px;text-align:center;color:var(--text-muted);">✅ Aucun utilisateur inactif depuis ${seuil} jours.</td></tr>`;
        }

        tableContainer.style.display = 'block';

    } catch (err) {
        loading.style.display = 'none';
        rapportTexte.textContent = '❌ Erreur lors de l\'analyse : ' + err.message;
        rapportTexte.style.display = 'block';
        console.error(err);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '⚡ Analyser les inactifs';
    }
}

// Spin animation pour le loader
const spinStyle = document.createElement('style');
spinStyle.textContent = '@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }';
document.head.appendChild(spinStyle);

// ✅ AUTO-HIDE FLASH MESSAGES APRÈS 5 SECONDES
setTimeout(() => {
    const flashMessages = document.querySelectorAll('.flash-message');
    flashMessages.forEach(msg => {
        msg.style.animation = 'fadeOut 0.4s ease forwards';
        setTimeout(() => msg.remove(), 400);
    });
}, 5000);
</script>

{% endblock %}
