<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin | {{ 'app.name'|trans }}{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="https://unpkg.com/feather-icons"></script>

    <style>
        :root {
            --brand-admin:      #6366f1;
            --sidebar-bg:       #ffffff;
            --sidebar-active-bg:#ede9fe;
            --sidebar-active-fg:#6366f1;
            --sidebar-hover:    #f5f3ff;
            --sidebar-border:   #f0f0f7;
            --logout-bg:        #fff0f0;
            --logout-fg:        #ef4444;
            --logout-border:    #fecaca;
            --logout-hover-bg:  #fee2e2;
        }
        body { font-family: {% if app.request.locale == 'ar' %}'Segoe UI', Tahoma{% else %}'Inter'{% endif %}, sans-serif; background: #f8f9fc; }
        [x-cloak] { display: none !important; }

        /* Sidebar user footer */
        .sidebar-user { padding: 16px; border-top: 1px solid #e5e7eb; margin-top: auto; }
        .user-profile { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 8px; }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 13px; }
        .user-info { flex: 1; min-width: 0; }
        .user-name  { font-weight: 600; font-size: 13px; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-email { font-size: 11px; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .logout-btn { display: flex; align-items: center; gap: 8px; width: 100%; padding: 10px 14px; margin-top: 8px; border-radius: 8px; font-size: 13px; font-weight: 500; text-decoration: none; background: var(--logout-bg); color: var(--logout-fg); border: 1px solid var(--logout-border); transition: background .2s; }
        .logout-btn:hover { background: var(--logout-hover-bg); }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
        {% block extra_styles %}{% endblock %}
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50">
<div x-data="{ sidebarOpen: window.innerWidth >= 1024 }"
     x-init="window.addEventListener('resize', () => { sidebarOpen = window.innerWidth >= 1024; })"
     x-cloak class="flex min-h-screen">

    <!-- Mobile overlay -->
    <div x-show="sidebarOpen && window.innerWidth < 1024" @click="sidebarOpen = false"
         class="fixed inset-0 bg-black/50 z-40 lg:hidden" x-transition.opacity></div>

    <!-- ── Sidebar ── -->
    <aside x-show="sidebarOpen || window.innerWidth >= 1024"
           class="fixed lg:sticky top-0 {{ app.request.locale == 'ar' ? 'right-0' : 'left-0' }} h-screen w-64 bg-white border-{{ app.request.locale == 'ar' ? 'left' : 'right' }} border-gray-200 z-50 lg:z-0 flex flex-col">

        <!-- Logo -->
        <div class="p-6 border-b border-gray-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center">
                        <span class="text-white font-bold">F</span>
                    </div>
                    <span class="text-lg font-bold text-gray-900">{{ 'app.name'|trans }}</span>
                </div>
                <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded">ADMIN</span>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto p-4">
            {% set r = app.request.get('_route') %}

            <!-- Main Navigation -->
            <div class="mb-6">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2">
                    {{ 'nav.dashboard'|trans }}
                </h3>
                <div class="space-y-1">
                    <a href="{{ path('admin_home') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r == 'admin_home' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="bar-chart-2" class="w-4 h-4"></i>
                        <span>{{ 'nav.dashboard'|trans }}</span>
                    </a>
                    <a href="{{ path('admin_dashboard') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r == 'admin_dashboard' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="shield" class="w-4 h-4"></i>
                        <span>{{ 'nav.security'|trans }}</span>
                    </a>
                    <a href="{{ path('admin_users_index') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r == 'admin_users_index' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="book-open" class="w-4 h-4"></i>
                        <span>{{ 'nav.journal'|trans }}</span>
                    </a>
                </div>
            </div>

            <!-- Accompagnement -->
            <div class="mb-6">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2">
                    {{ 'nav.support'|trans }}
                </h3>
                <div class="space-y-1">
                    <a href="{{ path('admin_rdv_accompagnement') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r == 'admin_rdv_accompagnement' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="calendar" class="w-4 h-4"></i>
                        <span>Rendez-vous</span>
                    </a>
                    <a href="{{ path('admin_wellness') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r starts with 'admin_wellness' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="heart" class="w-4 h-4"></i>
                        <span>{{ 'nav.wellness'|trans }}</span>
                    </a>
                    <a href="{{ path('admin_emergency') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r == 'admin_emergency' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="alert-triangle" class="w-4 h-4"></i>
                        <span>{{ 'nav.emergency'|trans }}</span>
                    </a>
                    <a href="{{ path('app_publication_index') }}"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {{ r starts with 'app_publication' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'text-gray-700 hover:bg-gray-100' }}">
                        <i data-feather="users" class="w-4 h-4"></i>
                        <span>{{ 'nav.forum'|trans }}</span>
                    </a>
                </div>
            </div>

            <!-- Bouton langue -->
            <div class="mb-4">
                <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-100 transition-colors">
                    <i data-feather="globe" class="w-4 h-4"></i>
                    <span>🌐 {{ 'app.lang_switch'|trans }}</span>
                </a>
            </div>
        </nav>

        <!-- User footer -->
        <div class="sidebar-user">
            <div class="user-profile">
                <div class="user-avatar">
                    {% if app.user %}
                        {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                    {% else %}U{% endif %}
                </div>
                <div class="user-info">
                    <div class="user-name">{{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : 'Utilisateur' }}</div>
                    <div class="user-email">{{ app.user ? app.user.email : '' }}</div>
                </div>
            </div>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="logout-btn">
                    <span>🚪</span> {{ 'nav.logout'|trans }}
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="logout-btn">{{ 'login.submit'|trans }}</a>
            {% endif %}
        </div>
    </aside>

    <!-- ── Main Content ── -->
    <main class="flex-1 min-w-0">
        <!-- Mobile header -->
        <div class="lg:hidden sticky top-0 z-40 bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
            <button @click="sidebarOpen = true" class="p-2 rounded-lg hover:bg-gray-100">
                <i data-feather="menu" class="w-5 h-5 text-gray-600"></i>
            </button>
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center">
                    <span class="text-white font-bold">F</span>
                </div>
                <span class="font-semibold text-gray-900">Admin Panel</span>
            </div>
            <div class="w-9"></div>
        </div>

        <!-- Page Content -->
        <div class="p-4 lg:p-8">
            {% block content %}{% endblock %}
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof feather !== 'undefined') feather.replace();
    });
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
