<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin | FeelSafe{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
   
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
   
    <!-- Feather Icons CDN -->
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
   
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
   
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.0/dist/cdn.min.js"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
   
    <style>
        [x-cloak] { display: none !important; }
       
        :root {
            --brand-admin:       #6366f1;
            --brand-admin-soft:  #eef2ff;
            --brand-admin-dark:  #4f46e5;
            --brand-admin-glow:  rgba(99,102,241,.18);

            --sidebar-bg:        #ffffff;
            --sidebar-border:    #e8eaf0;
            --sidebar-hover:     #f5f5ff;
            --sidebar-active-bg: #eef2ff;
            --sidebar-active-fg: #6366f1;

            --text-main:         #111827;
            --text-muted:        #6b7280;
            --text-light:        #9ca3af;

            --user-bg:           #f7f8ff;
            --user-border:       #e8eaf0;
            --logout-bg:         #fff0f0;
            --logout-fg:         #ef4444;
            --logout-border:     #fecaca;
            --logout-hover-bg:   #fee2e2;

            --radius-sm:  7px;
            --radius:     12px;
            --radius-lg:  16px;
            --transition: all .2s cubic-bezier(.4,0,.2,1);
            --shadow-sm:  0 1px 4px rgba(0,0,0,.07);
            --shadow-md:  0 4px 16px rgba(0,0,0,.10);
        }

        /* ── Base ───────────────────────────────── */
        body { font-family: 'Figtree', sans-serif; }

        /* ── Custom scrollbar ───────────────────── */
        .sidebar-scroll::-webkit-scrollbar       { width: 5px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
        .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

        /* ══════════════════════════════════════════
           SIDEBAR USER SECTION  ← amélioration clé
           ══════════════════════════════════════════ */
        .sidebar-user {
            padding: 12px 16px 16px;
            border-top: 1px solid var(--user-border);
            background: var(--user-bg);
            border-radius: 0 0 0 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            border-radius: var(--radius);
            background: #ffffff;
            border: 1px solid var(--user-border);
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .user-profile:hover {
            border-color: var(--brand-admin);
            box-shadow: 0 0 0 3px var(--brand-admin-glow);
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Syne', sans-serif;
            font-size: 14px;
            font-weight: 700;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(99,102,241,.35);
            letter-spacing: -.01em;
        }

        .user-info {
            flex: 1;
            min-width: 0;
        }

        .user-name {
            font-family: 'Figtree', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.3;
            letter-spacing: -.01em;
        }

        .user-email {
            font-size: 11px;
            color: var(--text-light);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
            line-height: 1.3;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 14px;
            border-radius: var(--radius);
            background: var(--logout-bg);
            color: var(--logout-fg);
            border: 1px solid var(--logout-border);
            font-family: 'Figtree', sans-serif;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            letter-spacing: -.01em;
        }

        .logout-btn:hover {
            background: var(--logout-hover-bg);
            border-color: #f87171;
            color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(239,68,68,.18);
            text-decoration: none;
        }

        .logout-btn:active {
            transform: translateY(0);
        }

        /* ── Sidebar nav active/hover overrides ─── */
        aside a.flex {
            font-family: 'Figtree', sans-serif !important;
            font-size: 13.5px !important;
            border-radius: var(--radius) !important;
            transition: var(--transition) !important;
        }

        aside a.bg-blue-50 {
            background-color: var(--sidebar-active-bg) !important;
            color: var(--sidebar-active-fg) !important;
            border-color: rgba(99,102,241,.2) !important;
            font-weight: 600 !important;
        }

        aside a.text-gray-700:hover {
            background-color: var(--sidebar-hover) !important;
            color: var(--brand-admin) !important;
        }

        /* ── Sidebar logo area ──────────────────── */
        aside .p-6 span.text-lg {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            letter-spacing: -.03em;
        }

        aside .rounded-lg.bg-blue-500 {
            background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
            border-radius: 9px !important;
            box-shadow: 0 2px 8px rgba(99,102,241,.35);
        }

        aside .text-blue-600.bg-blue-50 {
            background-color: var(--sidebar-active-bg) !important;
            color: var(--sidebar-active-fg) !important;
            font-family: 'Figtree', sans-serif;
            font-size: 10px !important;
            font-weight: 800 !important;
            letter-spacing: .05em;
            border-radius: 6px !important;
        }

        /* ── Section headings in nav ────────────── */
        aside h3 {
            font-family: 'Figtree', sans-serif !important;
            font-size: 10px !important;
            font-weight: 700 !important;
            letter-spacing: .1em !important;
            color: #c4c8d4 !important;
        }

        /* ── Mobile header ──────────────────────── */
        .lg\:hidden.sticky span.font-semibold {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
        }

        /* ── Sidebar border ─────────────────────── */
        aside {
            border-right-color: var(--sidebar-border) !important;
        }

        /* ── Scrollbar for whole page ───────────── */
        ::-webkit-scrollbar       { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover { background: var(--brand-admin); }
    </style>
   
    {% block stylesheets %}{% endblock %}
    {% block javascripts_head %}{% endblock %}
</head>
<body class="bg-gray-50">
    <div
        x-data="{
            sidebarOpen: window.innerWidth >= 1024,
            currentPath: window.location.pathname
        }"
        x-init="
            $nextTick(() => $el.removeAttribute('x-cloak'));
            window.addEventListener('resize', () => {
                sidebarOpen = window.innerWidth >= 1024;
            });
        "
        x-cloak
        class="flex min-h-screen"
    >
        <!-- Mobile overlay -->
        <div x-show="sidebarOpen && window.innerWidth < 1024"
             @click="sidebarOpen = false"
             class="fixed inset-0 bg-black/50 z-40 lg:hidden"
             x-transition.opacity></div>

        <!-- Sidebar -->
        <aside x-show="sidebarOpen || window.innerWidth >= 1024"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="-translate-x-full"
               x-transition:enter-end="translate-x-0"
               x-transition:leave="transition ease-in duration-300"
               x-transition:leave-start="translate-x-0"
               x-transition:leave-end="-translate-x-full"
               class="fixed lg:sticky top-0 left-0 h-screen w-64 bg-white border-r border-gray-200 z-50 lg:z-0 flex flex-col">
           
            <!-- Logo -->
            <div class="p-6 border-b border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center">
                            <span class="text-white font-bold">F</span>
                        </div>
                        <span class="text-lg font-bold text-gray-900">FeelSafe</span>
                    </div>
                    <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded">ADMIN</span>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto sidebar-scroll p-4">
                <!-- Main Navigation -->
                <div class="mb-6">
                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2">Navigation</h3>
                    <div class="space-y-1">
                        <a href="{{ path('admin_home') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_home' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="bar-chart-2" class="w-4 h-4"></i>
                            <span>Tableau de bord</span>
                        </a>
                        <a href="{{ path('admin_dashboard') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_dashboard' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="shield" class="w-4 h-4"></i>
                            <span>Sécurité & Profil</span>
                        </a>
                         <a href="{{ path('admin_users_index') }}" 
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_users_index' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="book-open" class="w-4 h-4"></i>
                            <span>Journal émotionnel</span>
                        </a>
                    </div>
                </div>

                <!-- Accompagnement -->
                <div class="mb-6">
                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2">Accompagnement</h3>
                    <div class="space-y-1">
                        <a href="{{ path('admin_rdv_accompagnement') }}" 
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_rdv_accompagnement' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="calendar" class="w-4 h-4"></i>
                            <span>Rendez-vous</span>
                        </a>
                        <a href="{{ path('admin_wellness') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') starts with 'admin_wellness' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="heart" class="w-4 h-4"></i>
                            <span>Bien-être</span>
                        </a>
                        <a href="{{ path('admin_emergency') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_emergency' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="alert-triangle" class="w-4 h-4"></i>
                            <span>Urgence</span>
                        </a>
                        <a href="{{ path('app_publication_index') }}" 
                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') starts with 'app_publication' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="users" class="w-4 h-4"></i>
                            <span>Forum</span>
                        </a>
                    </div>
                </div>

                <!-- Administration -->
                <div class="mb-6">
                    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3 px-2">Administration</h3>
                    <div class="space-y-1">
                        <a href="{{ path('admin_support') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_support' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="life-buoy" class="w-4 h-4"></i>
                            <span>Support</span>
                        </a>
                        <a href="{{ path('admin_profile') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_profile' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="user" class="w-4 h-4"></i>
                            <span>Profil détaillé</span>
                        </a>
                        <a href="{{ path('admin_settings') }}"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {% if app.request.get('_route') == 'admin_settings' %}bg-blue-50 text-blue-600 border border-blue-100{% else %}text-gray-700 hover:bg-gray-100{% endif %}">
                            <i data-feather="settings" class="w-4 h-4"></i>
                            <span>Paramètres</span>
                        </a>
                    </div>
                </div>
            </nav>

            <!-- User Profile -->
            <div class="sidebar-user">
                <div class="user-profile">
                    <div class="user-avatar">
                        {% if app.user %}
                            {{ app.user.prenom|slice(0, 1)|upper }}{{ app.user.nom|slice(0, 1)|upper }}
                        {% else %}
                            U
                        {% endif %}
                    </div>
                    <div class="user-info">
                        <div class="user-name">
                            {% if app.user %}
                                {{ app.user.prenom }} {{ app.user.nom }}
                            {% else %}
                                Utilisateur
                            {% endif %}
                        </div>
                        <div class="user-email">
                            {% if app.user %}
                                {{ app.user.email }}
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% if app.user %}
                    <a href="{{ path('app_logout') }}" class="logout-btn">
                        <span>🚪</span>
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="logout-btn">
                        Connexion
                    </a>
                {% endif %}
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 min-w-0">
            <!-- Mobile header -->
            <div class="lg:hidden sticky top-0 z-40 bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
                <button @click="sidebarOpen = true" class="p-2 rounded-lg hover:bg-gray-100">
                    <i data-feather="menu" class="w-5 h-5 text-gray-600"></i>
                </button>
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center">
                        <span class="text-white font-bold">F</span>
                    </div>
                    <span class="font-semibold text-gray-900">Admin Panel</span>
                </div>
                <div class="w-9"></div>
            </div>

            <!-- Page Content -->
            <div class="p-4 lg:p-8">
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Feather Icons initialization -->
    <script>
        document.addEventListener('alpine:init', function() {
            setTimeout(function() {
                if (typeof feather !== 'undefined') {
                    try {
                        feather.replace();
                    } catch (error) {
                        console.warn('Feather Icons could not replace some elements:', error.message);
                    }
                }
            }, 100);
        });
       
        document.addEventListener('alpine:initialized', () => {
            Alpine.$watch('sidebarOpen', () => {
                setTimeout(() => {
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                }, 150);
            });
        });
    </script>
   
    {% block javascripts %}{% endblock %}
</body>
</html>
