<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin | FeelSafe{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    {% block stylesheets %}{% endblock %}
    
    <style>
        :root {
            /* Admin-specific color palette */
            --brand-admin: #0ea5e9;        /* sky blue - more professional */
            --brand-admin-soft: #f0f9ff;
            --brand-admin-dark: #0369a1;
            
            /* Neutral palette */
            --bg-main: #f8fafc;
            --bg-sidebar: #ffffff;
            --bg-card: #ffffff;
            
            /* Typography */
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-light: #94a3b8;
            
            /* UI elements */
            --border: #e2e8f0;
            --hover: #f1f5f9;
            --focus-ring: rgba(14, 165, 233, 0.15);
            
            /* Effects */
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 4px 20px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 10px 38px rgba(15, 23, 42, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        body {
            background: var(--bg-main);
            color: var(--text-main);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        /* ===== LAYOUT ===== */
        .admin-layout {
            display: flex;
            min-height: 100vh;
            background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);
        }

        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: 280px;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            padding: 28px 20px;
            position: sticky;
            top: 0;
            height: 100vh;
            box-shadow: var(--shadow-md);
            z-index: 10;
            display: flex;
            flex-direction: column;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 36px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .admin-logo span {
            font-weight: 800;
            font-size: 22px;
            color: var(--text-main);
            position: relative;
        }

        .admin-logo span::after {
            content: '';
            position: absolute;
            right: -70px;
            top: 50%;
            transform: translateY(-50%);
            width: 60px;
            height: 1px;
            background: linear-gradient(90deg, var(--brand-admin), transparent);
        }

        .admin-logo small {
            color: var(--brand-admin);
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 4px 10px;
            border-radius: 20px;
            background: var(--brand-admin-soft);
            border: 1px solid rgba(14, 165, 233, 0.2);
        }

        /* ===== NAV SECTIONS ===== */
        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section:last-of-type {
            margin-bottom: 32px;
        }

        .nav-section-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-light);
            margin-bottom: 12px;
            padding-left: 8px;
            position: relative;
        }

        .nav-section-title::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 12px;
            background: var(--brand-admin);
            border-radius: 2px;
        }

        /* ===== NAV ITEMS ===== */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-muted);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            margin-bottom: 4px;
        }

        .nav-item:last-child {
            margin-bottom: 0;
        }

        .nav-item .icon {
            width: 20px;
            text-align: center;
            font-size: 16px;
            color: inherit;
        }

        .nav-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 3px;
            background: var(--brand-admin);
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .nav-item:hover {
            background: var(--hover);
            color: var(--brand-admin);
            transform: translateX(4px);
        }

        .nav-item:hover::before {
            transform: translateX(0);
        }

        .nav-item.active {
            background: var(--brand-admin-soft);
            color: var(--brand-admin);
            font-weight: 600;
            box-shadow: inset 0 0 0 1px rgba(14, 165, 233, 0.1);
        }

        .nav-item.active::before {
            transform: translateX(0);
        }

        /* ===== SIDEBAR USER ===== */
        .sidebar-user {
            margin-top: auto;
            padding: 16px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--bg-card);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--brand-admin-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-admin);
            font-size: 18px;
            border: 1px solid rgba(14, 165, 233, 0.2);
        }

        .user-info {
            flex: 1;
        }

        .user-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 2px;
        }

        .user-email {
            font-size: 12px;
            color: var(--text-muted);
            word-break: break-all;
        }

        /* ===== MAIN CONTENT ===== */
        .admin-main {
            flex: 1;
            padding: 32px 40px;
            animation: fadeIn 0.4s ease;
            overflow-y: auto;
            max-height: 100vh;
        }

        /* Main header */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 0;
            color: var(--text-main);
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 40px;
            height: 3px;
            background: var(--brand-admin);
            border-radius: 2px;
        }

        /* ===== ADMIN CARDS ===== */
        .admin-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 24px;
        }

        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .card-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-main);
        }

        .card-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ===== BUTTONS ===== */
        .btn-admin {
            background: var(--brand-admin);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-admin:hover {
            background: var(--brand-admin-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.25);
        }

        .btn-admin-outline {
            background: transparent;
            color: var(--brand-admin);
            border: 1px solid var(--brand-admin);
        }

        .btn-admin-outline:hover {
            background: var(--brand-admin-soft);
        }

        /* ===== STATUS INDICATORS ===== */
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .status-active {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.1);
            color: #d97706;
        }

        .status-inactive {
            background: rgba(100, 116, 139, 0.1);
            color: var(--text-muted);
        }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1024px) {
            .admin-sidebar {
                width: 240px;
                padding: 24px 16px;
            }
            
            .admin-main {
                padding: 24px;
            }
        }

        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            
            .admin-sidebar {
                width: 100%;
                height: auto;
                position: relative;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }
            
            .admin-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: center;
            }
            
            .nav-item {
                flex: 1;
                min-width: 120px;
                justify-content: center;
                text-align: center;
            }
            
            .nav-item::before {
                display: none;
            }
            
            .admin-main {
                max-height: none;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="admin-logo">
            <span>FeelSafe</span>
            <small style="color:#94a3b8;font-weight:600;">ADMIN</small>
        </div>

        <nav class="admin-nav">
            <!-- Main Navigation -->
            <div class="nav-section">
                <a href="{{ path('admin_home') }}" class="nav-item {% if app.request.get('_route') == 'admin_home' %}active{% endif %}">
                    <i class="icon">📊</i>
                    <span>Tableau de bord</span>
                </a>
                <a href="{{ path('admin_security') }}" class="nav-item {% if app.request.get('_route') == 'admin_security' %}active{% endif %}">
                    <i class="icon">🔒</i>
                    <span>Sécurité & Profil</span>
                </a>
                <a href="{{ path('admin_journal_index') }}" class="nav-item {% if app.request.get('_route') == 'admin_journal_index' %}active{% endif %}">
                    <i class="icon">📓</i>
                    <span>Journal émotionnel</span>
                </a>
            </div>

            <!-- Accompagnement Section -->
            <div class="nav-section">
                <div class="nav-section-title">Accompagnement</div>
                <a href="{{ path('admin_wellness') }}" class="nav-item {% if app.request.get('_route') starts with 'admin_wellness' %}active{% endif %}">
                    <i class="icon">😊</i>
                    <span>Bien-être</span>
                </a>
                <a href="{{ path('admin_emergency') }}" class="nav-item {% if app.request.get('_route') == 'admin_emergency' %}active{% endif %}">
                    <i class="icon">🚨</i>
                    <span>Urgence</span>
                </a>
                <a href="{{ path('admin_forum') }}" class="nav-item {% if app.request.get('_route') == 'admin_forum' %}active{% endif %}">
                    <i class="icon">👥</i>
                    <span>Communauté</span>
                </a>
            </div>

            <!-- Additional Admin Sections -->
            <div class="nav-section">
                <div class="nav-section-title">Administration</div>
                <a href="{{ path('admin_support') }}" class="nav-item {% if app.request.get('_route') == 'admin_support' %}active{% endif %}">
                    <i class="icon">🛟</i>
                    <span>Support</span>
                </a>
                <a href="{{ path('admin_profile') }}" class="nav-item {% if app.request.get('_route') == 'admin_profile' %}active{% endif %}">
                    <i class="icon">👤</i>
                    <span>Profil détaillé</span>
                </a>
                <a href="{{ path('admin_settings') }}" class="nav-item {% if app.request.get('_route') == 'admin_settings' %}active{% endif %}">
                    <i class="icon">⚙️</i>
                    <span>Paramètres</span>
                </a>
            </div>
        </nav>
        
        <!-- User Profile -->
        <div class="sidebar-user">
            <div class="user-avatar">
                <i>👤</i>
            </div>
            <div class="user-info">
                <div class="user-name">Utilisateur</div>
                <div class="user-email">user@example.com</div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="admin-main">
        {% block content %}{% endblock %}
    </main>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>