{% extends 'base.html.twig' %}

{% block title %}Administration - FeelSafe{% endblock %}

{% block body %}
<div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="bg-card border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                        <i data-feather="heart" class="w-6 h-6 text-primary-foreground"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-serif font-bold">Administration</h1>
                        <p class="text-sm text-muted-foreground">Bienvenue, {{ app.user.fullName }}</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <a href="{{ path('app_profile') }}" class="text-sm hover:text-primary">
                        <i data-feather="user" class="w-5 h-5 inline"></i>
                        Mon profil
                    </a>
                    <a href="{{ path('app_logout') }}" class="text-sm text-red-600 hover:text-red-700">
                        <i data-feather="log-out" class="w-5 h-5 inline"></i>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-lg bg-green-100 text-green-700">
                <i data-feather="check-circle" class="w-5 h-5 inline mr-2"></i>
                {{ message }}
            </div>
        {% endfor %}

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-card border rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground">Total Utilisateurs</p>
                        <p class="text-3xl font-bold mt-2">{{ stats.total }}</p>
                    </div>
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                        <i data-feather="users" class="w-6 h-6 text-primary"></i>
                    </div>
                </div>
            </div>

            <div class="bg-card border rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground">Clients</p>
                        <p class="text-3xl font-bold mt-2">{{ stats.clients }}</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <i data-feather="user" class="w-6 h-6 text-blue-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-card border rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground">Professionnels</p>
                        <p class="text-3xl font-bold mt-2">{{ stats.professionnels }}</p>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                        <i data-feather="briefcase" class="w-6 h-6 text-green-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-card border rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-muted-foreground">Administrateurs</p>
                        <p class="text-3xl font-bold mt-2">{{ stats.admins }}</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                        <i data-feather="shield" class="w-6 h-6 text-purple-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <a href="{{ path('app_admin_users') }}" class="bg-card border rounded-lg p-6 hover:shadow-lg transition-shadow">
                <i data-feather="users" class="w-8 h-8 text-primary mb-3"></i>
                <h3 class="font-semibold mb-2">Gérer les utilisateurs</h3>
                <p class="text-sm text-muted-foreground">Voir et gérer tous les comptes utilisateurs</p>
            </a>

            <a href="#" class="bg-card border rounded-lg p-6 hover:shadow-lg transition-shadow">
                <i data-feather="bar-chart" class="w-8 h-8 text-primary mb-3"></i>
                <h3 class="font-semibold mb-2">Statistiques</h3>
                <p class="text-sm text-muted-foreground">Consulter les rapports et analyses</p>
            </a>

            <a href="#" class="bg-card border rounded-lg p-6 hover:shadow-lg transition-shadow">
                <i data-feather="settings" class="w-8 h-8 text-primary mb-3"></i>
                <h3 class="font-semibold mb-2">Paramètres</h3>
                <p class="text-sm text-muted-foreground">Configurer l'application</p>
            </a>
        </div>

        <!-- Recent Users -->
        <div class="bg-card border rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4">Derniers utilisateurs inscrits</h2>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b">
                            <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Nom</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Email</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Rôle</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in recent_users %}
                        <tr class="border-b hover:bg-accent/50">
                            <td class="py-3 px-4">{{ user.fullName }}</td>
                            <td class="py-3 px-4 text-sm text-muted-foreground">{{ user.email }}</td>
                            <td class="py-3 px-4">
                                {% if user.hasRole('ROLE_ADMIN') %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-700">Admin</span>
                                {% elseif user.hasRole('ROLE_PROFESSIONNEL') %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-700">Professionnel</span>
                                {% else %}
                                    <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-700">Client</span>
                                {% endif %}
                            </td>
                            <td class="py-3 px-4 text-sm text-muted-foreground">
                                {{ user.dateCreation|date('d/m/Y') }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script src="https://unpkg.com/feather-icons"></script>
<script>
    feather.replace();
</script>
{% endblock %}
