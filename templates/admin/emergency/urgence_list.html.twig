{% extends "admin/base.html.twig" %}

{% block title %}Gestion des Urgences{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [x-cloak] { display: none !important; }
        
        .btn {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-green { background-color: #2e7d32; color: white; }
        .btn-green:hover { background-color: #1b5e20; }
        
        .btn-blue { background-color: #1565c0; color: white; }
        .btn-blue:hover { background-color: #0d47a1; }
        
        .btn-red { background-color: #c62828; color: white; }
        .btn-red:hover { background-color: #b71c1c; }
        
        .btn-gray { background-color: #e0e0e0; color: #333; }
        .btn-gray:hover { background-color: #ccc; }
        
        .filter-bar {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .filter-input {
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            width: 100px;
        }
        
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .modal-content {
            background: white;
            border-radius: 12px;
            max-width: 500px;
            width: 90%;
            padding: 20px;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 5px;
            color: #333;
        }
        
        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
        }
        
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: #2e7d32;
        }
        
        .error-message {
            color: #c62828;
            font-size: 11px;
            margin-top: 4px;
        }
        
        .badge {
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }
        
        .badge-critical { background-color: #ffebee; color: #c62828; }
        .badge-high { background-color: #fff3e0; color: #ef6c00; }
        .badge-medium { background-color: #fff8e1; color: #f9a825; }
        .badge-low { background-color: #e8f5e9; color: #2e7d32; }
        
        .badge-status-pending { background-color: #fff3e0; color: #ef6c00; }
        .badge-status-progress { background-color: #e3f2fd; color: #1565c0; }
        .badge-status-resolved { background-color: #e8f5e9; color: #2e7d32; }
        
        .table-container {
            overflow-x: auto;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
        }
        
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        
        .data-table th {
            background-color: #f1f8e9;
            padding: 10px;
            text-align: left;
            font-weight: bold;
            color: #2e7d32;
            border-bottom: 1px solid #c8e6c9;
        }
        
        .data-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .data-table tr:hover {
            background-color: #e8f5e9;
            cursor: pointer;
        }
        
        .action-icons {
            display: flex;
            gap: 8px;
        }
        
        .action-icons button {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
{% endblock %}

{% block content %}
<div x-data="urgenceManager()" x-init="init()" x-cloak>
    
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold text-gray-900">Gestion des Urgences</h1>
        <button @click="openCreateModal()" class="btn btn-green">➕ Ajouter</button>
    </div>
    
    <!-- Filter Bar -->
    <div class="filter-bar">
        <span class="text-sm font-bold">Filtrer par Gravité:</span>
        <input type="text" x-model="filterGravity" @input="filterData()" placeholder="1-5" class="filter-input">
        <button @click="clearFilter()" class="btn btn-gray">Tout afficher</button>
    </div>
    
    <!-- Table -->
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Gravité</th>
                    <th>Statut</th>
                    <th>Date/Heure</th>
                    <th>ID User</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <template x-for="item in filteredData" :key="item.id">
                    <tr>
                        <td x-text="item.id"></td>
                        <td x-text="item.type"></td>
                        <td x-text="item.description?.substring(0, 50) + (item.description?.length > 50 ? '...' : '')"></td>
                        <td>
                            <span class="badge" :class="getGravityClass(item.gravity)" x-text="item.gravity"></span>
                        </td>
                        <td>
                            <span class="badge" :class="getStatusClass(item.status)" x-text="item.status"></span>
                        </td>
                        <td x-text="item.date"></td>
                        <td x-text="item.userId"></td>
                        <td>
                            <div class="action-icons">
                                <button @click="openEditModal(item)" title="Modifier">✏️</button>
                                <button @click="deleteItem(item.id)" title="Supprimer">🗑️</button>
                            </div>
                        </td>
                    </tr>
                </template>
                <tr x-show="filteredData.length === 0">
                    <td colspan="8" class="text-center py-8 text-gray-500">Aucune urgence trouvée</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- Create/Edit Modal -->
    <div x-show="showModal" x-cloak class="modal" @click.self="closeModal()">
        <div class="modal-content">
            <h2 class="text-xl font-bold mb-4" x-text="modalTitle"></h2>
            
            <div x-show="errorMessage" class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded mb-4 text-sm" x-text="errorMessage"></div>
            
            <div class="form-group">
                <label class="form-label">Type d'urgence *</label>
                <input type="text" x-model="form.type" class="form-input" placeholder="Ex: Crise d'anxiété">
            </div>
            
            <div class="form-group">
                <label class="form-label">Description *</label>
                <textarea x-model="form.description" class="form-textarea" rows="3" placeholder="Décrivez la situation..."></textarea>
            </div>
            
            <div class="form-group">
                <label class="form-label">Niveau de gravité (1-5) *</label>
                <select x-model="form.gravity" class="form-select">
                    <option value="1">1 - Très faible</option>
                    <option value="2">2 - Faible</option>
                    <option value="3">3 - Modéré</option>
                    <option value="4">4 - Élevé</option>
                    <option value="5">5 - Critique</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">Statut *</label>
                <select x-model="form.status" class="form-select">
                    <option value="en attente">En attente</option>
                    <option value="prise en charge">Prise en charge</option>
                    <option value="résolue">Résolue</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">ID Utilisateur *</label>
                <input type="number" x-model="form.userId" class="form-input" placeholder="ID de l'utilisateur">
            </div>
            
            <div class="flex justify-end gap-2 mt-6">
                <button @click="closeModal()" class="btn btn-gray">Annuler</button>
                <button @click="save()" class="btn btn-green">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
function urgenceManager() {
    return {
        items: [],
        filteredData: [],
        filterGravity: '',
        showModal: false,
        modalTitle: '',
        isEdit: false,
        editId: null,
        errorMessage: '',
        form: {
            type: '',
            description: '',
            gravity: 3,
            status: 'en attente',
            userId: ''
        },
        
        init() {
            this.loadData();
        },
        
        async loadData() {
            try {
                const res = await fetch('{{ path('admin_urgence_data') }}');
                const data = await res.json();
                if (data.success) {
                    this.items = data.data;
                    this.filteredData = [...this.items];
                }
            } catch(e) {
                console.error('Error loading data:', e);
            }
        },
        
        filterData() {
            if (!this.filterGravity) {
                this.filteredData = [...this.items];
            } else {
                const gravity = parseInt(this.filterGravity);
                if (!isNaN(gravity) && gravity >= 1 && gravity <= 5) {
                    this.filteredData = this.items.filter(item => item.gravity === gravity);
                } else {
                    this.filteredData = [...this.items];
                }
            }
        },
        
        clearFilter() {
            this.filterGravity = '';
            this.filteredData = [...this.items];
        },
        
        getGravityClass(gravity) {
            if (gravity >= 5) return 'badge-critical';
            if (gravity >= 4) return 'badge-high';
            if (gravity >= 3) return 'badge-medium';
            return 'badge-low';
        },
        
        getStatusClass(status) {
            if (status === 'en attente') return 'badge-status-pending';
            if (status === 'prise en charge') return 'badge-status-progress';
            return 'badge-status-resolved';
        },
        
        openCreateModal() {
            this.modalTitle = 'Nouvelle Urgence';
            this.isEdit = false;
            this.editId = null;
            this.errorMessage = '';
            this.form = {
                type: '',
                description: '',
                gravity: 3,
                status: 'en attente',
                userId: ''
            };
            this.showModal = true;
        },
        
        openEditModal(item) {
            this.modalTitle = 'Modifier l\'Urgence #' + item.id;
            this.isEdit = true;
            this.editId = item.id;
            this.errorMessage = '';
            this.form = {
                type: item.type,
                description: item.description,
                gravity: item.gravity,
                status: item.status,
                userId: item.userId
            };
            this.showModal = true;
        },
        
        closeModal() {
            this.showModal = false;
        },
        
        async save() {
            this.errorMessage = '';
            
            if (!this.form.type.trim()) {
                this.errorMessage = 'Le type d\'urgence est requis';
                return;
            }
            if (this.form.type.trim().length < 3) {
                this.errorMessage = 'Le type doit contenir au moins 3 caractères';
                return;
            }
            if (!this.form.description.trim()) {
                this.errorMessage = 'La description est requise';
                return;
            }
            if (this.form.description.trim().length < 5) {
                this.errorMessage = 'La description doit contenir au moins 5 caractères';
                return;
            }
            if (!this.form.userId || this.form.userId <= 0) {
                this.errorMessage = 'ID utilisateur invalide';
                return;
            }
            
            try {
                let url, method, body;
                
                if (this.isEdit) {
                    url = `{{ path('admin_urgence_update', {'id': 'ID'}) }}`.replace('ID', this.editId);
                    method = 'PUT';
                } else {
                    url = '{{ path('admin_urgence_create') }}';
                    method = 'POST';
                }
                
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.form)
                });
                
                const data = await res.json();
                
                if (data.success) {
                    this.closeModal();
                    this.loadData();
                } else {
                    this.errorMessage = data.error;
                }
            } catch(e) {
                this.errorMessage = 'Erreur lors de l\'enregistrement';
                console.error(e);
            }
        },
        
        async deleteItem(id) {
            if (!confirm('Supprimer cette urgence ?')) return;
            
            try {
                const res = await fetch(`{{ path('admin_urgence_delete', {'id': 'ID'}) }}`.replace('ID', id), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    this.loadData();
                } else {
                    alert('Erreur: ' + data.error);
                }
            } catch(e) {
                console.error('Error deleting:', e);
            }
        }
    };
}
</script>
{% endblock %}