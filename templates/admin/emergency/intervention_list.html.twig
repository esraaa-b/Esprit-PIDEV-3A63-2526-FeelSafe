{% extends "admin/base.html.twig" %}

{% block title %}Gestion des Interventions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [x-cloak] { display: none !important; }
        
        .btn {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-green { background-color: #2e7d32; color: white; }
        .btn-green:hover { background-color: #1b5e20; }
        
        .btn-blue { background-color: #1565c0; color: white; }
        .btn-blue:hover { background-color: #0d47a1; }
        
        .btn-red { background-color: #c62828; color: white; }
        .btn-red:hover { background-color: #b71c1c; }
        
        .btn-gray { background-color: #e0e0e0; color: #333; }
        .btn-gray:hover { background-color: #ccc; }
        
        .filter-bar {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .filter-input {
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            width: 100px;
        }
        
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        
        .modal-content {
            background: white;
            border-radius: 12px;
            max-width: 500px;
            width: 90%;
            padding: 20px;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 5px;
            color: #333;
        }
        
        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
        }
        
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: #2e7d32;
        }
        
        .error-message {
            color: #c62828;
            font-size: 11px;
            margin-top: 4px;
        }
        
        .warning-message {
            background-color: #fff3e0;
            border-left: 3px solid #ff9800;
            padding: 10px;
            margin-bottom: 15px;
            font-size: 12px;
        }
        
        .badge {
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: bold;
        }
        
        .badge-status-en-cours { background-color: #e3f2fd; color: #1565c0; }
        .badge-status-terminee { background-color: #e8f5e9; color: #2e7d32; }
        .badge-status-annulee { background-color: #ffebee; color: #c62828; }
        
        .table-container {
            overflow-x: auto;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
        }
        
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        
        .data-table th {
            background-color: #f1f8e9;
            padding: 10px;
            text-align: left;
            font-weight: bold;
            color: #2e7d32;
            border-bottom: 1px solid #c8e6c9;
        }
        
        .data-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .data-table tr:hover {
            background-color: #e8f5e9;
            cursor: pointer;
        }
        
        .action-icons {
            display: flex;
            gap: 8px;
        }
        
        .action-icons button {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
{% endblock %}

{% block content %}
<div x-data="interventionManager()" x-init="init()" x-cloak>
    
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold text-gray-900">Gestion des Interventions</h1>
        <button @click="openCreateModal()" class="btn btn-green">➕ Ajouter</button>
    </div>
    
    <!-- Filter Bar - Matching Java -->
    <div class="filter-bar">
        <span class="text-sm font-bold">Filtrer par ID Urgence:</span>
        <input type="text" x-model="filterIdUrgence" @input="filterData()" placeholder="ID Urgence" class="filter-input">
        <button @click="clearFilter()" class="btn btn-gray">Tout afficher</button>
    </div>
    
    <!-- Table -->
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ID Urgence</th>
                    <th>Type</th>
                    <th>Statut</th>
                    <th>Date/Heure</th>
                    <th>Notes</th>
                    <th>ID Admin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <template x-for="item in filteredData" :key="item.id">
                    <tr>
                        <td x-text="item.id"></td>
                        <td x-text="item.idUrgence"></td>
                        <td x-text="item.type"></td>
                        <td>
                            <span class="badge" :class="getStatusClass(item.status)" x-text="item.status"></span>
                        </td>
                        <td x-text="item.date"></td>
                        <td x-text="item.notes?.substring(0, 40) + (item.notes?.length > 40 ? '...' : '')"></td>
                        <td x-text="item.adminId"></td>
                        <td>
                            <div class="action-icons">
                                <button @click="openEditModal(item)" title="Modifier">✏️</button>
                                <button @click="deleteItem(item.id)" title="Supprimer">🗑️</button>
                            </div>
                        </td>
                    </tr>
                </template>
                <tr x-show="filteredData.length === 0">
                    <td colspan="8" class="text-center py-8 text-gray-500">Aucune intervention trouvée</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- Create/Edit Modal -->
    <div x-show="showModal" x-cloak class="modal" @click.self="closeModal()">
        <div class="modal-content">
            <h2 class="text-xl font-bold mb-4" x-text="modalTitle"></h2>
            
            <!-- Warning for already terminated/cancelled (matching Java) -->
            <div x-show="warningMessage" class="warning-message" x-text="warningMessage"></div>
            
            <div x-show="errorMessage" class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded mb-4 text-sm" x-text="errorMessage"></div>
            
            <div class="form-group">
                <label class="form-label">ID Urgence *</label>
                <input type="number" x-model="form.idUrgence" class="form-input" placeholder="ID de l'urgence">
            </div>
            
            <div class="form-group">
                <label class="form-label">Type d'intervention *</label>
                <select x-model="form.type" class="form-select">
                    <option value="appel">📞 Appel</option>
                    <option value="équipe">👥 Équipe</option>
                    <option value="escalade">⬆️ Escalade</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">Statut *</label>
                <select x-model="form.status" class="form-select">
                    <option value="en cours">En cours</option>
                    <option value="terminée">Terminée</option>
                    <option value="annulée">Annulée</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">Notes</label>
                <textarea x-model="form.notes" class="form-textarea" rows="3" placeholder="Détails de l'intervention... (max 500 caractères)"></textarea>
                <div class="text-right text-xs text-gray-400 mt-1" x-text="form.notes?.length + ' / 500'"></div>
            </div>
            
            <div class="form-group">
                <label class="form-label">ID Admin *</label>
                <input type="number" x-model="form.adminId" class="form-input" placeholder="ID de l'administrateur">
            </div>
            
            <div class="flex justify-end gap-2 mt-6">
                <button @click="closeModal()" class="btn btn-gray">Annuler</button>
                <button @click="save()" class="btn btn-green">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
function interventionManager() {
    return {
        items: [],
        filteredData: [],
        filterIdUrgence: '',
        showModal: false,
        modalTitle: '',
        isEdit: false,
        editId: null,
        errorMessage: '',
        warningMessage: '',
        form: {
            idUrgence: '',
            type: 'appel',
            status: 'en cours',
            notes: '',
            adminId: ''
        },
        
        init() {
            this.loadData();
        },
        
        async loadData() {
            try {
                const res = await fetch('{{ path('admin_intervention_data') }}');
                const data = await res.json();
                if (data.success) {
                    this.items = data.data;
                    this.filteredData = [...this.items];
                }
            } catch(e) {
                console.error('Error loading data:', e);
            }
        },
        
        filterData() {
            if (!this.filterIdUrgence) {
                this.filteredData = [...this.items];
            } else {
                const idUrgence = parseInt(this.filterIdUrgence);
                if (!isNaN(idUrgence)) {
                    this.filteredData = this.items.filter(item => item.idUrgence === idUrgence);
                } else {
                    this.filteredData = [...this.items];
                }
            }
        },
        
        clearFilter() {
            this.filterIdUrgence = '';
            this.filteredData = [...this.items];
        },
        
        getStatusClass(status) {
            if (status === 'en cours') return 'badge-status-en-cours';
            if (status === 'terminée') return 'badge-status-terminee';
            return 'badge-status-annulee';
        },
        
        openCreateModal() {
            this.modalTitle = 'Nouvelle Intervention';
            this.isEdit = false;
            this.editId = null;
            this.errorMessage = '';
            this.warningMessage = '';
            this.form = {
                idUrgence: '',
                type: 'appel',
                status: 'en cours',
                notes: '',
                adminId: ''
            };
            this.showModal = true;
        },
        
        openEditModal(item) {
            this.modalTitle = 'Modifier l\'Intervention #' + item.id;
            this.isEdit = true;
            this.editId = item.id;
            this.errorMessage = '';
            this.warningMessage = '';
            
            // Check if intervention is already terminated/cancelled (matching Java warning)
            if (item.status === 'terminée' || item.status === 'annulée') {
                this.warningMessage = `⚠️ Cette intervention est déjà ${item.status}. La modification est possible mais soyez prudent.`;
            }
            
            this.form = {
                idUrgence: item.idUrgence,
                type: item.type,
                status: item.status,
                notes: item.notes || '',
                adminId: item.adminId
            };
            this.showModal = true;
        },
        
        closeModal() {
            this.showModal = false;
        },
        
        async save() {
            this.errorMessage = '';
            
            // Validation
            if (!this.form.idUrgence || this.form.idUrgence <= 0) {
                this.errorMessage = 'ID Urgence invalide';
                return;
            }
            if (!this.form.adminId || this.form.adminId <= 0) {
                this.errorMessage = 'ID Admin invalide';
                return;
            }
            if (this.form.notes && this.form.notes.length > 500) {
                this.errorMessage = 'Les notes ne peuvent pas dépasser 500 caractères';
                return;
            }
            
            try {
                let url, method, body;
                
                if (this.isEdit) {
                    url = `{{ path('admin_intervention_update', {'id': 'ID'}) }}`.replace('ID', this.editId);
                    method = 'PUT';
                } else {
                    url = '{{ path('admin_intervention_create') }}';
                    method = 'POST';
                }
                
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.form)
                });
                
                const data = await res.json();
                
                if (data.success) {
                    this.closeModal();
                    this.loadData();
                } else {
                    this.errorMessage = data.error;
                }
            } catch(e) {
                this.errorMessage = 'Erreur lors de l\'enregistrement';
                console.error(e);
            }
        },
        
        async deleteItem(id) {
            if (!confirm('Supprimer cette intervention ?')) return;
            
            try {
                const res = await fetch(`{{ path('admin_intervention_delete', {'id': 'ID'}) }}`.replace('ID', id), {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    this.loadData();
                } else {
                    alert('Erreur: ' + data.error);
                }
            } catch(e) {
                console.error('Error deleting:', e);
            }
        }
    };
}
</script>
{% endblock %}