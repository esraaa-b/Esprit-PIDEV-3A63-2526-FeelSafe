{% extends "admin/base.html.twig" %}

{% block title %}Emergency Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        [x-cloak] { display: none !important; }
    </style>
{% endblock %}

{% block content %}
<div class="space-y-8">
    {# Header #}
    <div>
        <h1 class="text-3xl font-serif font-bold text-gray-900">
            Emergency Management
        </h1>
        <p class="text-gray-600 mt-1">
            Manage emergencies and interventions
        </p>
    </div>

    {# Flash Messages #}
    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline">{{ message }}</span>
        </div>
    {% endfor %}

    {# EMERGENCY FORM #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">
                {% if edit_emergency_id %}
                    Edit Emergency #{{ edit_emergency_id }}
                {% else %}
                    Create New Emergency
                {% endif %}
            </h2>
            {% if edit_emergency_id %}
                <a href="{{ path('admin_emergency') }}" 
                   class="inline-block mt-2 px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 text-sm">
                   ← Cancel Edit
                </a>
            {% endif %}
        </div>
        <div class="p-6">
            {{ form_start(emergencyForm, {'attr': {'class': 'space-y-6'}}) }}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    {{ form_label(emergencyForm.emergencyType, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(emergencyForm.emergencyType, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
                
                <div>
                    {{ form_label(emergencyForm.severityLevel, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(emergencyForm.severityLevel, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent', 'min': 1, 'max': 5}}) }}
                </div>
                
                <div class="md:col-span-2">
                    {{ form_label(emergencyForm.emergencyDescription, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(emergencyForm.emergencyDescription, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent', 'rows': 3}}) }}
                </div>
                
                <div>
                    {{ form_label(emergencyForm.emergencyStatus, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(emergencyForm.emergencyStatus, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
                
                <div>
                    {{ form_label(emergencyForm.location, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(emergencyForm.location, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
            </div>

            {# Submit Button #}
            <div class="pt-4">
                {{ form_widget(emergencyForm.save, {'attr': {'class': 'px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500'}}) }}
            </div>
            
            {{ form_end(emergencyForm) }}
        </div>
    </div>

    {# INTERVENTION FORM #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">
                {% if edit_intervention_id %}
                    Edit Intervention #{{ edit_intervention_id }}
                {% else %}
                    Create New Intervention
                {% endif %}
            </h2>
            {% if edit_intervention_id %}
                <a href="{{ path('admin_emergency') }}" 
                   class="inline-block mt-2 px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 text-sm">
                   ← Cancel Edit
                </a>
            {% endif %}
        </div>
        <div class="p-6">
            {{ form_start(interventionForm, {'attr': {'class': 'space-y-6'}}) }}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {# Emergency selection only for new interventions #}
                {% if not edit_intervention_id and interventionForm.urgence is defined %}
                    <div>
                        {{ form_label(interventionForm.urgence, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(interventionForm.urgence, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                    </div>
                {% endif %}
                
                <div>
                    {{ form_label(interventionForm.interventionType, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(interventionForm.interventionType, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
                
                <div>
                    {{ form_label(interventionForm.result, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(interventionForm.result, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
                
                <div>
                    {{ form_label(interventionForm.interventionDate, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(interventionForm.interventionDate, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent'}}) }}
                </div>
                
                <div class="md:col-span-2">
                    {{ form_label(interventionForm.interventionNotes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(interventionForm.interventionNotes, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent', 'rows': 3}}) }}
                </div>
            </div>

            {# Submit Button #}
            <div class="pt-4">
                {{ form_widget(interventionForm.save, {'attr': {'class': 'px-4 py-2 bg-green-600 text-white font-medium rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500'}}) }}
            </div>
            
            {{ form_end(interventionForm) }}
        </div>
    </div>

    {# Emergencies Table #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">Emergencies</h2>
        </div>
        <div class="p-6">
            {% if emergencies|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Severity</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for emergency in emergencies %}
                            <tr class="{% if edit_emergency_id == emergency.id %}bg-blue-50{% endif %}">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ emergency.id }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ emergency.typeUrgence }}</td>
                                <td class="px-6 py-4 text-sm text-gray-500">{{ emergency.description|slice(0, 30) }}{% if emergency.description|length > 30 %}...{% endif %}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                        {% if emergency.severityLevel >= 4 %}bg-red-100 text-red-800
                                        {% elseif emergency.severityLevel >= 3 %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-green-100 text-green-800{% endif %}">
                                        Level {{ emergency.severityLevel }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                        {% if emergency.status == 'Resolved' %}bg-green-100 text-green-800
                                        {% elseif emergency.status == 'In Progress' %}bg-blue-100 text-blue-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {{ emergency.status }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ emergency.location }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ emergency.createdAt|date('Y-m-d H:i') }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <a href="{{ path('admin_emergency', {'edit_emergency_id': emergency.id}) }}" class="text-blue-600 hover:text-blue-900 mr-3">Edit</a>
                                    <form method="post" action="{{ path('admin_emergency_delete', {'id': emergency.id}) }}" class="inline" onsubmit="return confirm('Are you sure?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emergency.id) }}">
                                        <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-8">
                    <p class="text-gray-500">No emergencies found.</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# Interventions Table #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">Interventions</h2>
        </div>
        <div class="p-6">
            {% if interventions|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emergency ID</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emergency Type</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Intervention Type</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Result</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {% for intervention in interventions %}
                            <tr class="{% if edit_intervention_id == intervention.id %}bg-blue-50{% endif %}">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ intervention.id }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ intervention.urgence ? intervention.urgence.id : 'N/A' }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ intervention.urgence ? intervention.urgence.typeUrgence : 'N/A' }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ intervention.interventionType }}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                        {% if intervention.result == 'Success' %}bg-green-100 text-green-800
                                        {% elseif intervention.result == 'Failed' %}bg-red-100 text-red-800
                                        {% elseif intervention.result == 'Partial Success' %}bg-yellow-100 text-yellow-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {{ intervention.result }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ intervention.interventionDate|date('Y-m-d') }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <a href="{{ path('admin_emergency', {'edit_intervention_id': intervention.id}) }}" class="text-blue-600 hover:text-blue-900 mr-3">Edit</a>
                                    <form method="post" action="{{ path('admin_intervention_delete', {'id': intervention.id}) }}" class="inline" onsubmit="return confirm('Are you sure?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ intervention.id) }}">
                                        <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-8">
                    <p class="text-gray-500">No interventions found.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
// Form validation for emergency form
document.addEventListener('DOMContentLoaded', function() {
    const emergencyForm = document.querySelector('#{{ emergencyForm.vars.id }}');
    if (emergencyForm) {
        emergencyForm.addEventListener('submit', function(e) {
            const severity = emergencyForm.querySelector('[name$="[severityLevel]"]');
            if (severity) {
                const value = parseInt(severity.value);
                if (value < 1 || value > 5) {
                    alert('Severity level must be between 1 and 5');
                    e.preventDefault();
                }
            }
        });
    }
});
</script>
{% endblock %}