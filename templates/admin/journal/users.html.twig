{% extends 'admin/base.html.twig' %}

{% block title %}Admin – Utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #22c55e20;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #22c55e;
            font-weight: 600;
        }
        .btn-journaux {
            background: #22c55e;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.875rem;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .btn-tendances {
            background: #8b5cf6;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            font-size: 0.875rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        .modal-content {
            background: white;
            border-radius: 16px;
            max-width: 800px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 24px;
        }
        [x-cloak] { display: none !important; }
        .stat-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 12px;
            text-align: center;
            border: 1px solid #e2e8f0;
        }
    </style>
{% endblock %}

{% block content %}
<div class="space-y-8" x-data="userApp()" @keydown.escape.window="closeModals">
    
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold">Utilisateurs</h1>
            
            <p class="text-muted-foreground mt-2">{{ users|length }} utilisateur(s)</p>
        </div>
    </div>

    <!-- Flash messages -->
    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Search form -->
    <form method="get" class="bg-white p-4 rounded-lg border">
        <div class="flex gap-2">
            <input type="text" 
                   name="search" 
                   value="{{ app.request.get('search') }}"
                   placeholder="Rechercher par email ou nom..."
                   class="flex-1 border rounded px-3 py-2">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Rechercher</button>

        </div>
    </form>

    <!-- Users Table -->
    <div class="bg-white rounded-lg border overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left">Utilisateur</th>
                    <th class="px-4 py-3 text-left">Email</th>
                    <th class="px-4 py-3 text-center">Journaux</th>
                    <th class="px-4 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr class="border-t hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <div class="user-avatar">
                                    {{ user.prenom|first|default('') }}{{ user.nom|first|default('') }}
                                </div>
                                <div>
                                    <div class="font-medium">{{ user.prenom }} {{ user.nom }}</div>
                                    <div class="text-xs text-gray-500">ID: {{ user.id }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3">{{ user.email }}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs">
                                {{ user.userjour|length }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <div class="flex justify-center gap-2">
                                <a href="{{ path('admin_user_journals', {id: user.id}) }}" class="btn-journaux">
                                    <i class="fas fa-book-open"></i> Journaux
                                </a>
                                <button @click="openTendances({{ user.id }}, '{{ user.email }}')" class="btn-tendances">
                                    <i class="fas fa-chart-line"></i> Tendances
                                </button>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-8 text-gray-500">
                            Aucun utilisateur trouvé
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- MODAL TENDANCES -->
    <div x-show="tendancesModalOpen" 
         x-cloak
         class="modal-overlay"
         @click="tendancesModalOpen = false">
        
        <div class="modal-content" @click.stop>
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-bold">
                        Tendances de <span class="text-purple-600" x-text="selectedUserEmail"></span>
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">Analyse des 30 derniers jours</p>
                </div>
                <button @click="tendancesModalOpen = false" class="text-gray-500 hover:text-gray-700 text-2xl">×</button>
            </div>

            <!-- Loading -->
            <div x-show="tendancesLoading" class="text-center py-12">
                <i class="fas fa-spinner fa-spin text-3xl text-purple-600"></i>
                <p class="mt-2 text-gray-500">Calcul des tendances...</p>
            </div>

            <!-- Chart and Stats -->
            <div x-show="!tendancesLoading">
                <!-- Stats cards -->
                <div class="grid grid-cols-5 gap-3 mb-6">
                    <template x-for="stat in tendancesStats" :key="stat.emotion">
                        <div class="stat-card">
                            <div class="text-2xl mb-1" x-html="stat.icon"></div>
                            <div class="text-xs font-medium text-gray-500" x-text="stat.label"></div>
                            <div class="text-lg font-bold" x-text="stat.count"></div>
                            <div class="text-xs" :style="'color: ' + stat.color" x-text="stat.percentage + '%'"></div>
                        </div>
                    </template>
                </div>

                <!-- Chart -->
                <div class="h-64 mt-6">
                    <canvas id="tendancesChart"></canvas>
                </div>

                <!-- Legend -->
                <div class="flex flex-wrap gap-4 justify-center mt-4 text-xs">
                    <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-600"></span> Très bien</div>
                    <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-300"></span> Bien</div>
                    <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-300"></span> Neutre</div>
                    <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-200"></span> Pas bien</div>
                    <div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-600"></span> Très mal</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function userApp() {
    return {
        tendancesModalOpen: false,
        selectedUserId: null,
        selectedUserEmail: '',
        tendancesStats: [],
        tendancesLoading: false,
        tendancesChart: null,

        openTendances(userId, email) {
            this.selectedUserId = userId;
            this.selectedUserEmail = email;
            this.tendancesModalOpen = true;
            this.tendancesLoading = true;

            if (this.tendancesChart) {
                this.tendancesChart.destroy();
            }

            fetch(`/api/user/${userId}/tendances`)
                .then(r => r.json())
                .then(data => {
                    this.tendancesStats = data.stats;
                    this.tendancesLoading = false;
                    this.$nextTick(() => this.initChart(data.chartLabels, data.chartData));
                })
                .catch(() => this.tendancesLoading = false);
        },

        initChart(labels, data) {
            const ctx = document.getElementById('tendancesChart');
            if (!ctx) return;

            this.tendancesChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Très bien', data: data.tres_bien, borderColor: '#16a34a', tension: 0.4 },
                        { label: 'Bien', data: data.bien, borderColor: '#86efac', tension: 0.4 },
                        { label: 'Neutre', data: data.neutre, borderColor: '#eab308', tension: 0.4 },
                        { label: 'Pas bien', data: data.pas_bien, borderColor: '#fecaca', tension: 0.4 },
                        { label: 'Très mal', data: data.tres_mal, borderColor: '#dc2626', tension: 0.4 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });
        },

        closeModals() {
            this.tendancesModalOpen = false;
        }
    }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}