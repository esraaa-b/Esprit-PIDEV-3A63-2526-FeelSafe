{% extends 'admin/base.html.twig' %}

{% block title %}Admin – Journaux émotionnels{% endblock %}
{% block stylesheets %}
<style>
/* ===== ADMIN UTILITIES ===== */
.space-y-8 > * + * { margin-top: 2rem; }

.flex { display: flex; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-2 { gap: .5rem; }

.text-sm { font-size: .875rem; }
.text-xs { font-size: .75rem; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }

.text-muted-foreground { color: #64748b; }
.text-primary { color: #22c55e; }

.rounded-md { border-radius: 8px; }
.rounded-lg { border-radius: 12px; }
.rounded-xl { border-radius: 16px; }
.rounded-full { border-radius: 999px; }

.border { border: 1px solid #e2e8f0; }
.border-border { border-color: #e2e8f0; }

.bg-card { background: #ffffff; }
.bg-muted { background: #f1f5f9; }

.shadow-sm { box-shadow: 0 1px 2px rgba(0,0,0,.04); }

/* ===== HEADER ===== */
h1 {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
}

/* ===== FLASH ===== */
.bg-green-100 {
    background: #ecfdf5;
}
.border-green-300 {
    border-color: #86efac;
}
.text-green-800 {
    color: #065f46;
}

/* ===== TABLE ===== */
table {
    width: 100%;
    border-collapse: collapse;
}

thead th {
    background: #f8fafc;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #64748b;
}

th, td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: middle;
}

tbody tr {
    transition: background .2s ease;
}

tbody tr:hover {
    background: #f1f5f9;
}

.divide-border > tr + tr {
    border-top: 1px solid #e2e8f0;
}

/* ===== EMOTION BADGES ===== */
.bg-primary\/10 {
    background: rgba(34, 197, 94, .12);
}

.inline-flex {
    display: inline-flex;
    align-items: center;
}

/* ===== MEDIA ===== */
img {
    display: block;
}

audio {
    width: 140px;
    height: 32px;
}

/* ===== ACTION BUTTONS ===== */
a, button {
    text-decoration: none;
    background: transparent;
    cursor: pointer;
}

.border-blue-500 {
    border-color: #3b82f6;
}
.text-blue-600 {
    color: #2563eb;
}
.hover\:bg-blue-50:hover {
    background: #eff6ff;
}

.border-red-500 {
    border-color: #ef4444;
}
.text-red-600 {
    color: #dc2626;
}
.hover\:bg-red-50:hover {
    background: #fef2f2;
}

/* ===== TRUNCATION ===== */
.max-w-xs {
    max-width: 260px;
}
.truncate {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
td img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #e6ece9;
    background-color: #f8fafc;}
</style>
{% endblock %}

{% block content %}
<div class="space-y-8">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Journaux émotionnels</h1>
            <p class="text-muted-foreground text-sm">
                Gestion des journaux utilisateurs
            </p>
        </div>
    </div>

    <!-- Flash messages -->
    {% for message in app.flashes('success') %}
        <div class="rounded-lg bg-green-100 border border-green-300 px-4 py-3 text-green-800">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Table -->
    <div class="overflow-hidden rounded-xl border border-border shadow-sm bg-card">
        <table class="min-w-full text-sm">
            <thead class="bg-muted text-muted-foreground">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold">Utilisateur</th>
                    <th class="px-4 py-3 text-left font-semibold">Émotion</th>
                    <th class="px-4 py-3 text-left font-semibold">Contenu</th>
                    <th class="px-4 py-3 text-left font-semibold">Image</th>
                    <th class="px-4 py-3 text-left font-semibold">Audio</th>
                    <th class="px-4 py-3 text-left font-semibold">Creation Date</th>
                    <th class="px-4 py-3 text-center font-semibold">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-border">
                {% for journal in journals %}
                    <tr class="hover:bg-muted/40 transition">
                        
                        <!-- User -->
                        <td class="px-4 py-3 font-medium">
                            {{ journal.utilisateur.email ?? '—' }}
                        </td>

                        <!-- Emotion -->
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center rounded-full
                                px-3 py-1 text-xs font-semibold
                                bg-primary/10 text-primary">
                                {{ journal.emotion.value|capitalize }}
                            </span>
                        </td>

                        <!-- Content -->
                        <td class="px-4 py-3 max-w-xs truncate text-muted-foreground">
                            {{ journal.contenu ?? '—' }}
                        </td>

                        <!-- Image -->
                        <td class="px-4 py-3">
                            {% if journal.image %}
                                <img src="{{ asset('uploads/journals/images/' ~ journal.image) }}"
                                     alt="Journal image"
                                     class="h-12 w-12 object-cover rounded-md border">
                            {% else %}
                                <span class="text-muted-foreground text-xs">Aucune</span>
                            {% endif %}
                        </td>

                        <!-- Audio -->
                        <td class="px-4 py-3">
                            {% if journal.audio %}
                                <audio controls class="w-32 h-8">
                                    <source src="{{ asset('uploads/journals/audio/' ~ journal.audio) }}">
                                </audio>
                            {% else %}
                                <span class="text-muted-foreground text-xs">Aucun</span>
                            {% endif %}
                        </td>

                        <!-- Date -->
                        <td class="px-4 py-3 whitespace-nowrap">
                            {{ journal.dateCreation|date('d/m/Y H:i') }}
                        </td>

                        <!-- Actions -->
                        <td class="px-4 py-3">
                            <div class="flex justify-center gap-2">
                                <a href="{{ path('admin_journal_edit', {id: journal.id}) }}"
                                   class="px-3 py-1 text-xs font-semibold rounded-md
                                          border border-blue-500 text-blue-600
                                          hover:bg-blue-50 transition">
                                    Modifier
                                </a>

                                <form method="post"
                                      action="{{ path('admin_journal_delete', {id: journal.id}) }}"
                                      onsubmit="return confirm('Supprimer ce journal ?');">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('delete' ~ journal.id) }}">
                                    <button class="px-3 py-1 text-xs font-semibold rounded-md
                                                   border border-red-500 text-red-600
                                                   hover:bg-red-50 transition">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center text-muted-foreground">
                            Aucun journal émotionnel trouvé.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
