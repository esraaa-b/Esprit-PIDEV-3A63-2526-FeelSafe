{% extends 'admin/base.html.twig' %}

{% block title %}Admin – Journaux émotionnels{% endblock %}

{% block content %}
<div class="space-y-8">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">
                Journaux émotionnels
            </h1>
            <p class="text-sm text-gray-600 mt-1">
                <i class="fas fa-book-open mr-1"></i>
                Gestion des journaux utilisateurs
            </p>
        </div>
        <div class="text-sm text-gray-500 bg-gray-100 px-3 py-1.5 rounded-lg">
            <i class="fas fa-filter mr-1"></i>
            {{ journals|length }} journal{{ journals|length > 1 ? 'aux' : 'al' }}
        </div>
    </div>

    <!-- Flash messages -->
    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border-l-4 border-green-600 text-green-700 px-4 py-3 rounded-lg shadow-md animate-slideInRight relative overflow-hidden">
            <div class="flex items-center">
                <i class="fas fa-check-circle mr-2 text-green-600"></i>
                {{ message }}
            </div>
            <div class="absolute bottom-0 left-0 h-1 bg-green-600 animate-progressBar"></div>
        </div>
    {% endfor %}

    <!-- Filter form -->
    <form method="get" class="flex flex-wrap items-end gap-4 bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
        <!-- 🔎 Email Search -->
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-medium text-gray-600 mb-1">
                <i class="fas fa-envelope mr-1"></i>Recherche par email
            </label>
            <input type="text"
                   name="email"
                   value="{{ filters.email ?? '' }}"
                   placeholder="ex: user@email.com"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        </div>

        <!-- 🎯 Emotion Filter -->
        <div class="flex-1 min-w-[180px]">
            <label class="block text-xs font-medium text-gray-600 mb-1">
                <i class="fas fa-heart mr-1"></i>Filtrer par émotion
            </label>
            <select name="emotion" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white">
                <option value="">Toutes les émotions</option>
                {% for e in emotions %}
                    <option value="{{ e.value }}"
                        {{ filters.emotion == e.value ? 'selected' }}>
                        {{ e.label() }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <!-- Buttons -->
        <div class="flex items-center gap-2">
            <button class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm" type="submit">
                <i class="fas fa-search"></i>
                Rechercher
            </button>
            <a href="{{ path('admin_journal_index') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                <i class="fas fa-rotate-left"></i>
                Reset
            </a>
        </div>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-user mr-2"></i>Utilisateur
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-heart mr-2"></i>Émotion
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-file-alt mr-2"></i>Contenu
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-image mr-2"></i>Image
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-music mr-2"></i>Audio
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-calendar-alt mr-2"></i>Date
                        </th>
                        <th scope="col" class="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                            <i class="fas fa-cogs mr-2"></i>Actions
                        </th>
                    </tr>
                </thead>

                <tbody class="bg-white divide-y divide-gray-200">
                    {% for journal in journals %}
                        <tr class="hover:bg-gray-50 transition-colors animate-fadeInUp" style="animation-delay: {{ loop.index * 0.1 }}s">
                            
                            <!-- User -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center gap-3">
                                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
                                        <i class="fas fa-user text-blue-600 text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">{{ journal.utilisateur.email ?? '—' }}</div>
                                        {% if journal.utilisateur %}
                                            <div class="text-xs text-gray-500">ID: {{ journal.utilisateur.id }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>

                            <!-- Emotion -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% set emotion = journal.emotion %}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium {{ emotion.color() }}">
                                    <span>{{ emotion.icon() }}</span>
                                    {{ emotion.label() }}
                                </span>
                            </td>
                            
                            <!-- Content -->
                            <td class="px-6 py-4 max-w-xs">
                                <div class="text-sm text-gray-600 line-clamp-2" title="{{ journal.contenu ?? '' }}">
                                    {{ journal.contenu|default('—')|slice(0, 100) }}{{ journal.contenu|default('')|length > 100 ? '...' : '' }}
                                </div>
                            </td>

                            <!-- Image -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if journal.image %}
                                    <img src="{{ asset('uploads/journals/images/' ~ journal.image) }}"
                                         alt="Journal image"
                                         class="w-14 h-14 object-cover rounded-lg border-2 border-white shadow-md cursor-pointer hover:scale-105 transition-transform duration-200"
                                         onclick="openImageModal(this.src)">
                                {% else %}
                                    <div class="flex items-center gap-2 text-gray-400 text-xs">
                                        <i class="fas fa-image"></i>
                                        <span>Aucune</span>
                                    </div>
                                {% endif %}
                            </td>

                            <!-- Audio -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if journal.audio %}
                                    <audio controls class="w-36 h-8 rounded-full" preload="none">
                                        <source src="{{ asset('uploads/journals/audio/' ~ journal.audio) }}">
                                    </audio>
                                {% else %}
                                    <div class="flex items-center gap-2 text-gray-400 text-xs">
                                        <i class="fas fa-volume-mute"></i>
                                        <span>Aucun</span>
                                    </div>
                                {% endif %}
                            </td>

                            <!-- Date -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex flex-col">
                                    <span class="text-sm font-medium text-gray-900">{{ journal.dateCreation|date('d/m/Y') }}</span>
                                    <span class="text-xs text-gray-500">{{ journal.dateCreation|date('H:i') }}</span>
                                </div>
                            </td>

                            <!-- Actions -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex justify-center gap-2">
                                    <a href="#"
                                       class="inline-flex items-center gap-1 px-3 py-1.5 bg-blue-50 text-blue-600 text-xs font-medium rounded-lg hover:bg-blue-100 transition-colors open-modal"
                                       data-url="{{ path('admin_journal_edit', {id: journal.id}) }}">
                                        <i class="fas fa-edit"></i>
                                        Modifier
                                    </a>

                                    <!-- Bouton Supprimer avec modal personnalisé -->
                                    <button type="button"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-50 text-red-600 text-xs font-medium rounded-lg hover:bg-red-100 transition-colors open-delete-modal"
                                            data-id="{{ journal.id }}"
                                            data-url="{{ path('admin_journal_delete', {id: journal.id}) }}"
                                            data-email="{{ journal.utilisateur.email ?? 'Utilisateur inconnu' }}"
                                            data-emotion="{{ journal.emotion.label() }}"
                                            data-date="{{ journal.dateCreation|date('d/m/Y H:i') }}"
                                            data-token="{{ csrf_token('delete' ~ journal.id) }}">
                                        <i class="fas fa-trash"></i>
                                        Supprimer
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center">
                                    <i class="fas fa-book-open text-5xl text-gray-300 mb-4"></i>
                                    <p class="text-lg font-medium text-gray-500">Aucun journal émotionnel trouvé.</p>
                                    <p class="text-sm text-gray-400 mt-2">Les journaux apparaîtront ici une fois créés.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    
</div>

<!-- Delete Confirmation Modal Template -->
<div id="delete-modal-template" class="hidden">
    <div class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50 animate-fadeIn">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 animate-slideUp">
            <div class="p-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Confirmer la suppression</h3>
                        <p class="text-sm text-red-600 mt-1">Cette action est irréversible</p>
                    </div>
                    <button class="text-gray-400 hover:text-gray-600 text-2xl leading-none close-modal">&times;</button>
                </div>
                
                <div class="bg-gray-50 rounded-lg p-4 mb-4 border border-gray-200">
                    <div class="font-medium text-gray-900 mb-2" id="modal-user-email"></div>
                    <div class="flex gap-3 text-xs text-gray-600 mb-2">
                        <span><i class="fas fa-calendar-alt mr-1"></i> <span id="modal-date"></span></span>
                    </div>
                    <span class="inline-block px-2 py-1 bg-gray-200 text-gray-700 rounded-full text-xs font-medium" id="modal-emotion"></span>
                </div>
                
                <div class="text-sm text-gray-600 mb-6">
                    Cette action supprimera définitivement le journal et tous ses fichiers associés.
                </div>
                
                <div class="flex justify-end gap-3">
                    <button class="px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors close-modal">
                        Annuler
                    </button>
                    
                    <form method="post" action="" id="delete-form" class="inline">
                        <input type="hidden" name="_token" value="" id="delete-token">
                        <button type="submit" class="px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors">
                            Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Preview Modal -->
<div id="image-modal" class="fixed inset-0 bg-black bg-opacity-80 z-50 hidden items-center justify-center">
    <div class="relative max-w-4xl max-h-[90vh] mx-4">
        <button class="absolute -top-10 right-0 text-white text-3xl hover:text-gray-300" onclick="closeImageModal()">&times;</button>
        <img id="modal-image" src="" alt="Preview" class="max-w-full max-h-[90vh] object-contain rounded-lg">
    </div>
</div>

<!-- Styles pour les animations (nécessaires car Tailwind ne les inclut pas par défaut) -->
<style>
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes progressBar {
    from { width: 100%; }
    to { width: 0%; }
}

.animate-fadeIn {
    animation: fadeIn 0.3s ease-out;
}

.animate-slideInRight {
    animation: slideInRight 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
}

.animate-slideUp {
    animation: slideUp 0.3s ease-out;
}

.animate-fadeInUp {
    animation: fadeInUp 0.4s ease-out forwards;
    opacity: 0;
}

.animate-progressBar {
    animation: progressBar 3s linear forwards;
}

/* Styles personnalisés pour l'audio player */
audio {
    height: 32px;
    border-radius: 20px;
    outline: none;
}

audio::-webkit-media-controls-panel {
    background: #f8fafc;
    border-radius: 20px;
}

/* Line clamp pour le contenu */
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Flash messages auto-hide
    const flashes = document.querySelectorAll('.bg-green-100');
    flashes.forEach(flash => {
        setTimeout(() => {
            flash.style.animation = 'slideOutRight 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards';
            setTimeout(() => flash.remove(), 500);
        }, 3000);
    });
});

// ===== MODAL DE CONFIRMATION SUPPRESSION =====
document.addEventListener('click', function(e) {
    const deleteBtn = e.target.closest('.open-delete-modal');
    if (!deleteBtn) return;
    
    e.preventDefault();
    
    const template = document.getElementById('delete-modal-template').innerHTML;
    const modalContainer = document.createElement('div');
    modalContainer.innerHTML = template;
    const modal = modalContainer.firstElementChild;
    
    // Remplir les données
    modal.querySelector('#modal-user-email').textContent = deleteBtn.dataset.email;
    modal.querySelector('#modal-date').textContent = deleteBtn.dataset.date;
    modal.querySelector('#modal-emotion').textContent = deleteBtn.dataset.emotion;
    
    const form = modal.querySelector('#delete-form');
    form.action = deleteBtn.dataset.url;
    modal.querySelector('#delete-token').value = deleteBtn.dataset.token;
    
    // Fermeture du modal
    modal.querySelectorAll('.close-modal').forEach(btn => {
        btn.addEventListener('click', () => modal.remove());
    });
    
    modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.remove();
    });
    
    document.body.appendChild(modal);
});

// Fermeture avec Echap
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const modal = document.querySelector('.fixed.inset-0.bg-gray-900.bg-opacity-50');
        if (modal) modal.remove();
        
        const imageModal = document.getElementById('image-modal');
        if (imageModal.classList.contains('flex')) {
            closeImageModal();
        }
    }
});

// ===== MODAL D'ÉDITION =====
document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.open-modal');
    if (!btn) return;

    e.preventDefault();

    const existingModal = document.querySelector('[data-modal]');
    if (existingModal) existingModal.remove();

    try {
        const response = await fetch(btn.dataset.url);
        const html = await response.text();
        document.body.insertAdjacentHTML('beforeend', html);
        
        if (typeof window.initEmotionButtons === 'function') {
            setTimeout(() => window.initEmotionButtons(), 50);
        } else {
            setTimeout(() => {
                if (typeof window.initEmotionButtons === 'function') {
                    window.initEmotionButtons();
                }
            }, 200);
        }
    } catch (err) {
        console.error('Modal load failed', err);
    }
});

// Fermeture du modal d'édition
document.addEventListener('click', (e) => {
    if (e.target.hasAttribute('data-close')) {
        const modal = e.target.closest('[data-modal]');
        if (modal) modal.remove();
    }
    if (e.target.classList.contains('modal-overlay')) {
        e.target.remove();
    }
});

// ===== IMAGE PREVIEW MODAL =====
function openImageModal(src) {
    const modal = document.getElementById('image-modal');
    const img = document.getElementById('modal-image');
    img.src = src;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeImageModal() {
    const modal = document.getElementById('image-modal');
    modal.classList.remove('flex');
    modal.classList.add('hidden');
}

// ===== CODE POUR LES ÉMOTIONS DANS LE MODAL D'ÉDITION =====
document.addEventListener('click', function(e) {
    const label = e.target.closest('.emotion-label');
    if (!label) return;
    
    e.preventDefault();
    
    document.querySelectorAll('.emotion-label').forEach(l => {
        l.style.background = '#f8fff8';
        l.style.color = '#3a5a3a';
        l.style.borderColor = '#d8e8d8';
    });
    
    const value = label.dataset.value;
    const colors = {
        'tres_bien': '#2b5e2b',
        'bien': '#3b7a3b',
        'neutre': '#b8a83b',
        'pas_bien': '#b85a5a',
        'tres_mal': '#b33a3a'
    };
    
    label.style.background = colors[value];
    label.style.color = 'white';
    label.style.borderColor = colors[value];
    
    const radioId = label.getAttribute('for');
    if (radioId) {
        const radio = document.getElementById(radioId);
        if (radio) radio.checked = true;
    }
});
</script>
{% endblock %}