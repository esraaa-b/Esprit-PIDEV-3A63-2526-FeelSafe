<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Nouvelle Urgence - FeelSafe</title>
</head>
<body style="margin: 0; padding: 0; background-color: #1a1a2e; font-family: Arial, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color: #1a1a2e; padding: 30px 0;">
    <tr>
        <td align="center">
            <table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                {# ── Header ── #}
                <tr>
                    <td style="background-color: #e74c3c; padding: 35px 30px; text-align: center; border-radius: 10px 10px 0 0;">
                        <p style="margin: 0 0 10px 0; font-size: 28px;">🚨</p>
                        <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; line-height: 1.3;">
                            NOUVELLE<br>URGENCE<br>SIGNALÉE
                        </h1>
                    </td>
                </tr>

                {# ── Severity Badge ── #}
                <tr>
                    <td style="background-color: #2d2d44; padding: 18px 30px; border-left: 1px solid #3a3a55; border-right: 1px solid #3a3a55;">
                        <p style="margin: 0; color: #e2e2e2; font-size: 15px; font-weight: bold; letter-spacing: 0.5px;">
                            NIVEAU D'URGENCE:
                            <span style="color: {% if emergency.severityLevel >= 5 %}#e74c3c{% elseif emergency.severityLevel >= 4 %}#e67e22{% else %}#3498db{% endif %};">
                                {{ severityText }}
                            </span>
                        </p>
                    </td>
                </tr>

                {# ── Details Table ── #}
                <tr>
                    <td style="background-color: #252538; padding: 0 30px; border-left: 1px solid #3a3a55; border-right: 1px solid #3a3a55;">
                        <table width="100%" cellpadding="0" cellspacing="0">

                            <tr style="border-bottom: 1px solid #3a3a55;">
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px; width: 130px;">Signalé par:</td>
                                <td style="padding: 14px 0; color: #e2e2e2; font-size: 14px;">{{ user.prenom }} {{ user.nom }}</td>
                            </tr>

                            <tr style="border-bottom: 1px solid #3a3a55;">
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px;">Email:</td>
                                <td style="padding: 14px 0; font-size: 14px;">
                                    <a href="mailto:{{ user.email }}" style="color: #5b8dee; text-decoration: none;">{{ user.email }}</a>
                                </td>
                            </tr>

                            <tr style="border-bottom: 1px solid #3a3a55;">
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px;">Téléphone:</td>
                                <td style="padding: 14px 0; color: #e2e2e2; font-size: 14px;">{{ user.telephone ?: 'Non renseigné' }}</td>
                            </tr>

                            <tr style="border-bottom: 1px solid #3a3a55;">
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px;">Localisation:</td>
                                <td style="padding: 14px 0; color: #e2e2e2; font-size: 14px;">{{ emergency.location }}</td>
                            </tr>

                            <tr style="border-bottom: 1px solid #3a3a55;">
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px;">Date/Heure:</td>
                                <td style="padding: 14px 0; color: #e2e2e2; font-size: 14px;">{{ reportedAt|date('d/m/Y H:i:s') }}</td>
                            </tr>

                            <tr>
                                <td style="padding: 14px 0; color: #8888aa; font-size: 14px;">Niveau:</td>
                                <td style="padding: 14px 0; color: #e2e2e2; font-size: 14px;">{{ emergency.severityLevel }}/5</td>
                            </tr>

                        </table>
                    </td>
                </tr>

                {# ── Description ── #}
                <tr>
                    <td style="background-color: #252538; padding: 0 30px 20px; border-left: 1px solid #3a3a55; border-right: 1px solid #3a3a55;">
                        <p style="margin: 0 0 10px 0; color: #e2e2e2; font-size: 15px; font-weight: bold;">Description:</p>
                        <div style="background-color: #1e1e35; border-radius: 6px; padding: 15px; color: #c0c0d8; font-size: 14px; line-height: 1.6;">
                            {{ emergency.description }}
                        </div>
                    </td>
                </tr>

                {# ── Action Required Banner ── #}
                <tr>
                    <td style="background-color: #1e1e35; padding: 18px 30px; border-left: 1px solid #3a3a55; border-right: 1px solid #3a3a55; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                        <p style="margin: 0 0 8px 0; color: #c0c0d8; font-size: 13px;">
                            <strong style="color: #e2e2e2;">Action requise:</strong> Traiter cette demande d'urgence dans les plus brefs délais.
                        </p>
                        {% if emergency.severityLevel >= 5 %}
                        <p style="margin: 0; color: #e74c3c; font-size: 13px; font-weight: bold;">
                            ⚠️ URGENCE CRITIQUE – ACTION IMMÉDIATE REQUISE
                        </p>
                        {% elseif emergency.severityLevel >= 4 %}
                        <p style="margin: 0; color: #e67e22; font-size: 13px; font-weight: bold;">
                            ⚠️ URGENCE ÉLEVÉE – TRAITEMENT PRIORITAIRE
                        </p>
                        {% endif %}
                    </td>
                </tr>

                {# ── Footer ── #}
                <tr>
                    <td style="padding: 20px 0; text-align: center;">
                        <p style="margin: 0; color: #555577; font-size: 12px;">
                            Cet email a été envoyé automatiquement par le système FeelSafe.<br>
                            Ne pas répondre directement à cet email.
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>

</body>
</html>
