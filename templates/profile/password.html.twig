{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe - FeelSafe{% endblock %}

{% block body %}
<div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="bg-card border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-4">
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_profile_edit') }}" class="hover:text-primary">
                        <i data-feather="arrow-left" class="w-5 h-5"></i>
                    </a>
                    <h1 class="text-xl font-serif font-bold">Changer mon mot de passe</h1>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-lg bg-green-100 text-green-700">
                <i data-feather="check-circle" class="w-5 h-5 inline mr-2"></i>
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 p-4 rounded-lg bg-red-100 text-red-700">
                <i data-feather="alert-circle" class="w-5 h-5 inline mr-2"></i>
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-card border rounded-lg p-6">
            <div class="mb-6">
                <h2 class="text-lg font-semibold">Sécurité du compte</h2>
                <p class="text-sm text-muted-foreground mt-1">
                    Assurez-vous que votre mot de passe est fort et unique
                </p>
            </div>
            
            {{ form_start(passwordForm, {'attr': {'class': 'space-y-6'}}) }}

            <div class="space-y-2">
                {{ form_label(passwordForm.oldPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground'}}) }}
                {{ form_widget(passwordForm.oldPassword) }}
                {{ form_errors(passwordForm.oldPassword) }}
            </div>

            <hr class="my-6">

            <div class="space-y-2">
                {{ form_label(passwordForm.newPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground'}}) }}
                {{ form_widget(passwordForm.newPassword.first) }}
                {{ form_errors(passwordForm.newPassword.first) }}
            </div>

            <div class="space-y-2">
                {{ form_label(passwordForm.newPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground'}}) }}
                {{ form_widget(passwordForm.newPassword.second) }}
                {{ form_errors(passwordForm.newPassword.second) }}
                <p class="text-xs text-muted-foreground mt-2">
                    <i data-feather="info" class="w-3 h-3 inline mr-1"></i>
                    Le mot de passe doit contenir au moins 8 caractères, une majuscule, une minuscule et un chiffre
                </p>
            </div>

            <div class="flex gap-4">
                <button
                    type="submit"
                    class="flex-1 h-11 bg-primary text-primary-foreground rounded-md font-medium hover:bg-primary/90 transition-colors"
                >
                    <i data-feather="save" class="w-4 h-4 inline mr-2"></i>
                    Modifier le mot de passe
                </button>
                <a
                    href="{{ path('app_profile_edit') }}"
                    class="flex-1 h-11 border border-input bg-transparent rounded-md font-medium hover:bg-accent hover:text-accent-foreground transition-colors flex items-center justify-center"
                >
                    Annuler
                </a>
            </div>

            {{ form_end(passwordForm) }}
        </div>

        <!-- Security Tips -->
        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="font-semibold mb-3 text-blue-900">
                <i data-feather="shield" class="w-5 h-5 inline mr-2"></i>
                Conseils de sécurité
            </h3>
            <ul class="space-y-2 text-sm text-blue-800">
                <li class="flex items-start gap-2">
                    <i data-feather="check" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                    <span>Utilisez un mot de passe unique pour chaque service</span>
                </li>
                <li class="flex items-start gap-2">
                    <i data-feather="check" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                    <span>Mélangez des lettres, chiffres et symboles</span>
                </li>
                <li class="flex items-start gap-2">
                    <i data-feather="check" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                    <span>Évitez les informations personnelles évidentes</span>
                </li>
                <li class="flex items-start gap-2">
                    <i data-feather="check" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                    <span>Changez votre mot de passe régulièrement</span>
                </li>
            </ul>
        </div>
    </main>
</div>

<script src="https://unpkg.com/feather-icons"></script>
<script>
    feather.replace();
</script>
{% endblock %}
