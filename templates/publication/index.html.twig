{% extends 'admin/base.html.twig' %}

{% block title %}Forum | FeelSafe{% endblock %}

{% block content %}

<!-- Header -->
<div class="admin-header">
    <div>
        <h1>Publications</h1>
        <p style="color: var(--text-muted); margin-top:6px;">
            Gérez les publications du forum
        </p>
    </div>

    <div style="display:flex; gap:10px; align-items:center;">
        <a href="{{ path('app_publication_stats') }}" class="btn-admin" style="background:#16a34a;">
            📊 Statistiques
        </a>
        <a href="{{ path('app_publication_new') }}" class="btn-admin">
            ➕ Nouvelle publication
        </a>
    </div>
</div>

<!-- ===== SEARCH FORM ===== -->
<form method="get" action="{{ path('app_publication_index') }}" class="admin-card" style="margin:20px 0; display:flex; gap:10px; align-items:center;">
    <input type="text" name="search_id" placeholder="Search by ID" class="btn-admin-outline" style="padding:6px 10px; border-radius:6px;" value="{{ app.request.query.get('search_id') }}">
    <input type="text" name="search_titre" placeholder="Search by Title" class="btn-admin-outline" style="padding:6px 10px; border-radius:6px;" value="{{ app.request.query.get('search_titre') }}">
    <button type="submit" class="btn-admin">Search</button>
    <a href="{{ path('app_publication_index') }}" class="btn-admin btn-admin-outline" style="margin-left:auto;">Reset</a>
</form>

<!-- Card -->
<div class="admin-card">
    <div class="card-header">
        <div>
            <div class="card-title">Liste des publications</div>
            <div class="card-subtitle">
                {{ publications|length }} publication(s)
                {% if sort_by is defined %}
                    - Trié par 
                    {% if sort_by == 'datePublication' %}
                        date ({{ sort_order == 'DESC' ? 'plus récentes en premier' : 'plus anciennes en premier' }})
                    {% elseif sort_by == 'titre' %}
                        titre ({{ sort_order == 'ASC' ? 'A-Z' : 'Z-A' }})
                    {% elseif sort_by == 'id' %}
                        ID ({{ sort_order == 'ASC' ? 'croissant' : 'décroissant' }})
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th style="cursor: pointer;">
                    <a href="{{ path('app_publication_index', {
                        'search_id': app.request.query.get('search_id'),
                        'search_titre': app.request.query.get('search_titre'),
                        'sort_by': 'id',
                        'sort_order': (sort_by|default('datePublication') == 'id' and sort_order|default('DESC') == 'ASC') ? 'DESC' : 'ASC'
                    }) }}" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 5px;">
                        ID 
                        {% if sort_by|default('datePublication') == 'id' %}
                            <span>{{ sort_order|default('DESC') == 'ASC' ? '↑' : '↓' }}</span>
                        {% endif %}
                    </a>
                </th>
                <th style="cursor: pointer;">
                    <a href="{{ path('app_publication_index', {
                        'search_id': app.request.query.get('search_id'),
                        'search_titre': app.request.query.get('search_titre'),
                        'sort_by': 'titre',
                        'sort_order': (sort_by|default('datePublication') == 'titre' and sort_order|default('DESC') == 'ASC') ? 'DESC' : 'ASC'
                    }) }}" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 5px;">
                        Titre
                        {% if sort_by|default('datePublication') == 'titre' %}
                            <span>{{ sort_order|default('DESC') == 'ASC' ? '↑' : '↓' }}</span>
                        {% endif %}
                    </a>
                </th>
                <th>Contenu</th>
                <th>Image</th>
                <th style="cursor: pointer;">
                    <a href="{{ path('app_publication_index', {
                        'search_id': app.request.query.get('search_id'),
                        'search_titre': app.request.query.get('search_titre'),
                        'sort_by': 'datePublication',
                        'sort_order': (sort_by|default('datePublication') == 'datePublication' and sort_order|default('DESC') == 'ASC') ? 'DESC' : 'ASC'
                    }) }}" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 5px;">
                        Date
                        {% if sort_by|default('datePublication') == 'datePublication' %}
                            <span>{{ sort_order|default('DESC') == 'ASC' ? '↑' : '↓' }}</span>
                        {% endif %}
                    </a>
                </th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for publication in publications %}
            <tr>
                <td>#{{ publication.id }}</td>
                <td><strong>{{ publication.titre }}</strong></td>
                <td>{{ publication.contenu|slice(0, 60) }}{% if publication.contenu|length > 60 %}...{% endif %}</td>
                <td>
                    {% if publication.image %}
                        <img src="{{ asset('uploads/' ~ publication.image) }}" alt="image" style="width:60px;height:40px;object-fit:cover;border-radius:6px;">
                    {% else %}
                        <span style="color: var(--text-light);">Aucune</span>
                    {% endif %}
                </td>
                <td>{{ publication.datePublication ? publication.datePublication|date('d/m/Y') : '-' }}</td>
                <td style="text-align:right;">
                    <a href="{{ path('app_publication_show', {id: publication.id}) }}" class="btn-admin btn-admin-outline" style="padding:6px 10px;font-size:12px;">Voir</a>
                    <a href="{{ path('app_publication_edit', {id: publication.id}) }}" class="btn-admin" style="padding:6px 10px;font-size:12px;">Modifier</a>
                    <form method="post" action="{{ path('app_publication_delete', {'id': publication.id}) }}" style="display:inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette publication ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ publication.id) }}">
                        <button type="submit" class="btn-admin btn-admin-outline">🗑 Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" style="text-align:center; padding:30px; color:var(--text-muted);">Aucune publication pour le moment</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}