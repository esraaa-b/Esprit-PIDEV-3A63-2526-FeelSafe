{% extends 'dashboard/base.html.twig' %}

{% block title %}Statistiques Forum | FeelSafe{% endblock %}

{% block stylesheets %}
<style>
    /* Masquer la barre de modules (navbar) uniquement sur cette page */
    .fixed.top-0.left-0.right-0 {
        display: none !important;
    }
    /* Annuler le padding-top ajouté par la base dashboard */
    body {
        padding-top: 0 !important;
    }
    main {
        padding-top: 1rem !important;
    }
    .stats-card {
        background: white;
        border-radius: 1.25rem;
        padding: 1.5rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stats-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    }
    .icon-box {
        width: 3rem;
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-6 px-4">
    {# Header & Back #}
    <div class="flex items-center justify-between mb-8">
        <a href="javascript:history.back()" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors">
            <i data-feather="arrow-left" class="w-4 h-4 mr-1"></i>
            Retour
        </a>
    
    </div>

    {# KPI Grid #}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                <i data-feather="file-text"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500">Publications</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ totalPubs }}</h3>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-green-50 flex items-center justify-center text-green-600">
                <i data-feather="message-circle"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500">Commentaires</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ totalComments }}</h3>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center text-red-600">
                <i data-feather="heart"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500">Total Likes</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ totalLikes }}</h3>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-gray-50 flex items-center justify-center text-gray-600">
                <i data-feather="thumbs-down"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500">Total Dislikes</p>
                <h3 class="text-2xl font-bold text-gray-900">{{ totalDislikes }}</h3>
            </div>
        </div>
    </div>

    {# Row 1: Monthly Chart (Full Width) #}
    <div class="bg-white rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50 p-8 mb-8">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-xl font-bold text-gray-900">Activité Mensuelle</h2>
            <div class="flex gap-4">
                <div class="flex items-center gap-1.5">
    <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Publications</span>
</div>
<div class="flex items-center gap-1.5">
    <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Commentaires</span>
</div>
<div class="flex items-center gap-1.5">
    <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
    <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">Réactions</span>
</div>
            </div>
        </div>
        <div style="height: 450px;">
            <canvas id="forumChart"></canvas>
        </div>
    </div>

   {# Row 2: Top Publications & Sentiment Overview #}
<div class="grid grid-cols-1 lg:grid-cols-4 gap-8 mb-8">
    {# Top Publications (1/4 width) #}
    <div class="lg:col-span-1 bg-white rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50 p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            <i data-feather="trending-up" class="text-orange-500 w-5 h-5"></i>
            Top Content
        </h2>
        <div class="space-y-4">
            {% for pub in topPublications %}
            <div class="flex items-center gap-3 p-3 rounded-2xl hover:bg-gray-50 transition-colors">
                <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center text-orange-600 font-bold text-sm">
                    #{{ loop.index }}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-gray-900 truncate">{{ pub.titre }}</p>
                    <p class="text-[10px] text-gray-500">{{ pub.likesCount }} likes • {{ pub.pubCom|length }} comms</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# Sentiment charts (3/4 width) #}
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50 p-6">
            <h3 class="text-sm font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i data-feather="smile" class="text-blue-500 w-4 h-4"></i>
                Likes / Catégorie
            </h3>
            <div style="height: 250px;">
                <canvas id="likesChart"></canvas>
            </div>
        </div>
        <div class="bg-white rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50 p-6">
            <h3 class="text-sm font-bold text-gray-900 mb-4 flex items-center gap-2">
                <i data-feather="frown" class="text-gray-400 w-4 h-4"></i>
                Dislikes / Catégorie
            </h3>
            <div style="height: 250px;">
                <canvas id="dislikesChart"></canvas>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Monthly Activity Chart
    const ctxMain = document.getElementById('forumChart').getContext('2d');
    const greenGradient = ctxMain.createLinearGradient(0, 0, 0, 400);
    greenGradient.addColorStop(0, 'rgba(34, 197, 94, 0.2)');
    greenGradient.addColorStop(1, 'rgba(34, 197, 94, 0)');
    const purpleGradient = ctxMain.createLinearGradient(0, 0, 0, 400);
    purpleGradient.addColorStop(0, 'rgba(168, 85, 247, 0.1)');
    purpleGradient.addColorStop(1, 'rgba(168, 85, 247, 0)');
    
    new Chart(ctxMain, {
        type: 'bar',
        data: {
            labels: {{ months|json_encode|raw }},
            datasets: [
                {
                    label: 'Publications',
                    data: {{ pubCounts|json_encode|raw }},
                    backgroundColor: 'rgba(59, 130, 246, 0.85)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 0,
                    borderRadius: 6,
                    barThickness: 20,
                    order: 3
                },
                {
                    label: 'Commentaires',
                    data: {{ comCounts|json_encode|raw }},
                    type: 'line',
                    borderColor: '#22c55e',
                    borderWidth: 3,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#22c55e',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    backgroundColor: greenGradient,
                    tension: 0.4,
                    order: 2
                },
                {
                    label: 'Réactions',
                    data: {{ reactCounts|json_encode|raw }},
                    type: 'line',
                    borderColor: '#a855f7',
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#a855f7',
                    pointBorderWidth: 2,
                    pointRadius: 3,
                    fill: true,
                    backgroundColor: purpleGradient,
                    tension: 0.4,
                    order: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { padding: 12, backgroundColor: '#1e293b', cornerRadius: 8 }
            },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9', drawBorder: false }, ticks: { color: '#64748b' } },
                x: { grid: { display: false, drawBorder: false }, ticks: { color: '#64748b' } }
            }
        }
    });

    // 2. Likes per Category Chart
    const ctxLikes = document.getElementById('likesChart').getContext('2d');
    const blueGrad = ctxLikes.createLinearGradient(0, 0, 400, 0);
    blueGrad.addColorStop(0, '#3b82f6');
    blueGrad.addColorStop(1, '#60a5fa');

    new Chart(ctxLikes, {
        type: 'bar',
        data: {
            labels: {{ catLabels|json_encode|raw }},
            datasets: [{
                label: 'Likes',
                data: {{ catLikes|json_encode|raw }},
                backgroundColor: blueGrad,
                borderRadius: 4,
                barThickness: 12
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: { 
                legend: { display: false },
                tooltip: { backgroundColor: '#1e293b', cornerRadius: 6 }
            },
            scales: {
                x: { 
                    beginAtZero: true, 
                    grid: { color: '#f1f5f9' },
                    ticks: { color: '#94a3b8', font: { size: 10 } }
                },
                y: { 
                    grid: { display: false }, 
                    ticks: { color: '#475569', font: { size: 11, weight: '500' } } 
                }
            }
        }
    });

    // 3. Dislikes per Category Chart
    const ctxDis = document.getElementById('dislikesChart').getContext('2d');
    const slateGrad = ctxDis.createLinearGradient(0, 0, 400, 0);
    slateGrad.addColorStop(0, '#94a3b8');
    slateGrad.addColorStop(1, '#cbd5e1');

    new Chart(ctxDis, {
        type: 'bar',
        data: {
            labels: {{ catLabels|json_encode|raw }},
            datasets: [{
                label: 'Dislikes',
                data: {{ catDislikes|json_encode|raw }},
                backgroundColor: slateGrad,
                borderRadius: 4,
                barThickness: 12
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: { 
                legend: { display: false },
                tooltip: { backgroundColor: '#1e293b', cornerRadius: 6 }
            },
            scales: {
                x: { 
                    beginAtZero: true, 
                    grid: { color: '#f1f5f9' },
                    ticks: { color: '#94a3b8', font: { size: 10 } }
                },
                y: { 
                    grid: { display: false }, 
                    ticks: { color: '#475569', font: { size: 11, weight: '500' } } 
                }
            }
        }
    });

    if (typeof feather !== 'undefined') feather.replace();
});
</script>
{% endblock %}
