{% extends 'dashboard/base.html.twig' %}

{% block title %}Statistiques Forum | FeelSafe{% endblock %}

{% block content %}
<div class="admin-header">
    <h1>Statistiques Forum</h1>
    <p style="color: var(--text-muted); margin-top:6px;">
        Activité des publications et commentaires
    </p>
</div>

<div class="admin-card">
    <div class="card-header">
        <div class="card-title">Statistiques mensuelles</div>
    </div>
    <canvas id="forumChart" width="400" height="200"></canvas>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('forumChart').getContext('2d');
    
    // Vérifiez que les données existent
    console.log('Months:', {{ months|json_encode|raw }});
    console.log('Publications:', {{ pubCounts|json_encode|raw }});
    console.log('Commentaires:', {{ comCounts|json_encode|raw }});
    
    const forumChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ months|json_encode|raw }},         // ["January","February",...]
            datasets: [
                {
                    label: 'Publications',
                    data: {{ pubCounts|json_encode|raw }}, // [0,0,3,1,...]
                    backgroundColor: 'rgba(14, 165, 233, 0.7)',
                    borderColor: 'rgba(14, 165, 233, 1)',
                    borderWidth: 1,
                    borderRadius: 6,
                    yAxisID: 'y'
                },
                {
                    label: 'Commentaires',
                    data: {{ comCounts|json_encode|raw }}, // [0,0,5,2,...]
                    type: 'line',
                    borderColor: 'rgba(34,197,94,1)',
                    backgroundColor: 'rgba(34,197,94,0.2)',
                    fill: true,
                    tension: 0.3,
                    yAxisID: 'y'
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: true,
                    text: 'Activité mensuelle du forum'
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Nombre'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Mois'
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}