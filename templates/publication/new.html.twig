{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle publication | FeelSafe{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto py-8">
    <div class="mb-8">
        <a href="{{ path('app_publication_index') }}" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors">
            <i data-feather="arrow-left" class="w-4 h-4 mr-1"></i>
            Retour à la gestion
        </a>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Créer une nouvelle publication</h1>
        <p class="text-gray-500 mt-1 text-sm text-lg">Partagez du contenu informatif ou inspirant avec la communauté.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl shadow-gray-100 border border-gray-100 p-8">
        {{ include('publication/_form.html.twig', {
            'button_label': 'Publier maintenant'
        }) }}
    </div>
</div>
{% endblock %}
