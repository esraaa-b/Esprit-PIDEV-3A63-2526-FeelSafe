{% extends 'admin/base.html.twig' %}

{% block title %}Modifier Publication | FeelSafe{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto py-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <a href="javascript:history.back()" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-blue-600 transition-colors">
                <i data-feather="arrow-left" class="w-4 h-4 mr-1"></i>
                Retour
            </a>
            <h1 class="text-3xl font-bold text-gray-900 mt-2">Modifier la publication #{{ publication.id }}</h1>
        </div>
        
        <div class="bg-red-50 p-4 rounded-xl border border-red-100 flex items-center gap-4">
            <div class="text-right">
                <p class="text-xs font-bold text-red-600 uppercase">Zone de danger</p>
                <p class="text-[10px] text-red-400">Action irréversible</p>
            </div>
            {{ include('publication/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-xl shadow-gray-100 border border-gray-100 p-8">
        {{ include('publication/_form.html.twig', {
            'button_label': 'Mettre à jour'
        }) }}
    </div>
</div>
{% endblock %}