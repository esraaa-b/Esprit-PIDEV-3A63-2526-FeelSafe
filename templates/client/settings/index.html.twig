{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-4xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-serif font-bold text-foreground">Paramètres</h1>
            <p class="text-muted-foreground mt-1">
                Personnalisez votre expérience FeelSafe
            </p>
        </div>

        <!-- Appearance -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Apparence</h2>
            </div>
            <p class="text-muted-foreground mb-6">
                Personnalisez l'apparence de l'application
            </p>
            
            <div class="space-y-6">
                <!-- Theme -->
                <div class="flex items-center justify-between">
                    <div class="space-y-1">
                        <span class="text-sm font-medium text-foreground">Thème</span>
                        <p class="text-sm text-muted-foreground">
                            Choisissez le thème de l'interface
                        </p>
                    </div>
                    <div x-data="{ theme: 'light' }" class="flex gap-2">
                        <button @click="theme = 'light'"
                                :class="theme === 'light' 
                                        ? 'border-primary bg-primary/5' 
                                        : 'border-border hover:border-muted-foreground'"
                                class="p-3 rounded-lg border-2 transition-all">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                <line x1="1" y1="12" x2="3" y2="12"></line>
                                <line x1="21" y1="12" x2="23" y2="12"></line>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                            </svg>
                        </button>
                        <button @click="theme = 'dark'"
                                :class="theme === 'dark' 
                                        ? 'border-primary bg-primary/5' 
                                        : 'border-border hover:border-muted-foreground'"
                                class="p-3 rounded-lg border-2 transition-all">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Language -->
                <div class="flex items-center justify-between">
                    <div class="space-y-1">
                        <span class="text-sm font-medium text-foreground">Langue</span>
                        <p class="text-sm text-muted-foreground">
                            Sélectionnez votre langue préférée
                        </p>
                    </div>
                    <div x-data="{ language: 'fr' }" class="relative">
                        <button @click="$refs.languageDropdown.classList.toggle('hidden')"
                                class="w-40 h-10 px-3 rounded-lg border border-input bg-background text-foreground flex items-center justify-between hover:bg-secondary/50 transition-colors">
                            <template x-if="language === 'fr'">Français</template>
                            <template x-if="language === 'en'">English</template>
                            <template x-if="language === 'es'">Español</template>
                            <template x-if="language === 'de'">Deutsch</template>
                            <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        
                        <div x-ref="languageDropdown" class="hidden absolute top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-lg z-50">
                            <button @click="language = 'fr'; $refs.languageDropdown.classList.add('hidden')"
                                    class="w-full px-3 py-2 text-left hover:bg-secondary transition-colors">
                                Français
                            </button>
                            <button @click="language = 'en'; $refs.languageDropdown.classList.add('hidden')"
                                    class="w-full px-3 py-2 text-left hover:bg-secondary transition-colors">
                                English
                            </button>
                            <button @click="language = 'es'; $refs.languageDropdown.classList.add('hidden')"
                                    class="w-full px-3 py-2 text-left hover:bg-secondary transition-colors">
                                Español
                            </button>
                            <button @click="language = 'de'; $refs.languageDropdown.classList.add('hidden')"
                                    class="w-full px-3 py-2 text-left hover:bg-secondary transition-colors">
                                Deutsch
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notifications -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Notifications</h2>
            </div>
            <p class="text-muted-foreground mb-6">
                Gérez vos préférences de notifications
            </p>
            
            <div class="space-y-6">
                {% set notificationSettings = [
                    { key: 'email', icon: 'mail', title: 'Notifications par email', desc: 'Recevez des mises à jour par email' },
                    { key: 'push', icon: 'smartphone', title: 'Notifications push', desc: 'Notifications sur votre appareil' },
                    { key: 'reminders', icon: 'clock', title: 'Rappels quotidiens', desc: 'Rappels pour le journal et la méditation' },
                    { key: 'community', icon: 'volume', title: 'Activité communautaire', desc: 'Réponses et mentions dans le forum' },
                ] %}
                
                {% for setting in notificationSettings %}
                    <div x-data="{ enabled: {{ loop.first ? 'true' : 'true' }} }" class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            {% if setting.icon == 'mail' %}
                                <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            {% elseif setting.icon == 'smartphone' %}
                                <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                    <path d="M12 18h.01"></path>
                                </svg>
                            {% elseif setting.icon == 'clock' %}
                                <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            {% elseif setting.icon == 'volume' %}
                                <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                </svg>
                            {% endif %}
                            <div>
                                <p class="font-medium text-foreground">{{ setting.title }}</p>
                                <p class="text-sm text-muted-foreground">{{ setting.desc }}</p>
                            </div>
                        </div>
                        <button @click="enabled = !enabled"
                                :class="enabled ? 'bg-primary' : 'bg-secondary'"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                            <span :class="enabled ? 'translate-x-6' : 'translate-x-1'" 
                                  class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                        </button>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Privacy -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Confidentialité</h2>
            </div>
            <p class="text-muted-foreground mb-6">
                Contrôlez la visibilité de vos informations
            </p>
            
            <div class="space-y-6">
                {% set privacySettings = [
                    { key: 'profile', title: 'Profil public', desc: 'Permettre aux autres de voir votre profil' },
                    { key: 'activity', title: 'Afficher mon activité', desc: 'Montrer votre activité récente' },
                    { key: 'stats', title: 'Partager mes statistiques', desc: 'Afficher vos stats dans le classement' },
                ] %}
                
                {% for setting in privacySettings %}
                    <div x-data="{ enabled: {{ loop.first ? 'true' : 'true' }} }" class="flex items-center justify-between">
                        <div>
                            <p class="font-medium text-foreground">{{ setting.title }}</p>
                            <p class="text-sm text-muted-foreground">{{ setting.desc }}</p>
                        </div>
                        <button @click="enabled = !enabled"
                                :class="enabled ? 'bg-primary' : 'bg-secondary'"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none">
                            <span :class="enabled ? 'translate-x-6' : 'translate-x-1'" 
                                  class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"></span>
                        </button>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Data Management -->
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center gap-2 mb-4">
                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <h2 class="text-xl font-semibold text-foreground">Gestion des données</h2>
            </div>
            <p class="text-muted-foreground mb-6">
                Exportez ou supprimez vos données personnelles
            </p>
            
            <div class="space-y-4">
                <!-- Export Data -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-secondary/50">
                    <div>
                        <p class="font-medium text-foreground">Exporter toutes mes données</p>
                        <p class="text-sm text-muted-foreground">Téléchargez une copie de vos données</p>
                    </div>
                    <button type="button" class="px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors flex items-center">
                        <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Exporter
                    </button>
                </div>

                <!-- Delete Account -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-destructive/5 border border-destructive/20">
                    <div>
                        <p class="font-medium text-foreground">Supprimer mon compte</p>
                        <p class="text-sm text-muted-foreground">Cette action est irréversible</p>
                    </div>
                    <button type="button" class="px-4 py-2 bg-destructive text-destructive-foreground rounded-lg font-medium hover:bg-destructive/90 transition-colors flex items-center">
                        <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            <line x1="10" y1="11" x2="10" y2="17"></line>
                            <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                        Supprimer
                    </button>
                </div>
            </div>
        </div>

        <!-- Save Button -->
        <div class="flex justify-end">
            <button type="button" class="px-6 py-3 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                Sauvegarder les modifications
            </button>
        </div>
    </div>
</div>
{% endblock %}