{% extends "dashboard/base.html.twig" %}

{% block title %}Prochain RDV{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto space-y-6">
    {% if nextRdv and nextRdvIso %}
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-sm text-gray-500">Prochain rendez-vous</div>
                <div class="mt-1 text-base font-medium text-gray-900">
                    <time datetime="{{ nextRdvIso }}">{{ nextRdv.dateRdv|date('d/m/Y') }} à {{ nextRdv.heureRdv|date('H:i') }}</time>
                    • {{ nextRdv.mode.value == 'en_ligne' ? 'En ligne' : 'Présentiel' }}
                </div>
                <div class="mt-1 text-sm text-gray-600">Démarre dans <span id="rdv-countdown" class="font-semibold text-gray-800">—</span></div>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('support_rdv_ics', { id: nextRdv.id }) }}" class="btn btn-outline btn-sm">.ics</a>
                {% if nextRdv.mode.value == 'en_ligne' %}
                <button type="button" class="btn btn-sm" onclick="openJitsi('{{ nextRdv.id }}','{{ app.user.getFullName()|e('js') }}','RDV FeelSafe {{ nextRdv.dateRdv|date('d/m/Y') }} {{ nextRdv.heureRdv|date('H:i') }}')">Démarrer l’appel</button>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">Propositions de prochains rendez-vous</h1>
        <a href="{{ path('app_support') }}" class="btn btn-outline">Prendre un RDV</a>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold mb-4">Suggestions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for s in suggestions %}
                <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
                    <div>
                        <div class="text-sm text-gray-500">Date</div>
                        <div class="text-base font-medium text-gray-900">{{ s.date|date('d/m/Y') }}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500">Heure</div>
                        <div class="text-base font-medium text-gray-900">{{ s.time }}</div>
                    </div>
                    <a href="{{ path('app_support', { date: s.date|date('Y-m-d'), time: s.time }) }}" class="btn btn-sm">Choisir</a>
                </div>
            {% else %}
                <div class="text-sm text-gray-500">Aucune suggestion disponible pour le moment.</div>
            {% endfor %}
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold mb-4">Mes rendez-vous</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Heure</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mode</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for r in rdvs %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 text-sm text-gray-700">{{ r.dateRdv|date('d/m/Y') }}</td>
                            <td class="px-6 py-4 text-sm text-gray-700">{{ r.heureRdv|date('H:i') }}</td>
                            <td class="px-6 py-4 text-sm text-gray-700">{{ r.mode.value == 'en_ligne' ? 'En ligne' : 'Présentiel' }}</td>
                            <td class="px-6 py-4 text-sm">
                                <span class="text-xs px-2 py-1 rounded-full 
                                    {% if r.statut.value == 'planifie' %}bg-blue-100 text-blue-700{% elseif r.statut.value == 'honore' %}bg-green-100 text-green-700{% elseif r.statut.value == 'annule' %}bg-red-100 text-red-700{% else %}bg-gray-100 text-gray-700{% endif %}">
                                    {{ r.statut.value }}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="{{ path('support_rdv_ics', { id: r.id }) }}" class="btn btn-sm btn-outline">Télécharger .ics</a>
                                    {% if r.mode.value == 'en_ligne' %}
                                        <button type="button" class="btn btn-sm btn-primary" onclick="openJitsi('{{ r.id }}','{{ app.user.getFullName()|e('js') }}','RDV FeelSafe {{ r.dateRdv|date('d/m/Y') }} {{ r.heureRdv|date('H:i') }}')">Démarrer l’appel</button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">Aucun rendez-vous</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="jitsi-modal" class="fixed inset-0 bg-black bg-opacity-60 hidden z-50">
    <div class="absolute top-4 right-4">
        <button id="jitsi-close" class="px-3 py-1 rounded bg-white text-gray-800 border">Fermer</button>
    </div>
    <div id="jitsi-container" class="w-full h-full"></div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://meet.jit.si/external_api.js"></script>
<script>
let jitsiApi=null;
function computeRoomAndPass(rdvId){const seed=btoa('feelsafe-v1:'+rdvId).replace(/[^A-Za-z0-9]/g,'');return{room:'feelsafe-'+rdvId+'-'+seed.slice(0,10),pass:seed.slice(-8)};}
function openJitsi(rdvId,displayName,subject){
    const modal=document.getElementById('jitsi-modal'),container=document.getElementById('jitsi-container'),c=computeRoomAndPass(rdvId);
    if(jitsiApi){try{jitsiApi.dispose();}catch(e){}jitsiApi=null;}
    modal.classList.remove('hidden');
    jitsiApi=new JitsiMeetExternalAPI('meet.jit.si',{roomName:c.room,parentNode:container,width:'100%',height:'100%',interfaceConfigOverwrite:{HIDE_DEEP_LINKING_LOGO:true,TOOLBAR_BUTTONS:['microphone','camera','closedcaptions','desktop','chat','raisehand','tileview','hangup']},configOverwrite:{prejoinPageEnabled:false,startWithAudioMuted:true,startWithVideoMuted:true},userInfo:{displayName:displayName}});
    jitsiApi.addListener('videoConferenceJoined',function(){try{jitsiApi.executeCommand('subject',subject||'Rendez-vous');}catch(e){}try{jitsiApi.executeCommand('password',c.pass);}catch(e){}});
    document.getElementById('jitsi-close').onclick=function(){try{jitsiApi.executeCommand('hangup');}catch(e){}setTimeout(function(){if(jitsiApi){try{jitsiApi.dispose();}catch(e){}jitsiApi=null;}modal.classList.add('hidden');container.innerHTML='';},300);};
}
</script>
{% if nextRdv and nextRdvIso %}
<script>
(function(){
  const el = document.getElementById('rdv-countdown');
  if(!el) return;
  const target = new Date('{{ nextRdvIso }}');
  function fmt(n){return String(n).padStart(2,'0');}
  function tick(){
    const now = new Date();
    let diff = Math.floor((target.getTime() - now.getTime())/1000);
    if (diff <= 0){ el.textContent = '0j 00:00:00'; return; }
    const d = Math.floor(diff / 86400); diff %= 86400;
    const h = Math.floor(diff / 3600); diff %= 3600;
    const m = Math.floor(diff / 60); const s = diff % 60;
    el.textContent = (d>0? (d+'j ') : '') + fmt(h)+':'+fmt(m)+':'+fmt(s);
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
{% endif %}
{% endblock %}
