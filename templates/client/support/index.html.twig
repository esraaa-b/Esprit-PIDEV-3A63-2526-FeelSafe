{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-serif font-bold text-foreground">Accompagnement</h1>
            <p class="text-muted-foreground mt-1">
                Support intelligent et rendez-vous avec des professionnels
            </p>
        </div>

        <!-- Tabs -->
        <div x-data="{ activeTab: 'ai-support' }" class="space-y-6">
            <!-- Tabs Navigation -->
            <div class="flex flex-wrap gap-2 border-b border-border pb-2">
                <button @click="activeTab = 'ai-support'"
                        :class="activeTab === 'ai-support' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Assistant IA
                </button>
                <button @click="activeTab = 'appointments'"
                        :class="activeTab === 'appointments' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Mes RDV
                </button>
                <button @click="activeTab = 'professionals'"
                        :class="activeTab === 'professionals' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Professionnels
                </button>
            </div>

            <!-- AI Support Tab -->
            <div x-show="activeTab === 'ai-support'" class="space-y-6">
                <div class="bg-card rounded-lg border border-border flex flex-col h-[600px]">
                    <!-- Chat Header -->
                    <div class="p-6 border-b border-border">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center">
                                <svg class="w-5 h-5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 8V4H8"></path>
                                    <rect x="4" y="8" width="16" height="12" rx="2"></rect>
                                    <circle cx="12" cy="14" r="2"></circle>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-foreground">Assistant Bien-être</h2>
                                <div class="flex items-center gap-1 text-sm text-muted-foreground">
                                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                                    Disponible 24h/24
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chat Messages -->
                    <div class="flex-1 overflow-y-auto p-6 space-y-4">
                        {% for message in chatMessages %}
                            <div class="flex {{ message.role == 'user' ? 'justify-end' : 'justify-start' }}">
                                <div class="max-w-[80%] rounded-2xl px-4 py-3 {{ message.role == 'user' ? 'bg-primary text-primary-foreground rounded-br-md' : 'bg-secondary text-secondary-foreground rounded-bl-md' }}">
                                    <p class="text-sm">{{ message.content }}</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Chat Input -->
                    <div class="p-6 border-t border-border">
                        <div class="flex gap-2">
                            <input type="text" 
                                   placeholder="Écrivez votre message..." 
                                   class="flex-1 h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                            <button type="button" class="w-10 h-10 rounded-lg bg-primary text-primary-foreground flex items-center justify-center hover:bg-primary/90 transition-colors">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                </svg>
                            </button>
                        </div>
                        <p class="text-xs text-muted-foreground mt-2 text-center">
                            Cet assistant ne remplace pas un professionnel de santé
                        </p>
                    </div>
                </div>
            </div>

            <!-- Appointments Tab -->
            <div x-show="activeTab === 'appointments'" class="space-y-6">
                <!-- Upcoming Appointments -->
                <div class="bg-card rounded-lg border border-border p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <h2 class="text-xl font-semibold text-foreground">Rendez-vous à venir</h2>
                    </div>
                    
                    <div class="space-y-4">
                        {% if upcomingAppointments|length > 0 %}
                            {% for appointment in upcomingAppointments %}
                                <div class="flex items-center justify-between p-4 rounded-xl bg-secondary/50 hover:bg-secondary transition-colors">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                                            {% if 'vidéo' in appointment.type %}
                                                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                                </svg>
                                            {% else %}
                                                <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                    <circle cx="12" cy="10" r="3"></circle>
                                                </svg>
                                            {% endif %}
                                        </div>
                                        <div>
                                            <p class="font-medium text-foreground">{{ appointment.professional }}</p>
                                            <p class="text-sm text-muted-foreground">{{ appointment.type }}</p>
                                            <div class="flex items-center gap-3 mt-1 text-sm text-muted-foreground">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                                    </svg>
                                                    {{ appointment.date }}
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"></circle>
                                                        <polyline points="12 6 12 12 16 14"></polyline>
                                                    </svg>
                                                    {{ appointment.time }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-1 text-xs rounded {{ appointment.status == 'confirmed' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground' }}">
                                            {{ appointment.status == 'confirmed' ? 'Confirmé' : 'En attente' }}
                                        </span>
                                        <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="9 18 15 12 9 6"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-8">
                                <svg class="w-12 h-12 text-muted-foreground mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <p class="text-muted-foreground">Aucun rendez-vous prévu</p>
                                <button type="button" class="mt-4 px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                                    Prendre un rendez-vous
                                </button>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-card rounded-lg border border-border p-6 hover:shadow-lg transition-shadow cursor-pointer text-center">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                            </svg>
                        </div>
                        <h3 class="font-medium text-foreground">Consultation vidéo</h3>
                        <p class="text-sm text-muted-foreground mt-1">Depuis chez vous</p>
                    </div>
                    <div class="bg-card rounded-lg border border-border p-6 hover:shadow-lg transition-shadow cursor-pointer text-center">
                        <div class="w-12 h-12 rounded-xl bg-chart-2/10 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <h3 class="font-medium text-foreground">Appel téléphonique</h3>
                        <p class="text-sm text-muted-foreground mt-1">Rapide et pratique</p>
                    </div>
                    <div class="bg-card rounded-lg border border-border p-6 hover:shadow-lg transition-shadow cursor-pointer text-center">
                        <div class="w-12 h-12 rounded-xl bg-chart-4/10 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <h3 class="font-medium text-foreground">En cabinet</h3>
                        <p class="text-sm text-muted-foreground mt-1">Près de chez vous</p>
                    </div>
                </div>
            </div>

            <!-- Professionals Tab -->
            <div x-show="activeTab === 'professionals'" class="space-y-6">
                <!-- Search -->
                <div class="flex gap-4">
                    <div class="relative flex-1">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" 
                               placeholder="Rechercher un professionnel..." 
                               class="w-full h-10 pl-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">
                    </div>
                    <button type="button" class="px-4 py-2 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors">
                        <svg class="w-4 h-4 inline mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"></path>
                        </svg>
                        Filtres
                    </button>
                </div>

                <!-- Professional List -->
                <div class="space-y-4">
                    {% for professional in professionals %}
                        <div class="bg-card rounded-lg border border-border overflow-hidden">
                            <div class="flex flex-col md:flex-row">
                                <!-- Image Placeholder -->
                                <div class="relative w-full md:w-48 h-48 md:h-auto shrink-0 bg-secondary">
                                    <div class="absolute inset-0 flex items-center justify-center text-muted-foreground">
                                        <svg class="w-16 h-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <polyline points="21 15 16 10 5 21"></polyline>
                                        </svg>
                                    </div>
                                    {% if professional.online %}
                                        <div class="absolute top-3 left-3">
                                            <span class="px-2 py-1 text-xs rounded bg-primary text-primary-foreground">
                                                Disponible en ligne
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                                
                                <!-- Info -->
                                <div class="flex-1 p-6">
                                    <div class="flex items-start justify-between">
                                        <div>
                                            <h3 class="font-semibold text-lg text-foreground">{{ professional.name }}</h3>
                                            <p class="text-muted-foreground">{{ professional.specialty }}</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-2xl font-bold text-foreground">{{ professional.price }}€</p>
                                            <p class="text-xs text-muted-foreground">par séance</p>
                                        </div>
                                    </div>
                                    
                                    <!-- Rating -->
                                    <div class="flex items-center gap-4 mt-3">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4 fill-chart-2 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                            </svg>
                                            <span class="font-medium text-foreground">{{ professional.rating }}</span>
                                            <span class="text-muted-foreground text-sm">({{ professional.reviews }} avis)</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Availability -->
                                    <div class="flex items-center gap-2 mt-4">
                                        <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <span class="text-sm text-foreground">
                                            Prochain créneau: <span class="font-medium">{{ professional.nextAvailable }}</span>
                                        </span>
                                    </div>
                                    
                                    <!-- Actions -->
                                    <div class="flex gap-2 mt-4">
                                        <button type="button" class="flex-1 px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                                            Prendre RDV
                                        </button>
                                        <button type="button" class="w-10 h-10 rounded-lg border border-input hover:bg-secondary hover:text-secondary-foreground transition-colors flex items-center justify-center">
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}