{% extends "base.html.twig" %}

{% block content %}
<div class="max-w-7xl mx-auto">
    <div class="space-y-8">
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-serif font-bold text-foreground">Accompagnement</h1>
            <p class="text-muted-foreground mt-1">
                Support intelligent et rendez-vous avec des professionnels
            </p>
        </div>

        <!-- Tabs -->
        <div x-data="{ activeTab: 'ai-support' }" class="space-y-6">
            <!-- Tabs Navigation -->
            <div class="flex flex-wrap gap-2 border-b border-border pb-2">
                <button @click="activeTab = 'ai-support'"
                        :class="activeTab === 'ai-support' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
                        class="px-4 py-2 transition-colors">
                    Assistant IA
                </button>
                <button @click="activeTab = 'appointments'"
                        :class="activeTab === 'appointments' 
                                ? 'border-b-2 border-primary text-primary font-medium' 
                                : 'text-muted-foreground hover:text-foreground'"
