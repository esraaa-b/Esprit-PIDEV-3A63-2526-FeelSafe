{# templates/dashboard/journal/edit.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Modifier le journal{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto space-y-8">
    
    <div>
        <h1 class="text-2xl font-bold text-foreground">Modifier le journal émotionnel</h1>
        <p class="text-muted-foreground">Modifiez votre entrée de journal</p>
    </div>

    <form method="post"
          enctype="multipart/form-data"
          x-data="{ selectedMood: '{{ journal.emotion.value }}' }"
          class="bg-card p-6 rounded-xl border border-border space-y-6">
        
        <input type="hidden" name="emotion" :value="selectedMood">
        
        <!-- EMOTION -->
        <div>
            <label class="block text-sm font-medium mb-3 text-foreground">Comment vous sentez-vous ?</label>
            <div class="flex gap-3 flex-wrap">
                {% for mood in moodOptions %}
                    <button type="button"
                            @click="selectedMood = '{{ mood.value }}'"
                            :class="selectedMood === '{{ mood.value }}'
                                ? 'bg-primary text-primary-foreground border-primary'
                                : 'border-border hover:border-primary/50 text-foreground'"
                            class="flex items-center gap-2 px-4 py-2 border-2 rounded-lg transition-all">
                        <span class="text-xl">{{ mood.icon() }}</span>
                        <span class="font-medium">{{ mood.label() }}</span>
                    </button>
                {% endfor %}
            </div>
        </div>

        <!-- CONTENT -->
        <div>
            <label class="block text-sm font-medium mb-2 text-foreground">Contenu de votre journal</label>
            <textarea name="contenu"
                      rows="6"
                      required
                      placeholder="Exprimez vos pensées et émotions..."
                      class="w-full rounded-lg border border-input bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary">{{ journal.contenu }}</textarea>
        </div>

        <!-- IMAGE PREVIEW -->
        {% if journal.image %}
            <div>
                <label class="block text-sm font-medium mb-2 text-foreground">Image actuelle</label>
                <img src="{{ asset('uploads/journals/images/' ~ journal.image) }}"
                     alt="Image du journal"
                     class="h-40 rounded-lg border border-border object-cover">
            </div>
        {% endif %}

        <!-- IMAGE UPLOAD -->
        <div>
            <label class="block text-sm font-medium mb-2 text-foreground">
                {% if journal.image %}Changer l'image{% else %}Ajouter une image{% endif %}
            </label>
            <input type="file" 
                   name="image"
                   accept="image/*"
                   class="block w-full text-sm text-foreground file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary file:text-primary-foreground hover:file:bg-primary/90">
        </div>

        <!-- AUDIO PREVIEW -->
        {% if journal.audio %}
            <div>
                <label class="block text-sm font-medium mb-2 text-foreground">Audio actuel</label>
                <audio controls class="w-full">
                    <source src="{{ asset('uploads/journals/audio/' ~ journal.audio) }}" type="audio/webm">
                    Votre navigateur ne supporte pas l'audio.
                </audio>
            </div>
        {% endif %}

        <!-- AUDIO UPLOAD -->
        <div>
            <label class="block text-sm font-medium mb-2 text-foreground">
                {% if journal.audio %}Changer l'audio{% else %}Ajouter un audio{% endif %}
            </label>
            <input type="file" 
                   name="audio"
                   accept="audio/*"
                   class="block w-full text-sm text-foreground file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary file:text-primary-foreground hover:file:bg-primary/90">
        </div>

        <!-- ACTIONS -->
        <div class="flex justify-end gap-3 pt-4 border-t border-border">
            <a href="{{ path('app_journal') }}"
               class="px-6 py-2 rounded-lg border border-input hover:bg-secondary transition-colors text-foreground">
                Annuler
            </a>
            
            <button type="submit"
                    class="px-6 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                Enregistrer les modifications
            </button>
        </div>
        
    </form>
</div>
{% endblock %}