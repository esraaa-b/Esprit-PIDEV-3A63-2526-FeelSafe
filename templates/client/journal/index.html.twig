                    </div>
                </div>
            </div>
        </div>

    </div>{# end max-w-7xl #}

    {% include 'client/journal/_calendar_heatmap.html.twig' %}

</div>{# end x-data journalApp #}

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lamejs/1.2.1/lame.min.js"></script>

<script>
function journalApp() {
    return {
        // State
        newJournalOpen: false,
        selectedMood: null,
        newEntry: '',
        isRecording: false,
        mediaRecorder: null,
        audioChunks: [],
        audioBlob: null,
        audioUrl: null,
        audioFile: null,
        imageFile: null,
        imagePreview: null,
        tresMalPopupOpen: false,

        // Calendar
        calendarModalOpen: false,
        calendarTotalEntries: 0,
        calendarActiveDays: 0,
        calendarLongestStreak: 0,
        _calendarData: [],

        // Edit modal
        editModalOpen: false,
        editId: null,
        editEmotion: null,
        editContenu: '',
        editCsrf: '',
        editImageUrl: null,
        editAudioUrl: null,
        removeImageFlag: '0',
        removeAudioFlag: '0',
        originalImageUrl: null,
        originalAudioUrl: null,

        // Filters
        activeMood: 'all',

        // Flash
        flashMessage: { show: false, text: '', type: 'success', timeout: null },

        // Delete modal
        deleteModal: { open: false, id: null, token: '', action: '' },

        // Charts
        calculationChartModalOpen: false,
        calculationLoading: false,
        calculationChart: null,

       init() {
    this.$nextTick(() => this.checkTresMalWarning());
},

        // ── Calendar ──────────────────────────────────────────────
        openCalendarModal() {
            const raw = JSON.parse(document.getElementById('calendar-data').textContent);
            this._calendarData = raw;
            let total = 0, active = 0;
            raw.forEach(d => { total += d.count; if (d.count > 0) active++; });
            this.calendarTotalEntries = total;
            this.calendarActiveDays  = active;
            const dates = raw.filter(d => d.count > 0).map(d => d.date).sort();
            let streak = 0, best = 0;
            dates.forEach((date, i) => {
                if (i === 0) { streak = 1; best = 1; return; }
                const diff = (new Date(date) - new Date(dates[i - 1])) / 86400000;
                streak = diff === 1 ? streak + 1 : 1;
                if (streak > best) best = streak;
            });
            this.calendarLongestStreak = best;
            this.calendarModalOpen = true;
            setTimeout(() => document.dispatchEvent(new CustomEvent('emotion-calendar:open', {
                detail: { calendarData: this._calendarData }
            })), 60);
        },
checkTresMalWarning() {
    const storageKey = 'feelsafe_tresMal_shown';
    const today      = new Date().toISOString().slice(0, 10);
    const yesterday  = new Date(Date.now() - 86400000).toISOString().slice(0, 10);

    if (localStorage.getItem(storageKey) === today) return; // already shown today — stop here

    const journals = JSON.parse(document.getElementById('journals-data')?.textContent || '[]');
    const hasTodayBad     = journals.some(j => j.emotion === 'tres_mal' && j.date === today);
    const hasYesterdayBad = journals.some(j => j.emotion === 'tres_mal' && j.date === yesterday);

    if (hasTodayBad && hasYesterdayBad) {
        localStorage.setItem(storageKey, today);
        setTimeout(() => { this.tresMalPopupOpen = true; }, 1200);
    }
    // if condition not met → tresMalPopupOpen stays false, nothing shows
},

        closeCalendarModal() {
            this.calendarModalOpen = false;
            document.dispatchEvent(new CustomEvent('emotion-calendar:close'));
        },

        // ── Flash ─────────────────────────────────────────────────
        showFlashMessage(message) {
            if (this.flashMessage.timeout) clearTimeout(this.flashMessage.timeout);
            this.flashMessage = { show: true, text: message.text, type: message.type,
                timeout: setTimeout(() => this.clearFlashMessage(), 3000) };
        },
        clearFlashMessage() {
            this.flashMessage.show = false;
            if (this.flashMessage.timeout) clearTimeout(this.flashMessage.timeout);
        },

        // ── Trends chart ──────────────────────────────────────────
        openCalculationModal() {
            this.calculationChartModalOpen = true;
            this.calculationLoading = true;
            fetch('{{ path('app_tendance_calculate_json') }}', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
                body: JSON.stringify({ _token: '{{ csrf_token('calculate_tendance') }}' })
            })
            .then(r => r.json())
            .then(data => { this.calculationLoading = false; setTimeout(() => this.initCalculationChart(data), 100); })
            .catch(() => {
                this.calculationLoading = false;
                this.calculationChartModalOpen = false;
                this.showFlashMessage({ text: 'Erreur lors du calcul des tendances', type: 'error' });
            });
        },

        closeCalculationChartModal() {
            this.calculationChartModalOpen = false;
            this.calculationLoading = false;
            if (this.calculationChart) { this.calculationChart.destroy(); this.calculationChart = null; }
        },

        initCalculationChart(data) {
            if (typeof Chart === 'undefined' || !data?.chartLabels) return;
            const ctx = document.getElementById('emotionCalculationChart');
            if (!ctx) return;
            if (this.calculationChart) { this.calculationChart.destroy(); this.calculationChart = null; }
            const DATASETS = [
                { key: 'tres_bien', label: '😊 Très bien', color: '#16a34a' },
                { key: 'bien',      label: '🙂 Bien',      color: '#86efac' },
                { key: 'neutre',    label: '😐 Neutre',    color: '#eab308' },
                { key: 'pas_bien',  label: '😕 Pas bien',  color: '#fecaca' },
                { key: 'tres_mal',  label: '😢 Très mal',  color: '#dc2626' },
            ];
            this.calculationChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.chartLabels,
                    datasets: DATASETS.map(d => ({
                        label: d.label,
                        data: data.chartData[d.key] || [],
                        borderColor: d.color,
                        backgroundColor: d.color + '1a',
                        tension: 0.4, fill: false, pointRadius: 4, borderWidth: 2
                    }))
                },
                options: {
                    responsive: true, maintainAspectRatio: false, animation: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } } }
                }
            });
        },

        handleResetSubmit(event) {
            event.preventDefault();
            this.calculationLoading = true;
            fetch('{{ path('app_tendance_reset_json') }}', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
                body: JSON.stringify({ _token: '{{ csrf_token('reset_tendance') }}' })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    this.showFlashMessage({ text: 'Tendances réinitialisées avec succès', type: 'success' });
                    if (this.calculationChartModalOpen) this.initCalculationChart(data);
                }
            })
            .catch(() => this.showFlashMessage({ text: 'Erreur lors de la réinitialisation', type: 'error' }))
            .finally(() => { this.calculationLoading = false; });
        },

        // ── Rich text toolbar helpers ─────────────────────────────
        wrapSelection(model, prefix, suffix, placeholder) {
            const id = model === 'newEntry' ? 'newEntryTextarea' : 'editContenuTextarea';
            const el = document.getElementById(id);
            if (!el) return;
            const start = el.selectionStart, end = el.selectionEnd;
            const val = el.value;
            const selected = val.slice(start, end) || placeholder;
            const newVal = val.slice(0, start) + prefix + selected + suffix + val.slice(end);
            this[model] = newVal;
            this.$nextTick(() => {
                el.focus();
                el.setSelectionRange(start + prefix.length, start + prefix.length + selected.length);
            });
        },

        insertAtLineStart(model, marker) {
            const id = model === 'newEntry' ? 'newEntryTextarea' : 'editContenuTextarea';
            const el = document.getElementById(id);
            if (!el) return;
            const pos = el.selectionStart;
            const val = el.value;
            const lineStart = val.lastIndexOf('\n', pos - 1) + 1;
            this[model] = val.slice(0, lineStart) + marker + val.slice(lineStart);
            this.$nextTick(() => { el.focus(); el.setSelectionRange(pos + marker.length, pos + marker.length); });
        },

        insertText(model, text) {
            const id = model === 'newEntry' ? 'newEntryTextarea' : 'editContenuTextarea';
            const el = document.getElementById(id);
            if (!el) return;
            const pos = el.selectionStart;
            const val = el.value;
            this[model] = val.slice(0, pos) + text + val.slice(pos);
            this.$nextTick(() => { el.focus(); el.setSelectionRange(pos + text.length, pos + text.length); });
        },

        // ── Edit modal ────────────────────────────────────────────
        openEditModal(id, emotion, contenu, imageUrl, audioUrl, csrfToken) {
            Object.assign(this, {
                editId: id, editEmotion: emotion, editContenu: contenu || '',
                editCsrf: csrfToken, editImageUrl: imageUrl || null, editAudioUrl: audioUrl || null,
                originalImageUrl: imageUrl || null, originalAudioUrl: audioUrl || null,
                removeImageFlag: '0', removeAudioFlag: '0', editModalOpen: true
            });
        },

        closeEditModal() {
            Object.assign(this, {
                editModalOpen: false, editId: null, editEmotion: null, editContenu: '',
                editCsrf: '', editImageUrl: null, editAudioUrl: null,
                originalImageUrl: null, originalAudioUrl: null,
                removeImageFlag: '0', removeAudioFlag: '0'
            });
        },

        onEditImageUpload(e) {
            const file = e.target.files[0];
            if (file) { this.removeImageFlag = '0'; this.editImageUrl = URL.createObjectURL(file); }
        },
        onEditAudioUpload(e) {
            const file = e.target.files[0];
            if (file) { this.removeAudioFlag = '0'; this.editAudioUrl = URL.createObjectURL(file); }
        },

        // ── Recording ─────────────────────────────────────────────
        async toggleRecording() {
            if (!this.isRecording) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    this.mediaRecorder = new MediaRecorder(stream);
                    this.audioChunks = [];
                    this.mediaRecorder.ondataavailable = e => this.audioChunks.push(e.data);
                    this.mediaRecorder.onstop = async () => {
                        const webmBlob  = new Blob(this.audioChunks, { type: 'audio/webm' });
                        const arrayBuf  = await webmBlob.arrayBuffer();
                        const audioBuf  = await new AudioContext().decodeAudioData(arrayBuf);
                        const mp3Blob   = this._encodeMp3(audioBuf);
                        this.audioBlob  = mp3Blob;
                        this.audioUrl   = URL.createObjectURL(mp3Blob);
                        this.audioFile  = new File([mp3Blob], 'recording.mp3', { type: 'audio/mpeg' });
                        const dt = new DataTransfer();
                        dt.items.add(this.audioFile);
                        const input = document.querySelector('#newJournalAudioInput');
                        if (input) input.files = dt.files;
                        stream.getTracks().forEach(t => t.stop());
                    };
                    this.mediaRecorder.start();
                    this.isRecording = true;
                } catch {
                    alert('Impossible d\'accéder au microphone. Vérifiez vos permissions.');
                }
            } else {
                this.mediaRecorder.stop();
                this.isRecording = false;
            }
        },

        _encodeMp3(audioBuffer) {
            const channels = audioBuffer.numberOfChannels;
            const sampleRate = audioBuffer.sampleRate;
            const mp3enc = new lamejs.Mp3Encoder(channels, sampleRate, 128);
            const left   = audioBuffer.getChannelData(0);
            const right  = channels > 1 ? audioBuffer.getChannelData(1) : left;
            const chunk  = 1152;
            const mp3Data = [];
            const l16 = new Int16Array(left.length);
            const r16 = new Int16Array(right.length);
            for (let i = 0; i < left.length; i++) {
                l16[i] = left[i]  * 32767.5;
                r16[i] = right[i] * 32767.5;
            }
            for (let i = 0; i < l16.length; i += chunk) {
                const mp3buf = mp3enc.encodeBuffer(l16.subarray(i, i + chunk), r16.subarray(i, i + chunk));
                if (mp3buf.length > 0) mp3Data.push(new Int8Array(mp3buf));
            }
            const end = mp3enc.flush();
            if (end.length > 0) mp3Data.push(new Int8Array(end));
            return new Blob(mp3Data, { type: 'audio/mpeg' });
        },

        // ── Uploads ───────────────────────────────────────────────
        onImageUpload(e) {
            this.imageFile = e.target.files[0];
            if (this.imageFile) this.imagePreview = URL.createObjectURL(this.imageFile);
        },
        onAudioUpload(e) {
            this.audioFile = e.target.files[0];
            if (this.audioFile) { this.audioUrl = URL.createObjectURL(this.audioFile); this.audioBlob = this.audioFile; }
        },

        // ── Reset form ────────────────────────────────────────────
        resetForm() {
            this.newJournalOpen = false;
            this.selectedMood = null;
            this.newEntry = '';
            this.isRecording = false;
            this.audioChunks = [];
            this.audioBlob = null;
            if (this.audioUrl) { URL.revokeObjectURL(this.audioUrl); this.audioUrl = null; }
            if (this.imagePreview) { URL.revokeObjectURL(this.imagePreview); this.imagePreview = null; }
            this.audioFile = null;
            this.imageFile = null;
            const img = document.querySelector('#newJournalImageInput');
            const aud = document.querySelector('#newJournalAudioInput');
            if (img) img.value = '';
            if (aud) aud.value = '';
        }
    };
}

document.addEventListener('alpine:init', () => Alpine.data('journalApp', journalApp));

document.addEventListener('DOMContentLoaded', () => {
    {% for message in app.flashes('success') %}
        window.dispatchEvent(new CustomEvent('flash-message', { detail: { text: '{{ message|escape('js') }}', type: 'success' } }));
    {% endfor %}
    {% for message in app.flashes('error') %}
        window.dispatchEvent(new CustomEvent('flash-message', { detail: { text: '{{ message|escape('js') }}', type: 'error' } }));
    {% endfor %}
});
