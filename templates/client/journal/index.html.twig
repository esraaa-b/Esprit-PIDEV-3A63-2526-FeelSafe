                        <div class="flex justify-end gap-3 pt-4">
                            <button type="button" @click="closeEditModal()"
                                    class="px-4 py-2 rounded-lg border border-input hover:bg-secondary transition-colors">Annuler</button>
                            <button type="submit"
                                    class="px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors">Enregistrer</button>
