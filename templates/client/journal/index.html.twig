        {# ── Global delete modal — lives outside cards so no hover-lift interference ── #}
        <div x-show="deleteModal.open" x-cloak
             class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
             style="background:rgba(0,0,0,0.5);"
             @open-delete-modal.window="deleteModal.open = true; deleteModal.id = $event.detail.id; deleteModal.token = $event.detail.token; deleteModal.action = $event.detail.action"
             @keydown.escape.window="deleteModal.open = false"
             @click.self="deleteModal.open = false">
            <div class="bg-card rounded-lg border border-border w-full max-w-md shadow-2xl p-6">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold text-foreground mb-1">Confirmer la suppression</h3>
                        <p class="text-sm text-muted-foreground mb-4">Êtes-vous sûr de vouloir supprimer cette entrée ? Cette action est irréversible.</p>
                        <div class="flex justify-end gap-2">
                            <button type="button" @click="deleteModal.open = false"
                                    class="px-3 py-1.5 text-xs font-medium rounded-md border border-input hover:bg-secondary transition-colors">
                                Annuler
                            </button>
                            <form method="post" :action="deleteModal.action" class="inline">
                                <input type="hidden" name="_token" :value="deleteModal.token">
                                <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-red-500 hover:bg-red-600 rounded-md transition-colors">
                                    Supprimer
                                </button>
