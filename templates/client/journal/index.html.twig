                                <div class="w-px h-5 bg-border mx-1"></div>
                                <button type="button" @click="insertText('editContenu', '😊')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😊</button>
                                <button type="button" @click="insertText('editContenu', '😢')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😢</button>
                                <button type="button" @click="insertText('editContenu', '💪')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">💪</button>
                                <button type="button" @click="insertText('editContenu', '❤️')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">❤️</button>
                                <button type="button" @click="insertText('editContenu', '😤')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😤</button>
                                <button type="button" @click="insertText('editContenu', '😴')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😴</button>
