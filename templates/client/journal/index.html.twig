{% extends "dashboard/base.html.twig" %}

{% block content %}
<script id="journals-data" type="application/json">
{{ journals|map(j => {
    'emotion': j.emotion.value,
    'date': j.dateCreation|date('Y-m-d')
})|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}
</script>
<div x-data="journalApp()"
     @flash-message.window="showFlashMessage($event.detail)"
     @clear-flash.window="clearFlashMessage()">

    <script id="calendar-data" type="application/json">{{ calendarData|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}</script>

    <div class="max-w-7xl mx-auto space-y-8">

        {# ── Header ── #}
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h1 class="text-3xl font-serif font-bold text-foreground">Journal Émotionnel</h1>
                <p class="text-muted-foreground mt-1">Exprimez vos émotions et suivez votre parcours de bien-être</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" @click="openCalendarModal()"
                        class="inline-flex items-center px-4 py-2 bg-secondary text-secondary-foreground rounded-lg font-medium hover:bg-secondary/80 transition-colors">
                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    Calendrier
                </button>
                <button type="button" @click="newJournalOpen = true"
                        class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors">
                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Nouvelle entrée
                </button>
            </div>
        </div>

      <div x-show="tresMalPopupOpen" x-cloak
     class="fixed inset-0 flex items-center justify-center"
     style="display:none; background:rgba(0,0,0,0.6); z-index:999999; isolation:isolate;"
             @keydown.escape.window="tresMalPopupOpen = false"
             @click.self="tresMalPopupOpen = false">
            <div class="w-full max-w-sm rounded-2xl shadow-2xl flex-shrink-0"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95">
                <div class="flex flex-col items-center gap-3 px-6 py-7" style="background:#1a3a5c;">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0"
                         style="background:rgba(255,255,255,0.13);">
                        <span style="color:#e06c7b; font-size:22px; line-height:1;">♥</span>
                    </div>
                    <span style="color:rgba(255,255,255,0.55); font-size:10px; letter-spacing:1.5px; text-transform:uppercase; font-weight:600;">
                        FEELSAFE VOUS ACCOMPAGNE
                    </span>
                    <h3 style="color:white; font-size:16px; font-weight:700; margin:0;">
                        Nous sommes là pour vous
                    </h3>
                </div>
                <div class="flex flex-col items-center gap-4 px-6 py-6 bg-card">
                    <p class="text-center text-sm text-muted-foreground" style="line-height:1.8;">
                        Cela fait deux jours que vous vous sentez très mal.<br>
                        Vous n'êtes pas seul(e) — voulez-vous en parler<br>
                        avec notre assistant IA ?
                    </p>
                    <button type="button"
                            @click="tresMalPopupOpen = false; $nextTick(() => document.getElementById('ai-drawer').dispatchEvent(new CustomEvent('open-drawer')))"
                            class="w-full py-3 rounded-xl font-bold text-sm transition-all hover:opacity-90 active:scale-95"
                            style="background:#1a3a5c; color:white; border:1px solid #2d5a8e;">
                        💬 &nbsp;Oui, je veux parler
                    </button>
                    <button type="button"
                            @click="tresMalPopupOpen = false"
                            class="w-full py-2.5 rounded-xl text-sm transition-colors hover:bg-secondary"
                            style="color:#6b7280; border:1px solid #e5e7eb; background:transparent;">
                        Non merci, peut-être plus tard
                    </button>
                </div>
            </div>
        </div>

        {# ── Flash message ── #}
        <div x-show="flashMessage.show" x-cloak
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-end="opacity-0"
             class="fixed right-6 z-[9999]" style="top:90px;">
            <div :class="flashMessage.type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700'"
                 class="border px-4 py-3 rounded-lg shadow-lg flex items-center justify-between max-w-md">
                <span x-text="flashMessage.text"></span>
                <button @click="clearFlashMessage()" class="ml-4">✕</button>
            </div>
        </div>

        {# ── Stats ── #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                            <path d="M8 11h8M8 6h8"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">{{ stats.monthEntries }}</p>
                        <p class="text-xs text-muted-foreground">Entrées ce mois</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-2/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">{{ stats.consecutiveDays }}</p>
                        <p class="text-xs text-muted-foreground">Jours consécutifs</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-lg p-6 border border-border stat-card hover-lift">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-chart-4/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-chart-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                            <line x1="9" y1="9" x2="9.01" y2="9"></line>
                            <line x1="15" y1="9" x2="15.01" y2="9"></line>
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">{{ stats.positivePercentage }}%</p>
                        <p class="text-xs text-muted-foreground">Humeur positive</p>
                    </div>
                </div>
            </div>
        </div>

        {# ── Main layout: entries left, AI panel right ── #}
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6 items-start">

            {# LEFT — journal entries #}
            <div class="min-w-0">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm mb-4">
                    <button type="button" @click="activeMood = 'all'"
                            :class="activeMood === 'all' ? 'bg-primary text-white border-primary' : 'border-input hover:bg-secondary'"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition">
                        Tous
                    </button>
                    {% for mood in moodOptions %}
                        <button type="button" @click="activeMood = '{{ mood.value }}'"
                                :class="activeMood === '{{ mood.value }}' ? '{{ mood.color() }}' : '{{ mood.inactiveColor() }}'"
                                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition">
                            <span>{{ mood.icon() }}</span>
                            <span>{{ mood.label() }}</span>
                        </button>
                    {% endfor %}
                </div>

                {% for entry in journals %}
                    {# ── single journal card ── #}
                    <div x-show="activeMood === 'all' || activeMood === '{{ entry.emotion.value }}'"
                         x-cloak
                         class="bg-card p-4 rounded-xl border mb-4 journal-card hover-lift">

                        <div class="flex items-center justify-between">
                            <h3 class="font-semibold text-lg">
                                Entrée du {{ entry.dateCreation|date('d/m/Y') }} à {{ entry.dateCreation|date('H:i') }}
                            </h3>
                            <span class="{{ entry.emotion.color() }} px-3 py-1 rounded-full text-xs font-medium flex items-center gap-1 emotion-badge">
                                <span>{{ entry.emotion.icon() }}</span>
                                <span>{{ entry.emotion.label() }}</span>
                            </span>
                        </div>

                        {% if entry.contenu %}
                            <div class="mt-3 p-3 bg-secondary/10 rounded-lg">
                                <p class="text-foreground whitespace-pre-wrap">{{ entry.contenu|nl2br }}</p>
                            </div>
                        {% endif %}

                        {% if entry.image %}
                            <div class="mt-4 flex justify-center">
                               <img src="https://res.cloudinary.com/dfgf4m52t/image/upload/{{ entry.image }}"
                                     alt="Journal image"
                                     class="rounded-lg max-w-md w-full object-cover border border-border hover-zoom">
                            </div>
                        {% endif %}

                        {% if entry.audio %}
                            <div class="mt-4">
                                <audio controls class="w-full">
                                    <source src="https://res.cloudinary.com/dfgf4m52t/raw/upload/{{ entry.audio }}">
                                </audio>
                            </div>
                        {% endif %}

                        {# ── action buttons ── #}
                        <div class="flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border">

                            <button type="button"
                                    @click="openEditModal({{ entry.id }}, {{ entry.emotion.value|json_encode|e('html_attr') }}, {{ entry.contenu|json_encode|e('html_attr') }}, {{ (entry.image ? 'https://res.cloudinary.com/dfgf4m52t/image/upload/' ~ entry.image : '')|json_encode|e('html_attr') }}, {{ (entry.audio ? 'https://res.cloudinary.com/dfgf4m52t/raw/upload/' ~ entry.audio : '')|json_encode|e('html_attr') }}, {{ csrf_token('edit_journal_' ~ entry.id)|json_encode|e('html_attr') }})"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-primary bg-primary/5 hover:bg-primary/10 rounded-lg transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                                Modifier
                            </button>

                            <button type="button"
                                    @click.stop="$dispatch('open-delete-modal', { id: {{ entry.id }}, token: '{{ csrf_token('delete' ~ entry.id) }}', action: '{{ path('app_journal_delete', {id: entry.id}) }}' })"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors"
                                    style="color:#dc2626; background:rgba(220,38,38,0.05);">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                Supprimer
                            </button>

                            <button type="button"
                                    @click="window.dispatchEvent(new CustomEvent('ai-analyse', { detail: { id: {{ entry.id }} } }))"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg transition-colors"
                                    style="color:#16a34a; background:rgba(22,163,74,0.05);">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.347.346A3.5 3.5 0 0114.5 20.5h-5a3.5 3.5 0 01-2.347-.9l-.347-.347z"/>
                                </svg>
                                Analyser
                            </button>

                        </div>{# end action buttons #}

                    </div>{# end journal card #}

                {% else %}
                    <div class="text-center py-16 bg-card rounded-xl border border-border">
                        <svg class="w-16 h-16 text-muted-foreground/30 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path>
                            <path d="M8 11h8M8 6h8"></path>
                        </svg>
                        <p class="text-lg font-medium text-foreground">Aucune entrée pour le moment</p>
                        <p class="text-sm text-muted-foreground mt-1">Utilisez le bouton "Nouvelle entrée" pour commencer</p>
                    </div>
                {% endfor %}

            </div>{# end entries column #}

            {# RIGHT — AI panel sticky sidebar #}
            <div class="sticky top-6 space-y-4">
                {% include 'client/journal/_ai_panel.html.twig' %}
            </div>

        </div>{# end grid #}

        {# ── Emotional stats section ── #}
        <div class="bg-card rounded-lg border border-border p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <h2 class="text-xl font-semibold text-foreground">Statistiques émotionnelles</h2>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" @click="openCalculationModal()"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold text-sm transition-colors shadow-sm"
                            style="background-color:#d1fae5; color:#065f46; border:1px solid #bbf7d0;">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                        Calculer les tendances
                    </button>
                </div>
            </div>
            <p class="text-muted-foreground mb-6">Vos émotions en un coup d'œil</p>
            <div class="flex flex-wrap gap-4 justify-between">
                {% for mood in moodOptions %}
                    {% set moodCount = moodStats[mood.value] ?? 0 %}
                    <div class="flex-1 min-w-[150px] bg-secondary/5 rounded-lg p-4">
                        <div class="flex flex-col items-center text-center">
                            <div class="{{ mood.color() }} w-12 h-12 rounded-full flex items-center justify-center text-xl mb-2">
                                {{ mood.icon() }}
                            </div>
                            <span class="text-sm font-medium text-foreground">{{ mood.label() }}</span>
                            <span class="text-2xl font-bold text-foreground mt-1">{{ moodCount }}</span>
                            <span class="text-xs text-muted-foreground">entrée{% if moodCount != 1 %}s{% endif %}</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# ── New entry modal ── #}
        <div x-show="newJournalOpen" x-cloak
             class="fixed inset-0 z-[9999] flex justify-center overflow-y-auto"
             style="padding-top:90px; padding-bottom:40px; background:rgba(0,0,0,0.5);"
             @keydown.escape.window="resetForm()" @click="resetForm()">
            <div class="relative bg-card rounded-lg border border-border w-full max-w-lg max-h-[90vh] flex flex-col shadow-2xl" @click.stop>
                <div class="p-6 overflow-y-auto flex-1">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-xl font-serif font-bold text-foreground">Nouvelle entrée de journal</h2>
                        <button @click="resetForm()" class="p-2 hover:bg-secondary rounded-lg transition-colors">
                            <svg class="w-5 h-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <p class="text-muted-foreground mb-6">Prenez un moment pour exprimer comment vous vous sentez</p>
                    <form method="POST" action="{{ path('app_journal_new') }}" enctype="multipart/form-data">
                        <input type="hidden" name="_token" value="{{ csrf_token('create_journal') }}">
                        <input type="hidden" name="emotion" :value="selectedMood">
                        <div class="mb-6">
                            <p class="text-sm font-medium text-foreground mb-3">Comment vous sentez-vous ?</p>
                            <div class="flex flex-wrap gap-2">
                                {% for mood in moodOptions %}
                                    <button type="button" @click="selectedMood = '{{ mood.value }}'"
                                            :class="selectedMood === '{{ mood.value }}' ? '{{ mood.color() }}' : '{{ mood.inactiveColor() }}'"
                                            class="flex items-center gap-2 px-3 py-2 rounded-full border-2 transition-all text-sm">
                                        <span>{{ mood.icon() }}</span><span>{{ mood.label() }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="flex items-center gap-1 p-2 rounded-lg border border-input bg-secondary/30 mb-2 flex-wrap">
                            <button type="button" @click="wrapSelection('newEntry', '**', '**', 'texte en gras')"
                                    class="px-2.5 py-1.5 text-sm font-bold rounded border border-input bg-card hover:bg-secondary transition-colors" title="Gras">B</button>
                            <button type="button" @click="insertAtLineStart('newEntry', '• ')"
                                    class="px-2.5 py-1.5 text-lg rounded border border-input bg-card hover:bg-secondary transition-colors leading-none" title="Puce">•</button>
                            <div class="w-px h-5 bg-border mx-1"></div>
                            <button type="button" @click="insertText('newEntry', '😊')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😊</button>
                            <button type="button" @click="insertText('newEntry', '😢')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😢</button>
                            <button type="button" @click="insertText('newEntry', '💪')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">💪</button>
                            <button type="button" @click="insertText('newEntry', '❤️')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">❤️</button>
                            <button type="button" @click="insertText('newEntry', '😤')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😤</button>
                            <button type="button" @click="insertText('newEntry', '😴')" class="px-2 py-1.5 rounded hover:bg-secondary transition-colors text-base">😴</button>
                        </div>
                        <textarea name="contenu" x-model="newEntry" id="newEntryTextarea"
                                  placeholder="Décrivez votre journée (optionnel si vous ajoutez une image ou un audio)..."
                                  class="w-full min-h-32 px-3 py-2 rounded-lg border border-input bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 mb-1"></textarea>
                        <p x-show="newEntry" class="text-xs text-muted-foreground mb-3 px-1"
                           x-text="'Aperçu : ' + newEntry.replace(/\*\*(.*?)\*\*/g, '$1')"></p>
                        <div class="space-y-3 mb-6">
                            <label class="inline-flex items-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary cursor-pointer transition-colors">
                                <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                Ajouter une image
                                <input type="file" name="image" id="newJournalImageInput" @change="onImageUpload" class="hidden" accept="image/*">
                            </label>
                            <template x-if="imagePreview">
                                <div class="max-h-44 overflow-hidden rounded-lg border">
                                    <img :src="imagePreview" alt="Aperçu" class="w-full h-full object-contain">
                                </div>
                            </template>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" @click="toggleRecording()"
                                        :class="isRecording ? 'bg-red-500 text-white border-red-500' : ''"
                                        class="inline-flex items-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary transition-colors">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M12 1v11m0 0a3 3 0 0 0 3-3V4a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3z"></path>
                                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                    </svg>
                                    <span x-text="isRecording ? 'Arrêter l\'enregistrement' : 'Enregistrer un vocal'"></span>
                                </button>
                                <label class="inline-flex items-center px-3 py-1.5 text-sm rounded-lg border border-input hover:bg-secondary cursor-pointer transition-colors">
                                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    Upload audio
                                    <input type="file" name="audio" id="newJournalAudioInput" @change="onAudioUpload" class="hidden" accept="audio/*">
                                </label>
                            </div>
                            <template x-if="audioUrl">
                                <div>
                                    <p class="text-sm text-muted-foreground mb-1">Aperçu audio :</p>
                                    <audio controls class="w-full">
                                        <source :src="audioUrl" :type="audioFile?.type || 'audio/webm'">
                                    </audio>
                                </div>
                            </template>
                        </div>
                        <div class="border-t border-border pt-4 flex justify-end gap-2">
                            <button type="button" @click="resetForm()"
                                    class="px-4 py-2 rounded-lg border border-input hover:bg-secondary transition-colors">
                                Annuler
                            </button>
                            <button type="submit"
                                    :disabled="!selectedMood || (!newEntry && !audioUrl && !imageFile)"
                                    :class="!selectedMood || (!newEntry && !audioUrl && !imageFile) ? 'opacity-50 cursor-not-allowed' : 'hover:bg-primary/90'"
                                    class="px-4 py-2 bg-primary text-primary-foreground rounded-lg transition-colors">
                                Publier
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# ── Edit modal ── #}
        <div x-show="editModalOpen" x-cloak
             class="fixed inset-0 z-[9999] flex justify-center overflow-y-auto"
             style="padding-top:90px; padding-bottom:40px; background:rgba(0,0,0,0.5);"
             @keydown.escape.window="closeEditModal()" @click="closeEditModal()">
            <div class="relative bg-card rounded-lg border border-border w-full max-w-lg max-h-[90vh] flex flex-col shadow-2xl" @click.stop>
                <div class="flex items-center justify-between p-6 border-b border-border shrink-0">
                    <h2 class="text-xl font-serif font-bold text-foreground">Modifier l'entrée</h2>
                    <button type="button" @click="closeEditModal()" class="p-2 hover:bg-secondary rounded-lg transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="p-6 overflow-y-auto flex-1">
                    <form method="POST" :action="`/dashboard/journal/${editId}/edit`" enctype="multipart/form-data">
                        <input type="hidden" name="_token" :value="editCsrf">
