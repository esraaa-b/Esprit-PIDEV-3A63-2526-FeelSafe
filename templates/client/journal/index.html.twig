                        <div class="mb-6">
                            <label class="block text-sm font-medium text-foreground mb-2">Description</label>
                            <div class="flex items-center gap-1 p-2 rounded-lg border border-input bg-secondary/30 mb-2 flex-wrap">
                                <button type="button" @click="wrapSelection('editContenu', '**', '**', 'texte en gras')"
