                        <input type="hidden" name="remove_audio" :value="removeAudioFlag">
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-foreground mb-2">Comment vous sentiez-vous ?</label>
                            <div class="flex flex-wrap gap-2">
                                {% for mood in moodOptions %}
