        </div>

        {# ── Trends chart modal ── #}
        <div x-show="calculationChartModalOpen" x-cloak
             class="fixed inset-0 z-[150] flex items-center justify-center p-4"
             style="background:rgba(0,0,0,0.5);"
             @keydown.escape.window="closeCalculationChartModal()" @click="closeCalculationChartModal()">
            <div class="relative bg-card rounded-lg border border-border w-full max-w-5xl max-h-[90vh] flex flex-col shadow-2xl" @click.stop>
                <div class="flex items-center justify-between p-6 border-b border-border shrink-0">
                    <div>
                        <h2 class="text-xl font-serif font-bold text-foreground">Tendances émotionnelles calculées</h2>
                        <p class="text-sm text-muted-foreground mt-1">Analyse de vos humeurs sur les 30 derniers jours</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <form method="POST" action="{{ path('app_tendance_reset_json') }}" @submit.prevent="handleResetSubmit" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('reset_tendance') }}">
                            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-md transition-colors">
                                Réinitialiser
