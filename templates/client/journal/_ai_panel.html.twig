{# ══ SCRIPT ═══════════════════════════════════════════════════════════════ #}
<script>
function openAiDrawer() {
    document.getElementById('ai-drawer').classList.add('open');
    document.getElementById('ai-backdrop').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeAiDrawer() {
    document.getElementById('ai-drawer').classList.remove('open');
    document.getElementById('ai-backdrop').classList.remove('open');
    document.body.style.overflow = '';
}

function aiJournalPanel() {
    const CSRF_TOKEN = '{{ csrf_token('ai_journal') }}';

    function parseMarkdown(text) {
        if (!text) return '';
        return text
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .split(/\n\n+/)
            .map(p => p.trim())
            .filter(Boolean)
            .map(p => `<p>${p.replace(/\n/g, '<br>')}</p>`)
            .join('');
    }

    return {
        activeTab: 'affirmation',

        affirmation: { text: '', date: '', loading: false, error: '' },

        prediction: {
            loading: false, text: null, html: null,
            error: null, basedOn: null, predictsFor: null, entryCount: null,
        },

        analysis: { open: false, text: '', html: '', loading: false, error: '' },

        // Chat state
        chat: { messages: [], input: '', loading: false, conversations: [], currentConversationId: null, activeConversation: false  },

        init() {
            this.$el.addEventListener('open-drawer', () => this.openDrawer());
            window.addEventListener('ai-analyse', (e) => {
                this.analyseEntry(e.detail.id);
            });
        },

        openDrawer()  { openAiDrawer(); this.loadConversations(); },
        closeDrawer() { closeAiDrawer(); },

        async loadAffirmation() {
            this.affirmation.loading = true;
            this.affirmation.error   = '';
            try {
                const res  = await fetch('{{ path('app_ai_journal_affirmation') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ _token: CSRF_TOKEN })
                });
                const data = await res.json();
                if (data.error) { this.affirmation.error = data.error; }
                else { this.affirmation.text = data.affirmation; this.affirmation.date = data.date; }
            } catch { this.affirmation.error = 'Erreur de connexion.'; }
            finally  { this.affirmation.loading = false; }
        },

        async loadPrediction() {
            this.prediction.loading = true;
            this.prediction.error   = null;
            try {
                const res  = await fetch('{{ path('app_ai_journal_next_day_prediction') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ _token: CSRF_TOKEN }),
                });
                const data = await res.json();
                if (!res.ok) {
                    this.prediction.error = data.error ?? 'Une erreur est survenue.';
                } else {
                    this.prediction.text        = data.prediction;
                    this.prediction.html        = parseMarkdown(data.prediction);
                    this.prediction.basedOn     = data.based_on;
                    this.prediction.predictsFor = data.predicts_for;
                    this.prediction.entryCount  = data.entry_count;
                }
            } catch { this.prediction.error = 'Impossible de contacter le serveur.'; }
            finally  { this.prediction.loading = false; }
        },

        async analyseEntry(entryId) {
            this.activeTab        = 'analysis';
            this.analysis.loading = true;
            this.analysis.text    = '';
            this.analysis.html    = '';
            this.analysis.error   = '';
            openAiDrawer();
            try {
                const res  = await fetch('{{ path('app_ai_journal_analyse') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ _token: CSRF_TOKEN, entry_id: entryId })
                });
                const data = await res.json();
                if (data.error) { this.analysis.error = data.error; }
                else { this.analysis.text = data.analysis; this.analysis.html = parseMarkdown(data.analysis); }
            } catch { this.analysis.error = 'Erreur de connexion.'; }
            finally  { this.analysis.loading = false; }
        },

        async loadConversations() {
            try {
                const res = await fetch('{{ path('app_ai_journal_conversations') }}', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await res.json();
                this.chat.conversations = data.conversations || [];
            } catch (e) {
                this.chat.conversations = [];
            }
        },

        async loadConversation(conversationId) {
            if (!conversationId) return;
            try {
                const res = await fetch('{{ path('app_ai_journal_conversation_messages', {'conversationId': 'CONV'}) }}'.replace('CONV', encodeURIComponent(conversationId)), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await res.json();
                this.chat.messages = (data.messages || []).map(m => ({ role: m.role, text: m.content }));
                this.chat.currentConversationId = conversationId;
                this.$nextTick(() => { if (this.$refs.chatList) this.$refs.chatList.scrollTop = this.$refs.chatList.scrollHeight; });
            } catch (e) {
                // ignore
            }
        },
        async deleteConversation(conversationId) {
            if (!confirm('Voulez-vous vraiment supprimer cette conversation ?')) return;
            try {
                await fetch('{{ path('app_ai_journal_conversation_delete', {'conversationId': 'CONV'}) }}'.replace('CONV', encodeURIComponent(conversationId)), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ _token: CSRF_TOKEN })
                });
                if (this.chat.currentConversationId === conversationId) {
                    this.chat.currentConversationId = null;
                    this.chat.messages = [];
                }
                await this.loadConversations();
            } catch (e) { console.error('Delete failed', e); }
        },
        selectConversation(conversationId) {
            this.activeTab = 'chat';
            this.openDrawer();
            this.loadConversation(conversationId);
        },
newConversation() {
    this.chat.currentConversationId = null;
    this.chat.messages = [];
    this.chat.activeConversation = true;
},

openConversation(conversationId) {
    this.chat.activeConversation = true;
    this.loadConversation(conversationId);
},
        async sendChat() {
            const text = (this.chat.input || '').trim();
            if (!text) return;
            this.chat.messages.push({ role: 'user', text });
            this.chat.input = '';
            this.chat.loading = true;
            // scroll to bottom
            this.$nextTick(() => { if (this.$refs.chatList) this.$refs.chatList.scrollTop = this.$refs.chatList.scrollHeight; });
            try {
                const payload = { _token: CSRF_TOKEN, message: text };
                if (this.chat.currentConversationId) payload.conversationId = this.chat.currentConversationId;

                const res = await fetch('{{ path('app_ai_journal_chat') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.error) {
                    this.chat.messages.push({ role: 'bot', text: 'Désolé, une erreur est survenue.' });
                } else {
                    const reply = data.reply || data?.text || 'Je suis là pour toi.';
                    this.chat.messages.push({ role: 'bot', text: reply });
                    // store conversationId returned by server
                    if (data.conversationId) this.chat.currentConversationId = data.conversationId;
                    // reload conversations list
                    this.loadConversations();
                }
            } catch (e) {
                this.chat.messages.push({ role: 'bot', text: 'Impossible de contacter le serveur.' });
            } finally {
                this.chat.loading = false;
                this.$nextTick(() => { if (this.$refs.chatList) this.$refs.chatList.scrollTop = this.$refs.chatList.scrollHeight; });
            }
        }
    };
}
</script>
