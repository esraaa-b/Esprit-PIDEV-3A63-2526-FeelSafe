{#
    Partial: _ai_panel.html.twig
    Renders a floating trigger button + a slide-over drawer containing all AI features.
    Include anywhere inside your page layout (outside other x-data components).
    {% include 'client/journal/_ai_panel.html.twig' %}
#}

{# ══ FLOATING TRIGGER BUTTON ════════════════════════════════════════════════ #}
<button
    onclick="document.getElementById('ai-drawer').dispatchEvent(new CustomEvent('open-drawer'))"
    class="ai-fab"
    title="Assistant IA"
    aria-label="Ouvrir l'assistant IA">
    <span class="ai-fab-glow"></span>
    <svg viewBox="0 0 24 24" fill="none" class="ai-fab-icon">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" fill="currentColor" opacity=".08"/>
        <path d="M9 9h1.5M13.5 9H15M9 12h6M9 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <circle cx="17" cy="7" r="3" fill="#a78bfa"/>
        <path d="M16 7h2M17 6v2" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
    <span class="ai-fab-label">IA</span>
</button>

{# ══ DRAWER BACKDROP ════════════════════════════════════════════════════════ #}
<div id="ai-backdrop" class="ai-backdrop" onclick="closeAiDrawer()"></div>

{# ══ SLIDE-OVER DRAWER ══════════════════════════════════════════════════════ #}
<div id="ai-drawer"
     x-data="aiJournalPanel()"
     x-init="init()"
     @open-drawer="openDrawer()"
     class="ai-drawer">

    <div class="ai-drawer-inner">

        {# ── Header ── #}
        <div class="ai-drawer-header">
            <div class="ai-drawer-header-left">
                <div class="ai-header-orb">
                    <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
                        <path d="M12 3v1m6.364 1.636-.707.707M21 12h-1M4 12H3m3.343-5.657-.707-.707M12 20v1M17.657 17.657l.707.707M6.343 17.657l-.707.707" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="12" cy="12" r="4" fill="#a78bfa" opacity=".3"/>
                        <circle cx="12" cy="12" r="2" fill="#a78bfa"/>
                    </svg>
                </div>
                <div>
                    <div class="ai-drawer-title">Assistant IA</div>
                    <div class="ai-drawer-subtitle">Bien-être émotionnel · Personnalisé</div>
                </div>
            </div>
            <button class="ai-close-btn" @click="closeDrawer()" aria-label="Fermer">
                <svg viewBox="0 0 24 24" fill="none" width="16" height="16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>

        {# ── Tab Nav ── #}
        <div class="ai-tabs">
            <button class="ai-tab" :class="{ 'ai-tab-active': activeTab === 'affirmation' }" @click="activeTab = 'affirmation'">
                <span class="ai-tab-icon">✨</span> Affirmation
            </button>
            <button class="ai-tab" :class="{ 'ai-tab-active': activeTab === 'prediction' }" @click="activeTab = 'prediction'">
                <span class="ai-tab-icon">🔮</span> Prédiction
            </button>
            <button class="ai-tab" :class="{ 'ai-tab-active': activeTab === 'chat' }" @click="activeTab = 'chat'">
                <span class="ai-tab-icon">💬</span> Chat
            </button>
            <button class="ai-tab" :class="{ 'ai-tab-active': activeTab === 'analysis' }" @click="activeTab = 'analysis'">
                <span class="ai-tab-icon">✦</span> Analyse
            </button>
        </div>

        {# ── Panel Body ── #}
        <div class="ai-panel-body">

            {# ════ AFFIRMATION TAB ════ #}
            <div x-show="activeTab === 'affirmation'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0">

                <p class="ai-intro-text">Une affirmation positive générée selon votre profil émotionnel du moment.</p>

                <div x-show="!affirmation.text && !affirmation.loading && !affirmation.error" class="ai-empty-state">
                    <div class="ai-empty-orb" style="--orb-color: #bbf7d0;">✨</div>
                    <p class="ai-empty-label">Prêt à vous inspirer</p>
                    <p class="ai-empty-hint">Cliquez sur "Générer" pour recevoir<br>votre affirmation personnalisée.</p>
                </div>

                <div x-show="affirmation.loading" class="ai-loading-state">
                    <div class="ai-loading-ring" x-cloak style="--ring-color: #4ade80;"></div>
                    <p class="ai-loading-label">Génération en cours…</p>
                </div>

                <div x-show="affirmation.text && !affirmation.loading" x-cloak
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-98"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="ai-result-card ai-result-green">
                    <div class="ai-result-quote">"</div>
                    <p class="ai-result-text" x-text="affirmation.text"></p>
                    <div class="ai-result-meta" x-show="affirmation.date">
                        <svg viewBox="0 0 24 24" fill="none" width="10" height="10" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        <span x-text="affirmation.date"></span>
                    </div>
                </div>

                <div x-show="affirmation.error" x-cloak class="ai-error-card">
                    <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span x-text="affirmation.error"></span>
                </div>

                <button @click="loadAffirmation()" :disabled="affirmation.loading" class="ai-action-btn ai-action-green">
                    <svg x-cloak x-show="!affirmation.loading" viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                    </svg>
                    <svg x-cloak x-show="affirmation.loading" class="ai-spin" viewBox="0 0 24 24" fill="none" width="14" height="14">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity=".25"/>
                        <path fill="currentColor" opacity=".75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                    </svg>
                    <span x-text="affirmation.loading ? 'Génération…' : (affirmation.text ? 'Nouvelle affirmation' : 'Générer')"></span>
                </button>
            </div>

            {# ════ PREDICTION TAB ════ #}
            <div x-show="activeTab === 'prediction'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0">

                <p class="ai-intro-text">Prédiction de votre journée de demain basée sur vos émotions d'aujourd'hui.</p>

                <div x-show="!prediction.text && !prediction.loading && !prediction.error" class="ai-empty-state">
                    <div class="ai-empty-orb" style="--orb-color: #e9d5ff;">🔮</div>
                    <p class="ai-empty-label">Votre futur proche</p>
                    <p class="ai-empty-hint">Cliquez sur "Prédire" pour explorer<br>votre journée de demain.</p>
                </div>

                <div x-show="prediction.loading" class="ai-loading-state">
                    <div class="ai-loading-ring" x-cloak style="--ring-color: #a78bfa;"></div>
                    <p class="ai-loading-label">Analyse de vos émotions…</p>
                </div>

                <div x-show="prediction.text && !prediction.loading" x-cloak
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-98"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="ai-result-card ai-result-purple">
                    <div class="ai-result-badge" x-show="prediction.predictsFor">
                        <svg viewBox="0 0 24 24" fill="none" width="10" height="10" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        Prédiction pour le <strong x-text="prediction.predictsFor"></strong>
                        <span x-show="prediction.entryCount" class="ai-badge-pill" x-text="prediction.entryCount + ' entrée' + (prediction.entryCount > 1 ? 's' : '')"></span>
                    </div>
                    <div class="ai-markdown" x-html="prediction.html"></div>
                </div>

                <div x-show="prediction.error" x-cloak class="ai-error-card">
                    <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span x-text="prediction.error"></span>
                </div>

                <button @click="loadPrediction()" :disabled="prediction.loading" class="ai-action-btn ai-action-purple">
                    <svg x-cloak x-show="!prediction.loading" viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M9.663 17h4.673M12 3v1m6.364 1.636-.707.707M21 12h-1M4 12H3m3.343-5.657-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                    <svg x-cloak x-show="prediction.loading" class="ai-spin" viewBox="0 0 24 24" fill="none" width="14" height="14">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity=".25"/>
                        <path fill="currentColor" opacity=".75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                    </svg>
                    <span x-text="prediction.loading ? 'Analyse…' : (prediction.text ? 'Actualiser' : 'Prédire')"></span>
                </button>
            </div>

            {# ════ ANALYSIS TAB ════ #}
            <div x-show="activeTab === 'analysis'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0">

                <p class="ai-intro-text">Analyse émotionnelle de votre entrée de journal par l'IA.</p>

                {# Empty state — no entry selected yet #}
                <div x-show="!analysis.text && !analysis.loading && !analysis.error" class="ai-analysis-empty">
                    <div class="ai-analysis-empty-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32" style="color:#a78bfa;">
                            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
                        </svg>
                    </div>
                    <p class="ai-analysis-empty-title">Aucune entrée sélectionnée</p>
                    <p class="ai-analysis-empty-hint">Cliquez sur « Analyser » sur une entrée du journal pour lancer l'analyse.</p>
                </div>

                <div x-show="analysis.loading" class="ai-loading-state">
                    <div class="ai-loading-ring" x-cloak style="--ring-color: #60a5fa;"></div>
                    <p class="ai-loading-label">Analyse en cours…</p>
                </div>

                <div x-show="analysis.text && !analysis.loading" x-cloak
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 scale-98"
                     x-transition:enter-end="opacity-100 scale-100"
                     class="ai-result-card ai-result-blue">
                    <div class="ai-markdown" x-html="analysis.html"></div>
                </div>

                <div x-show="analysis.error && !analysis.loading" x-cloak class="ai-error-card">
                    <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    <span x-text="analysis.error"></span>
                </div>

                <div x-show="analysis.text && !analysis.loading" x-cloak>
                    <button @click="closeDrawer()" class="ai-action-btn ai-action-blue">Fermer</button>
                </div>
            </div>

            {# ════ CHAT TAB ════ #}
            <div x-show="activeTab === 'chat'"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-x-2"
                 x-transition:enter-end="opacity-100 translate-x-0">

                <p class="ai-intro-text">Parle avec l'assistant. Il est là pour t'écouter et te réconforter.</p>

                {# ── Conversations list view (shown when no active convo) ── #}
                <div x-show="!chat.activeConversation">

                    {# Header row: Historique + Nouvelle conversation #}
                    <div class="ai-chat-list-header">
                        <span class="ai-chat-list-title">
                            <svg viewBox="0 0 24 24" fill="none" width="14" height="14" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Historique
                        </span>
                        <button class="ai-new-conv-btn" @click="newConversation()">
                            + Nouvelle conversation
                        </button>
                    </div>

                    {# Conversation cards #}
                    <div class="ai-conv-list">
                        <template x-if="chat.conversations.length === 0">
                            <div class="ai-conv-empty">
                                <svg viewBox="0 0 24 24" fill="none" width="28" height="28" stroke="rgba(167,139,250,0.3)" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                <p>Aucune conversation.</p>
                                <p style="font-size:10px;color:#334155;margin-top:2px;">Commencez par "Nouvelle conversation".</p>
                            </div>
                        </template>
                        <template x-for="c in chat.conversations" :key="c.conversationId">
                            <div class="ai-conv-card" @click="openConversation(c.conversationId)">
                                <div class="ai-conv-card-left">
                                    <div class="ai-conv-card-icon">
                                        <svg viewBox="0 0 24 24" fill="none" width="13" height="13" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    </div>
                                    <div>
                                        <div class="ai-conv-card-title"
                                             x-text="c.lastMessage ? (c.lastMessage.content.length > 30 ? c.lastMessage.content.slice(0,30)+'…' : c.lastMessage.content) : 'Nouvelle conversation'"></div>
                                        <div class="ai-conv-card-meta">
                                            <span x-text="'Conv. ' + (chat.conversations.indexOf(c) + 1)"></span>
                                            <span class="ai-conv-card-sep">—</span>
                                            <span x-text="c.lastMessage ? c.lastMessage.createdAt.slice(0,16).replace('T',' ') : ''"></span>
                                        </div>
                                        <div class="ai-conv-card-count" x-show="c.messageCount">
                                            <span x-text="(c.messageCount || '') + ' message(s)'"></span>
                                        </div>
                                    </div>
                                </div>
                                <button class="ai-conv-card-delete"
                                        @click.stop="deleteConversation(c.conversationId)"
                                        title="Supprimer">
                                    <svg viewBox="0 0 24 24" fill="none" width="12" height="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                </button>
                            </div>
                        </template>
                    </div>
                </div>

                {# ── Active conversation view ── #}
                <div x-show="chat.activeConversation" style="display:flex;flex-direction:column;gap:10px;">

                    {# Back button #}
                    <button class="ai-chat-back-btn" @click="chat.activeConversation = false; chat.messages = []; chat.currentConversationId = null;">
                        <svg viewBox="0 0 24 24" fill="none" width="13" height="13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                        Retour aux conversations
                    </button>

                    {# Messages #}
                    <div class="ai-chat-messages" x-ref="chatList">
                        <template x-for="(m, i) in chat.messages" :key="i">
                            <div :class="m.role === 'user' ? 'ai-chat-msg user' : 'ai-chat-msg bot'">
                                <div class="ai-chat-text" x-text="m.text"></div>
                            </div>
                        </template>
                        <div x-show="chat.loading" class="ai-chat-typing">
                            <span></span><span></span><span></span>
                        </div>
                        <template x-if="chat.messages.length === 0 && !chat.loading">
                            <div style="text-align:center;padding:24px 0;color:#334155;font-size:12px;">Dis bonjour 👋</div>
                        </template>
                    </div>

                    {# Input #}
                    <div class="ai-chat-input-row">
                        <input x-model="chat.input"
                               @keydown.enter="sendChat()"
                               placeholder="Écris quelque chose…"
                               class="ai-chat-input"
                               :disabled="chat.loading" />
                        <button @click="sendChat()"
                                :disabled="chat.loading || !chat.input.trim()"
                                class="ai-chat-send-btn">
                            <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/>
                            </svg>
                        </button>
                    </div>
                </div>

            </div>

        </div>{# end panel body #}
    </div>{# end drawer inner #}
</div>{# end drawer #}

{# ══ STYLES ══════════════════════════════════════════════════════════════════ #}
<style>
/* ── Floating Action Button ──────────────────────────────────────────── */
.ai-fab {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px 12px 14px;
    background: #0f0f1a;
    color: #e2e8f0;
    border: 1px solid rgba(167,139,250,0.25);
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35), 0 0 0 1px rgba(167,139,250,0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
.ai-fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(167,139,250,0.3), 0 0 20px rgba(167,139,250,0.15);
}
.ai-fab-glow {
    position: absolute;
    inset: -1px;
    border-radius: 50px;
    background: linear-gradient(135deg, rgba(167,139,250,0.15), transparent 60%);
    pointer-events: none;
}
.ai-fab-icon { width: 20px; height: 20px; color: #a78bfa; }
.ai-fab-label { color: #c4b5fd; }

/* ── Backdrop ────────────────────────────────────────────────────────── */
.ai-backdrop {
    display: none;
    position: fixed;
    top: 64px; left: 0; right: 0; bottom: 0;
    z-index: 99998;
    background: rgba(5,5,15,0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: backdropIn 0.25s ease forwards;
}
@media (min-width: 768px) {
    .ai-backdrop { top: 80px; }
}
.ai-backdrop.open { display: block; }
@keyframes backdropIn { from { opacity: 0; } to { opacity: 1; } }

/* ── Drawer ──────────────────────────────────────────────────────────── */
.ai-drawer {
    position: fixed;
    top: 64px; right: 0; bottom: 0; /* sit below h-16 navbar */
    z-index: 99999;
    width: 420px;
    max-width: 100vw;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
    border-radius: 16px 0 0 0;
}
@media (min-width: 768px) {
    .ai-drawer { top: 80px; } /* h-20 on md+ */
}
.ai-drawer.open { transform: translateX(0); }

.ai-drawer-inner {
    height: 100%;
    background: #0c0c18;
    border-left: 1px solid rgba(167,139,250,0.18);
    border-top: 1px solid rgba(167,139,250,0.18);
    border-radius: 16px 0 0 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: -8px 0 40px rgba(0,0,0,0.5), -1px 0 0 rgba(167,139,250,0.08);
}

/* ── Header ──────────────────────────────────────────────────────────── */
.ai-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: linear-gradient(135deg, rgba(167,139,250,0.08) 0%, rgba(139,92,246,0.04) 50%, transparent 100%);
    flex-shrink: 0;
}
.ai-drawer-header-left { display: flex; align-items: center; gap: 12px; }
.ai-header-orb {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(167,139,250,0.2), rgba(139,92,246,0.1));
    border: 1px solid rgba(167,139,250,0.3);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(167,139,250,0.15);
}
.ai-drawer-title { font-size: 14px; font-weight: 700; color: #f1f5f9; letter-spacing: -0.2px; }
.ai-drawer-subtitle { font-size: 10px; color: rgba(167,139,250,0.55); margin-top: 2px; letter-spacing: 0.3px; }
.ai-close-btn {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: #94a3b8;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    flex-shrink: 0;
}
.ai-close-btn:hover { background: rgba(239,68,68,0.12); color: #f87171; border-color: rgba(239,68,68,0.2); }

/* ── Tabs ────────────────────────────────────────────────────────────── */
.ai-tabs {
    display: flex;
    gap: 2px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0;
    background: rgba(0,0,0,0.2);
}
.ai-tab {
    flex: 1;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 11px; font-weight: 600;
    color: #64748b;
    cursor: pointer; border: none;
    background: transparent;
    transition: all 0.15s ease;
    display: flex; align-items: center; justify-content: center; gap: 5px;
    letter-spacing: 0.2px;
}
.ai-tab:hover { color: #94a3b8; background: rgba(255,255,255,0.04); }
.ai-tab-active {
