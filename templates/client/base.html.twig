<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.name'|trans }} - {{ 'nav.dashboard'|trans }}{% endblock %}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: {% if app.request.locale == 'ar' %}'Segoe UI', Tahoma, 'Arial Unicode MS'{% else %}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto{% endif %}, sans-serif;
            background: #f5f5f5;
        }
        .app-layout { display: flex; min-height: 100vh; }
        .sidebar {
            width: 280px; background: white;
            border-{{ app.request.locale == 'ar' ? 'left' : 'right' }}: 1px solid #e5e7eb;
            display: flex; flex-direction: column; position: fixed;
            height: 100vh; {{ app.request.locale == 'ar' ? 'right' : 'left' }}: 0; top: 0;
        }
        .sidebar-header { padding: 24px 20px; border-bottom: 1px solid #e5e7eb; }
        .logo { display: flex; align-items: center; gap: 12px; }
        .logo-icon { font-size: 28px; }
        .logo-text { font-size: 24px; font-weight: 700; color: #1f2937; }
        .sidebar-nav { flex: 1; padding: 20px 12px; overflow-y: auto; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; margin-bottom: 4px; border-radius: 8px; text-decoration: none; color: #6b7280; font-size: 15px; transition: all 0.2s; }
        .nav-item:hover { background: #f3f4f6; color: #1f2937; }
        .nav-item.active { background: #10b981; color: white; }
        .nav-icon { font-size: 20px; }
        .sidebar-footer { padding: 16px; border-top: 1px solid #e5e7eb; }
        .user-profile { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 8px; cursor: pointer; transition: background 0.2s; }
        .user-profile:hover { background: #f3f4f6; }
        .user-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #10b981 0%, #059669 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px; }
        .user-info { flex: 1; min-width: 0; }
        .user-name { font-weight: 600; font-size: 14px; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-email { font-size: 12px; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-menu-btn { background: none; border: none; color: #6b7280; cursor: pointer; font-size: 20px; padding: 4px; }
        .main-content {
            {{ app.request.locale == 'ar' ? 'margin-right' : 'margin-left' }}: 280px;
            flex: 1; padding: 32px; overflow-y: auto;
        }
        {% block extra_styles %}{% endblock %}
    </style>
</head>
<body>
<div class="app-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <span class="logo-icon">❤️</span>
                <span class="logo-text">{{ 'app.name'|trans }}</span>
            </div>
        </div>

        {# ✅ Bouton langue #}
        <div style="padding:8px 12px;border-bottom:1px solid #e5e7eb;">
            <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
               style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:8px;background:#f3f4f6;color:#374151;font-size:13px;font-weight:600;text-decoration:none;">
                🌐 {{ 'app.lang_switch'|trans }}
            </a>
        </div>

        <nav class="sidebar-nav">
            {% set r = app.request.get('_route') %}

            <a href="{{ path('app_client') }}" class="nav-item {{ r == 'app_client' ? 'active' : '' }}">
                <span class="nav-icon">📊</span>
                <span class="nav-text">{{ 'nav.dashboard'|trans }}</span>
            </a>
            <a href="{{ path('app_security') }}" class="nav-item {{ r starts with 'app_security' ? 'active' : '' }}">
                <span class="nav-icon">🛡️</span>
                <span class="nav-text">{{ 'nav.security'|trans }}</span>
            </a>
            <a href="{{ path('app_journal') }}" class="nav-item {{ r starts with 'app_journal' ? 'active' : '' }}">
                <span class="nav-icon">📔</span>
                <span class="nav-text">{{ 'nav.journal'|trans }}</span>
            </a>
            <a href="{{ path('app_support') }}" class="nav-item {{ r == 'app_support' ? 'active' : '' }}">
                <span class="nav-icon">❤️</span>
                <span class="nav-text">{{ 'nav.support'|trans }}</span>
            </a>
            <a href="{{ path('app_wellness') }}" class="nav-item {{ r == 'app_wellness' ? 'active' : '' }}">
                <span class="nav-icon">☀️</span>
                <span class="nav-text">{{ 'nav.wellness'|trans }}</span>
            </a>
            <a href="{{ path('app_emergency') }}" class="nav-item {{ r == 'app_emergency' ? 'active' : '' }}">
                <span class="nav-icon">⚠️</span>
                <span class="nav-text">{{ 'nav.emergency'|trans }}</span>
            </a>
            <a href="{{ path('app_forum') }}" class="nav-item {{ r == 'app_forum' ? 'active' : '' }}">
                <span class="nav-icon">👥</span>
                <span class="nav-text">{{ 'nav.forum'|trans }}</span>
            </a>
            <a href="{{ path('app_logout') }}" class="nav-item" style="color:#ef4444;margin-top:16px;">
                <span class="nav-icon">🚪</span>
                <span class="nav-text">{{ 'nav.logout'|trans }}</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">
                    {{ (prenom|default('U'))[0]|upper }}{{ (nom|default('U'))[0]|upper }}
                </div>
                <div class="user-info">
                    <div class="user-name">{{ prenom|default('') }} {{ nom|default('') }}</div>
                    <div class="user-email">{{ email|default('') }}</div>
                </div>
                <button class="user-menu-btn">⋮</button>
            </div>
        </div>
    </aside>

    <main class="main-content">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
