<!-- dashboard_navbar.html.twig -->

{# Read stars from sessionStorage BEFORE Alpine initializes — eliminates flash #}
<script>
(function() {
    try {
        const d = JSON.parse(sessionStorage.getItem('feelsafe_stars') || 'null');
        window.__feelsafeStars = d || { stars: 0, badge: false, remaining: 6, tooltip: '' };
    } catch(_) {
        window.__feelsafeStars = { stars: 0, badge: false, remaining: 6, tooltip: '' };
    }
})();
</script>

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
     x-data="{ scrolled: false }"
     x-init="window.addEventListener('scroll', () => scrolled = window.scrollY > 50)"
     :class="scrolled ? 'bg-white/95 dark:bg-gray-100/95 backdrop-blur-md shadow-lg' : 'bg-transparent'">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 md:h-20">

            {# ── Logo + Stars ── #}
            <div class="flex items-center gap-2 flex-shrink-0"
                 x-data="feelsafeStars()"
                 x-init="init()">
                <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                </div>
                <div class="flex flex-col leading-none gap-0.5">
                    <span class="text-lg font-bold text-foreground">FeelSafe</span>
                    <div class="flex items-center gap-0.5 cursor-default" :title="tooltip">
                        <template x-for="i in 6" :key="i">
                            <span class="text-sm leading-none transition-all duration-200"
                                  :style="i <= stars
                                      ? 'color:#facc15; filter:drop-shadow(0 0 3px #facc1599);'
                                      : 'color:#d1d5db;'">★</span>
                        </template>
                    </div>
                    <span x-show="badge" x-cloak
                          x-transition:enter="transition ease-out duration-300"
                          x-transition:enter-start="opacity-0 translate-y-1"
                          x-transition:enter-end="opacity-100 translate-y-0"
                          class="text-xs font-bold"
                          style="color:#facc15; line-height:1.2;">
                        🏅 Badge du mois !
                    </span>
                </div>
            </div>

            {# ── Navigation desktop ── #}
            <div class="hidden lg:flex items-center gap-0.5">
                {% set current_route = app.request.get('_route') %}
                {% set isForumContext =
                    (current_route is defined and current_route starts with 'app_front_publication')
                    or (app.request.pathInfo starts with '/front/publication')
                    or (app.request.pathInfo starts with '/dashboard/forum')
                %}
                {% set navLinks = [
                    {url: '/client/dashboard',    label: 'nav.dashboard'|trans,  active: current_route == 'dashboard'},
                    {url: '/dashboard/security',  label: 'nav.security'|trans,   active: false},
                    {url: '/dashboard/journal',   label: 'nav.journal'|trans,    active: false},
                    {url: '/dashboard/support',   label: 'nav.support'|trans,    active: false},
                    {url: '/dashboard/wellness',  label: 'nav.wellness'|trans,   active: false},
                    {url: '/dashboard/emergency', label: 'nav.emergency'|trans,  active: false},
                    {url: '/dashboard/forum',     label: 'nav.forum'|trans,      active: isForumContext},
                ] %}
                {% for link in navLinks %}
                    <a href="{{ link.url }}"
                       class="px-3 py-1.5 rounded-md text-[15px] font-medium transition-colors whitespace-nowrap
                              {{ link.active
                                 ? 'text-primary bg-primary/10'
                                 : 'text-muted-foreground hover:text-foreground hover:bg-secondary/60' }}">
                        {{ link.label }}
                    </a>
                {% endfor %}
            </div>

            {# ── Right side ── #}
            <div class="flex items-center gap-2 flex-shrink-0">

                {# Language toggle — always visible #}
                <a href="{{ path('app_locale_switch', {locale: app.request.locale == 'ar' ? 'fr' : 'ar'}) }}"
                   class="flex items-center px-3 py-1.5 text-xs font-semibold border border-gray-300 rounded-full hover:bg-gray-100 transition-colors text-gray-600 whitespace-nowrap">
                    🌐 {{ 'app.lang_switch'|trans }}
                </a>

                {# Notifications #}
                <div class="relative">
                    {{ render(controller('App\\Controller\\FrontPublicationController::badge')) }}
                </div>

                {# User menu #}
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open"
                            class="flex items-center gap-2 p-2 hover:bg-secondary rounded-lg transition-colors">
                        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                            <span class="text-sm font-medium text-primary-foreground">
                                {% if app.user %}
                                    {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                                {% else %}U{% endif %}
                            </span>
                        </div>
                        <svg class="w-4 h-4 text-muted-foreground transition-transform duration-200"
                             :class="open ? 'rotate-180' : ''"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <div x-show="open" @click.away="open = false"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="opacity-100 scale-100"
                         x-transition:leave-end="opacity-0 scale-95"
                         class="absolute right-0 mt-2 w-48 bg-card border border-border rounded-lg shadow-lg py-1 z-50"
                         style="display:none;">
                        <a href="{{ path('app_profile') }}" @click="open = false"
                           class="block px-4 py-2 text-sm text-foreground hover:bg-secondary">{{ 'nav.profile'|trans }}</a>
                        <a href="{{ path('app_security') }}" @click="open = false"
                           class="block px-4 py-2 text-sm text-foreground hover:bg-secondary">{{ 'profile.security'|trans }}</a>
                        <a href="{{ path('app_settings') }}" @click="open = false"
                           class="block px-4 py-2 text-sm text-foreground hover:bg-secondary">{{ 'nav.settings'|trans }}</a>
                        <hr class="my-1 border-border">
                        <a href="{{ path('app_logout') }}" @click="open = false"
                           class="block px-4 py-2 text-sm text-destructive hover:bg-secondary">{{ 'nav.logout'|trans }}</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</nav>

<script>
function feelsafeStars() {
    return {
        // Initialize directly from the global set synchronously above — no flash
        stars:     window.__feelsafeStars.stars,
        badge:     window.__feelsafeStars.badge,
        remaining: window.__feelsafeStars.remaining,
        tooltip:   window.__feelsafeStars.tooltip,

        async init() {
            // Fetch fresh data silently in background
            try {
                const res  = await fetch('/dashboard/stars/data', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                this.stars     = data.stars     ?? 0;
                this.badge     = data.badge     ?? false;
                this.remaining = data.remaining ?? 6;
                this.tooltip   = data.tooltip   ?? '';
                // Update cache for next page
                window.__feelsafeStars = data;
                sessionStorage.setItem('feelsafe_stars', JSON.stringify(data));
            } catch (e) {
                console.warn('Stars fetch failed', e);
            }
        }
    };
}
</script>